#!/bin/bash
# Compare each installed agent app with the newest version it could be updated
# to and record the result for the bar panel. Never installs anything.
#
#   omarchy     omarchy-pkgs' own bin/sync-upstream moves the recipe to the
#               vendor's newest release in a local clone, the resulting version
#               is read back, and the recipe is restored.
#   vendor-pkg  the feed in apps.json; the vendor publishes the package.
#   indicator   the feed in apps.json; no install path.
#   mise        `mise latest <tool>`.
#
#   agent-apps-check [--no-notify] [--no-mise]
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/agent-apps-common"

notify=1 with_mise=1
for arg; do
  case $arg in
    --no-notify) notify=0 ;;
    --no-mise) with_mise=0 ;;
    *) echo "usage: agent-apps-check [--no-notify] [--no-mise]" >&2; exit 2 ;;
  esac
done

mkdir -p "$state_dir"
# The shell timer and a hand run can overlap; the second one has nothing to add.
exec 9>"$state_dir/.check.lock"
flock -n 9 || exit 0

previous='{"apps":[]}'
[[ -s $status_file ]] && jq -e . "$status_file" >/dev/null 2>&1 && previous=$(<"$status_file")
notified='{}'
[[ -s $notified_file ]] && jq -e 'type == "object"' "$notified_file" >/dev/null 2>&1 && notified=$(<"$notified_file")

tmp=$(mktemp -d)
pkgs_state=""
pkgs_commit=$(jq -r '.omarchyPkgs.commit // ""' <<<"$previous")
pkgs_error=""
missing=$(missing_tools | paste -sd, - | sed 's/,/, /g')
rows=() order='[]' status_done=0
cleanup() {
  (( status_done )) || write_status 2 || true
  [[ $pkgs_state == ready ]] && pkgs_restore .
  rm -rf "$tmp"
}
trap cleanup EXIT

# The clone is set up on first need, so a machine without any Omarchy-packaged
# app never fetches it. An install holds the lock for its whole build; the
# check then keeps what it knew instead of waiting.
pkgs_ready() {
  if [[ -z $pkgs_state ]]; then
    if ! pkgs_take_lock 20; then
      pkgs_state=busy
      pkgs_error="The omarchy-pkgs clone is busy with an update, showing the last result"
    elif pkgs_commit=$(pkgs_prepare 2>"$tmp/git.err"); then
      pkgs_state=ready
    else
      pkgs_state=failed
      pkgs_error="Could not update the omarchy-pkgs clone: $(tail -1 "$tmp/git.err")"
    fi
  fi
  [[ $pkgs_state == ready ]]
}

table=$(apps_table)
order=$(jq -c 'map(.pkg)' <<<"$table")

# Replaces status.json in one rename. $1 is 0 while checking, 1 for the final
# write, 2 when the run dies half way. Until the final write, rows not checked
# yet keep their previous entry, flagged "checking": true while the run lasts,
# so the panel shows progress row by row; the check time stays the old one.
write_status() {
  local final=$1 out at
  at=$(jq -r '.checkedAt // ""' <<<"$previous")
  (( final == 1 )) && at=$(date -Iseconds)
  out=$(mktemp "$state_dir/.status.XXXXXX")
  # Desktop apps first, mise tools after them, each in table order.
  printf '%s\n' "${rows[@]}" | jq -s --argjson prev "$previous" --argjson order "$order" \
    --argjson final "$final" --arg at "$at" --arg commit "$pkgs_commit" --arg perr "$pkgs_error" '
    (map(.pkg)) as $done
    | (if $final == 1 then .
       else . + [$prev.apps[] | select(.pkg as $p | $done | index($p) | not) | .checking = ($final == 0)] end)
    | sort_by([.source == "mise", (.pkg as $p | $order | index($p) // 1e9)])
    | {checkedAt: $at, checking: ($final == 0), omarchyPkgs: {commit: $commit, error: $perr}, apps: .}' >"$out"
  mv -f "$out" "$status_file"
}

write_status 0
while IFS= read -r app; do
  pkg=$(jq -r '.pkg' <<<"$app")
  label=$(jq -r '.label // .pkg' <<<"$app")
  [[ $with_mise == 0 && $(jq -r '.source' <<<"$app") == mise ]] && continue
  read -r source installed_name installed < <(installed_app "$app") || continue

  prev=$(jq -c --arg pkg "$pkg" '[.apps[] | select(.pkg == $pkg)][0] // {}' <<<"$previous")
  latest="" from="" error="" note="" installable=false keep=false
  feed_err=""

  case $source in
    mise)
      installable=true
      rc=0
      latest=$(mise_latest "$installed_name" 2>"$tmp/err") || rc=$?
      case $rc in
        0) from=mise ;;
        2) continue ;;  # not in mise's registry, so nothing to compare with
        *) latest="" error=$(<"$tmp/err") ;;
      esac ;;
    vendor-pkg)
      if vendor_pkg_url "$app" x >/dev/null; then
        installable=true
        [[ $installed_name != "$pkg" ]] && note="Installed as $installed_name, Update switches to $pkg"
      else
        note="No vendor package for $(uname -m)"
      fi
      latest=$(feed_version "$app" 2>"$tmp/err") && from=feed || error=$(<"$tmp/err") ;;
    indicator)
      note="No supported install path"
      [[ $(jq -r '.feed.type // ""' <<<"$app") == aur-rpc ]] && note+=", version from AUR"
      latest=$(feed_version "$app" 2>"$tmp/err") && from=feed || error=$(<"$tmp/err") ;;
    omarchy)
      sync_err=""
      if pkgs_ready; then
        overlay=$(recipe_overlay "$pkg" "$app" 2>"$tmp/err") || { overlay=""; sync_err=$(<"$tmp/err"); }
        note=$(recipe_blocker "$pkg")
        [[ -z $note && -n $overlay ]] && note="Recipe from unmerged $overlay"
        if [[ -z $(recipe_blocker "$pkg") ]]; then
          installable=true
          # A recipe whose hook downloads the whole release to hash it is
          # checked through the plugin's own feed; the hook runs on install.
          if [[ $(jq -r '.checkWith // ""' <<<"$app") != feed ]]; then
            if (cd "$pkgs_dir" && timeout 300 bin/sync-upstream "$pkg") >"$tmp/sync.log" 2>&1 </dev/null \
               && read -r _ latest < <(recipe_version "$pkgs_dir/pkgbuilds/$pkg" 2>"$tmp/err"); then
              from=recipe
            else
              latest=""
              sync_err=$(sync_error "$tmp/sync.log")
              [[ -n $sync_err ]] || sync_err=$(<"$tmp/err")
            fi
            pkgs_restore "$pkg"
          fi
        fi
      elif [[ $pkgs_state == busy ]]; then
        keep=true
        note=$pkgs_error
      else
        sync_err=$pkgs_error
      fi
      if [[ -z $latest && $keep == false ]]; then
        if [[ $(jq -r '.feed.type // ""' <<<"$app") != "" ]]; then
          if latest=$(feed_version "$app" 2>"$tmp/err"); then
            from=feed
            [[ -n $sync_err ]] && note="Recipe sync failed ($sync_err), version from the vendor feed"
          else
            feed_err=$(<"$tmp/err")
            error="feed unavailable: ${sync_err:+$sync_err; }$feed_err"
          fi
        else
          error="feed unavailable: ${sync_err:-no vendor feed declared}"
        fi
      fi
      [[ -n $missing ]] && note="Missing: $missing${note:+; $note}" ;;
    *)
      error="unknown source '$source'" ;;
  esac

  # Keep the last known version so a flaky feed neither hides a pending
  # update nor re-announces it once the feed comes back.
  if [[ -n $error || $keep == true ]]; then
    latest=$(jq -r '.latest // ""' <<<"$prev")
    from=$(jq -r '.versionFrom // ""' <<<"$prev")
    [[ $keep == true ]] && installable=$(jq -r '.installable // false' <<<"$prev")
  fi
  error=${error:0:240}

  # A recipe version is a full pacman version; a feed only knows upstream's.
  update=false
  if [[ -n $latest ]]; then
    have=$installed
    [[ $from == feed ]] && have=$(upstream_part "$installed")
    newer "$latest" "$have" && update=true
  fi

  announced=$(jq -r --arg pkg "$pkg" '.[$pkg] // ""' <<<"$notified")
  if (( notify )) && [[ $update == true && -z $error ]] \
     && { [[ -z $announced ]] || newer "$latest" "$announced"; }; then
    body="Installed: $installed. Open the Agent Apps panel to update."
    [[ $installable == true ]] || body="Installed: $installed. ${note^}."
    if notify-send -a "Agent Apps" "$label $latest available" "$body" 2>/dev/null; then
      notified=$(jq -c --arg pkg "$pkg" --arg v "$latest" '.[$pkg] = $v' <<<"$notified")
    fi
  fi

  rows+=("$(jq -cn --arg pkg "$pkg" --arg label "$label" --arg source "$source" \
    --arg installedName "$installed_name" --arg installed "$installed" \
    --arg latest "$latest" --arg versionFrom "$from" --argjson update "$update" \
    --argjson installable "$installable" --arg error "$error" --arg note "$note" \
    --arg icon "$(jq -r '.icon // ""' <<<"$app")" --arg iconLight "$(jq -r '.iconLight // ""' <<<"$app")" \
    '{pkg: $pkg, label: $label, source: $source, installedName: $installedName,
      installed: $installed, latest: $latest, versionFrom: $versionFrom,
      updateAvailable: $update, installable: $installable, error: $error, note: $note,
      icon: $icon, iconLight: $iconLight}')")
  write_status 0
done < <(jq -c '.[]' <<<"$table")

write_status 1
status_done=1

out=$(mktemp "$state_dir/.notified.XXXXXX")
jq . <<<"$notified" >"$out"
mv -f "$out" "$notified_file"
