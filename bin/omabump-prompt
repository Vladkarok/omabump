#!/bin/bash
# Print a prompt asking a coding agent to plan an update of one app the plugin
# cannot update itself (indicator rows, recipes without an upstream watch,
# rows whose route failed), or a mise tool its request holds below a newer
# release. The panel's "Ask agent" passes it to
# omarchy-agent --prompt, "Copy prompt" puts it on the clipboard. Reads the
# last check's status.json.
#
#   omabump-prompt <pkg>
set -euo pipefail
here=$(dirname "$(readlink -f "$0")")
# shellcheck source=omabump-common
source "$here/omabump-common"

name=${1:?usage: omabump-prompt <pkg>}
die() { echo "omabump-prompt: $*" >&2; exit 1; }

app=$(app_json "$name") || die "$name is not in the app table"
pkg=$(jq -r .pkg <<<"$app")
[[ -s $status_file ]] || die "no check has run yet; run $here/omabump-check"
row=$(jq -ce --arg pkg "$pkg" '[.apps[] | select(.pkg == $pkg)][0]' "$status_file" 2>/dev/null) \
  || die "$pkg is not in the last check (not installed?)"
IFS=$'\x1f' read -r label installed_name installed latest from update < <(jq -r \
  '[.label // .pkg, .installedName // .pkg, .installed, .latest // "", .versionFrom // "", .updateAvailable == true] | map(tostring) | join("\u001f")' <<<"$row")
if [[ $(jq -r .source <<<"$app") == mise ]]; then
  # mise rows always have a route (mise up); a prompt is only for one held
  # below a newer release by its request or by mise's settings.
  [[ -n $latest && $latest != "$installed" && $update != true ]] \
    || die "the last check found $label held below no newer release; mise up handles it"
  request=$(jq -r '.request // ""' <<<"$row")
  if [[ -n $request && $request != latest ]]; then
    held="pinned by the request '$request'"
  else
    held="held back by mise's settings (the request is '${request:-latest}', and Omabump runs mise with no release-age cooldown)"
  fi
  echo "On this Omarchy (Arch Linux, Hyprland) machine, $label is managed by mise as $installed_name, installed at $installed and $held; $latest exists, and mise up will not move it. First, without changing anything, find where that request or setting comes from (mise ls $installed_name, mise config ls, mise settings) and write a plan: either adjust the mise request so mise up can install $latest, or explain why it cannot or should not move. Show me the plan and wait for my approval before changing any mise config or installing anything. You run with whatever permissions omarchy-agent grants you, which may let you run commands without asking, so this approval step is up to you. Never edit /usr/share/omarchy. When done, run \`$here/omabump-check --no-notify --wait\` so the Omabump panel refreshes."
  exit 0
fi
[[ -n $latest && $update == true ]] || die "the last check found no newer version of $label"

url=$(per_arch .feed.url "$app")
case $from:$(jq -r '.feed.type // ""' <<<"$app") in
  *:apt-index) where="in the vendor's apt repository, $url" ;;
  *:zcode-manifest|*:latest-yml) where="according to the vendor's update feed, $url" ;;
  *:github-release) where="https://github.com/$(jq -r .feed.repo <<<"$app")/releases/latest" ;;
  *:aur-rpc) where="version taken from the AUR package https://aur.archlinux.org/packages/$(jq -r '.feed.name // .pkg' <<<"$app")" ;;
  *) where="according to the feed in Omabump's app table" ;;
esac

echo "On this Omarchy (Arch Linux, Hyprland) machine, $label is installed as pacman package $installed_name $installed, and the vendor has published $latest ($where). First, without changing anything, find the vendor's official Linux build and write a plan to update the app to $latest in a way pacman can manage: the Omarchy recipe in omarchy-pkgs (https://github.com/omacom/omarchy-pkgs) if one exists, else the vendor's own Arch package. If neither exists, say so and stop. Show me the plan and wait for my approval before running anything that changes the system, with or without sudo. You run with whatever permissions omarchy-agent grants you, which may let you run commands without asking, so this approval step is up to you. Never edit /usr/share/omarchy, and leave user data under ~/.config untouched. When done, run \`$here/omabump-check --no-notify --wait\` so the Omabump panel refreshes."
