#!/bin/bash
# Install the newest release of one agent app. Meant to run in a visible
# terminal: makepkg and pacman talk to the user, sudo may ask for a password,
# and pacman always asks before it installs.
# Every path runs install knowledge someone else maintains:
#
#   repo        Update: the package Omarchy's own repo [omarchy] publishes,
#               signed with Omarchy's key: downloaded, its sha256,
#               signature, name and version checked, installed with pacman
#               -U. It never builds, and no code from omarchy-pkgs runs.
#               Build now (--build), for a release the vendor has and the
#               repo not yet, on an entry with "build": true and only while
#               the buildAhead setting is on: Omarchy's own recipe from
#               omarchy-pkgs at the commit pinned in pins.json, checked out
#               detached, moved to the vendor's newest release by
#               omarchy-pkgs' bin/sync-upstream, built with makepkg. The
#               recipe diff is shown before anything is built.
#   vendor-pkg  The Arch package the vendor publishes, at the version the
#               app's feed advertises, installed with pacman -U.
#   mise        mise install <tool>@<version>, the version mise outdated
#               finds under the configured request.
#
#   self        Omabump itself: its clone fast-forwarded to the release tag,
#               after the log is shown and you answer y.
#
# An app installed as a copy that updates itself (apps.json "appImage" or
# "npmPackage") instead of its package is refused: the app updates itself.
#
#   omabump-install [--prepare] [--switch | --build] <pkg>
#
# --switch replaces an app installed under another package name
# (chatgpt-desktop, z-code-bin) with <pkg> at the same or a newer full
# version. Update requires a strictly newer one. Either way pacman asks
# before it removes the old package, and the scripts the new package runs
# are printed first. Build now reads the conflict pacman needs from the
# recipe before the build, and from the built package again after.
# An Update whose route has nothing newer than what is installed succeeds
# when the app has already reached the version the panel showed (something
# else updated it since the last check, or while makepkg built) and fails
# when the route is behind that version (nothing_newer).
#
# --prepare with --build fetches, syncs and prepares the recipe (this runs
# omarchy-pkgs' sync tool and the recipe's hook, and makepkg reads the
# PKGBUILD), and stops before makepkg builds. On the vendor path it downloads and checks the
# package and stops before pacman -U. On the repo path it reads the repo's
# database and stops before it downloads the package. Nothing is installed and sudo is never
# called; the staging and install commands are printed instead. On the self
# row it fetches the release tag, prints the plan and stops before asking.
# Where a run would end without installing (a version refused, nothing left
# to install), it prints what that run would decide and ends there too.
set -euo pipefail
# BASH_SOURCE, not $0: the tests source this file (see the end).
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck source=omabump-common
source "$here/omabump-common"

# Sourcing this file defines functions and constants and nothing else: it
# takes no lock, reads no state and never exits. omabump_install, called at
# the end when the file runs as a command, is the run.
#
# A run's facts are globals, set in this order and read by all that follows:
#   install_args     prepare switch build pkg (as given), action (what the
#                    messages call the run: Update or Build now)
#   install_app      app pkg (the table's) label staged_left
#   installed_facts  source installed_name installed
# The routes then set target_version and shown, and the bookkeeping on_exit
# reads (restore_clone started self_before self_stop staged_copy
# staging_running pacman_running).

# pacman -U reads the package from a root-owned copy in staging_dir
# (stage_and_install), a running pacman holds pacman_lock, and bin_dir is
# where drop_orphan_link looks. Set here, whatever the environment says, so
# a run as a command changes none of them: only the tests, which source this
# file (see the end), set their own afterwards.
staging_dir=/var/cache/omabump pacman_lock=/var/lib/pacman/db.lck bin_dir=/usr/bin
prepare=0 switch=0 build=0 action=Update pkg="" app="" label="" staged_left=""
source="" installed_name="" installed="" target_version=""

die() { echo "omabump: $*" >&2; exit 1; }

# Where --prepare stops: prints what the run would do or say from here, the
# lines $@, and ends with 0. A real run goes on past it.
prepare_stop() {
  (( prepare )) || return 0
  (( ! $# )) || printf '%s\n' "$@"
  exit 0
}

# Ends a run that cannot install: says why, $1, or with --prepare what a
# run would refuse, and stops there as that run would.
refuse() {
  prepare_stop "Would refuse: $1"
  die "$1"
}

# The arguments: --prepare, --switch or --build, then the package.
install_args() {
  local usage="usage: omabump-install [--prepare] [--switch | --build] <pkg>"
  prepare=0 switch=0 build=0 action=Update
  while [[ ${1:-} == --* ]]; do
    case $1 in
      --prepare) prepare=1 ;;
      --switch) switch=1 ;;
      --build) build=1 action="Build now" ;;
      *) echo "$usage" >&2; exit 2 ;;
    esac
    shift
  done
  pkg=${1:?$usage}
}

# The app's entry for the package named: Omabump's own row, or the table's,
# found by its pkg or an installed name (z-code-bin finds ZCode).
install_app() {
  command -v jq >/dev/null || die "jq is missing; install it with: sudo pacman -S --needed jq"
  if [[ $pkg == "$self_pkg" ]]; then
    app=$self_app
  else
    load_table
    app=$(app_json "$pkg") || die "$pkg is not in the app table"
  fi
  pkg=$(jq -r .pkg <<<"$app")
  # The name becomes a lock file name below and reaches pacman and git.
  app_id_ok "$pkg" || die "'$pkg' is not a package name Omabump accepts"
  # A label may come from the user's apps.json: shown in the terminal only
  # after term_safe, on one line.
  label=$(jq -r '.label // .pkg' <<<"$app" | term_safe | tr '\t\n' '  ' | sed 's/ *$//')
  # The staged copies stopped runs left (on_exit), one record per app: only
  # a run holding the app's lock (fd 7) reads or writes it, while updates of
  # other apps may run at the same time.
  staged_left=$cache_dir/staged-left/$pkg
}

# What is installed for the app now: its source, the name it is installed
# under (a package, a mise tool, a self-updating copy's path) and the
# version, both empty when nothing is.
installed_facts() {
  installed_name="" installed=""
  [[ $(jq -r '.source' <<<"$app") == mise ]] && mise_load 0
  if read -r source installed_name installed < <(installed_app "$app"); then :; else
    source=$(jq -r '.source // ""' <<<"$app")
  fi
}

# The refusals Omabump's own rules make from the app's entry, the arguments
# and what is installed, with no recipe, feed or package to read. Prints the
# reason of the first that applies, as a run refuses with it, and succeeds;
# fails with 1 when none applies, and with 2 when a rule could not read the
# entry (update_blocked), which is neither: a run ends there as failed,
# --prepare too, as a read under set -e ended it (rule_ask). It writes
# nothing, locks nothing and asks no network: it reads the entry, the facts
# installed_facts read, the plugin directory and, for copy, what
# installed_app reads (pacman's database, an npm package.json, an
# AppImage's desktop entry through 7z to stdout). It calls neither refuse
# nor die: a run and --prepare act on the same answer (refuse), and a test
# can ask it directly. $1 is how far the run has got, which names the
# rules it asks:
#   copy   the app's lock taken, the staged copies stopped runs left not yet
#          removed: an app installed as a copy that updates itself
#          (installed_app: an npmPackage, or an appImage with its package
#          not installed). The app updates itself, replacing the copy, so
#          nothing here may stage, build or call sudo for it. It reads what
#          is installed itself.
#   entry  those copies removed, which every other refusal leaves the run to
#          do first: Update turned off in apps.json (updateBlocked), a known
#          problem in what it would install. Not for a copy that updates
#          itself: copy refuses that.
#   route  installed_facts read: --switch on a row it does not work for, or
#          with nothing to switch; --build on a row Build now may not build,
#          beside --switch, or while the buildAhead setting is off (read
#          once, with the other settings, by load_quiet); an indicator row;
#          Omabump run from a local checkout. The run has not written a
#          file of its own yet, nor asked the network anything.
# The rules that need the synced recipe (a hold, its version, its
# conflicts), the feed (nothing newer, no https package or published
# checksum for the release, a mise request or backend) or the package (its
# owners, its full version) are the routes', where that data is.
rule_refusal() {
  local name how blocked
  case $1 in
    copy)
      jq -e '(.appImage // "") != "" or (.npmPackage // "") != ""' >/dev/null 2>&1 <<<"$app" || return 1
      read -r _ name _ < <(installed_app "$app") || return 1
      self_updating_name "$name" || return 1
      how=$(self_update_text "$app" "$label" | term_safe | tr '\t\n' '  ' | sed 's/ *$//')
      echo "$label updates itself: $how (it is installed as $name, which Omabump does not replace)" ;;
    entry)
      blocked=$(update_blocked "$app" false) || return $(( $? == 1 ? 1 : 2 ))
      echo "Update of $label is off in Omabump: $(term_safe <<<"$blocked" | tr '\t\n' '  ' | sed 's/ *$//')" ;;
    route)
      if (( switch )) && ! route "$source" switch yes; then
        echo "--switch works for rows from Omarchy's repo and vendor rows only"
      elif (( switch && build )); then
        echo "--switch and --build do not go together: Build now replaces a package installed under another name itself, as Update does"
      elif (( switch )) && [[ -z $installed_name || $installed_name == "$pkg" ]]; then
        echo "$label is not installed under another name; nothing to switch"
      elif (( build )) && ! build_allowed "$app"; then
        echo "Build now is not available for $label: Omabump does not build its recipe (its apps.json entry has no \"build\": true). Update installs it once Omarchy's repo has it"
      elif (( build )) && [[ $setting_build_ahead != true ]]; then
        echo "Build now is off. It builds $label on this machine from Omarchy's own recipe, before Omarchy's repo has the release: it takes minutes, runs Omarchy's build recipe as you, and the package is not signed by Omarchy. Turn it on with: omarchy bar set $self_plugin_id buildAhead true --json (or in the Omabump panel's settings)"
      elif [[ $source == indicator ]]; then
        echo "$label has no Update here: omarchy update updates it when pacman or the AUR has its package, else update it the way you installed it"
      elif [[ $source == self ]] && ! self_git_managed; then
        echo "Omabump runs from a local checkout ($plugin_dir); update it with git"
      else
        return 1
      fi ;;
    *) return 1 ;;
  esac
}

# Asks rule_refusal at the phase $1: sets why to the reason and succeeds
# when a rule refuses, fails when none applies, and ends the run, with
# --prepare too, when a rule could not read the app's entry: that is no
# answer, and Update must not go on as if Update were not off.
rule_ask() {
  local rc=0
  why=$(rule_refusal "$1") || rc=$?
  (( rc < 2 )) || die "could not read the entry of $label in the app table; nothing was installed"
  return "$rc"
}

# The staged copies earlier runs of this app recorded in $staged_left
# (on_exit: stopped while sudo or pacman ran, or with the terminal closed)
# that are still there, one per line. The record is a file of yours, so
# only a plain file name in $staging_dir counts; other lines do not.
staged_left_copies() {
  local p lines=()
  [[ -f $staged_left ]] || return 0
  mapfile -t lines <"$staged_left"
  for p in "${lines[@]}"; do
    [[ ${p%/*} == "$staging_dir" && ${p##*/} == [!.]* ]] || continue
    [[ -e $p || -L $p ]] || continue
    printf '%s\n' "$p"
  done
}

# Removes those copies, now that a terminal is there for sudo to ask on.
# The app's lock keeps its other runs away, but not a pacman one of them
# left running (pacman runs without that lock): while pacman's lock file is
# there, a pacman may be reading a copy, so the copies stay recorded. Only
# what staged_left_copies names reaches sudo rm; other lines, and copies
# already gone, are dropped. A copy that cannot go is named and stays
# recorded.
clear_staged_left() {
  local p lines=() keep=()
  [[ -f $staged_left ]] || return 0
  mapfile -t lines < <(staged_left_copies)
  for p in "${lines[@]}"; do
    if [[ -e $pacman_lock ]]; then
      echo "omabump: pacman's lock file $pacman_lock is there, so a pacman may be reading the staged copy a stopped run left; it stays in $p. Once pacman has ended, remove it with: sudo rm -f -- $p (the next Update of $label removes it too)" >&2
      keep+=("$p")
    elif (( prepare )); then
      echo "Would run: sudo rm -f -- $p (the staged copy a stopped run left)"
    elif run_unlocked sudo rm -f -- "$p"; then
      echo "Removed the staged copy a stopped run left: $p"
    else
      echo "omabump: could not remove the staged copy a stopped run left; remove it with: sudo rm -f -- $p" >&2
      keep+=("$p")
    fi
  done
  (( ! prepare )) || return 0
  if (( ${#keep[@]} )); then
    printf '%s\n' "${keep[@]}" >"$staged_left"
  else
    rm -f -- "$staged_left"
  fi
}

# Everything a run does before its route, in this order: the arguments and
# the app, the app's lock, the staged copies stopped runs left, what is
# installed and the build directories, with the rule refusals
# (rule_refusal) each asked once the run has got far enough for it. Ends
# the run where one of them stops it.
install_setup() {
  local why copy left_copies
  install_args "$@"
  install_app
  # The widget's settings, once: only buildAhead matters here.
  load_quiet 2>/dev/null

  # One update per app at a time; the clone lock serialises Omarchy builds.
  mkdir -p "$cache_dir/locks"
  exec 7>"$cache_dir/locks/$pkg.lock"
  flock -n 7 || die "another update of $label is already running"

  # A copy that updates itself is refused before the staged copies go. A
  # copy an earlier Update of its package left would then stay for good,
  # with no next Update to remove it: each is named, with the command that
  # removes it.
  if rule_ask copy; then
    mapfile -t left_copies < <(staged_left_copies)
    for copy in "${left_copies[@]}"; do
      echo "omabump: a stopped Update of the $pkg package left its staged copy in $copy, and no Update of $label will remove it now; remove it with: sudo rm -f -- $copy" >&2
    done
    refuse "$why"
  fi

  # The copies stopped runs left go first, whatever the run does next (a
  # refusal, no newer version yet, a failed download).
  clear_staged_left
  # The check shows the same reason on the row.
  if rule_ask entry; then refuse "$why"; fi

  installed_facts
  echo "$label: installed ${installed:-nothing} (${installed_name:-$pkg}, $source)"
  if rule_ask route; then refuse "$why"; fi
  (( ! switch )) || echo "Switching from $installed_name to $pkg at the same or a newer version."

  # PKGEXT without a compressor: the package is installed seconds after the
  # build, and zstd -22 on a 1.5 GB Electron app takes minutes. pacman -U
  # reads a plain .pkg.tar.
  export PKGDEST=$cache_dir/packages SRCDEST=$cache_dir/sources BUILDDIR=$cache_dir/build PKGEXT=.pkg.tar
  mkdir -p "$PKGDEST" "$SRCDEST" "$BUILDDIR"
  trap on_exit EXIT
}

# Code from omarchy-pkgs (bin/sync-upstream, the recipe's hook) and makepkg
# download with curl. Two files written on every run keep those downloads
# HTTPS only, redirects included, and bounded:
#   $cache_dir/curl/.curlrc   read by every plain curl sync-upstream and its
#                             hooks run, through CURL_HOME
#   $cache_dir/makepkg.conf   the user's makepkg configuration, sourced in
#                             makepkg's own order, with DLAGENTS replaced
# Both are 0600. sync-upstream also gets its own TMPDIR under the cache.
write_download_policy() {
  mkdir -p "$cache_dir/curl" "$cache_dir/scratch"
  (umask 077
   cat >"$cache_dir/curl/.curlrc" <<'EOF'
proto = "=https"
proto-redir = "=https"
connect-timeout = 15
max-time = 900
max-filesize = 4G
EOF
   cat >"$cache_dir/makepkg.conf" <<'EOF'
# Written by omabump-install on every run; edits are lost.
for c in /etc/makepkg.conf /etc/makepkg.conf.d/*.conf; do
  [[ -r $c ]] && source "$c"
done
if [[ -r ${XDG_CONFIG_HOME:-$HOME/.config}/pacman/makepkg.conf ]]; then
  source "${XDG_CONFIG_HOME:-$HOME/.config}/pacman/makepkg.conf"
elif [[ -r $HOME/.makepkg.conf ]]; then
  source "$HOME/.makepkg.conf"
fi
unset c
DLAGENTS=('https::/usr/bin/curl -qgb "" --proto =https --proto-redir =https --connect-timeout 15 --max-time 1800 --max-filesize 4G -fLC - --retry 3 --retry-delay 3 -o %o %u'
          'http::/bin/false' 'ftp::/bin/false' 'scp::/bin/false' 'rsync::/bin/false')
EOF
  )
  chmod 0600 "$cache_dir/curl/.curlrc" "$cache_dir/makepkg.conf"
}

# makepkg under the configuration above.
mkpkg() { run_unlocked makepkg --config "$cache_dir/makepkg.conf" "$@"; }

# A failed build or install keeps its files for a look; a successful one
# removes them (clean_after_install). started is set from the first build
# or download until the run is done with those files: a run that ends
# meanwhile, by an error or a signal, says they stay. ($? cannot tell: bash
# runs this trap for a signal with $? still the last command's status.)
# self_before is set from install_self's merge until the new version passed
# validation (self_merge): a run that ends meanwhile puts the clone back
# from here. self_merge holds Ctrl-C, the terminal closing and TERM until
# its step is done, then rolls back itself: either step cut short would
# leave a plugin no release names or one never validated. staged_copy names the
# root-owned copy in $staging_dir from the call to sudo install that writes
# it (stage_and_install). A run that ends with it there, pacman not
# running (TERM or the terminal closed end this script at once), removes
# it with sudo -n. That works only while
# the terminal is still open (TERM, Ctrl-C): sudo by default keeps your
# password for the terminal it asked in, and once that terminal is closed
# this script has none, so sudo -n finds no password and nothing can ask.
# sudo install and pacman are processes of their own, which the signal
# that ended this script need not have reached. A run that ends while
# pacman runs (pacman_running) leaves the copy alone: pacman may still be
# reading or installing it. One that ends while sudo install runs
# (staging_running) before the copy is there records it all the same:
# sudo may still be asking for your password, and write the copy once you
# answer. A copy that stays is recorded in $staged_left, which needs no
# terminal, for the next Update of the app to remove (clear_staged_left),
# and the message names it and the command that removes it. The removal
# and the record come first and the message last: with the terminal gone,
# a failed write would end on_exit.
restore_clone=0 started=0 self_before="" self_stop=0 staged_copy="" staging_running=0 pacman_running=0 build_keyring=""
on_exit() {
  local left="" later=""
  pgp_keyring_drop "$build_keyring"
  if [[ -n $staged_copy && -e $staged_copy ]]; then
    if (( pacman_running )); then
      left=$staged_copy
    elif ! run_unlocked sudo -n rm -f -- "$staged_copy" 2>/dev/null </dev/null; then
      left=$staged_copy
    fi
  elif [[ -n $staged_copy ]] && (( staging_running )); then
    left=$staged_copy
  fi
  if [[ -n $left ]]; then
    { mkdir -p "${staged_left%/*}" && printf '%s\n' "$left" >>"$staged_left"; } 2>/dev/null \
      && later=" (the next Update of $label removes it too)"
  fi
  (( restore_clone )) && pkgs_restore "$pkg"
  [[ -z $self_before ]] || self_undo "the update stopped part way"
  if [[ -n $left ]] && (( pacman_running )); then
    echo "omabump: pacman may still be reading the staged copy, so it stays in $left; once pacman has ended, remove it with: sudo rm -f -- $left$later" >&2
  elif [[ -n $left && ! -e $left ]]; then
    echo "omabump: sudo was still copying the package to $left, so the copy may appear there; once sudo has ended, remove it with: sudo rm -f -- $left$later" >&2
  elif [[ -n $left ]]; then
    echo "omabump: the staged copy stays in $left; remove it with: sudo rm -f -- $left$later" >&2
  fi
  if (( started )); then
    echo "omabump: the build and download files stay in $cache_dir/{build,packages,sources}" >&2
  fi
}

# --wait: a check already running may have read the version from before the
# install, so this one runs after it rather than not at all.
refresh_panel() { "$here/omabump-check" --no-notify --wait || true; }

# Fails, with the reason on stdout, unless the full version $1
# (epoch:pkgver-pkgrel) is newer than what pacman has installed under the
# app's installed name right now, or with --switch at least as new. A run
# that replaces a package installed under another name reads both names:
# an update elsewhere may have put the canonical package in meanwhile, at
# the target or past it, and the run would then take it back down. Asked
# before the download or build and again right before the staging
# (stage_and_install).
guard_version() {
  local now_line other
  if now_line=$(installed_package "$installed_name"); then
    if (( switch )) && newer "${now_line#* }" "$1"; then
      echo "$1 is older than the installed $now_line"
      return 1
    elif (( ! switch )) && ! newer "$1" "${now_line#* }"; then
      echo "$1 is not newer than the installed $now_line"
      return 1
    fi
  fi
  if replaces_other && other=$(installed_package "$pkg") && ! newer "$1" "${other#* }"; then
    echo "$pkg is installed now, at ${other#* }, which $1 is not newer than"
    return 1
  fi
  return 0
}

# The field $1 of this app's row in the last check's status.json, which the
# panel shows until the next check, on one line; true or false for a flag.
# Nothing when no check ran, the file is not one the check wrote, or the
# row or field is missing (status_field).
panel_row() { status_field "$pkg" "$1" 2>/dev/null | head -n1 | term_safe || true; }

# True when the version installed now, $1 (the full version on pacman
# rows), has reached the one the panel shows for this app, the row's latest
# from the last check, or the panel shows none (no check ran, or its row
# has no latest). Sets shown to that latest. Pacman rows compare with
# vercmp, the upstream part against the feed's version as the check does.
# mise rows compare as strings, mise deciding what is newer, and are only
# asked once mise finds nothing newer than $1: they have reached it at the
# same version, at one that moved since the check (to that release or a
# newer one, which strings cannot tell apart), or when the row offered no
# update (a check whose mise fetch failed keeps the last latest next to the
# version installed then).
shown=""
panel_reached() {
  local from
  shown=$(panel_row latest)
  [[ -n $shown ]] || return 0
  # A repo row's newest known version may be the repo's own, a full one.
  from=$(panel_row versionFrom)
  [[ $from == repo ]] || from=feed
  if string_versions "$source"; then
    [[ $1 == "$shown" || $1 != "$(panel_row installed)" || $(panel_row updateAvailable) != true ]]
  elif row_newer "$shown" "$1" "$from"; then
    return 1
  fi
}

# Ends an Update that has nothing left to install, the version installed
# now, $1, having reached what the panel showed: says so, refreshes the
# panel so the row clears, and exits 0. With --prepare it says what that
# run would say and do.
already_installed() {
  local msg="$label $1 is already installed; nothing to do."
  prepare_stop "Would say: $msg" "Would run: $here/omabump-check --no-notify --wait (the panel's refresh)"
  echo "$msg"
  # The check reads the omarchy-pkgs clone: under this run's lock it would
  # find the clone busy and give every omarchy row the last result.
  if (( restore_clone )); then pkgs_restore "$pkg"; restore_clone=0; fi
  pkgs_drop_lock
  refresh_panel
  exit 0
}

# The route reaches nothing newer than the version installed now, $1 (the
# full version on pacman rows), yet Update was pressed: the panel showed a
# newer one, the row's latest from the last check. Apps update outside
# Omabump too, often minutes after a check (Omarchy's wrappers update mise
# CLIs on launch, omarchy update runs mise up and pacman), and the panel
# shows that check until the next one. When the version installed has
# reached the one the panel showed (panel_reached), nothing is left to do
# (already_installed). Otherwise the route is behind the panel, and Update
# fails with "$2, not the <latest> $3", and $4 after it when given. Either
# way the run ends here.
nothing_newer() {
  panel_reached "$1" && already_installed "$1"
  refuse "$2, not the $shown $3; $action cannot install it yet.${4:+ $4}"
}

# pacman -Qi wraps long fields to COLUMNS when it is set, which would hide
# names on continuation lines from qi_names.
pacman_qi() { env -u COLUMNS pacman "$@"; }

# Names in a pacman -Qi / -Qip field ("Provides", "Conflicts With"), with
# version constraints cut off; nothing for "None".
qi_names() {
  sed -n "s/^$1 *: //p" | tr -s ' ' '\n' | sed 's/[<>=].*//' | grep -vx 'None' | grep -v '^$' || true
}

# True when the install replaces a package installed under another name:
# --switch, or an Update the check offered as one.
replaces_other() { [[ -n $installed_name && $installed_name != "$pkg" ]]; }

# pacman replaces the old package only when one of the two declares a
# conflict with the other (by name or by something the other provides).
# Without one it would keep both, so the switch stops. $1 is the new
# package file, or a recipe directory read through makepkg --printsrcinfo.
# Fails with 1 when neither declares one, with 2 when pacman or makepkg
# cannot say.
switch_conflicts() {
  local src=$1 new_c new_p old_c old_p info arch
  if [[ -f $src ]]; then
    info=$(pacman_qi -Qip -- "$src") || return 2
    new_c=$(qi_names 'Conflicts With' <<<"$info") new_p=$(qi_names Provides <<<"$info")
  else
    info=$(cd "$src" && mkpkg --printsrcinfo 2>/dev/null) || return 2
    # The package built here gets conflicts_<arch> and provides_<arch> for
    # this machine's architecture on top of the plain ones, as pacman -Qip
    # would show them; an odd uname -m takes every architecture's.
    arch=$(uname -m)
    [[ $arch =~ ^[a-z0-9_]+$ ]] || arch='[a-z0-9_]*'
    new_c=$(sed -n "s/^\tconflicts\(_$arch\)\? = //p" <<<"$info" | sed 's/[<>=].*//')
    new_p=$(sed -n "s/^\tprovides\(_$arch\)\? = //p" <<<"$info" | sed 's/[<>=].*//')
  fi
  info=$(pacman_qi -Qi -- "$installed_name") || return 2
  old_c=$(qi_names 'Conflicts With' <<<"$info") old_p=$(qi_names Provides <<<"$info")
  # $old_p and $new_p are newline lists of package names, split on purpose:
  # quoted, an empty list would add an empty pattern that matches anything.
  # shellcheck disable=SC2086
  grep -qxF -f <(printf '%s\n' "$installed_name" $old_p) <<<"$new_c" && return 0
  # shellcheck disable=SC2086
  grep -qxF -f <(printf '%s\n' "$pkg" $new_p) <<<"$old_c" && return 0
  return 1
}

# Stops the install unless switch_conflicts finds that conflict in $1.
require_conflict() {
  local rc=0
  switch_conflicts "$1" || rc=$?
  (( rc != 2 )) || die "cannot read the conflicts $pkg or $installed_name declares; not switching"
  (( rc == 0 )) || refuse "neither $pkg nor $installed_name declares a conflict with the other, so pacman would keep both; not switching"
}

# The install script the recipe in the current directory gives package $1,
# as makepkg reads it (install=$pkgname.install expanded): the package's own
# install= when its package function sets one, else the global one. Prints
# its path, or nothing when there is none.
recipe_install() {
  local name
  name=$(mkpkg --printsrcinfo 2>/dev/null | awk -v want="$1" '
    /^pkgbase = / { sec = "base"; next }
    /^pkgname = / { sec = ($3 == want) ? "own" : ""; next }
    /^\tinstall = / { v = substr($0, index($0, " = ") + 3); if (sec == "base") base = v; else if (sec == "own") own = v }
    END { if (own != "") print own; else if (base != "") print base }') || return 0
  [[ -z $name ]] || echo "$PWD/$name"
}

# Before pacman replaces a differently named package: what the new package's
# install script and the old one's remove script will run, and where the
# app keeps its data. Nothing is promised about that data; pacman does not
# touch $HOME, the app itself may. $1 is the package file or, before a build,
# the recipe's install file (empty for none), with $2 the recipe directory.
show_switch() {
  local script=$1 old config
  replaces_other || return 0
  echo
  require_conflict "${2:-$script}"
  echo "pacman will ask to remove $installed_name for $pkg (declared conflict); answer y to switch."
  if [[ $script == *.pkg.tar || $script == *.pkg.tar.* ]]; then
    if bsdtar -tf "$script" .INSTALL >/dev/null 2>&1; then
      echo "--- $pkg install script (.INSTALL), run as root:"
      bsdtar -xOf "$script" .INSTALL | term_safe
      echo "---"
    else
      echo "$pkg has no install script."
    fi
  elif [[ -f $script ]]; then
    echo "--- $pkg install script (${script##*/} in the recipe), run as root:"
    term_safe <"$script"
    echo "---"
  else
    echo "$pkg's recipe has no install script."
  fi
  old=/var/lib/pacman/local/$installed_name-$installed/install
  if [[ -f $old ]]; then
    echo "--- $installed_name's install script, its remove hooks run as root:"
    term_safe <"$old"
    echo "---"
  else
    echo "$installed_name has no install script."
  fi
  config=$(jq -r '.configDir // ""' <<<"$app")
  if [[ -n $config ]]; then
    echo "$label keeps its settings in $config. pacman does not touch \$HOME; whether $pkg reads that directory the same way is up to the app."
  else
    echo "pacman does not touch \$HOME; whether $pkg reads $installed_name's settings is up to the app."
  fi
  echo
}

# Refuses unless the recipe in $1 builds a package named $2 that is newer than
# what is installed right now; an Update that finds the recipe's version
# installed already ends in nothing_newer. Sets target_version.
check_target() {
  local dir=$1 want=$2 name msg now
  read -r name target_version < <(recipe_version <"$dir/PKGBUILD") || die "cannot read the recipe version"
  [[ $name == "$want" ]] || die "recipe builds '$name', expected '$want'"
  echo "Recipe builds $name $target_version"
  msg=$(guard_version "$target_version") && return 0
  # Build now never runs with --switch (rule_refusal).
  now=$(installed_package "$installed_name") || now=" $installed"
  now=${now#* }
  # nothing_newer, unless the recipe reaches the version the panel showed
  # and the app has not: then an epoch installed, or a pkgrel above the
  # recipe's, is what stops the build, and guard_version's message names it.
  if panel_reached "$now" || row_newer "$shown" "$target_version" feed; then
    nothing_newer "$now" "omarchy-pkgs' recipe reaches $target_version" "the vendor's feed shows"
  fi
  refuse "$msg; nothing to do"
}

# pacman installs each file with the numeric owner its package records and
# looks up no names. makepkg records whatever package() left under fakeroot,
# so a vendor archive unpacked there without --no-same-owner keeps the IDs
# of the machine that made it, and so does a vendor's own package built that
# way. On your machine uid 1001 is the second account, which could then
# replace those files. So every file must be owned by root, in root's group
# or in one Arch's own packages use with a fixed ID: tty (5), ftp (11),
# games (50). omarchy-pkgs' builds refuse packages that break this rule since
# 98353c6b (helpers/package-owners.sh), but Update builds a newer release
# than theirs, on your machine. Prints up to 3 entries that break the rule as
# "<uid>:<gid> <path>", then how many more; fails with 1 when one does, with
# 2 when the package cannot be listed. The listing goes through a pipe, never
# a temporary file: one bash could not write would read as no entry at all.
package_owner_gids="0 5 11 50"
foreign_owners() {
  local bad
  # bsdtar -tv prints one line per entry (it escapes a newline in a name):
  # mode, links, uid, gid, size, three date fields, path.
  bad=$(set -o pipefail
    bsdtar -tvf "$1" --numeric-owner 2>/dev/null | awk -v gids="$package_owner_gids" '
      BEGIN { n = split(gids, l, " "); for (i = 1; i <= n; i++) ok[l[i]] = 1 }
      $3 != "0" || !($4 in ok) {
        if (++bad <= 3) { path = $0; for (i = 1; i <= 8; i++) sub(/^ *[^ ]+ +/, "", path); print $3 ":" $4 " " path }
      }
      END { if (bad > 3) print "and " bad - 3 " more" }') || return 2
  [[ -z $bad ]] && return 0
  printf '%s\n' "$bad" | term_safe
  return 1
}

# Refuses package $1 ("<name> <full version>" $2) when foreign_owners finds
# an entry it does not take; $3 says where the package stays. $4, when set,
# is a staged copy to remove first.
require_root_owners() {
  local owners rc=0
  owners=$(foreign_owners "$1") || rc=$?
  (( rc == 0 )) && return 0
  [[ -z ${4:-} ]] || unstage "$4"
  (( rc == 1 )) || die "could not list the files of $1 to check who owns them; not installing"
  refuse "$2 has files that pacman would install with an owner other than root:"$'\n'"  ${owners//$'\n'/$'\n'  }"$'\n'"On this machine those IDs can belong to another account, which could then replace the files. Not installing (omarchy-pkgs refuses such packages too); $3"
}

# pacman -U reads the package from a root-owned copy: the verified file in
# the user's cache could otherwise be swapped by any process running as the
# user between the last check and the moment pacman opens it. The copy is
# checked again (digest when $3/$4 give one, name and full version always,
# and who owns its files: foreign_owners), and pacman asks before it
# installs. Once pacman is done the copy goes, whether it installed or not
# (packages can be gigabytes), and so does one a stopped run leaves (on_exit,
# or, when it cannot or sudo or pacman was still running, the next Update:
# clear_staged_left), and one require_root_owners refuses (the copy is
# faithful, the package is what is refused); only a copy that fails its
# digest or version check stays, and the message says where. With $5, a
# detached signature of the file, the staged copy's signature is checked
# too (package_signature_ok), after its digest: the copy pacman opens is
# then the signed file itself, whatever happened to the one in your cache
# since it was checked. A copy whose signature does not verify goes, and
# the run ends. Nothing is staged
# while pacman's lock file is there: pacman -U could not take the lock, and
# the pacman holding it may be one an earlier run left at its prompt, about
# to read a copy of the same name that this run would overwrite and then
# remove. $1 is the verified file, $2 the expected "<name> <full version>".
# With --prepare it prints the commands and calls no sudo. pacman_hint, when
# set, is a line said before the failure when pacman installs nothing.
pacman_hint=""
stage_and_install() {
  local file=$1 expect=$2 algo=${3:-} want=${4:-} sig=${5:-} staged got line now rc=0 locked
  staged=$staging_dir/${file##*/}
  locked="pacman's lock file $pacman_lock is there: a pacman is running, or one ended without removing it"
  if (( prepare )); then
    [[ ! -e $pacman_lock ]] || echo "Would refuse while $locked"
    echo "Would run: sudo install -o root -g root -m 0644 -D /dev/stdin $staged <$file"
    [[ -z $algo ]] || echo "Would check: ${algo}sum of $staged is $want"
    [[ -z $sig ]] || echo "Would check: gpg --verify $sig $staged (pacman's keyring) finds a good signature by a key pacman trusts"
    echo "Would check: pacman -Qp $staged is $expect"
    echo "Would check: every file in $staged is owned by root, in group root, tty, ftp or games"
    echo "Would run: sudo pacman -U -- $staged (pacman asks before it installs)"
    echo "Would run: sudo rm -f -- $staged (whether pacman installed it or not)"
    return 0
  fi
  [[ ! -e $pacman_lock ]] || die "$locked. Not staging $staged; run $action again once no pacman runs (if none does, the lock file is stale: sudo rm $pacman_lock)"
  # What is installed may have moved since the file was checked (a build
  # takes minutes, sudo may wait for a password): both names again.
  if ! got=$(guard_version "${expect#* }"); then
    # Installed meanwhile by something else, at what the panel showed:
    # nothing left to do, as when that is found before the download.
    now=$(installed_package "$installed_name") || now=" $installed"
    if (( ! switch )) && panel_reached "${now#* }"; then already_installed "${now#* }"; fi
    die "$got; not installing"
  fi
  # The file is opened here, as you, and root only writes what it reads: a
  # symlink swapped in for it cannot make root copy a file you cannot read
  # (/etc/shadow) into a world-readable place. The check is on the open file
  # itself, so a FIFO or device swapped in cannot feed root an endless copy.
  local src
  exec {src}<"$file" || die "cannot open $file"
  [[ -f /proc/self/fd/$src ]] || { exec {src}<&-; die "$file is not a regular file; not installing"; }
  # From here on_exit removes the copy if the run ends early, a copy cut
  # short included, or records it while sudo install runs; one that fails
  # its check is kept and named instead.
  staged_copy=$staged staging_running=1
  run_unlocked sudo install -o root -g root -m 0644 -D /dev/stdin "$staged" <&"$src" || rc=$?
  staging_running=0
  exec {src}<&-
  (( rc == 0 )) || die "could not copy $file to $staged"
  if [[ -n $algo ]]; then
    got=$("${algo}sum" -- "$staged" | cut -d' ' -f1)
    [[ $got == "$want" ]] || { staged_copy=""; die "$algo of the staged copy is $got, expected $want; not installing (the copy stays in $staged)"; }
  fi
  if [[ -n $sig ]] && ! package_signature_ok "$sig" "$staged"; then
    unstage "$staged"
    die "the staged copy's signature did not verify ($sig_error); removed $staged, not installing"
  fi
  line=$(pacman -Qp -- "$staged") || { staged_copy=""; die "cannot read $staged; not installing (the copy stays there)"; }
  [[ $line == "$expect" ]] || { staged_copy=""; die "the staged copy is '$line', expected '$expect'; not installing (the copy stays in $staged)"; }
  require_root_owners "$staged" "$expect" "the package stays in $file" "$staged"
  echo "Staged copy checked: $staged"
  # pacman asks "Proceed with installation?": that prompt is where you can
  # still stop. sudo need not ask for a password, makepkg -s may have used it.
  # A run that ends meanwhile leaves the copy to pacman (on_exit).
  pacman_running=1
  run_unlocked sudo pacman -U -- "$staged" || rc=$?
  pacman_running=0
  if (( rc == 0 )); then
    unstage "$staged"
    confirm_replaced "$expect"
    return 0
  fi
  # pacman fails when you answer n, and also when a hook or install script
  # fails after the package went in: what is installed now tells them apart
  # (Update needs a newer version, Switch another name, so it was not
  # installed before).
  now=$(installed_package "${expect%% *}") || now=""
  unstage "$staged"
  if [[ $now == "$expect" ]]; then
    echo "omabump: warning: pacman reported an error, but $expect is installed; read pacman's output above for the hook or install script that failed" >&2
    confirm_replaced "$expect"
    return 0
  fi
  [[ -z $pacman_hint ]] || echo "omabump: $pacman_hint" >&2
  die "pacman did not install $expect (you answered no, or it failed above). The verified package stays in $file for a retry"
}

# After pacman installed $1 ("<name> <full version>") in place of a package
# installed under another name: the old one must be gone. A conflict that
# names a version range (old<2) lets pacman keep both, which is no switch.
confirm_replaced() {
  local still
  replaces_other || return 0
  still=$(installed_package "$installed_name") || return 0
  die "pacman installed $1, but $still is still installed beside it (its conflict does not cover this version); remove it with: sudo pacman -R $installed_name"
}

# Removes the staged copy. One that cannot go is named, not fatal: by then
# pacman has finished either way.
unstage() {
  run_unlocked sudo rm -f -- "$1" || echo "omabump: could not remove the staged copy; remove it with: sudo rm -f -- $1" >&2
  staged_copy=""
}

# Builds the recipe in the current directory, checks the result and installs it.
build_and_install() {
  local want=$1 list files f line msg sum now match=""
  list=$(mkpkg --packagelist) || die "makepkg --packagelist failed"
  mapfile -t files <<<"$list"
  for f in "${files[@]}"; do
    [[ $(basename "$f") == "$want-$target_version-"* ]] && match=$f
  done
  [[ -n $match ]] || die "makepkg would not produce $want $target_version: ${files[*]}"
  echo "Package file: $match"
  if (( prepare )); then
    if replaces_other; then show_switch "$(recipe_install "$want")" "$PWD"; fi
    echo "After the build:"
    stage_and_install "$match" "$want $target_version" sha256 "the one taken of $match right after the build"
    # build_recipe puts the clone back; install_main ends the run.
    echo "Prepared: stopping before makepkg builds."
    return 0
  fi
  # A switch the recipe's conflicts already rule out stops here, not after
  # a build that can take many minutes. The built package is checked again.
  if replaces_other; then require_conflict "$PWD"; fi

  started=1
  # -s installs missing build dependencies with sudo pacman -S --asdeps;
  # without --noconfirm pacman asks for those too. Signed sources are
  # verified against the recipe's own keys alone (build_keyring).
  GNUPGHOME=$build_keyring mkpkg -sfC
  [[ -f $match ]] || die "makepkg did not produce $match"
  # The digest of the file makepkg wrote, before anything else reads it: the
  # staged copy must match it, not only its name and version.
  sum=$(sha256sum -- "$match" | cut -d' ' -f1) || die "cannot read $match"
  line=$(pacman -Qp -- "$match") || die "cannot read $match"
  [[ $line == "$want $target_version" ]] || die "built package is '$line', expected '$want $target_version'"
  if ! msg=$(guard_version "$target_version"); then
    # Something else installed this version or a newer one while makepkg
    # built, which can take many minutes (omarchy update, from the [omarchy]
    # repo). Once that reached the version the panel showed, the build has
    # nothing left to install and goes with its files, as after an install.
    now=$(installed_package "$installed_name") || now=" $installed"
    if panel_reached "${now#* }"; then
      rm -f -- "${files[@]}"
      clean_build_tree
      clean_sources
      started=0
      cd /
      already_installed "${now#* }"
    fi
    die "$msg; not installing"
  fi
  show_switch "$match"
  stage_and_install "$match" "$want $target_version" sha256 "$sum"
  clean_after_install "${files[@]}"
  clean_build_tree
  clean_sources
  started=0
}

# makepkg builds in $BUILDDIR/<pkgbase>. Run in the recipe directory.
clean_build_tree() {
  local base
  base=$(mkpkg --printsrcinfo 2>/dev/null | sed -n 's/^pkgbase = //p' | head -1)
  pkg_name_ok "$base" && [[ -d $BUILDDIR/$base ]] || return 0
  rm -rf -- "${BUILDDIR:?}/$base" && echo "Removed the build tree $BUILDDIR/$base."
}

# After pacman -U succeeded: the package files go. $@ are the files.
clean_after_install() {
  local f
  for f; do [[ -f $f ]] && rm -f -- "$f"; done
  echo "Removed the installed package file from $PKGDEST."
}

# After pacman -U succeeded, or something else installed the version built
# (build_and_install): the sources this recipe downloaded go too. They
# are the installed version's, so only a failed install (whose sources stay,
# for the retry) could use them again. Of other files, only those downloaded
# over a week ago go: a retry that late fetches again. Omarchy installs hold
# the clone lock, so no other build is using SRCDEST meanwhile. Run in the
# recipe directory.
clean_sources() {
  local used f n=0
  while IFS= read -r used; do
    f=${used%%::*}
    [[ $used == *::* ]] || f=${used##*/}
    [[ $f =~ ^[A-Za-z0-9@%+,_~][A-Za-z0-9@%+,._~-]*$ && -f $SRCDEST/$f ]] || continue
    rm -f -- "$SRCDEST/$f" && n=$((n + 1))
  done < <(mkpkg --printsrcinfo 2>/dev/null | sed -n 's/^\tsource\(_[a-z0-9_]*\)\? = //p')
  n=$(( n + $(find "$SRCDEST" -mindepth 1 -maxdepth 1 -type f -mtime +7 -print -delete 2>/dev/null | wc -l) ))
  (( n == 0 )) || echo "Removed $n downloaded source file(s) from $SRCDEST."
}

# Build now's build: Omarchy's recipe at the pinned commit, synced to the
# vendor's newest release, built, checked and installed (build_and_install).
build_recipe() {
  local blocker commit text list why fprs=()
  echo "Waiting for the omarchy-pkgs clone..."
  pkgs_take_lock 600 || die "the omarchy-pkgs clone stayed locked"
  commit=$(pkgs_fetch) || die "could not fetch omarchy-pkgs"
  pkgs_base=$commit
  pkgs_checkout || die "could not check out omarchy-pkgs ${commit:0:12}"
  restore_clone=1
  if (( pkgs_follow )); then
    echo "omarchy-pkgs: following master (unpinned), at $commit"
  else
    echo "omarchy-pkgs pinned at $commit, checked out detached"
  fi

  blocker=$(recipe_blocker "$pkgs_base" "$pkg") || die "could not read the $pkg recipe at ${pkgs_base:0:12}"
  [[ -z $blocker ]] || refuse "$blocker; wait for the [omarchy] repo"
  # The keys the recipe verifies its sources with, from the pinned commit,
  # before any of its code runs (pgp_keyring).
  text=$(recipe_file "$pkgs_base" "$pkg" PKGBUILD) || die "could not read the $pkg recipe at ${pkgs_base:0:12}"
  list=$(pgp_fingerprints <<<"$text" 2>&1) || refuse "the $pkg recipe at ${pkgs_base:0:12}: $list; not building"
  [[ -z $list ]] || mapfile -t fprs <<<"$list"
  mkdir -p "$cache_dir"
  build_keyring=$(mktemp -u "$cache_dir/gnupg.XXXXXX")
  why=$(pgp_keyring "$pkgs_base" "$pkg" "$build_keyring" "${fprs[@]}" 2>&1 >/dev/null) \
    || refuse "${why:-could not make the keyring for the $pkg recipe; not building}"
  if (( ${#fprs[@]} )); then
    echo "Signed sources are verified with the recipe's own keys only: ${fprs[*]}"
  fi

  # The first fetched code that runs: omarchy-pkgs' sync tool and the
  # recipe's upstream hook, as you, after you pressed Update. Its curl calls
  # read the .curlrc above, its temporary files go under the cache, and the
  # maintainer-only release-age bypass never reaches it. Nor does
  # UPSTREAM_GITHUB_TOKEN: with it, sync-upstream points CURL_HOME at a
  # .curlrc of its own (github_api_netrc), which would take the limits
  # above off every plain curl of the run, and leaves the token in a file.
  write_download_policy
  (cd "$pkgs_dir" && run_unlocked env -u BYPASS_MIN_RELEASE_AGE -u MIN_RELEASE_AGE_SECONDS -u UPSTREAM_GITHUB_TOKEN \
     CURL_HOME="$cache_dir/curl" TMPDIR="$cache_dir/scratch" \
     timeout -k 10 900 bin/sync-upstream "$pkg") </dev/null || die "bin/sync-upstream $pkg failed"

  echo
  echo "Build now: building $label on this machine from Omarchy's recipe. The package is not signed by Omarchy."
  echo "Changes to Omarchy's $pkg recipe against omarchy-pkgs ${pkgs_base:0:12}:"
  pgit add -A -- "pkgbuilds/$pkg"
  if pgit diff --cached --quiet HEAD -- "pkgbuilds/$pkg"; then
    echo "(none, the recipe already holds the newest release)"
  else
    pgit --no-pager diff --cached --no-color HEAD -- "pkgbuilds/$pkg" | term_safe
  fi
  echo

  check_target "$pkgs_dir/pkgbuilds/$pkg" "$pkg"
  cd "$pkgs_dir/pkgbuilds/$pkg"
  build_and_install "$pkg"
  cd /
  # Leave the clone as the pinned commit has it.
  pkgs_restore "$pkg"
  restore_clone=0
  exec 8>&-
  pgp_keyring_drop "$build_keyring"
  build_keyring=""
}

# A vendor package's install script can link $bin_dir/<pkg> to its binary
# without the package owning the link (ZCode's post_install runs ln -sf
# /opt/ZCode/zcode /usr/bin/zcode). pacman then refuses the same-named
# repository or AUR package that ships that path ("exists in filesystem"),
# and with it the whole yay -Sua. The link goes when no package owns it
# and the package just installed owns its target. A link that cannot go is
# named, not fatal: the install itself is done.
drop_orphan_link() {
  local link=$bin_dir/$pkg target
  [[ -L $link ]] || return 0
  pacman -Qqo -- "$link" >/dev/null 2>&1 && return 0
  target=$(readlink -f -- "$link") || return 0
  [[ $(pacman -Qqo -- "$target" 2>/dev/null) == "$pkg" ]] || return 0
  if (( prepare )); then
    echo "Would run: sudo rm -f -- $link (a link to $target that no package owns)"
  elif run_unlocked sudo rm -f -- "$link"; then
    echo "Removed $link, a link to $target that no package owns: pacman would refuse a $pkg package that ships it."
  else
    echo "omabump: could not remove $link, a link to $target that no package owns; pacman refuses a $pkg package that ships it until you remove it with: sudo rm -f -- $link" >&2
  fi
}

# pacman would download a URL itself, but it checks remote files against
# RemoteFileSigLevel, which defaults to SigLevel (Required) and vendors do not
# sign these packages. So curl fetches the file over HTTPS, its digest must
# match the one the vendor publishes (vendor_checksum), pacman -Qp reads its
# name and version, and pacman -U installs the local file under
# LocalFileSigLevel. A package without a published digest is not installed.
install_vendor_pkg() {
  local latest url file line name ver now_line msg sum algo want got feed_file
  feed_file=$(mktemp "$cache_dir/.feed.XXXXXX")
  latest=$(feed_save=$feed_file feed_version "$app") || { rm -f "$feed_file"; die "the feed has no version"; }
  echo "Feed: $latest"
  # An Update the feed has nothing newer for downloads nothing, so it ends
  # here: the package's URL and its checksum (a second request, for some
  # vendors) cannot fail it.
  if (( ! switch )) && [[ -n $installed ]] && ! row_newer "$latest" "$installed" feed; then
    rm -f "$feed_file"
    nothing_newer "$installed" "the vendor's feed gives $latest now" "it gave at the last check"
  fi
  url=$(vendor_pkg_url "$app" "$latest") || { rm -f "$feed_file"; refuse "the vendor publishes no https $pkg package for $(uname -m)"; }
  echo "Vendor package: $url"
  sum=$(vendor_checksum "$app" "$url" "$latest" "$feed_file") || { rm -f "$feed_file"; refuse "no published checksum for ${url##*/}; not downloading"; }
  rm -f "$feed_file"
  read -r algo want <<<"$sum"
  echo "Published $algo: $want"
  if (( switch )) && [[ -n $installed ]] && ! switch_target_ok "$installed" "$latest"; then
    refuse "$latest is older than the installed $installed_name $installed; nothing to do"
  fi
  file=$PKGDEST/${url##*/}
  started=1
  if [[ -f $file ]]; then
    echo "Using the download from an earlier run: $file"
  else
    max_time=1800 max_size=4G fetch -fL --retry 2 -o "$file.part" "$url" || die "could not download $url"
    mv -f "$file.part" "$file"
  fi
  got=$("${algo}sum" -- "$file" | cut -d' ' -f1)
  if [[ $got != "$want" ]]; then
    rm -f -- "$file"
    die "$algo of the download is $got, the vendor publishes $want; removed the file, not installing"
  fi
  echo "$algo matches."
  line=$(pacman -Qp -- "$file") || die "cannot read $file"
  name=${line%% *} ver=${line#* }
  [[ $name == "$pkg" ]] || die "the vendor package is '$name', expected '$pkg'"
  full_version_ok "$ver" || die "the vendor package has an odd version '$ver'"
  [[ $(upstream_part "$ver") == "$latest" ]] || die "the vendor package is $ver, expected $latest"
  # The feed knows no epoch or pkgrel; the file does. Compare its full
  # version with what is installed right now.
  msg=$(guard_version "$ver") || refuse "vendor package: $msg; not installing"
  # Before sudo, and under --prepare too; the staged copy is checked again.
  require_root_owners "$file" "$line" "the download stays in $file"
  echo "Package file: $file ($line)"
  show_switch "$file"
  stage_and_install "$file" "$line" "$algo" "$want"
  if (( prepare )); then
    drop_orphan_link
    started=0
    prepare_stop "Prepared: stopping before sudo."
  fi
  now_line=$(installed_package "$pkg") || die "pacman -Q $pkg finds nothing after the install"
  [[ $now_line == "$pkg $ver" ]] || die "pacman -Q says '$now_line', expected '$pkg $ver'"
  echo "Installed $now_line."
  drop_orphan_link
  clean_after_install "$file"
  started=0
  target_version=$ver
}

# Omarchy's repo [omarchy]: the package omarchy update would install from
# it, now. The repo's database is read again here (repo_load), never taken
# from status.json, and it is not signed (pacman.conf has DatabaseOptional),
# so it only names the file and its sha256: every claim is checked on the
# file itself. curl fetches the package and its .sig over HTTPS into the
# packages cache; the file's sha256 must be the database's; gpg must find
# a good signature on it by a key pacman's keyring trusts, where Omarchy
# keeps its own (package_signature_ok, not pacman-key --verify, which lets
# an untrusted key's signature pass); pacman -Qp must name the package at
# the database's full version, newer than what is installed now. Only then
# does the file go to the staging, the owner check and pacman -U that the
# other routes use, and the staged copy, root's, is what the signature is
# checked on once more: the sha256 came from the unsigned database, so the
# copy pacman opens must itself be the signed file. pacman -U on a local
# file would not check the signature itself: pacman.conf's
# LocalFileSigLevel is Optional. No code from omarchy-pkgs runs, and its
# clone is not touched.

# A repo row's Update: refuses when this machine has no such repo or the
# repo no such package, and ends as under nothing_newer when the repo's
# version is not newer than the installed one (the vendor is ahead of the
# repo, or something else installed it). It never builds: Build now
# (install_build) is the other action. With --switch it installs the
# repo's package over one installed under another name, at the same or a
# newer version (switch_target_ok, the check's rule too), the conflict
# read from the downloaded, verified package (show_switch).
install_repo() {
  local said hint
  require_repo_tools
  echo "Reading Omarchy's repo database..."
  if ! repo_load; then
    [[ $repo_state != none ]] || refuse "$repo_error, so there is no package to install $label from"
    die "$repo_error"
  fi
  repo_lookup "$pkg" || refuse "Omarchy's repo has no $pkg package"
  echo "Omarchy's repo ($repo_server) has $pkg $repo_version"
  if (( switch )); then
    [[ -z $installed ]] || switch_target_ok "$installed" "$repo_version" \
      || refuse "$repo_version is older than the installed $installed_name $installed; nothing to do"
  elif [[ -n $installed ]] && ! newer "$repo_version" "$installed"; then
    # The vendor ahead of the repo, which usually catches up soon; or a
    # repo version the last check saw that the repo no longer has.
    said="the vendor's feed shows" hint="It usually follows within the hour."
    if [[ $(panel_row versionFrom) == repo ]]; then said="the repo had at the last check" hint=""; fi
    if build_allowed "$app"; then hint="${hint:+$hint }Build now (b in the panel) builds it from Omarchy's recipe meanwhile."; fi
    nothing_newer "$installed" "Omarchy's repo has $repo_version" "$said" "$hint"
  fi
  repo_install
}

# Build now: Omarchy's recipe, built here, for a release the vendor has and
# Omarchy's repo not yet. rule_refusal has already refused an entry Build
# now may not build and a run while the buildAhead setting is off. The
# vendor's newest release is read again (its feed, else the one the panel
# showed), and, when it is known, must be ahead of what is installed and
# of the repo's package (vendor_ahead, the check's rule): once the repo has
# it, Update installs its signed package instead, and Build now says so. A
# repo that cannot be read stops nothing here: the build needs none of it.
install_build() {
  local vendor
  require_omarchy_tools
  vendor=$(feed_version "$app" 2>/dev/null) || vendor=$(panel_row vendorVersion)
  version_ok "$vendor" || vendor=""
  echo "The vendor's newest release: ${vendor:-not known}"
  repo_version=""
  if repo_load && repo_lookup "$pkg"; then echo "Omarchy's repo ($repo_server) has $pkg $repo_version"; fi
  # The repo has something newer: Update installs it, signed. Build now
  # only when the vendor is known to be ahead of that too.
  if [[ -n $repo_version ]] && newer "$repo_version" "$installed" && ! vendor_ahead "$installed" "$repo_version" "$vendor"; then
    [[ -n $vendor ]] || refuse "Omarchy's repo has $pkg $repo_version, newer than the installed ${installed:-nothing}, and the vendor's newest release is not known; use Update instead, which installs its signed package"
    refuse "Omarchy's repo has $pkg $repo_version, the vendor's newest release; use Update instead, which installs its signed package"
  fi
  # Without a vendor's version to go by, the recipe's sync says what the
  # newest is, and check_target whether it is newer than what is installed.
  if [[ -n $vendor && -n $installed ]] && ! vendor_ahead "$installed" "$repo_version" "$vendor"; then
    nothing_newer "$installed" "the vendor's feed gives $vendor now" "it gave at the last check"
  fi
  build_recipe
}

# Downloads, checks and installs the repo's package repo_file (repo_lookup
# set it) as above. With --prepare it says each step and stops before the
# download.
repo_install() {
  local file sig url line msg got now_line now
  file=$PKGDEST/$repo_file sig=$PKGDEST/$repo_file.sig url=$(repo_file_url "$repo_file")
  echo "Package: $url"
  echo "sha256 in the repo's database: $repo_sha256"
  if (( prepare )); then
    echo "Would download: $url to $file, and its signature $url.sig to $sig"
    echo "Would check: sha256sum of $file is $repo_sha256"
    echo "Would check: gpg --verify $sig $file (pacman's keyring) finds a good signature by a key pacman trusts"
    echo "Would check: pacman -Qp $file is $pkg $repo_version, newer than the installed ${installed:-nothing}"
    echo "Would check: every file in $file is owned by root, in group root, tty, ftp or games"
    if replaces_other; then echo "Would check: $pkg or $installed_name declares a conflict with the other, and show their install scripts"; fi
    stage_and_install "$file" "$pkg $repo_version" sha256 "$repo_sha256" "$sig"
    prepare_stop "Prepared: stopping before the download."
  fi
  started=1
  if [[ -f $file && $(sha256sum -- "$file" | cut -d' ' -f1) == "$repo_sha256" ]]; then
    echo "Using the download from an earlier run: $file"
  else
    rm -f -- "$file"
    max_time=1800 max_size=4G fetch -fL --retry 2 -o "$file.part" "$url" || die "could not download $url"
    mv -f -- "$file.part" "$file"
  fi
  # The signature comes fresh each time; a few hundred bytes.
  rm -f -- "$sig"
  fetch -fL --retry 2 -o "$sig.part" "$url.sig" || die "could not download $url.sig"
  mv -f -- "$sig.part" "$sig"
  got=$(sha256sum -- "$file" | cut -d' ' -f1)
  if [[ $got != "$repo_sha256" ]]; then
    rm -f -- "$file" "$sig"
    started=0
    die "sha256 of the download is $got, Omarchy's repo database lists $repo_sha256; removed the file, not installing"
  fi
  echo "sha256 matches."
  # Before sudo, so a bad file never asks for a password; the staged copy
  # is checked again.
  if ! package_signature_ok "$sig" "$file"; then
    rm -f -- "$file" "$sig"
    started=0
    die "the signature of $repo_file did not verify ($sig_error). Removed the download, not installing"
  fi
  echo "Signature: good, by $sig_signer"
  line=$(pacman -Qp -- "$file") || die "cannot read $file"
  [[ $line == "$pkg $repo_version" ]] \
    || die "the package is '$line', and Omarchy's repo database names '$pkg $repo_version'; not installing"
  if ! msg=$(guard_version "$repo_version"); then
    # omarchy update may have installed the same package meanwhile.
    now=$(installed_package "$installed_name") || now=" $installed"
    if (( ! switch )) && panel_reached "${now#* }"; then
      rm -f -- "$file" "$sig"
      started=0
      already_installed "${now#* }"
    fi
    refuse "Omarchy's repo package: $msg; not installing"
  fi
  # Before sudo; the staged copy is checked again.
  require_root_owners "$file" "$line" "the download stays in $file"
  echo "Package file: $file ($line)"
  show_switch "$file"
  pacman_hint="if pacman stopped on a dependency, run omarchy update: it updates the rest of the system with Omarchy's repo"
  stage_and_install "$file" "$line" sha256 "$repo_sha256" "$sig"
  pacman_hint=""
  now_line=$(installed_package "$pkg") || die "pacman -Q $pkg finds nothing after the install"
  [[ $now_line == "$pkg $repo_version" ]] || die "pacman -Q says '$now_line', expected '$pkg $repo_version'"
  echo "Installed $now_line."
  clean_after_install "$file" "$sig"
  started=0
  target_version=$repo_version
}

# mise outdated finds the version the configured request reaches (an exact
# pin or a range), the same policy the check used, and like it runs with no
# release-age cooldown; mise install puts in exactly that version, so the
# target shown in the panel is the one installed here. What mise's answer
# means is the check's own reading of it (mise_row), here for the one tool.
install_mise() {
  local tool=$installed_name target now
  local latest from note installable mise_update request feed_error unchecked
  [[ -n $tool ]] || die "${mise_inventory_error:-mise has no active $label}"
  mise_load 1 "$tool"
  mise_row "$tool" "$installed"
  case $mise_state in
    unchecked) refuse "$note; Omabump updates mise tools on mise's own backends only. Update $tool with mise up yourself." ;;
    error) die "$feed_error" ;;
    pinned)
      [[ $request == latest ]] && refuse "$label is held back at $installed by your mise settings ($latest exists); mise up would not move it. See mise settings."
      refuse "$label is held at $installed by its mise request '$request' ($latest exists); mise up would not move it. Change the request with mise use." ;;
    current) nothing_newer "$installed" "mise keeps $label at $installed" "mise showed at the last check" ;;
    update) target=$latest ;;
    *) die "no reading of mise's answer for $tool" ;;
  esac
  # The version the request reaches now, as mise outdated just found it,
  # installed as it is: mise neither looks for the newest again nor lists
  # every release (mise_run, mise_versions_host), and the request in your
  # config, unchanged, makes it the active one.
  [[ $target =~ ^[A-Za-z0-9][A-Za-z0-9._+~-]*$ ]] || die "mise gave $tool an odd version '$target'"
  echo "mise install -- $tool@$target"
  prepare_stop "Would run: mise install -- $tool@$target (in $HOME)"
  tool_name_ok "$tool" || die "'$tool' is not a mise tool name Omabump accepts"
  mise_timeout=900 mise_versions_host=1 mise_run install -- "$tool@$target"
  mise_load 0
  now=$(mise_active "$app") || now=""
  now=${now#* }
  # Installed but not the active one: a lockfile can keep the request on
  # the old version, which mise up rewrites. That is the slower way, as it
  # finds the version again and lists every release.
  if [[ $now != "$target" ]]; then
    echo "$label is ${now:-not active} after mise install; running mise up -- $tool, which also updates a lockfile."
    mise_timeout=900 mise_run up -- "$tool"
    mise_load 0
    now=$(mise_active "$app") || now=""
    now=${now#* }
  fi
  if [[ $now == "$target" ]]; then
    echo "$label is now $now."
  elif [[ -n $now && $now != "$installed" ]]; then
    # mise up looks for the newest again: a release since mise outdated.
    echo "$label is now $now: mise up found a release past $target."
  else
    die "$label is ${now:-not active} after mise up, expected $target. See mise ls $tool."
  fi
  target_version=$now
}

# Fast-forwards the plugin clone from the commit $1 to $self_target and
# validates the result with "${@:2}" <plugin dir>; if either fails, or the
# run is stopped meanwhile, self_undo puts the clone back at $1. A signal
# waits for the step it comes in: the merge runs held (self_git_held), out
# of reach of Ctrl-C, a closing terminal and a TERM sent to this script
# alone, so rolling back at once would race a merge that carries on and
# lands. Held, the merge is never cut short part way either. Each step is
# bounded, the merge by self_git_held's timeout.
self_merge() {
  local rc=0
  self_before=$1 self_stop=0
  shift
  trap 'self_stop=1' HUP INT TERM
  self_git_held merge -q --ff-only "$self_target" || rc=$?
  (( ! self_stop )) || self_undo "the update stopped part way"
  (( rc == 0 )) || self_undo "git merge --ff-only $self_target failed"
  run_unlocked "$@" "$plugin_dir" </dev/null || rc=$?
  (( ! self_stop )) || self_undo "the update stopped part way"
  (( rc == 0 )) || self_undo "the new version failed validation"
  self_before=""
  trap - HUP INT TERM
}

# Puts the plugin clone back at self_before and exits with $1. git clean
# -fd removes the new files a failed merge left untracked; not -x, which
# would delete ignored files of yours too. git runs under timeout alone,
# not through self_git's run_killable, which stops git on Ctrl-C or a
# closing terminal: a reset cut short there would leave the release in
# place, and the run would end before it could say so. This script ignores
# INT, HUP and TERM from here to its exit too. bash lets a Ctrl-C pass while it
# waits for a command that does not die of it, as git here does not, but
# one that arrives between commands (a second Ctrl-C, or the first landing
# as one git ends and the next starts) would end the run before git clean
# and the message, and on_exit no longer rolls back.
self_git_held() { run_unlocked timeout -k 10 120 env GIT_ALLOW_PROTOCOL=https GIT_TERMINAL_PROMPT=0 git "${git_safe[@]}" -C "$plugin_dir" "$@" </dev/null; }
self_undo() {
  local before=$self_before
  trap '' INT HUP TERM
  self_before=""
  if self_git_held reset -q --hard "$before" && self_git_held clean -qfd; then
    die "$1; rolled back to ${before:0:12}, the old version is still installed"
  fi
  die "$1, and the rollback failed; see git -C $plugin_dir status, and restore it with: git -C $plugin_dir reset --hard $before"
}

# Omabump itself: the plugin's own clone, fast-forwarded to the commit the
# release tag names (self_plan) once you have read its log and answered y,
# then validated as Omarchy's updater does; self_merge rolls it back if the
# merge or the validation fails. `omarchy plugin update` would install the
# repository's HEAD instead. The function exits, so nothing of this file is
# read after the merge replaced it.
install_self() {
  local latest answer before validate=(omarchy-plugin-validate)
  # A local checkout of Omabump was refused before (rule_refusal route).
  command -v omarchy-plugin-validate >/dev/null || validate=(omarchy plugin validate)
  command -v "${validate[0]}" >/dev/null || die "omarchy-plugin-validate is missing"
  latest=$(feed_version "$app") || die "could not read Omabump's newest release"
  echo "Newest release: $latest"
  newer "$latest" "$installed" || nothing_newer "$installed" "Omabump's newest release is $latest" "the panel showed"
  self_origin_ok || refuse "the plugin clone's origin is not $self_repo; update it with: omarchy plugin update $self_plugin_id"
  self_plan "$latest" || die "not updating to v$latest. omarchy plugin update $self_plugin_id still works; it installs the repository's HEAD"
  echo "Release v$latest is commit $self_target."
  echo
  echo "Commits after the installed $(self_git rev-parse --short HEAD):"
  self_git --no-pager log --no-color --oneline "HEAD..$self_target" | term_safe
  echo
  self_git --no-pager diff --no-color --stat HEAD "$self_target" | term_safe
  echo
  prepare_stop "Would ask: Update Omabump to $latest? [y/N]" \
    "Would run: git merge --ff-only $self_target in $plugin_dir, ${validate[*]} $plugin_dir (if either fails or the run is stopped before the validation passed: git reset --hard to the installed commit and git clean -fd), omarchy-shell shell rescanPlugins"
  before=$(self_git rev-parse HEAD) || die "git rev-parse HEAD failed in $plugin_dir"
  read -r -p "Update Omabump to $latest? [y/N] " answer </dev/tty || answer=""
  [[ $answer == [yY] ]] || { echo "Not updated."; exit 0; }
  # The prompt can wait for minutes: refuse if the clone changed meanwhile,
  # so a rollback below can never discard an edit made while it waited.
  [[ $(self_git rev-parse HEAD) == "$before" ]] || die "the plugin clone moved while waiting; nothing changed, run Update again"
  [[ -z $(self_git status --porcelain --untracked-files=normal) ]] || die "the plugin clone has local changes now; nothing changed"
  self_merge "$before" "${validate[@]}"
  run_unlocked omarchy-shell shell rescanPlugins >/dev/null 2>&1 </dev/null || true
  "$plugin_dir/bin/omabump-check" --no-notify --wait || true
  # rescanPlugins finds the plugin again but QML it already loaded can stay
  # cached, while the row above already reads the new version.
  echo "Omabump is now $latest. Restart the shell to load its new panel: omarchy restart shell"
  exit 0
}

# The install on the app's route, then the panel's refresh.
install_main() {
  case $source in
    self) install_self ;;
    # Update takes the repo's signed package and never builds; Build now
    # (--build) builds Omarchy's recipe. Decided here, once.
    repo) if (( build )); then install_build; else install_repo; fi ;;
    vendor-pkg) install_vendor_pkg ;;
    mise) install_mise ;;
    # An indicator row has no route: install_setup refused it (rule_refusal).
    *) die "unknown source '$source'" ;;
  esac

  # A --prepare run ends here once the route stopped and cleaned up: the
  # build returns, having put the clone back; the others have ended
  # the run where they stop.
  prepare_stop
  refresh_panel
  if [[ $source != mise ]]; then
    if [[ -n $installed ]]; then echo "Restart $label to use $target_version."; else echo "$label $target_version is installed."; fi
  fi
}

# The run: its setup, then its route.
omabump_install() {
  install_setup "$@"
  install_main
}

# tests/install.sh sources this file, which runs nothing, with stub
# commands first on PATH, then sets staging_dir, pacman_lock and bin_dir to
# its own directories and calls omabump_install, install_setup or single
# functions. Run as a command, the run starts here; the exit means nothing
# after this line is read, whatever the file holds by then.
(return 0 2>/dev/null) || { omabump_install "$@"; exit; }
