#!/bin/bash
# Install the newest release of one agent app. Meant to run in a visible
# terminal: makepkg and pacman talk to the user, sudo may ask for a password,
# and pacman always asks before it installs.
# Every path runs install knowledge someone else maintains:
#
#   omarchy     Omarchy's own recipe from omarchy-pkgs at the commit pinned
#               in pins.json, checked out detached, moved to the vendor's
#               newest release by omarchy-pkgs' bin/sync-upstream. The recipe
#               diff is shown before anything is built.
#   vendor-pkg  The Arch package the vendor publishes, at the version the
#               app's feed advertises, installed with pacman -U.
#   mise        mise up <tool>.
#
#   self        Omabump itself: its clone fast-forwarded to the release tag,
#               after the log is shown and you answer y.
#
#   omabump-install [--prepare] [--switch] <pkg>
#
# --switch replaces an app installed under another package name
# (chatgpt-desktop, z-code-bin) with <pkg> at the same or a newer full
# version. Update requires a strictly newer one. Either way pacman asks
# before it removes the old package, and the scripts the new package runs
# are printed first. On the omarchy path the conflict pacman needs is read
# from the recipe before the build, and from the built package again after.
#
# --prepare fetches, syncs and prepares the recipe (this runs omarchy-pkgs'
# sync tool and the recipe's hook, and makepkg reads the PKGBUILD), and stops
# before makepkg builds. On the vendor path it downloads and checks the
# package and stops before pacman -U. Nothing is installed and sudo is never
# called; the staging and install commands are printed instead. On the self
# row it fetches the release tag, prints the plan and stops before asking.
set -euo pipefail
# BASH_SOURCE, not $0: the tests source this file (see the end).
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck source=omabump-common
source "$here/omabump-common"

prepare=0 switch=0
while [[ ${1:-} == --* ]]; do
  case $1 in
    --prepare) prepare=1 ;;
    --switch) switch=1 ;;
    *) echo "usage: omabump-install [--prepare] [--switch] <pkg>" >&2; exit 2 ;;
  esac
  shift
done
pkg=${1:?usage: omabump-install [--prepare] [--switch] <pkg>}

die() { echo "omabump: $*" >&2; exit 1; }
command -v jq >/dev/null || die "jq is missing; install it with: sudo pacman -S --needed jq"

if [[ $pkg == "$self_pkg" ]]; then
  app=$self_app
else
  load_table
  app=$(app_json "$pkg") || die "$pkg is not in the app table"
fi
pkg=$(jq -r .pkg <<<"$app")
# The name becomes a lock file name below and reaches pacman and git.
app_id_ok "$pkg" || die "'$pkg' is not a package name Omabump accepts"
# A discovered row's label comes from a menu file: shown in the terminal only
# after term_safe, on one line.
label=$(jq -r '.label // .pkg' <<<"$app" | term_safe | tr '\t\n' '  ' | sed 's/ *$//')

# One update per app at a time; the clone lock below serialises Omarchy builds.
mkdir -p "$cache_dir/locks"
exec 7>"$cache_dir/locks/$pkg.lock"
flock -n 7 || die "another update of $label is already running"

installed_name="" installed=""
[[ $(jq -r '.source' <<<"$app") == mise ]] && mise_load 0
if read -r source installed_name installed < <(installed_app "$app"); then :; else
  source=$(jq -r '.source // ""' <<<"$app")
fi
[[ $source == omarchy ]] && require_omarchy_tools
echo "$label: installed ${installed:-nothing} (${installed_name:-$pkg}, $source)"
if (( switch )); then
  [[ $source == omarchy || $source == vendor-pkg ]] || die "--switch works for omarchy and vendor rows only"
  [[ -n $installed_name && $installed_name != "$pkg" ]] || die "$label is not installed under another name; nothing to switch"
  echo "Switching from $installed_name to $pkg at the same or a newer version."
fi

# PKGEXT without a compressor: the package is installed seconds after the
# build, and zstd -22 on a 1.5 GB Electron app takes minutes. pacman -U reads
# a plain .pkg.tar.
export PKGDEST=$cache_dir/packages SRCDEST=$cache_dir/sources BUILDDIR=$cache_dir/build PKGEXT=.pkg.tar
mkdir -p "$PKGDEST" "$SRCDEST" "$BUILDDIR"

# Code from omarchy-pkgs (bin/sync-upstream, the recipe's hook) and makepkg
# download with curl. Two files written on every run keep those downloads
# HTTPS only, redirects included, and bounded:
#   $cache_dir/curl/.curlrc   read by every plain curl sync-upstream and its
#                             hooks run, through CURL_HOME
#   $cache_dir/makepkg.conf   the user's makepkg configuration, sourced in
#                             makepkg's own order, with DLAGENTS replaced
# Both are 0600. sync-upstream also gets its own TMPDIR under the cache.
write_download_policy() {
  mkdir -p "$cache_dir/curl" "$cache_dir/scratch"
  (umask 077
   cat >"$cache_dir/curl/.curlrc" <<'EOF'
proto = "=https"
proto-redir = "=https"
connect-timeout = 15
max-time = 900
max-filesize = 4G
EOF
   cat >"$cache_dir/makepkg.conf" <<'EOF'
# Written by omabump-install on every run; edits are lost.
for c in /etc/makepkg.conf /etc/makepkg.conf.d/*.conf; do
  [[ -r $c ]] && source "$c"
done
if [[ -r ${XDG_CONFIG_HOME:-$HOME/.config}/pacman/makepkg.conf ]]; then
  source "${XDG_CONFIG_HOME:-$HOME/.config}/pacman/makepkg.conf"
elif [[ -r $HOME/.makepkg.conf ]]; then
  source "$HOME/.makepkg.conf"
fi
unset c
DLAGENTS=('https::/usr/bin/curl -qgb "" --proto =https --proto-redir =https --connect-timeout 15 --max-time 1800 --max-filesize 4G -fLC - --retry 3 --retry-delay 3 -o %o %u'
          'http::/bin/false' 'ftp::/bin/false' 'scp::/bin/false' 'rsync::/bin/false')
EOF
  )
  chmod 0600 "$cache_dir/curl/.curlrc" "$cache_dir/makepkg.conf"
}

# makepkg under the configuration above.
mkpkg() { run_unlocked makepkg --config "$cache_dir/makepkg.conf" "$@"; }

# A failed build or install keeps its files for a look; a successful one
# removes them (clean_after_install). self_before is set only while
# install_self moves the plugin clone (self_apply), which holds Ctrl-C and
# the like until its step is done and rolls back itself; anything else that
# ends the run there puts the clone back from here. staged_copy names the
# root-owned copy in $staging_dir while it exists (stage_and_install). A run
# that ends with it there (the terminal closed or TERM at pacman's prompt,
# which end this script at once) removes it with sudo -n, which works while
# sudo still holds your password from pacman -U; otherwise the message names
# the copy and the command that removes it. The removal comes first and the
# message last: with the terminal gone, a failed write would end on_exit.
restore_clone=0 started=0 self_before="" staged_copy=""
on_exit() {
  local rc=$? left=""
  if [[ -n $staged_copy && -e $staged_copy ]]; then
    run_unlocked sudo -n rm -f -- "$staged_copy" 2>/dev/null </dev/null || left=$staged_copy
  fi
  (( restore_clone )) && pkgs_restore "$pkg"
  [[ -z $self_before ]] || self_rollback "the update stopped part way"
  [[ -z $left ]] || echo "omabump: the staged copy stays in $left; remove it with: sudo rm -f -- $left" >&2
  if (( rc != 0 && started )); then
    echo "omabump: the build and download files stay in $cache_dir/{build,packages,sources}" >&2
  fi
}
trap on_exit EXIT

# --wait: a check already running may have read the version from before the
# install, so this one runs after it rather than not at all.
refresh_panel() { "$here/omabump-check" --no-notify --wait || true; }

# Fails unless the full version $1 (epoch:pkgver-pkgrel) is newer than what
# pacman has installed under the app's installed name right now, or with
# --switch at least as new.
guard_version() {
  local now_line
  now_line=$(installed_package "$installed_name") || return 0
  if (( switch )); then
    newer "${now_line#* }" "$1" || return 0
    echo "$1 is older than the installed $now_line"
  else
    newer "$1" "${now_line#* }" && return 0
    echo "$1 is not newer than the installed $now_line"
  fi
  return 1
}

# pacman -Qi wraps long fields to COLUMNS when it is set, which would hide
# names on continuation lines from qi_names.
pacman_qi() { env -u COLUMNS pacman "$@"; }

# Names in a pacman -Qi / -Qip field ("Provides", "Conflicts With"), with
# version constraints cut off; nothing for "None".
qi_names() {
  sed -n "s/^$1 *: //p" | tr -s ' ' '\n' | sed 's/[<>=].*//' | grep -vx 'None' | grep -v '^$' || true
}

# True when the install replaces a package installed under another name:
# --switch, or an Update the check offered as one.
replaces_other() { [[ -n $installed_name && $installed_name != "$pkg" ]]; }

# pacman replaces the old package only when one of the two declares a
# conflict with the other (by name or by something the other provides).
# Without one it would keep both, so the switch stops. $1 is the new
# package file, or a recipe directory read through makepkg --printsrcinfo.
# Fails with 1 when neither declares one, with 2 when pacman or makepkg
# cannot say.
switch_conflicts() {
  local src=$1 new_c new_p old_c old_p info arch
  if [[ -f $src ]]; then
    info=$(pacman_qi -Qip -- "$src") || return 2
    new_c=$(qi_names 'Conflicts With' <<<"$info") new_p=$(qi_names Provides <<<"$info")
  else
    info=$(cd "$src" && mkpkg --printsrcinfo 2>/dev/null) || return 2
    # The package built here gets conflicts_<arch> and provides_<arch> for
    # this machine's architecture on top of the plain ones, as pacman -Qip
    # would show them; an odd uname -m takes every architecture's.
    arch=$(uname -m)
    [[ $arch =~ ^[a-z0-9_]+$ ]] || arch='[a-z0-9_]*'
    new_c=$(sed -n "s/^\tconflicts\(_$arch\)\? = //p" <<<"$info" | sed 's/[<>=].*//')
    new_p=$(sed -n "s/^\tprovides\(_$arch\)\? = //p" <<<"$info" | sed 's/[<>=].*//')
  fi
  info=$(pacman_qi -Qi -- "$installed_name") || return 2
  old_c=$(qi_names 'Conflicts With' <<<"$info") old_p=$(qi_names Provides <<<"$info")
  # $old_p and $new_p are newline lists of package names, split on purpose:
  # quoted, an empty list would add an empty pattern that matches anything.
  # shellcheck disable=SC2086
  grep -qxF -f <(printf '%s\n' "$installed_name" $old_p) <<<"$new_c" && return 0
  # shellcheck disable=SC2086
  grep -qxF -f <(printf '%s\n' "$pkg" $new_p) <<<"$old_c" && return 0
  return 1
}

# Stops the install unless switch_conflicts finds that conflict in $1.
require_conflict() {
  local rc=0
  switch_conflicts "$1" || rc=$?
  (( rc != 2 )) || die "cannot read the conflicts $pkg or $installed_name declares; not switching"
  (( rc == 0 )) || die "neither $pkg nor $installed_name declares a conflict with the other, so pacman would keep both; not switching"
}

# The install script the recipe in the current directory gives package $1,
# as makepkg reads it (install=$pkgname.install expanded): the package's own
# install= when its package function sets one, else the global one. Prints
# its path, or nothing when there is none.
recipe_install() {
  local name
  name=$(mkpkg --printsrcinfo 2>/dev/null | awk -v want="$1" '
    /^pkgbase = / { sec = "base"; next }
    /^pkgname = / { sec = ($3 == want) ? "own" : ""; next }
    /^\tinstall = / { v = substr($0, index($0, " = ") + 3); if (sec == "base") base = v; else if (sec == "own") own = v }
    END { if (own != "") print own; else if (base != "") print base }') || return 0
  [[ -z $name ]] || echo "$PWD/$name"
}

# Before pacman replaces a differently named package: what the new package's
# install script and the old one's remove script will run, and where the
# app keeps its data. Nothing is promised about that data; pacman does not
# touch $HOME, the app itself may. $1 is the package file or, before a build,
# the recipe's install file (empty for none), with $2 the recipe directory.
show_switch() {
  local script=$1 old config
  replaces_other || return 0
  echo
  require_conflict "${2:-$script}"
  echo "pacman will ask to remove $installed_name for $pkg (declared conflict); answer y to switch."
  if [[ $script == *.pkg.tar || $script == *.pkg.tar.* ]]; then
    if bsdtar -tf "$script" .INSTALL >/dev/null 2>&1; then
      echo "--- $pkg install script (.INSTALL), run as root:"
      bsdtar -xOf "$script" .INSTALL | term_safe
      echo "---"
    else
      echo "$pkg has no install script."
    fi
  elif [[ -f $script ]]; then
    echo "--- $pkg install script (${script##*/} in the recipe), run as root:"
    term_safe <"$script"
    echo "---"
  else
    echo "$pkg's recipe has no install script."
  fi
  old=/var/lib/pacman/local/$installed_name-$installed/install
  if [[ -f $old ]]; then
    echo "--- $installed_name's install script, its remove hooks run as root:"
    term_safe <"$old"
    echo "---"
  else
    echo "$installed_name has no install script."
  fi
  config=$(jq -r '.configDir // ""' <<<"$app")
  if [[ -n $config ]]; then
    echo "$label keeps its settings in $config. pacman does not touch \$HOME; whether $pkg reads that directory the same way is up to the app."
  else
    echo "pacman does not touch \$HOME; whether $pkg reads $installed_name's settings is up to the app."
  fi
  echo
}

# Refuses unless the recipe in $1 builds a package named $2 that is newer than
# what is installed right now. Sets target_version.
check_target() {
  local dir=$1 want=$2 name msg
  read -r name target_version < <(recipe_version <"$dir/PKGBUILD") || die "cannot read the recipe version"
  [[ $name == "$want" ]] || die "recipe builds '$name', expected '$want'"
  echo "Recipe builds $name $target_version"
  if ! msg=$(guard_version "$target_version"); then
    (( prepare )) && { echo "Would refuse: $msg"; return 0; }
    die "$msg; nothing to do"
  fi
}

# pacman -U reads the package from a root-owned copy: the verified file in
# the user's cache could otherwise be swapped by any process running as the
# user between the last check and the moment pacman opens it. The copy is
# checked again (digest when $3/$4 give one, name and full version always),
# and pacman asks before it installs. Once pacman is done the copy goes,
# whether it installed or not (packages can be gigabytes), and so does one
# a stopped run leaves (on_exit); only a copy that fails its check stays,
# and the message says where. $1 is the verified file, $2 the expected
# "<name> <full version>". With --prepare it prints the commands and calls
# no sudo. Run as a command, nothing changes the directory: the tests
# source this file and set staging_dir themselves.
staging_dir=/var/cache/omabump
stage_and_install() {
  local file=$1 expect=$2 algo=${3:-} want=${4:-} staged got line now
  staged=$staging_dir/${file##*/}
  if (( prepare )); then
    echo "Would run: sudo install -o root -g root -m 0644 -D /dev/stdin $staged <$file"
    [[ -z $algo ]] || echo "Would check: ${algo}sum of $staged is $want"
    echo "Would check: pacman -Qp $staged is $expect"
    echo "Would run: sudo pacman -U -- $staged (pacman asks before it installs)"
    echo "Would run: sudo rm -f -- $staged (whether pacman installed it or not)"
    return 0
  fi
  # The file is opened here, as you, and root only writes what it reads: a
  # symlink swapped in for it cannot make root copy a file you cannot read
  # (/etc/shadow) into a world-readable place. The check is on the open file
  # itself, so a FIFO or device swapped in cannot feed root an endless copy.
  local src
  exec {src}<"$file" || die "cannot open $file"
  [[ -f /proc/self/fd/$src ]] || { exec {src}<&-; die "$file is not a regular file; not installing"; }
  # From here on_exit removes the copy if the run ends early, a copy cut
  # short included; one that fails its check is kept and named instead.
  staged_copy=$staged
  run_unlocked sudo install -o root -g root -m 0644 -D /dev/stdin "$staged" <&"$src" || { exec {src}<&-; die "could not copy $file to $staged"; }
  exec {src}<&-
  if [[ -n $algo ]]; then
    got=$("${algo}sum" -- "$staged" | cut -d' ' -f1)
    [[ $got == "$want" ]] || { staged_copy=""; die "$algo of the staged copy is $got, expected $want; not installing (the copy stays in $staged)"; }
  fi
  line=$(pacman -Qp -- "$staged") || { staged_copy=""; die "cannot read $staged; not installing (the copy stays there)"; }
  [[ $line == "$expect" ]] || { staged_copy=""; die "the staged copy is '$line', expected '$expect'; not installing (the copy stays in $staged)"; }
  echo "Staged copy checked: $staged"
  # pacman asks "Proceed with installation?": that prompt is where you can
  # still stop. sudo need not ask for a password, makepkg -s may have used it.
  if run_unlocked sudo pacman -U -- "$staged"; then
    unstage "$staged"
    return 0
  fi
  # pacman fails when you answer n, and also when a hook or install script
  # fails after the package went in: what is installed now tells them apart
  # (Update needs a newer version, Switch another name, so it was not
  # installed before).
  now=$(installed_package "${expect%% *}") || now=""
  unstage "$staged"
  if [[ $now == "$expect" ]]; then
    echo "omabump: warning: pacman reported an error, but $expect is installed; read pacman's output above for the hook or install script that failed" >&2
    return 0
  fi
  die "pacman did not install $expect (you answered no, or it failed above). The verified package stays in $file for a retry"
}

# Removes the staged copy. One that cannot go is named, not fatal: by then
# pacman has finished either way.
unstage() {
  run_unlocked sudo rm -f -- "$1" || echo "omabump: could not remove the staged copy; remove it with: sudo rm -f -- $1" >&2
  staged_copy=""
}

# Builds the recipe in the current directory, checks the result and installs it.
build_and_install() {
  local want=$1 list files f line msg sum match=""
  list=$(mkpkg --packagelist) || die "makepkg --packagelist failed"
  mapfile -t files <<<"$list"
  for f in "${files[@]}"; do
    [[ $(basename "$f") == "$want-$target_version-"* ]] && match=$f
  done
  [[ -n $match ]] || die "makepkg would not produce $want $target_version: ${files[*]}"
  echo "Package file: $match"
  if (( prepare )); then
    if replaces_other; then show_switch "$(recipe_install "$want")" "$PWD"; fi
    echo "After the build:"
    stage_and_install "$match" "$want $target_version" sha256 "the one taken of $match right after the build"
    echo "Prepared: stopping before makepkg builds."
    return 0
  fi
  # A switch the recipe's conflicts already rule out stops here, not after
  # a build that can take many minutes. The built package is checked again.
  if replaces_other; then require_conflict "$PWD"; fi

  started=1
  # -s installs missing build dependencies with sudo pacman -S --asdeps;
  # without --noconfirm pacman asks for those too.
  mkpkg -sfC
  [[ -f $match ]] || die "makepkg did not produce $match"
  # The digest of the file makepkg wrote, before anything else reads it: the
  # staged copy must match it, not only its name and version.
  sum=$(sha256sum -- "$match" | cut -d' ' -f1) || die "cannot read $match"
  line=$(pacman -Qp -- "$match") || die "cannot read $match"
  [[ $line == "$want $target_version" ]] || die "built package is '$line', expected '$want $target_version'"
  msg=$(guard_version "$target_version") || die "$msg; not installing"
  show_switch "$match"
  stage_and_install "$match" "$want $target_version" sha256 "$sum"
  clean_after_install "${files[@]}"
  clean_build_tree
  clean_sources
}

# makepkg builds in $BUILDDIR/<pkgbase>. Run in the recipe directory.
clean_build_tree() {
  local base
  base=$(mkpkg --printsrcinfo 2>/dev/null | sed -n 's/^pkgbase = //p' | head -1)
  pkg_name_ok "$base" && [[ -d $BUILDDIR/$base ]] || return 0
  rm -rf -- "${BUILDDIR:?}/$base" && echo "Removed the build tree $BUILDDIR/$base."
}

# After pacman -U succeeded: the package files go. $@ are the files.
clean_after_install() {
  local f
  for f; do [[ -f $f ]] && rm -f -- "$f"; done
  echo "Removed the installed package file from $PKGDEST."
}

# After pacman -U succeeded: the sources this recipe downloaded go too. They
# are the installed version's, so only a failed install (whose sources stay,
# for the retry) could use them again. Of other files, only those downloaded
# over a week ago go: a retry that late fetches again. Omarchy installs hold
# the clone lock, so no other build is using SRCDEST meanwhile. Run in the
# recipe directory.
clean_sources() {
  local used f n=0
  while IFS= read -r used; do
    f=${used%%::*}
    [[ $used == *::* ]] || f=${used##*/}
    [[ $f =~ ^[A-Za-z0-9@%+,_~][A-Za-z0-9@%+,._~-]*$ && -f $SRCDEST/$f ]] || continue
    rm -f -- "$SRCDEST/$f" && n=$((n + 1))
  done < <(mkpkg --printsrcinfo 2>/dev/null | sed -n 's/^\tsource\(_[a-z0-9_]*\)\? = //p')
  n=$(( n + $(find "$SRCDEST" -mindepth 1 -maxdepth 1 -type f -mtime +7 -print -delete 2>/dev/null | wc -l) ))
  (( n == 0 )) || echo "Removed $n downloaded source file(s) from $SRCDEST."
}

install_omarchy() {
  local blocker commit
  echo "Waiting for the omarchy-pkgs clone..."
  pkgs_take_lock 600 || die "the omarchy-pkgs clone stayed locked"
  commit=$(pkgs_fetch) || die "could not fetch omarchy-pkgs"
  pkgs_base=$commit
  pkgs_checkout || die "could not check out omarchy-pkgs ${commit:0:12}"
  restore_clone=1
  if (( pkgs_follow )); then
    echo "omarchy-pkgs: following master (unpinned), at $commit"
  else
    echo "omarchy-pkgs pinned at $commit, checked out detached"
  fi

  recipe_source "$pkg" "$app" || die "the pinned recipe is not usable"
  [[ -n $recipe_note ]] && echo "$recipe_note"
  if [[ $recipe_rev != "$pkgs_base" ]]; then
    recipe_materialise "$pkg" "$recipe_rev" || die "could not lay out the recipe from $recipe_rev"
    echo "Recipe tree taken whole from $recipe_rev"
  fi
  blocker=$(recipe_blocker "$recipe_rev" "$pkg") || die "could not read the $pkg recipe at ${recipe_rev:0:12}"
  [[ -z $blocker ]] || die "$blocker; wait for the [omarchy] repo"

  # The first fetched code that runs: omarchy-pkgs' sync tool and the
  # recipe's upstream hook, as you, after you pressed Update. Its curl calls
  # read the .curlrc above, its temporary files go under the cache, and the
  # maintainer-only release-age bypass never reaches it.
  write_download_policy
  (cd "$pkgs_dir" && run_unlocked env -u BYPASS_MIN_RELEASE_AGE -u MIN_RELEASE_AGE_SECONDS \
     CURL_HOME="$cache_dir/curl" TMPDIR="$cache_dir/scratch" \
     timeout -k 10 900 bin/sync-upstream "$pkg") </dev/null || die "bin/sync-upstream $pkg failed"

  echo
  echo "Changes to Omarchy's $pkg recipe against omarchy-pkgs ${pkgs_base:0:12}:"
  pgit add -A -- "pkgbuilds/$pkg"
  if pgit diff --cached --quiet HEAD -- "pkgbuilds/$pkg"; then
    echo "(none, the recipe already holds the newest release)"
  else
    pgit --no-pager diff --cached --no-color HEAD -- "pkgbuilds/$pkg" | term_safe
  fi
  echo

  check_target "$pkgs_dir/pkgbuilds/$pkg" "$pkg"
  cd "$pkgs_dir/pkgbuilds/$pkg"
  build_and_install "$pkg"
  cd /
  # Leave the clone as the pinned commit has it.
  pkgs_restore "$pkg"
  restore_clone=0
  exec 8>&-
}

# pacman would download a URL itself, but it checks remote files against
# RemoteFileSigLevel, which defaults to SigLevel (Required) and vendors do not
# sign these packages. So curl fetches the file over HTTPS, its digest must
# match the one the vendor publishes (vendor_checksum), pacman -Qp reads its
# name and version, and pacman -U installs the local file under
# LocalFileSigLevel. A package without a published digest is not installed.
install_vendor_pkg() {
  local latest url file line name ver now_line msg have sum algo want got feed_file
  feed_file=$(mktemp "$cache_dir/.feed.XXXXXX")
  latest=$(feed_save=$feed_file feed_version "$app") || { rm -f "$feed_file"; die "the feed has no version"; }
  echo "Feed: $latest"
  url=$(vendor_pkg_url "$app" "$latest") || { rm -f "$feed_file"; die "the vendor publishes no https $pkg package for $(uname -m)"; }
  echo "Vendor package: $url"
  sum=$(vendor_checksum "$app" "$url" "$latest" "$feed_file") || { rm -f "$feed_file"; die "no published checksum for ${url##*/}; not downloading"; }
  rm -f "$feed_file"
  read -r algo want <<<"$sum"
  echo "Published $algo: $want"
  msg=""
  if [[ -n $installed ]]; then
    have=$(upstream_part "$installed")
    if (( switch )); then
      if newer "$have" "$latest"; then msg="$latest is older than the installed $installed_name $installed"; fi
    elif ! newer "$latest" "$have"; then
      msg="$latest is not newer than the installed $installed_name $installed"
    fi
  fi
  if [[ -n $msg ]]; then
    (( prepare )) && { echo "Would refuse: $msg"; return 0; }
    die "$msg; nothing to do"
  fi
  file=$PKGDEST/${url##*/}
  started=1
  if [[ -f $file ]]; then
    echo "Using the download from an earlier run: $file"
  else
    max_time=1800 max_size=4G fetch -fL --retry 2 -o "$file.part" "$url" || die "could not download $url"
    mv -f "$file.part" "$file"
  fi
  got=$("${algo}sum" -- "$file" | cut -d' ' -f1)
  if [[ $got != "$want" ]]; then
    rm -f -- "$file"
    die "$algo of the download is $got, the vendor publishes $want; removed the file, not installing"
  fi
  echo "$algo matches."
  line=$(pacman -Qp -- "$file") || die "cannot read $file"
  name=${line%% *} ver=${line#* }
  [[ $name == "$pkg" ]] || die "the vendor package is '$name', expected '$pkg'"
  full_version_ok "$ver" || die "the vendor package has an odd version '$ver'"
  [[ $(upstream_part "$ver") == "$latest" ]] || die "the vendor package is $ver, expected $latest"
  # The feed knows no epoch or pkgrel; the file does. Compare its full
  # version with what is installed right now.
  msg=$(guard_version "$ver") || die "vendor package: $msg; not installing"
  echo "Package file: $file ($line)"
  show_switch "$file"
  stage_and_install "$file" "$line" "$algo" "$want"
  if (( prepare )); then
    echo "Prepared: stopping before sudo."
    return 0
  fi
  now_line=$(installed_package "$pkg") || die "pacman -Q $pkg finds nothing after the install"
  [[ $now_line == "$pkg $ver" ]] || die "pacman -Q says '$now_line', expected '$pkg $ver'"
  echo "Installed $now_line."
  clean_after_install "$file"
  target_version=$ver
}

# mise up keeps the configured request (an exact pin or a range), the same
# policy the check used through mise outdated, and like it runs with no
# release-age cooldown, so the target shown in the panel is the one
# installed here.
install_mise() {
  local tool=$installed_name target request now
  [[ -n $tool ]] || die "${mise_inventory_error:-mise has no active $label}"
  mise_load 1 "$tool"
  mise_key_safe "$tool" || die "$(mise_skip_note "$tool"); Omabump updates mise tools on mise's own backends only. Update $tool with mise up yourself."
  [[ -z $mise_error ]] || die "$mise_error"
  [[ -z ${mise_fetch_failed[$tool]:-} ]] || die "mise could not fetch the versions of $tool: ${mise_fetch_failed[$tool]}"
  # An entry mise_outdated_table could not read has no fields: read as such,
  # it would say newest or held where the check (mise_row) says the answer
  # could not be read. Each table is checked before its fields are read.
  mise_entry_ok "$mise_outdated_json" "$tool" || die "mise outdated gave an entry for $tool that is not an object"
  target=$(mise_field "$mise_outdated_json" "$tool" latest)
  if [[ -z $target ]]; then
    [[ -z $mise_bump_error ]] || die "$mise_bump_error"
    mise_entry_ok "$mise_bump_json" "$tool" || die "mise outdated --bump gave an entry for $tool that is not an object"
    # The release itself, as the panel's row shows it; bump is only the
    # request rewritten to reach it.
    request=$(mise_field "$mise_bump_json" "$tool" requested)
    now=$(mise_field "$mise_bump_json" "$tool" latest)
    [[ -n $now ]] || now=$(mise_field "$mise_bump_json" "$tool" bump)
    if [[ -n $now && $now != "$installed" ]]; then
      [[ $request == latest ]] && die "$label is held back at $installed by your mise settings ($now exists); mise up would not move it. See mise settings."
      die "$label is held at $installed by its mise request '$request' ($now exists); mise up would not move it. Change the request with mise use."
    fi
    echo "$label $installed is the newest mise up can install."
    exit 0
  fi
  echo "mise up -- $tool would install $target"
  if (( prepare )); then
    echo "Would run: mise up -- $tool (in $HOME)"
    return 0
  fi
  tool_name_ok "$tool" || die "'$tool' is not a mise tool name Omabump accepts"
  mise_timeout=900 mise_run up -- "$tool"
  mise_load 0
  now=$(mise_active "$app") || now=""
  now=${now#* }
  if [[ $now == "$target" ]]; then
    echo "$label is now $now."
  else
    echo "$label is ${now:-not active} after mise up, expected $target. See mise ls $tool."
  fi
  target_version=$now
}

# Set by self_apply: what its merge creates, and whether a signal came.
self_new=() self_stop=0

# self_git for the steps that must not stop part way, the merge and the
# rollback: git under timeout, in a process group of its own that Ctrl-C
# and a closing terminal do not reach, and with nothing that passes INT or
# HUP on to it (self_git runs through run_killable, which stops git on
# either). Each step is still bounded by the timeout. A signal that comes
# meanwhile runs self_apply's trap once git is done.
self_git_held() { run_unlocked timeout -k 10 120 env GIT_ALLOW_PROTOCOL=https GIT_TERMINAL_PROMPT=0 git "${git_safe[@]}" -C "$plugin_dir" "$@" </dev/null; }

# Fast-forwards the plugin clone from the commit $1 to $self_target and
# validates the result with the command "${@:2}" <plugin dir>. From the
# merge until the validation passed, any end of the run (a merge that fails
# part way, a failed validation, Ctrl-C, the terminal closing, kill) puts
# the clone back at $1 through self_rollback: never a half-updated plugin.
self_apply() {
  local before=$1 added=() p rc=0
  shift
  # What the merge creates: each path the release adds that is not on disk
  # now, cut to its top-most directory that is not on disk either. The
  # rollback removes these whole, since git status shows neither ignored
  # files nor empty directories. A path already on disk is an ignored file
  # of yours (status was clean), which the merge overwrites as git does and
  # the rollback leaves.
  mapfile -d '' -t added < <(self_git diff -z --name-only --no-renames --diff-filter=A "$before" "$self_target")
  wait "$!" || die "git diff failed in $plugin_dir; nothing changed"
  self_new=()
  for p in "${added[@]}"; do
    [[ -e $plugin_dir/$p || -L $plugin_dir/$p ]] && continue
    while [[ $p == */* && ! -e $plugin_dir/${p%/*} && ! -L $plugin_dir/${p%/*} ]]; do p=${p%/*}; done
    self_new+=("$p")
  done
  self_before=$before self_stop=0
  # A signal waits for the step it comes in: the merge runs through
  # self_git_held, out of reach of Ctrl-C, a closing terminal and a TERM
  # sent to this script, so stopping at once would roll back under a merge
  # that carries on and lands. The rollback's git runs the same way, so a
  # second Ctrl-C cannot cut its reset short and leave the release in
  # place. Each step is bounded, the merge by self_git_held's timeout.
  trap 'self_stop=1' HUP INT TERM
  self_git_held merge -q --ff-only "$self_target" || rc=$?
  (( ! self_stop )) || self_rollback "the update stopped part way"
  (( rc == 0 )) || self_rollback "git merge --ff-only $self_target failed"
  run_unlocked "$@" "$plugin_dir" </dev/null || rc=$?
  (( ! self_stop )) || self_rollback "the update stopped part way"
  (( rc == 0 )) || self_rollback "the new version failed validation"
  self_before=""
  trap - HUP INT TERM
}

# Puts the plugin clone back at self_before, HEAD and work tree: a merge
# that stopped part way can leave files of the release that are not in the
# index yet, so what the merge created (self_new) goes too, ignored files
# included. Exits with $1 and whether that worked.
self_rollback() {
  local before=$self_before
  self_before=""
  if self_restore "$before"; then
    die "$1; rolled back to ${before:0:12}"
  fi
  die "$1, and the rollback did not finish; see git -C $plugin_dir status, and restore it with: git -C $plugin_dir reset --hard $before"
}

# True once the clone is at $1 with a clean work tree and nothing the merge
# created is left. git runs held (self_git_held): Ctrl-C or the terminal
# closing during the rollback waits for it.
self_restore() {
  local p
  self_git_held reset -q --hard "$1" || return 1
  if (( ${#self_new[@]} )); then
    self_git_held --literal-pathspecs clean -qfdx -- "${self_new[@]}" || return 1
  fi
  for p in "${self_new[@]}"; do
    [[ ! -e $plugin_dir/$p && ! -L $plugin_dir/$p ]] || return 1
  done
  [[ $(self_git_held rev-parse HEAD) == "$1" && -z $(self_git_held status --porcelain) ]]
}

# Omabump itself: the plugin's own clone, fast-forwarded to the commit the
# release tag names (self_plan) once you have read its log and answered y,
# then validated as Omarchy's updater does; self_apply rolls it back if the
# merge or the validation fails. `omarchy plugin update` would install the
# repository's HEAD instead. The function exits, so nothing of this file is
# read after the merge replaced it.
install_self() {
  local latest answer before validate=(omarchy-plugin-validate)
  self_git_managed || die "Omabump runs from a local checkout ($plugin_dir); update it with git"
  command -v omarchy-plugin-validate >/dev/null || validate=(omarchy plugin validate)
  command -v "${validate[0]}" >/dev/null || die "omarchy-plugin-validate is missing"
  latest=$(feed_version "$app") || die "could not read Omabump's newest release"
  echo "Newest release: $latest"
  if ! newer "$latest" "$installed"; then
    echo "Omabump $installed is the newest release."
    exit 0
  fi
  self_origin_ok || die "the plugin clone's origin is not $self_repo; update it with: omarchy plugin update $self_plugin_id"
  self_plan "$latest" || die "not updating to v$latest. omarchy plugin update $self_plugin_id still works; it installs the repository's HEAD"
  echo "Release v$latest is commit $self_target."
  echo
  echo "Commits after the installed $(self_git rev-parse --short HEAD):"
  self_git --no-pager log --no-color --oneline "HEAD..$self_target" | term_safe
  echo
  self_git --no-pager diff --no-color --stat HEAD "$self_target" | term_safe
  echo
  if (( prepare )); then
    echo "Would ask: Update Omabump to $latest? [y/N]"
    echo "Would run: git merge --ff-only $self_target in $plugin_dir, ${validate[*]} $plugin_dir (if either fails or the run is stopped before the validation passed: git reset --hard to the installed commit, and what the merge created removed), omarchy-shell shell rescanPlugins"
    exit 0
  fi
  before=$(self_git rev-parse HEAD) || die "git rev-parse HEAD failed in $plugin_dir"
  read -r -p "Update Omabump to $latest? [y/N] " answer </dev/tty || answer=""
  [[ $answer == [yY] ]] || { echo "Not updated."; exit 0; }
  # The prompt can wait for minutes: refuse if the clone changed meanwhile,
  # so a rollback below can never discard an edit made while it waited.
  [[ $(self_git rev-parse HEAD) == "$before" ]] || die "the plugin clone moved while waiting; nothing changed, run Update again"
  [[ -z $(self_git status --porcelain) ]] || die "the plugin clone has local changes now; nothing changed"
  self_apply "$before" "${validate[@]}"
  run_unlocked omarchy-shell shell rescanPlugins >/dev/null 2>&1 </dev/null || true
  "$plugin_dir/bin/omabump-check" --no-notify --wait || true
  # rescanPlugins finds the plugin again but QML it already loaded can stay
  # cached, while the row above already reads the new version.
  echo "Omabump is now $latest. Restart the shell to load its new panel: omarchy restart shell"
  exit 0
}

# The install on the app's route, then the panel's refresh.
install_main() {
  case $source in
    self) install_self ;;
    omarchy) install_omarchy ;;
    vendor-pkg) install_vendor_pkg ;;
    mise) install_mise ;;
    indicator) die "$label has no supported install path; update it the way you installed it" ;;
    *) die "unknown source '$source'" ;;
  esac

  (( prepare )) && exit 0
  refresh_panel
  if [[ $source != mise ]]; then
    if [[ -n $installed ]]; then echo "Restart $label to use $target_version."; else echo "$label $target_version is installed."; fi
  fi
}

# tests/install.sh sources this file with an app's arguments, stub commands
# first on PATH: everything above runs as in a real run, then the tests call
# the functions themselves, or install_main with staging_dir in their own
# directory.
if (return 0 2>/dev/null); then return 0; fi
install_main
