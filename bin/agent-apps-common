# Sourced by agent-apps-check and agent-apps-install; not run on its own.
# shellcheck shell=bash

plugin_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
shipped_apps=$plugin_dir/apps.json
user_apps=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/agent-apps/apps.json
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/plugins/io.github.vladkarok.agent-apps
status_file=$state_dir/status.json
notified_file=$state_dir/notified.json
cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/agent-apps
pkgs_dir=$cache_dir/omarchy-pkgs
pkgs_url=https://github.com/omacom/omarchy-pkgs.git
pkgs_lock=$cache_dir/omarchy-pkgs.lock

# The app table: the shipped one, with the user's file merged over it by pkg.
# A user entry adds an app or overrides fields of a shipped one; "disabled":
# true hides it. Shipped order comes first, user additions after.
apps_table() {
  local user='[]'
  if [[ -f $user_apps ]]; then
    user=$(jq -ce 'if type == "array" then . else error("not an array") end' "$user_apps" 2>/dev/null) \
      || { echo "ignoring $user_apps: not a JSON array" >&2; user='[]'; }
  fi
  jq -c --argjson user "$user" '
    reduce (. + $user)[] as $a ({order: [], by: {}};
      if .by[$a.pkg] then .by[$a.pkg] += $a
      else .order += [$a.pkg] | .by[$a.pkg] = $a end)
    | [.order[] as $p | .by[$p] | select(.disabled != true)]' "$shipped_apps"
}

app_json() {
  apps_table | jq -ce --arg pkg "$1" '.[] | select(.pkg == $pkg)'
}

# vercmp is the only comparator: pacman, makepkg and omarchy-pkgs all use it.
newer() { (( $(vercmp "$1" "$2") > 0 )); }

# The upstream part of a pacman version: no epoch, no pkgrel.
upstream_part() { local v=${1#*:}; echo "${v%-*}"; }

# What Arch allows in pkgver, plus ":" for an epoch. Versions end up in sed
# expressions and file names, so anything else is a feed error.
version_ok() { [[ $1 =~ ^[A-Za-z0-9._+~:]+$ ]]; }

# Prints "<name> <full version>" for the first of the given names pacman has
# installed. Only exact names count: a provide could be an unrelated package.
installed_package() {
  local name line
  for name in "$@"; do
    [[ -n $name ]] || continue
    line=$(pacman -Q -- "$name" 2>/dev/null) || continue
    [[ ${line%% *} == "$name" ]] || continue
    echo "$line"
    return 0
  done
  return 1
}

# The version mise actually runs: the entry marked active, else what
# `mise current` prints.
mise_active() {
  local tool=$1 v
  command -v mise >/dev/null || return 1
  v=$(mise ls --json "$tool" 2>/dev/null | jq -r '[.[]? | select(.active == true)][0].version // ""' 2>/dev/null) || v=""
  [[ -n $v ]] || v=$(mise current "$tool" 2>/dev/null | awk '{print $1; exit}')
  [[ -n $v ]] && echo "$v"
}

# Prints "<source> <installed name> <version>" for an app, or fails when it is
# not installed. A mise install wins over a pacman one: its shims sit ahead of
# /usr/bin in PATH, so it is the copy in use.
installed_app() {
  local app=$1 tool v line names
  tool=$(jq -r '.mise // ""' <<<"$app")
  if [[ -n $tool ]] && v=$(mise_active "$tool"); then
    echo "mise $tool $v"
    return 0
  fi
  mapfile -t names < <(jq -r '((.installed // [.pkg]) + (if .aur then [.aur] else [] end))[]' <<<"$app")
  line=$(installed_package "${names[@]}") || return 1
  echo "$(jq -r '.source // "aur"' <<<"$app") $line"
}

# Newest version in a Debian Packages index for one exact package name.
apt_newest() {
  local index=$1 want=$2 v best=""
  while read -r v; do
    if [[ -z $best ]] || newer "$v" "$best"; then best=$v; fi
  done < <(awk -v want="$want" '
    { sub(/\r$/, "") }
    /^Package:/ { p = $2 }
    /^Version:/ { v = $2 }
    /^$/        { if (p == want && v != "") print v; p = v = "" }
    END         { if (p == want && v != "") print v }' <<<"$index")
  [[ -n $best ]] && echo "$best"
}

# Prints the newest version the app's own feed advertises. Every fetch is
# checked on its own: a failed or cut-off download is an error, never a version.
feed_version() {
  local app=$1 type url body v repo cmd want
  type=$(jq -r '.feed.type // ""' <<<"$app")
  url=$(jq -r '.feed.url // ""' <<<"$app")
  case $type in
    apt-index)
      want=$(jq -r '.feed.package // .pkg' <<<"$app")
      body=$(curl -fsSL --max-time 30 "$url" 2>/dev/null) || { echo "could not fetch $url (curl exit $?)" >&2; return 1; }
      v=$(apt_newest "$body" "$want") || { echo "no $want in the apt index" >&2; return 1; } ;;
    zcode-manifest)
      body=$(curl -fsSL --max-time 30 "$url" 2>/dev/null) || { echo "could not fetch $url (curl exit $?)" >&2; return 1; }
      v=$(sed -n 's/^version: *//p' <<<"$body" | head -1) ;;
    github-release)
      # The /releases/latest redirect names the tag; the REST API would do the
      # same but allows only 60 unauthenticated calls an hour.
      repo=$(jq -r '.feed.repo // ""' <<<"$app")
      body=$(curl -sS -o /dev/null --max-time 30 -w '%{http_code} %{redirect_url}' \
        "https://github.com/$repo/releases/latest" 2>/dev/null) || { echo "could not reach github.com/$repo (curl exit $?)" >&2; return 1; }
      [[ $body == 302\ */releases/tag/* ]] || { echo "github.com/$repo has no latest release (${body%% *})" >&2; return 1; }
      v=${body##*/releases/tag/}
      v=${v#v} ;;
    command)
      cmd=$(jq -r '.feed.command // ""' <<<"$app")
      body=$(timeout 60 bash -c "$cmd" </dev/null) || { echo "feed command failed" >&2; return 1; }
      v=$(head -1 <<<"$body") ;;
    "")
      echo "no feed declared" >&2; return 1 ;;
    *)
      echo "unknown feed type '$type'" >&2; return 1 ;;
  esac
  v=$(tr -d '[:space:]' <<<"$v")
  [[ -n $v ]] || { echo "feed returned no version" >&2; return 1; }
  version_ok "$v" || { echo "feed returned an odd version '$v'" >&2; return 1; }
  echo "$v"
}

# --- omarchy-pkgs ----------------------------------------------------------

# Takes the clone lock on fd 8 for the rest of the process, waiting up to $1 s.
pkgs_take_lock() {
  mkdir -p "$cache_dir"
  exec 8>"$pkgs_lock"
  flock -w "${1:-0}" 8
}

# Brings the clone to origin/master and prints the commit. Needs the lock.
pkgs_prepare() {
  if [[ ! -d $pkgs_dir/.git ]]; then
    rm -rf "$pkgs_dir"
    git clone -q --filter=blob:none "$pkgs_url" "$pkgs_dir" </dev/null >&2 || return 1
  fi
  git -C "$pkgs_dir" fetch -q origin </dev/null >&2 || return 1
  git -C "$pkgs_dir" reset -q --hard origin/master >&2 || return 1
  git -C "$pkgs_dir" clean -qfdx >&2 || return 1
  git -C "$pkgs_dir" rev-parse HEAD
}

# Puts Omarchy's recipe back the way origin/master has it. A hard reset,
# because a recipe overlay (below) is staged into the index.
pkgs_restore() {
  git -C "$pkgs_dir" reset -q --hard origin/master 2>/dev/null || true
  git -C "$pkgs_dir" clean -qfdx -- "pkgbuilds/${1:?}" 2>/dev/null || true
}

# Lays an unmerged omarchy-pkgs ref's recipe over origin/master's. apps.json
# sets "recipeRef" (e.g. refs/pull/725/head) when a pending PR gives a package
# the upstream watch that master still lacks. Prints the ref when applied.
recipe_overlay() {
  local pkg=$1 ref
  ref=$(jq -r '.recipeRef // ""' <<<"$2")
  [[ -n $ref ]] || return 0
  git -C "$pkgs_dir" fetch -q origin "$ref" </dev/null >&2 || { echo "could not fetch $ref" >&2; return 1; }
  git -C "$pkgs_dir" checkout -q FETCH_HEAD -- "pkgbuilds/$pkg" >&2 || { echo "no $pkg recipe in $ref" >&2; return 1; }
  echo "$ref"
}

# Why the recipe cannot follow its vendor, or nothing when it can.
recipe_blocker() {
  local dir=$pkgs_dir/pkgbuilds/$1 meta
  meta=$dir/.omarchy/package.json
  [[ -f $dir/PKGBUILD ]] || { echo "No $1 recipe in omarchy-pkgs"; return; }
  if [[ -f $meta ]] && jq -e '.sync == false' "$meta" >/dev/null 2>&1; then
    echo "Repo recipe has no upstream watch yet (sync: false)"; return
  fi
  if [[ -f $dir/.omarchy/upstream.sh ]] || { [[ -f $meta ]] && jq -e '.upstream' "$meta" >/dev/null 2>&1; }; then
    return
  fi
  echo "Repo recipe has no upstream watch yet"
}

# Prints "<pkgname> <full version>" from a PKGBUILD without running it. Only
# plain assignments are accepted, the form omarchy-pkgs' own tools rewrite.
recipe_version() {
  local pb=$1/PKGBUILD name ver rel epoch
  name=$(pkgbuild_field "$pb" pkgname) ver=$(pkgbuild_field "$pb" pkgver)
  rel=$(pkgbuild_field "$pb" pkgrel) epoch=$(pkgbuild_field "$pb" epoch)
  [[ $name =~ ^[a-z0-9@._+-]+$ ]] || { echo "unreadable pkgname in $pb" >&2; return 1; }
  [[ $ver =~ ^[A-Za-z0-9._+~]+$ ]] || { echo "unreadable pkgver in $pb" >&2; return 1; }
  [[ $rel =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "unreadable pkgrel in $pb" >&2; return 1; }
  [[ -z $epoch || $epoch =~ ^[0-9]+$ ]] || { echo "unreadable epoch in $pb" >&2; return 1; }
  echo "$name ${epoch:+$epoch:}$ver-$rel"
}

pkgbuild_field() { sed -n "s/^$2=//p" "$1" | head -1 | tr -d "\"'"; }

# The last error line of a sync-upstream log, without colour codes.
sync_error() {
  local line
  line=$(sed 's/\x1b\[[0-9;]*m//g' "$1" | grep '^✗' | grep -v 'sync completed with failures' | tail -1) || true
  [[ -n $line ]] || line=$(grep -v '^[[:space:]]*$' "$1" | tail -1) || true
  line=${line#✗ }
  echo "${line:0:200}"
}
