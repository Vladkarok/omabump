#!/usr/bin/env python3
"""Print the coding-agent CLIs Omarchy offers, with the mise key each one
installs under, as JSON:

  {"agents": [{"command", "label", "key", "source": "wrapper"|"command",
               "warning": "..." (only for a mise wrapper that was rejected)}],
   "errors": ["..."]}

Omarchy lists its agents in the menu, as the immediate entries
setup.default.agent.<command> of the stock omarchy-menu.jsonc and the user's
extension (merged by id, user fields over stock ones, as the shell does). A
stock menu that parses but has no such entry at all is an error: Omarchy
renamed its ids, and no agent would be found.
omarchy-mise-install writes ~/.local/bin/<command> as a short wrapper that
names the mise package; that package, with a trailing @version and [options]
suffix removed, is the key `mise ls` reports. Both files are read as text
only: nothing is executed, sourced or evaluated, and of a menu entry only
the id and the label are used. Menus are opened without blocking and read
only when they are regular files owned by the user or root. Labels lose
control and format characters (bidi, zero-width) and stop at 64 characters;
at most 64 agents are listed.

A wrapper is read line by line: the bash shebang first, then exactly one
`mise use -g [flags] "PKG"` line (optionally `|| exit 1`) and after it one
`exec mise x "PKG" -- "BIN" "$@"` line (or `mise exec`), with the same PKG;
`export NAME=VALUE` lines, comments and blank lines may sit around them.
A wrapper that does not parse is ignored, and the agent falls back to its
command name as the key (source "command"); the check accepts that key only
when mise has exactly it installed and active. When the rejected file runs
mise (a command, outside quotes, comments and here-document bodies, that is
mise use, x or exec, also after &&, ;, if, NAME=value, or exec, sudo, env,
nice or timeout with their options, by name or by path), the agent carries a
"warning" naming it, so a changed template shows in the panel (unless the
user disabled that command's row). Anything else in its place stays silent:
no file, a symlink, a binary, or a script that does not run mise, even if a
message or a comment in it names mise (Omarchy installs some agents, Hermes
and OpenClaw, with their own launchers, and ~/.local/bin holds the user's
own scripts too).

  omabump-discover [--debug] [--stock FILE] [--user FILE] [--bin-dir DIR] [--uid N] [--menu-uid N]

--debug prints why a wrapper was rejected on stderr. The other options exist
for the tests.
"""

import errno
import json
import os
import re
import stat
import sys
import unicodedata

COMMAND_ID = re.compile(r"setup\.default\.agent\.([a-z0-9][a-z0-9-]{0,40})")
# The literals omarchy-mise-install double-quotes: no $ ` " \ ! and no
# control characters (it switches to printf %q for those, never accepted).
LITERAL = r'"([^$`"\\!\x00-\x1f\x7f]+)"'
# The lines a wrapper may have, each matched whole after the indentation
# and trailing blanks are cut.
SHEBANG = re.compile(r"#!(?:/bin/bash|/usr/bin/bash|/usr/bin/env bash)")
USE_LINE = re.compile(r"mise +use((?: +-[A-Za-z0-9-]+)*) +" + LITERAL + r"(?: *\|\| *exit(?: +[0-9]+)?)?")
EXEC_LINE = re.compile(r"exec +mise +(?:x|exec) +" + LITERAL + r" +-- +" + LITERAL + r' +"\$@"')
EXPORT_LINE = re.compile(r"export +[A-Za-z_][A-Za-z0-9_]*=(?:[A-Za-z0-9_./:@%+,=-]*|" + LITERAL
                         + r"|'[^'\x00-\x1f\x7f]*')")
# The flags of `mise use` that take no value (a flag that takes one would
# swallow the package literal); -g or --global must be among them.
USE_FLAGS = {"-g", "--global", "-q", "--quiet", "-y", "--yes", "-f", "--force", "--silent",
             "--pin", "--fuzzy", "--locked", "-v", "--verbose", "--raw"}
# A command that runs mise as a wrapper does (use, x or exec), so a file
# that fails to parse is still worth a warning. The command is one of
# shell_commands, and its first word, after any NAME=value, a keyword (if,
# then, do, ...), ! or {, or a command that runs another (exec, command,
# env, sudo, nohup, time, nice, timeout, by name or by path) with its
# options and numbers (sudo -E, env -i, nice -n 19, timeout 60), is mise or
# a path ending in /mise. Of those commands' options, the ones in
# RUNNER_VALUE_FLAG take the next word as their value (sudo -u root, exec
# -a NAME); any other word ends the options, so `sudo -E echo "mise use"`
# stays an echo. Global flags may come before the subcommand, with the
# value of those that take one. omarchy-mise-install itself,
# `mise exec-env`, and mise in an echo or a comment do not count. Each
# token matches one way only, so a long run of them cannot make the regex
# backtrack exponentially: a flag that takes a value never also matches as
# a bare flag, and a command's path never starts with - or a digit, as an
# option or a number does.
MISE_VALUE_FLAG = r"(?:-C|--cd|-E|--env|-P|--profile|-j|--jobs|--log-level)"
RUNNER_VALUE_FLAG = r"(?:-[aCDfgoRrsTtUu]|--(?:argv0|chdir|format|group|output|signal|unset|user))"
KEYWORD = r"(?:if|elif|while|until|then|do|else|!|\{)"
ASSIGNMENT = r"[A-Za-z_]\w*=(?:\"[^\"]*\"|'[^']*'|[^\s\"'])*"
RUNNER = r"(?![-\d])(?:[^\s\"'=]*/)?(?:exec|command|env|sudo|nohup|time|nice|timeout)"
MISE = r"(?![-\d])[\"']?(?:[^\s\"'=]*/)?mise[\"']?"
RUNS_MISE = re.compile(
    r"(?:" + KEYWORD + r"\s+|" + ASSIGNMENT + r"\s+|" + RUNNER
    + r"(?:\s+(?:" + RUNNER_VALUE_FLAG + r"\s+\S+|(?!" + RUNNER_VALUE_FLAG + r"\s)-\S*|\d\S*))*\s+)*"
    + MISE +
    r"(?:\s+(?:" + MISE_VALUE_FLAG + r"\s+\S+|(?!" + MISE_VALUE_FLAG + r"\s)-\S+))*"
    r"\s+(?:use|x|exec)(?![\w-])")
# A here-document's operator and delimiter word: <<WORD, <<-WORD, <<'WORD',
# <<"WORD" or <<\WORD, blanks allowed between them. The delimiter is the
# word without its quotes.
HEREDOC = re.compile(r"<<(-?)[ \t]*(?:'([^'\n]*)'|\"([^\"\n]*)\"|\\?([^\s;&|()<>'\"\\]+))")
# Where a new command starts in shell text, outside quotes: after a
# control operator (; & && | ||), a subshell's or a command substitution's
# parenthesis, or a newline.
COMMAND_BREAK = frozenset(";&|()\n")
OPTIONS = re.compile(r"^([^\[\]]*)\[[^\[\]]*\]$")
# What follows the @ of a version suffix (1.2.3, latest, prefix:20,
# ref:main): only dropped, so only its shape is checked.
VERSION = re.compile(r"^[A-Za-z0-9][^@\[\]\s]*$")
# bash tool_name_ok in omabump-common.
TOOL_NAME = re.compile(r"^[A-Za-z0-9@_+:][A-Za-z0-9@._+:/-]*$")
MAX_WRAPPER = 4096
MAX_MENU = 4 * 1024 * 1024
MAX_LABEL = 64
MAX_AGENTS = 64


class NoWrapper(ValueError):
    """No wrapper, or a file that is clearly not one: nothing to report."""


def strip_jsonc(text):
    """JSON from JSONC: // and /* */ comments, then trailing commas, removed
    outside strings only, so "https://..." inside a string survives."""
    out, i, n = [], 0, len(text)
    while i < n:
        c = text[i]
        if c == '"':
            j = _string_end(text, i)
            out.append(text[i:j])
            i = j
        elif text.startswith("//", i):
            j = text.find("\n", i)
            i = n if j < 0 else j
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            if j < 0:
                raise ValueError("unterminated comment")
            out.append(" ")
            i = j + 2
        else:
            out.append(c)
            i += 1
    text, out, i = "".join(out), [], 0
    n = len(text)
    while i < n:
        c = text[i]
        if c == '"':
            j = _string_end(text, i)
            out.append(text[i:j])
            i = j
            continue
        if c == ",":
            j = i + 1
            while j < n and text[j] in " \t\r\n":
                j += 1
            if j < n and text[j] in "}]":
                i += 1
                continue
        out.append(c)
        i += 1
    return "".join(out)


def _string_end(text, i):
    """The index just past the JSON string that starts at text[i]."""
    j, n = i + 1, len(text)
    while j < n and text[j] != '"':
        j += 2 if text[j] == "\\" else 1
    return j + 1


def read_bounded(fd, limit):
    """Up to limit + 1 bytes from fd."""
    chunks, left = [], limit + 1
    while left > 0:
        chunk = os.read(fd, min(left, 65536))
        if not chunk:
            break
        chunks.append(chunk)
        left -= len(chunk)
    return b"".join(chunks)


def read_menu(path, uid):
    """The menu's items by id: a flat object, or one under "items". A menu
    may be a symlink (dotfile setups use them), but what it opens must be a
    regular file owned by the user or root; the descriptor is opened without
    blocking, so a FIFO cannot stall the check."""
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise ValueError("not a regular file")
        if st.st_uid not in (uid, 0):
            raise ValueError("not owned by uid %d or root" % uid)
        if st.st_size > MAX_MENU:
            raise ValueError("larger than 4 MiB")
        raw = read_bounded(fd, MAX_MENU)
    finally:
        os.close(fd)
    if len(raw) > MAX_MENU:
        raise ValueError("larger than 4 MiB")
    text = strip_jsonc(raw.decode("utf-8"))
    if not text.strip():
        return {}
    # The decoder recurses once per nesting level: a deep enough menu runs
    # out of stack, which must be this menu's error, not discovery's end.
    try:
        data = json.loads(text)
    except RecursionError:
        raise ValueError("nested too deeply")
    if not isinstance(data, dict):
        raise ValueError("not a JSON object")
    items = data.get("items")
    return items if isinstance(items, dict) else data


def clean_label(label):
    """A label without control or format characters (Cc, Cf: bidi overrides,
    zero-width), whitespace collapsed, at most MAX_LABEL characters."""
    if not isinstance(label, str):
        return ""
    kept = "".join(c for c in label if unicodedata.category(c) not in ("Cc", "Cf"))
    return " ".join(kept.split())[:MAX_LABEL].strip()


def menu_agents(stock, user, uid, errors):
    """[(command, label)] in menu order, user fields merged over stock ones."""
    merged = {}
    for path, required in ((stock, True), (user, False)):
        try:
            items = read_menu(path, uid)
        except FileNotFoundError:
            if required:
                errors.append("no Omarchy menu at %s" % path)
            continue
        except (OSError, ValueError, UnicodeDecodeError) as e:
            errors.append("cannot read the menu %s: %s" % (path, e))
            continue
        ids = [(COMMAND_ID.fullmatch(key), value) for key, value in items.items()]
        ids = [(m, value) for m, value in ids if m]
        if required and not ids:
            errors.append("the menu %s lists no setup.default.agent.<command> entries" % path)
        for m, value in ids:
            if not isinstance(value, dict):
                continue
            entry = merged.setdefault(m.group(1), {})
            if "label" in value:
                entry["label"] = value["label"]
    agents = [(c, clean_label(e.get("label"))) for c, e in merged.items()]
    return [(c, label) for c, label in agents if label][:MAX_AGENTS]


def tool_name_ok(name):
    return bool(TOOL_NAME.match(name)) and ".." not in name


def heredoc_end(text, i, strip_tabs, word):
    """Where a here-document whose body starts at i ends: just past its
    delimiter line (which, with <<-, may start with tabs), or -1 when no
    line is the delimiter."""
    n = len(text)
    while i < n:
        j = text.find("\n", i)
        end = n if j < 0 else j
        line = text[i:end]
        if (line.lstrip("\t") if strip_tabs else line) == word:
            return min(end + 1, n)
        i = end + 1
    return -1


def shell_commands(text):
    """The commands of shell text, split where COMMAND_BREAK starts one,
    without comments (an unquoted # that starts a word, to the end of its
    line) and backslash-newlines, and whether the text ends outside any
    quote and here-document. Quotes are only followed, never removed, so
    mise inside an echo's string stays part of the echo, even across lines.
    A here-document's body is data and is skipped whole, up to its
    delimiter line, without following quotes: an apostrophe in it is text,
    not the start of a string. One that feeds a shell (bash <<EOF) is not
    followed either. Nothing is expanded."""
    out, cur, quote, heredocs, i, n = [], [], None, [], 0, len(text)
    while i < n:
        c = text[i]
        if quote == "'":
            quote = None if c == "'" else quote
        elif c == "\\":
            # A backslash quotes the next character, and a newline after it
            # continues the line.
            if text.startswith("\n", i + 1):
                i += 2
                continue
            cur.append(text[i:i + 2])
            i += 2
            continue
        elif quote is not None:
            # Inside "..." or $'...', where a backslash escapes (above).
            quote = None if c == quote[-1] else quote
        elif c == "'" and cur and cur[-1] == "$":
            # $'...' ends at a ' that no backslash quotes ($'it\'s').
            quote = "$'"
        elif c in "'\"":
            quote = c
        elif c == "#" and (not cur or text[i - 1].isspace()):
            j = text.find("\n", i)
            i = n if j < 0 else j
            continue
        elif c == "<" and text.startswith("<<<", i):
            # A here-string, not a here-document.
            cur.append("<<<")
            i += 3
            continue
        elif c == "<" and HEREDOC.match(text, i):
            m = HEREDOC.match(text, i)
            word = next(w for w in m.group(2, 3, 4) if w is not None)
            heredocs.append((m.group(1) == "-", word))
            cur.append(m.group(0))
            i = m.end()
            continue
        elif c in COMMAND_BREAK:
            out.append("".join(cur))
            cur = []
            i += 1
            # The bodies of the here-documents opened on the line just
            # ended follow it, one after another.
            while c == "\n" and heredocs:
                i = heredoc_end(text, i, *heredocs.pop(0))
                if i < 0:
                    return out, False
            continue
        cur.append(c)
        i += 1
    out.append("".join(cur))
    return out, quote is None


def runs_mise(text):
    """True when a command in the text runs mise as a wrapper does
    (RUNS_MISE, from the command's first word). When the text ends inside
    a quote or a here-document without its delimiter line, something was
    likely misread (a quoting form not followed, an arithmetic << taken for
    a here-document) and the split may have swallowed real commands, so
    each line is also tried on its own, as before the split: a stray quote
    can add a warning, never drop one."""
    commands, closed = shell_commands(text)
    if not closed:
        commands += text.splitlines()
    return any(RUNS_MISE.match(command.strip()) for command in commands)


def parse_wrapper(text):
    """The package a wrapper's text names, or raises ValueError with the
    reason. Every line must be one the wrapper may have (see the module
    docstring); nothing else is allowed, so no extra statement can hide."""
    lines = text.split("\n")
    if not SHEBANG.fullmatch(lines[0].rstrip(" \t")):
        raise ValueError("no bash shebang on the first line")
    uses, execs = [], []
    for n, line in enumerate(lines[1:], 2):
        line = line.strip(" \t")
        if not line or line.startswith("#") or EXPORT_LINE.fullmatch(line):
            continue
        m = USE_LINE.fullmatch(line)
        if m:
            flags = set(m.group(1).split())
            if not flags <= USE_FLAGS or not flags & {"-g", "--global"}:
                raise ValueError("line %d: mise use without -g, or with a flag Omabump does not know" % n)
            uses.append((n, m.group(2)))
            continue
        m = EXEC_LINE.fullmatch(line)
        if m:
            execs.append((n, m.group(1)))
            continue
        raise ValueError("line %d is not a line of an omarchy-mise-install wrapper" % n)
    if len(uses) != 1 or len(execs) != 1:
        raise ValueError("%d mise use and %d exec mise lines, not one of each" % (len(uses), len(execs)))
    if uses[0][0] > execs[0][0]:
        raise ValueError("mise use comes after exec mise")
    if uses[0][1] != execs[0][1]:
        raise ValueError("the two package literals differ")
    return uses[0][1]


def package_key(pkg):
    """The key `mise ls` reports for a package as `mise use` takes it:
    without a trailing @version, then without an [options] suffix. The @ of
    an npm scope (npm:@scope/name, @scope/name) starts the name and is not a
    version; an @ inside [options] (a URL's user) is not one either. A colon
    ends a backend only before any @ but a leading one: in omp@prefix:1 and
    @scope/name@ref:main it is part of the version."""
    if "[" in pkg:
        start = pkg.rfind("]") + 1
    else:
        colon, first_at = pkg.find(":"), pkg.find("@", 1)
        start = colon + 1 if colon >= 0 and (first_at < 0 or colon < first_at) else 0
        if pkg.startswith("@", start):
            start += 1
    at = pkg.rfind("@", start)
    if at >= 0:
        if not VERSION.match(pkg[at + 1:]):
            raise ValueError("malformed @version suffix")
        pkg = pkg[:at]
    if pkg.endswith("]"):
        o = OPTIONS.match(pkg)
        if not o:
            raise ValueError("malformed [options] suffix")
        pkg = o.group(1)
    return pkg


def wrapper_key(path, uid):
    """The mise key a wrapper installs, or raises ValueError with the reason
    (NoWrapper when the file is no mise wrapper at all). The file is opened
    without following a symlink and checked on the open descriptor, so it
    cannot be swapped between the check and the read."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK)
    except FileNotFoundError:
        raise NoWrapper("no wrapper")
    except OSError as e:
        if e.errno == errno.ELOOP:
            raise NoWrapper("a symlink")
        # Unreadable, so nothing says it is a mise wrapper.
        raise NoWrapper("cannot open: %s" % e.strerror)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise NoWrapper("not a regular file")
        raw = read_bounded(fd, MAX_WRAPPER)
    finally:
        os.close(fd)
    if not raw.startswith(b"#!"):
        raise NoWrapper("not a script")
    # Whether it runs mise is decided on the text as far as it was read; the
    # safety rules below then apply to a file that does.
    if not runs_mise(raw[:MAX_WRAPPER].decode("utf-8", "replace")):
        raise NoWrapper("a script that does not run mise")
    if st.st_uid != uid:
        raise ValueError("not owned by uid %d" % uid)
    if len(raw) > MAX_WRAPPER:
        raise ValueError("larger than %d bytes" % MAX_WRAPPER)
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise ValueError("not UTF-8")
    key = package_key(parse_wrapper(text))
    if not tool_name_ok(key):
        raise ValueError("mise key %r has characters Omabump does not accept" % key)
    return key


def shown(path, home):
    """A path with the home directory as ~."""
    if home and path.startswith(home.rstrip("/") + "/"):
        return "~" + path[len(home.rstrip("/")):]
    return path


def main(argv):
    home = os.environ.get("HOME", "")
    omarchy = os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy"
    opts = {
        "--stock": os.path.join(omarchy, "default/omarchy/omarchy-menu.jsonc"),
        "--user": os.path.join(home, ".config/omarchy/extensions/omarchy-menu.jsonc"),
        "--bin-dir": os.path.join(home, ".local/bin"),
        "--uid": str(os.getuid()),
        "--menu-uid": str(os.getuid()),
    }
    debug = False
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--debug":
            debug = True
        elif a in opts and args:
            opts[a] = args.pop(0)
        else:
            print("usage: omabump-discover [--debug] [--stock FILE] [--user FILE] [--bin-dir DIR] [--uid N] [--menu-uid N]",
                  file=sys.stderr)
            return 2
    errors, agents = [], []
    uid = int(opts["--uid"])
    for command, label in menu_agents(opts["--stock"], opts["--user"], int(opts["--menu-uid"]), errors):
        path = os.path.join(opts["--bin-dir"], command)
        agent = {"command": command, "label": label}
        try:
            agent.update(key=wrapper_key(path, uid), source="wrapper")
        except ValueError as e:
            if debug:
                print("omabump-discover: %s: %s" % (command, e), file=sys.stderr)
            agent.update(key=command, source="command")
            # On the agent, not in errors: the check drops it for a command
            # whose row the user disabled.
            if not isinstance(e, NoWrapper):
                agent["warning"] = "wrapper %s not recognised: %s" % (shown(path, home), e)
        agents.append(agent)
    json.dump({"agents": agents, "errors": errors}, sys.stdout)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
