#!/bin/bash
# Compare each installed agent app with the newest version it could be updated
# to and record the result for the bar panel. Never installs anything.
#
#   repo        the database of Omarchy's repo [omarchy] (read once per
#               check, as text) gives the package Update would install, and
#               the feed in apps.json, when the entry has one, the vendor's
#               newest release, which may be ahead of the repo. For such a
#               row of an entry Build now may build, and only while the
#               buildAhead setting is on, the recipe at the omarchy-pkgs
#               commit pinned in pins.json is read (PKGBUILD and .omarchy/
#               as text, with git show) to see whether bin/sync-upstream
#               could move it. Nothing fetched is run: sync-upstream runs
#               only in omabump-install --build, after you asked for it.
#   vendor-pkg  the feed in apps.json; the vendor publishes the package.
#   indicator   the feed in apps.json; no install path.
#   mise        `mise outdated`: what `mise up` would reach under the
#               configured request, and what lies outside it (a pin).
#
# An app installed as a copy that updates itself rather than its package
# (apps.json "appImage" or "npmPackage"): the feed in apps.json, against the
# version the AppImage names (read with 7z) or the npm package's
# package.json; the app updates itself, so no route.
#
#   omabump-check [--no-notify] [--no-cli] [--wait] [--retry]
#   omabump-check --if-due --interval SEC [--no-notify] [--no-cli]
#   omabump-check --local [--no-cli]
#
# --no-cli leaves the CLI section out (Show CLI tools off); --no-mise, its
# name until 0.1.19, still works, for a caller of then, and can go once
# none is left.
#
# --wait runs after a check already in progress instead of leaving it to
# that one: the installer's refresh needs a check that starts after its
# install, since the running one may have read the old version.
#
# --retry marks the run as the one retry of a check that failed
# (status.json's retry): a retry that fails is not retried.
#
# --if-due runs a check only when one is due, SEC (the widget's interval
# setting) after the last one started, or the retry of one that failed:
# the widget's timer and the panel opening ask with it. Exit 76 when none
# is due, with nothing written: see "whether a check is due" below. A run
# that found one due says "due" on stdout before it checks.
#
# --local reads the installed versions again and nothing else, without the
# network: see local_refresh below.
#
# Exit 75: no check ran. Without --wait another check held the lock, and
# that one writes status.json; with --wait, it held the lock past the wait.
# A check that finds a local refresh, or an --if-due run that has not said
# "due", holding it waits for that one instead, which takes seconds and may
# be no check. Exit 76: --if-due found no check
# due.
#
# Muted rows and skipped versions come from the widget's settings in
# Omarchy's shell.json (load_quiet), whoever runs the check. So do the
# notify, showCli and buildAhead settings when no flag says otherwise: the
# shell passes --no-notify and --no-cli when they are off, and a run from a terminal,
# the installer's refresh or an agent passes none and still honours them.
#
# The shell runs it under `timeout -k 10 600` (checkDeadlineSec and
# killAfterSec in Model.js), so a hung feed or tool cannot keep a check
# alive past ten minutes. The shell never passes --wait: it waits for the
# lock itself, before that deadline starts, since a long wait under it
# would end in the deadline's kill instead of exit 75. The TERM trap below
# still writes status.json as a failed run, with runError saying so. Every
# command under its own `timeout` runs through run_killable, so the trap
# is not held until that command ends.
set -euo pipefail
# shellcheck source=omabump-common
source "$(dirname "$(readlink -f "$0")")/omabump-common"

usage="usage: omabump-check [--no-notify] [--no-cli] [--wait] [--retry]
       omabump-check --if-due --interval SEC [--no-notify] [--no-cli]
       omabump-check --local [--no-cli]"
notify="" with_cli="" wait_lock=0 local_run=0 retry=0 if_due=0 interval=""
while (( $# )); do
  case $1 in
    --no-notify) notify=0 ;;
    --no-cli|--no-mise) with_cli=0 ;;
    --wait) wait_lock=1 ;;
    --local) local_run=1 ;;
    --retry) retry=1 ;;
    --if-due) if_due=1 ;;
    --interval) (( $# > 1 )) || { echo "$usage" >&2; exit 2; }; interval=$2; shift ;;
    *) echo "$usage" >&2; exit 2 ;;
  esac
  shift
done
(( ! (local_run && (wait_lock || retry || if_due)) )) || { echo "$usage" >&2; exit 2; }
# --if-due decides the retry itself and never waits for a check: a check
# holding the lock is the one that was due.
if (( if_due )); then
  if [[ ! $interval =~ ^[1-9][0-9]{0,8}$ ]] || (( wait_lock || retry )); then echo "$usage" >&2; exit 2; fi
else
  [[ -z $interval ]] || { echo "$usage" >&2; exit 2; }
fi

# What --local tells its caller besides 0 and 75 (Model.js reads the same
# numbers, Model.localOutcome): a row changed in a way only a check can
# read; there is no status.json of a check to start from; pacman is in the
# middle of a transaction, so its rows wait for the next try. Numbers no
# tool here exits with, so a command that fails under set -e reads as a
# failed run, not as one of these.
full_check_exit=80 no_status_exit=81 pacman_busy_exit=82

mkdir -p "$state_dir"
# The shell timer and a hand run can overlap; the second one has nothing to
# add, unless it was asked to --wait. It exits 75, not 0, so a caller can
# tell it from a check that ran. A check lasts at most ten minutes; a wait
# that outlasts that exits 75 too, as the widget's own wait does.
#
# A local refresh holds the same lock, so neither runs during the other, and
# .local.lock (fd 6) as well, taken first and let go last. A check that
# finds the check lock taken while .local.lock is held waits for the local
# refresh to end and tries once more: that refresh writes no check, so
# leaving the answer to it would drop the check until the next tick. It
# takes a second or so; the wait lasts as long as the shell lets one run,
# its deadline and the KILL after it (localDeadlineSec and killAfterSec in
# Model.js). The local refresh itself never waits: behind a check or
# another local refresh it has nothing to add.
exec 9>"$state_dir/.check.lock"
if (( local_run )); then
  exec 6>"$state_dir/.local.lock"
  if ! flock -n 6 || ! flock -n 9; then
    echo "omabump-check: a check or another local refresh is running; no local refresh ran" >&2
    exit 75
  fi
elif (( wait_lock )); then
  flock -n 9 || { echo "Waiting for the running check to end..." >&2; flock -w 660 9; } \
    || { echo "omabump-check: the running check held the lock for over 11 min; no check ran" >&2; exit 75; }
elif (( if_due )); then
  # --if-due holds .local.lock too while it decides, as a local refresh
  # does: it may find none due and write nothing, so a check that finds it
  # holding the check lock waits for it instead of leaving the answer to it.
  # Behind a local refresh or another --if-due run, this one waits as well.
  exec 6>"$state_dir/.local.lock"
  flock -w 130 6 || true
  if ! flock -n 9; then
    echo "omabump-check: another check is running and will write status.json; no check ran" >&2
    exit 75
  fi
elif ! flock -n 9; then
  # The check lock is tried again with the local one held, so no new local
  # refresh can take it in between.
  exec 6>"$state_dir/.local.lock"
  flock -w 130 6 || true
  if ! flock -n 9; then
    echo "omabump-check: another check is running and will write status.json; no check ran (--wait runs one after it)" >&2
    exit 75
  fi
  exec 6>&-
fi
# Muted rows (the panel's mutedApps setting) and rows at a version the user
# skipped (skippedVersions) never notify; status.json still says the truth
# about them, plus "muted", "skipped" and "skipEnded": the panel compares
# no versions and takes skipped as the answer to whether a skip still
# applies, and skipEnded (skip_over) as the one to whether it may go. They and
# the notify, showCli and buildAhead settings are read under the lock, so a run that
# waited for it checks with
# the settings as they are when it starts: the widget counts on a check
# that took the lock after a change of Show CLI tools to honour it.
load_quiet
[[ -n $notify ]] || if [[ $setting_notify == false ]]; then notify=0; else notify=1; fi
[[ -n $with_cli ]] || if [[ $setting_show_cli == false ]]; then with_cli=0; else with_cli=1; fi
# Build now is off unless the setting turns it on: then the check reads a
# recipe for a row the vendor is ahead on, and announces such a release.
build_ahead=0
[[ $setting_build_ahead != true ]] || build_ahead=1

# --- whether a check is due (--if-due) ---------------------------------------
#
# Decided under the lock, so whatever status.json says is over: no other
# check runs, and a "checking" mark left in it is a run that was killed.
# Every monitor's bar asks every minute, and a shell reload starts them all,
# so a check that started less than the interval, less due_slack_sec
# (run_recent in omabump-common), ago is recent enough. Its start counts,
# not its end: from the end, the next one would come up short by however
# long the last one took. A time ahead of the clock (it was set back)
# proves nothing, and a check is due.
#
# A check that failed is tried once more retry_sec after it started
# (sooner with a shorter interval), instead of a whole interval later: the
# summary says "Check failed" (offline after a resume, a feed's 504). Once:
# a retry that fails too waits the interval, so an outage, or a rate limit
# that lasts the hour, is not asked again every few minutes. Failed means
# what the widget calls a failure, by the settings as they are now, or the
# killed run's mark: check_failed in omabump-common.
#
# attempt_file holds when the last --if-due run started, and whether it was
# the retry. A run that wrote nothing (it died before its first write) moved
# no time in status.json: its start counts all the same, so nothing starts
# every minute behind it, and it failed. A retry that wrote nothing was the
# retry all the same.
not_due_exit=76 retry_sec=300
attempt_file=$state_dir/check-attempt
if (( if_due )); then
  now_s=$(date +%s)
  started_at="" checked_at="" file_retry=false failed=false
  # shellcheck disable=SC2016 # jq variables, not the shell's
  status_load && IFS=$'\x1f' read -r started_at checked_at file_retry failed < <(jq -r \
    --argjson muted "$muted_json" --argjson mise "$with_cli" "$jq_status"'
    [(.startedAt | field_text), (.checkedAt | field_text), (.retry == true), check_failed($muted; $mise)]
    | map(tostring) | join("\u001f")' <<<"$status_json" 2>/dev/null) || true
  # When the last run status.json shows started: a file from before
  # startedAt has only checkedAt.
  run_s=""
  [[ -z $started_at ]] || run_s=$(date -d "$started_at" +%s 2>/dev/null) || run_s=""
  [[ -n $run_s || -z $checked_at ]] || run_s=$(date -d "$checked_at" +%s 2>/dev/null) || run_s=""
  attempt_s="" attempt_retry=0
  [[ ! -s $attempt_file ]] || read -r attempt_s attempt_retry <"$attempt_file" || true
  # An attempt ahead of the clock (it was set back) proves nothing either.
  [[ $attempt_s =~ ^[0-9]{1,12}$ && $attempt_retry =~ ^[01]$ ]] && (( attempt_s <= now_s )) \
    || attempt_s="" attempt_retry=0
  last_s=$run_s retried=0
  [[ $file_retry == true ]] && retried=1
  if [[ -n $attempt_s ]] && { [[ -z $run_s ]] || (( attempt_s >= run_s )); }; then
    # The last attempt is the last run. Started in the same second, it is
    # the run status.json shows; after it, one that wrote nothing.
    if [[ -z $run_s ]] || (( attempt_s > run_s )); then failed=true retried=0; fi
    (( ! attempt_retry )) || retried=1
    last_s=$attempt_s
  fi
  window=$interval
  if [[ $failed == true ]] && (( ! retried )); then
    window=$(( interval < retry_sec ? interval : retry_sec )) retry=1
  fi
  # The check lock goes before .local.lock, so a check waiting on that one
  # finds this one free.
  if run_recent "$now_s" "$last_s" "$window"; then
    exec 9>&- 6>&-
    exit "$not_due_exit"
  fi
  printf '%s %s\n' "$now_s" "$retry" >"$attempt_file"
  exec 6>&-
  # The widget's word that a check runs: until then it shows none.
  echo due
fi

# Only a check or a local refresh makes these, and only under the lock: any
# left over is from a run that was killed outright. The locks themselves,
# .check.lock and .local.lock, match none of them, and deleting one would
# let a second run take a new lock beside this one.
rm -rf -- "$state_dir"/.run.* "$state_dir"/.status.* "$state_dir"/.state.*
# An Update makes these while it runs, without this lock. One more than a
# day old belongs to no live run.
find "$state_dir" "$cache_dir" -mindepth 1 -maxdepth 1 \( -name '.mise.??????' \
  -o -name '.mise-select.??????' -o -name '.feed.??????' -o -name '.repo.??????' \) -mmin +1440 -exec rm -rf -- {} + 2>/dev/null || true
# A killed Update's half download (curl writes to it until it stops, within
# 30 minutes, and a new download starts it over) and sync-upstream's mktemp
# dir (it runs at most 15 minutes and removes its own). Only mktemp's names
# in scratch: a hook's file by another name may carry an archive's old time
# while a live run still reads it.
find "$cache_dir/packages" -mindepth 1 -maxdepth 1 -type f -name '*.part' -mmin +1440 -exec rm -f -- {} + 2>/dev/null || true
find "$cache_dir/scratch" -mindepth 1 -maxdepth 1 -name 'tmp.??????????' -mmin +1440 -exec rm -rf -- {} + 2>/dev/null || true

# Each app of the table $1, then Omabump itself, as one line of its pkg,
# source, entry and what installed_from reads of it (jq_app_facts, from
# mise's inventory as mise_load left it), split by \x1f: the entry is
# compact JSON, and the pkg and source are names the table allows
# (apps_table), so none holds one. One jq for the table, not one per app.
# With Show CLI tools off (with_cli 0) the apps of the CLI section are left
# out, whatever their route: their rows are neither read nor written.
table_lines() {
  # shellcheck disable=SC2016 # jq variables, not the shell's
  jq -r --argjson self "$self_app" --argjson cli "$with_cli" --slurpfile ls <(printf '%s\n' "$mise_ls_json") \
    "$jq_routes$jq_app_facts"'
    (.[], $self) | select($cli == 1 or route_section != "cli")
    | [.pkg, .source, tojson, app_facts($ls[0])] | join("\u001f")' <<<"$1"
}

# --- a local refresh (--local) -------------------------------------------------
#
# Apps are updated outside Omabump: Omarchy's wrappers update mise CLIs on
# launch, and omarchy update runs pacman and mise up. Until the next check,
# a row can then offer an Update that is already installed, and a
# self-updating app's own updater moves it. This reads the installed
# versions again, from pacman, the apps' own copies and Omabump's
# manifest.json (installed_app) and mise's inventory (mise ls, offline),
# for the apps of the table (load_table), and nothing else:
# no feed, no omarchy-pkgs, no mise outdated, nothing on the network. It
# starts from the last check's status.json and keeps the rest of each row
# (the newest version, the route, notes, errors, muted, skipped), except
# icon and iconLight: every row of the table, a row the run does not read
# included, takes those from apps.json. It
# writes the file once, with checkedAt and startedAt as that check left
# them: the widget counts the next check from those, and a local refresh
# must never put it off.
# inventoryAt says when the installed versions were last read, by a check
# or by this. It never notifies and never reads or writes notified.json.
# It exits:
#   0                  done
#   full_check_exit    something only a check can read changed; the rows say
#                      what is known until one runs (the widget starts it)
#   no_status_exit     no status.json of a finished check to start from;
#                      nothing written
#   pacman_busy_exit   pacman was in the middle of a transaction
#                      (pacman_busy) before, during or after the reads;
#                      nothing written, for a later try
# and 75 when a check or another local refresh held the lock (above).
local_refresh() {
  local previous need_full=0 changes=() at app pkg source name installed prev row why
  # pacman's transaction first: every other answer may ask for a check,
  # which reads pacman with no such guard. So the mise rows wait too; the
  # next try, once the transaction is over, finds them as this one would
  # have.
  ! pacman_busy || local_pacman_busy
  if ! status_load finished; then
    echo "omabump-check: no status.json of a finished check to start from; a full check is needed" >&2
    exit "$no_status_exit"
  fi
  previous=$status_json
  tmp=$(mktemp -d "$state_dir/.run.XXXXXX")
  run_tmp=$tmp
  # The check's lock goes before the local one: a check that waits for this
  # refresh to end then finds it free.
  trap 'rm -rf "$tmp"; exec 9>&- 6>&-' EXIT
  trap 'exit 143' TERM
  trap 'exit 130' INT
  trap 'exit 129' HUP
  printf '%s\n' "$previous" >"$tmp/previous.json"
  at=$(date -Iseconds)

  load_table
  # The inventory alone, under a shorter limit than a check's, offline:
  # mise ls names the active versions without asking any backend.
  if (( with_cli )); then
    mise_timeout=30 mise_offline=1
    mise_load 0
    [[ -z $mise_inventory_error ]] || echo "omabump-check: $mise_inventory_error; the mise rows stay as they were" >&2
  fi

  # mise ls can take a while, and a transaction that started
  # meanwhile would be read half way: pacman's lock is looked for again
  # right before its rows are read, and once more after them.
  ! pacman_busy || local_pacman_busy
  while IFS=$'\x1f' read -r pkg source app facts; do
    # A mise tool mise could not list is never read as uninstalled.
    if [[ $source == mise ]]; then
      (( with_cli )) && [[ -z $mise_inventory_error ]] || continue
    fi
    if ! read -r _ name installed < <(installed_from "$app" "$facts"); then
      # Gone, as a check drops a row that is no longer installed. A row
      # status.json does not have stays out: the merge below drops it as
      # soon as it adds it. The id needs no escapes in JSON (app_id_ok).
      changes+=("{\"pkg\":\"$pkg\",\"_drop\":true}")
      continue
    fi
    prev=$(status_row "$pkg" "$previous")
    name=$(clean_text "$name") installed=$(clean_text "$installed")
    # The skip as these settings hold it, judged at the versions now.
    if local_row; then changes+=("$(jq -c --arg e "$(skip_ended "$row")" '.skipEnded = $e' <<<"$row")"); fi
    if [[ -n $why ]]; then
      echo "omabump-check: $why; a full check is needed" >&2
      need_full=1
    fi
  done < <(table_lines "$app_table")
  ! pacman_busy || local_pacman_busy

  # Every row of the table takes its marks from apps.json as a check writes
  # them, so a new or overridden icon shows without one. The table goes in
  # with --slurpfile: as one argv string a large one would pass the
  # kernel's limit on an argument and fail every refresh.
  printf '%s\n' "$app_table" >"$tmp/table.json"
  # From a file, not a pipe: the rename stays in this shell (status_write_check).
  printf '%s\n' "${changes[@]}" >"$tmp/changes"
  status_write_local "$tmp/previous.json" "$tmp/table.json" "$at" <"$tmp/changes"
  (( ! need_full )) || exit "$full_check_exit"
  exit 0
}

# pacman's lock file is there while a transaction runs, and pacman -Q may
# read the database half way through one: a package being replaced reads as
# uninstalled, its row would go, and the next run would bring it back as
# new and ask for a check it does not need. pacman_lock is where it looks.
pacman_lock=""
pacman_busy() {
  local db=""
  if [[ -z $pacman_lock ]]; then
    read -r db < <(pacman-conf DBPath 2>/dev/null </dev/null) || true
    db=${db:-/var/lib/pacman/}
    pacman_lock=${db%/}/db.lck
  fi
  [[ -e $pacman_lock ]]
}

# A local refresh that found pacman busy leaves with nothing written: what
# it read so far goes with its run's dir.
local_pacman_busy() {
  echo "omabump-check: pacman is running ($pacman_lock); nothing changed, a later try reads the installed versions" >&2
  exit "$pacman_busy_exit"
}

# The row of $app ($pkg, $source) now that it is installed as $name at
# $installed, from its last row $prev, by the rules a check applies to the
# versions it knows (the rows section of omabump-common): sets row, and why
# when only a check can read the rest. Fails, row unset, when the row stays
# as it is.
local_row() {
  local p_source p_name p_installed p_latest p_from p_installable p_unchecked p_self p_unread p_repo p_vendor
  local p_vendor_known p_note p_ahead p_buildable p_build_note
  local update held=false installable switchable=false past=false self=false blocked unchecked note unread=false repo_version="" hold_clause=""
  row="" why=""
  self_updating_name "$name" && self=true
  if [[ $prev == '{}' ]]; then
    # Installed since the last check: what it is, not yet what is newer.
    local label installed_name=$name latest="" from="" error="" stale=false
    local omarchy_update=false self_updating=$self muted skipped skip_end quiet hold_clause=""
    update=false installable=false unchecked=true note="Not checked yet" unread=true
    label=$(jq -r '.label // .pkg' <<<"$app")
    row_quiet "$pkg" "$source" false "" "$installed"
    # Any failure of update_blocked, an unread entry too, reads as not off
    # here, as in 0.1.17: this row only shows, Update reads updateBlocked
    # itself and fails closed, and the next check reads it again.
    blocked=$(update_blocked "$app" "$self") || blocked=""
    row=$(row_json)
    why="$pkg${installed:+ $installed} is installed since the last check"
    return 0
  fi
  # p_unread: a row a local refresh wrote and no check has read since (new,
  # or moved between package and its own copy), its field unread
  # (row_unread). For a self-updating app, unchecked alone does not say so:
  # its unknown or pre-release version is unchecked too.
  IFS=$'\x1f' read -r p_source p_name p_installed p_latest p_from p_installable p_unchecked p_self p_unread p_repo \
    p_vendor p_vendor_known p_note p_ahead p_buildable p_build_note < <(jq -r "$jq_status"'
    [.source // "", .installedName // "", .installed // "", .latest // "", .versionFrom // "",
     .installable == true, .unchecked == true, .selfUpdating == true, row_unread, .repoVersion // "",
     (.vendorVersion // (if .versionFrom == "feed" then .latest else "" end)),
     (has("vendorVersion") or .versionFrom != "repo"), .note // "", .ahead == true, .buildable == true, .buildNote // ""]
    | map(tostring) | join("\u001f")' <<<"$prev")
  if [[ $p_source != "$source" ]]; then
    why="$pkg has another source in the app table"
    return 1
  fi
  [[ $name != "$p_name" || $installed != "$p_installed" ]] || return 1

  # From the package to the copy that updates itself or back: the route, the
  # note and what counts as newer all change, and only a check reads them.
  # The newest version stays (the feed is the entry's, whatever is
  # installed); what only the other form had goes, as a new row has it:
  # omarchy update's AUR route, Build now, and updateBlocked's mark, which
  # an app that updates itself never carries.
  if [[ $self != "$p_self" ]]; then
    # As for a new row above: an unread entry reads as not off, on purpose.
    blocked=$(update_blocked "$app" "$self") || blocked=""
    row=$(jq -c --arg name "$name" --arg installed "$installed" --argjson self "$self" --arg blocked "$blocked" '
      . + {installedName: $name, installed: $installed, selfUpdating: $self, updateAvailable: false, installable: false,
           switchable: false, held: false, skipped: false, unchecked: true, note: "Not checked yet",
           omarchyUpdate: false, blocked: ($blocked != ""), holdClause: "", unread: true,
           ahead: false, buildable: false, buildNote: ""}' <<<"$prev")
    why="$pkg is installed as $name now"
    return 0
  fi
  if [[ $self == true ]]; then
    # No check has read the row yet: it stays unread at its new version, as
    # a package row does, and the check asked for reads the rest.
    if [[ $p_unread == true ]]; then
      row=$(jq -c --arg name "$name" --arg installed "$installed" '. + {installedName: $name, installed: $installed}' <<<"$prev")
      why="$pkg${installed:+ $installed} is not checked yet"
      return 0
    fi
    # Its version against the newest known, as a check reads it (self_row):
    # its own updater moved it.
    self_row "$app" "$(jq -r '.label // .pkg' <<<"$app")" "$name" "$installed" "$p_latest"
    # Past the newest version known: a release no check has seen, which only
    # a check can compare with the feed's newest. Unread until one does. A
    # copy has no pkgrel: its version as it is, as self_row compares it.
    if [[ $unchecked == false && -n $p_latest ]] && row_past "$installed" "$p_latest" ""; then
      update=false unchecked=true note="Not checked yet" unread=true
      why="$pkg $installed is past the last known $p_latest"
    fi
    row=$(jq -c --arg name "$name" --arg installed "$installed" --argjson update "$update" --argjson unchecked "$unchecked" \
      --arg note "$(clean_text "$note")" --argjson unread "$unread" '
      . + {installedName: $name, installed: $installed, updateAvailable: $update, unchecked: $unchecked, note: $note,
           unread: $unread}
      | if $update then . else .skipped = false end' <<<"$prev")
    [[ $name == "$p_name" ]] || why="$pkg is installed as $name now"
    return 0
  fi

  if route "$source" newest mise; then
    # mise's answer about a newer version holds only for the version it was
    # asked about. At the newest one known, the row is current, and a check
    # reads whether the request still holds it.
    if [[ $name == "$p_name" && -n $p_latest && $installed == "$p_latest" ]]; then
      row=$(jq -c --arg installed "$installed" '. + {installed: $installed, updateAvailable: false, skipped: false}' <<<"$prev")
      why="$pkg reached $installed"
    else
      row=$(jq -c --arg name "$name" --arg installed "$installed" --argjson keyed "$([[ $name == "$p_name" ]] && echo false || echo true)" '
        . + {installedName: $name, installed: $installed, updateAvailable: false, skipped: false,
             installable: false, unchecked: true, note: "Not checked yet", unread: true}
        | if $keyed then . + {latest: "", versionFrom: "", request: ""} else . end' <<<"$prev")
      why="$pkg is $name $installed now"
    fi
    return 0
  fi

  # A route whose newest is Omarchy's repo's: the row again by the check's
  # rule (repo_derive), from what the last check read of the repo and of
  # the vendor (repoVersion, vendorVersion), kept as they were, against the
  # version installed now. omarchy update installs the repo's package, and
  # Build now one at the vendor's version: either clears the row without a
  # check. The route's own word (Update off, its tools, Build now's) is read
  # again, as cheaply as the check reads it; what the last check said of
  # the repo when it had no package, and of the recipe while the vendor
  # was ahead, stays.
  if route "$source" newest repo; then
    local repo_why="" repo_failed=false feed_error="" recipe_why="" build_reason may_build=false
    local repo_new ahead buildable build_note route_ok latest from route_error="" vendor_version
    repo_version=$p_repo vendor_version=$p_vendor
    blocked=$(update_blocked "$app" false) || blocked=""
    repo_route_base
    apply_blocked
    # No package in the repo: nothing Update could install, and the note's
    # reason (no repo, no package) is the last check's.
    [[ -n $repo_version ]] || installable=false note=$p_note
    [[ $p_ahead != true || $p_buildable == true ]] || recipe_why=$p_build_note
    build_allowed "$app" && may_build=true
    build_reason=$(build_why "$may_build" "$blocked" "$(missing_tools_line)" "$recipe_why")
    repo_derive
    row_switchable "$source" "$name" "$pkg" "$route_ok" "$update" "$installable" "$repo_version" "$installed" && switchable=true
    if [[ -n $latest ]] && row_past "$installed" "$latest" "$from"; then past=true; fi
    row=$(jq -c --arg name "$name" --arg installed "$installed" --argjson update "$update" --argjson held "$held" \
      --argjson installable "$installable" --argjson switchable "$switchable" --arg note "$(clean_text "$note")" \
      --arg clause "$hold_clause" --arg latest "$latest" --arg from "$from" --argjson ahead "$ahead" \
      --argjson buildable "$buildable" --arg buildNote "$(clean_text "$build_note")" --argjson past "$past" '
      . + {installedName: $name, installed: $installed, updateAvailable: $update, held: $held,
           installable: $installable, switchable: $switchable, note: $note, holdClause: $clause,
           latest: $latest, versionFrom: $from, ahead: $ahead, buildable: $buildable, buildNote: $buildNote}
      | if $update then . else .skipped = false end
      | if $past then . + {updateAvailable: false, switchable: false, skipped: false, ahead: false, buildable: false,
          unchecked: true, note: "Not checked yet", unread: true} else . end' <<<"$prev")
    if [[ $past == true ]]; then
      why="$pkg $installed is past the last known $p_latest"
    elif [[ $name != "$p_name" ]]; then
      why="$pkg is installed as $name now"
    elif [[ $p_unchecked == true ]]; then
      why="$pkg $installed is not checked yet"
    elif [[ $p_vendor_known == false && $update == false ]]; then
      # A row a checker before 0.2.0 wrote, whose newest version was the
      # repo's: what the vendor has, which may be ahead still, only a check
      # reads.
      why="$pkg reached $p_latest, the newest Omarchy's repo had; the vendor's newest is not known here"
    fi
    return 0
  fi

  # The installed version against the newest known, as a check compares
  # them (row_newer). No other route holds a release, so nothing of a
  # hold is left to take off.
  update=false
  if [[ -n $p_latest ]] && row_newer "$p_latest" "$installed" "$p_from"; then update=true; fi
  installable=$p_installable
  row_switchable "$source" "$name" "$pkg" "$installable" "$update" "$installable" "$p_latest" "$installed" && switchable=true
  # Past the newest version known: a release no check has seen, as for a
  # self-updating copy above. What the check knew about the route
  # (installable, omarchy update's AUR route) stays.
  if [[ -n $p_latest ]] && row_past "$installed" "$p_latest" "$p_from"; then past=true; fi
  row=$(jq -c --arg name "$name" --arg installed "$installed" --argjson update "$update" \
    --argjson switchable "$switchable" --argjson past "$past" '
    . + {installedName: $name, installed: $installed, updateAvailable: $update, switchable: $switchable}
    | if $update then . else .skipped = false end
    | if $past then . + {updateAvailable: false, switchable: false, skipped: false, unchecked: true, note: "Not checked yet",
        unread: true} else . end' <<<"$prev")
  if [[ $past == true ]]; then
    why="$pkg $installed is past the last known $p_latest"
  elif [[ $name != "$p_name" ]]; then
    why="$pkg is installed as $name now"
  elif [[ $p_unchecked == true ]]; then
    why="$pkg $installed is not checked yet"
  fi
  return 0
}
(( ! local_run )) || local_refresh

# Last run's results, used only when they have the shape this script writes
# (status_load).
previous='{"apps":[]}'
! status_load || previous=$status_json
notified='{}'
[[ -s $notified_file ]] && jq -e 'type == "object"' "$notified_file" >/dev/null 2>&1 && notified=$(<"$notified_file")

pkgs_state=""
pkgs_commit=$(jq -r '.omarchyPkgs.commit // ""' <<<"$previous")
pkgs_error="" pkgs_note="" mise_note=""
# An --if-due run starts when its attempt says, to the second, so a clock
# stepped back since then cannot make the run look like one that wrote
# nothing.
if (( if_due )); then started=$(date -Iseconds -d "@$now_s"); else started=$(date -Iseconds); fi
rows=() order='[]' status_done=0
# Every scratch file of the run, the helpers' included (run_tmp), is in
# $tmp, which the EXIT trap removes however the run ends.
tmp=$(mktemp -d "$state_dir/.run.XXXXXX")
run_tmp=$tmp
cleanup() {
  local rc=$?
  (( status_done )) || write_status 2 "The check stopped early (exit $rc)" || true
  rm -rf "$tmp"
}
trap cleanup EXIT
# Without these, a run stopped by Ctrl-C or a closed terminal would reach
# the EXIT trap with the status of the last command, often 0.
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP
# write_status reads the previous run from a file (--slurpfile), so a large
# status.json never becomes a command-line argument.
printf '%s\n' "$previous" >"$tmp/previous.json"
missing_line=$(missing_tools_line)

# The clone is fetched on first need, and only for a row the vendor is
# ahead on, of an entry Build now may build, while buildAhead is on: with
# it off the check never clones or fetches omarchy-pkgs. The check only
# reads it: no checkout, nothing run. The lock is held for the fetch alone;
# recipes are then read with git show from the object store, which an
# install's checkout and build do not touch. An install holds the lock for
# its whole build; a check that finds it taken reads no recipe this time,
# and Build now finds out the rest when asked.
pkgs_busy_note="The omarchy-pkgs clone is busy with an update; Build now reads its recipe when asked"
pkgs_ready() {
  if [[ -z $pkgs_state ]]; then
    if ! pkgs_take_lock 0; then
      pkgs_state=busy
      pkgs_note=$pkgs_busy_note
    else
      if pkgs_commit=$(pkgs_fetch 2>"$tmp/git.err"); then
        pkgs_state=ready pkgs_base=$pkgs_commit
      else
        pkgs_state=failed
        pkgs_error="Could not fetch omarchy-pkgs: $(tail -1 "$tmp/git.err")"
      fi
      pkgs_drop_lock
    fi
  fi
  [[ $pkgs_state == ready ]]
}

# What the recipe of $1 at the pinned commit (pkgs_base) says about Build
# now, for the vendor's release $2, into recipe_why: its blocker (no
# recipe, no upstream watch), its release-age hold (build_hold_clause), or
# why the clone or the recipe could not be read; "" when it could build,
# or when the clone is busy (nothing is known then).
recipe_why=""
recipe_read() {
  local pkg=$1 blocker age
  recipe_why=""
  if ! pkgs_ready; then
    [[ $pkgs_state == busy ]] || recipe_why=$pkgs_error
    return 0
  fi
  if ! blocker=$(recipe_blocker "$pkgs_base" "$pkg" 2>"$tmp/err") \
    || { [[ -z $blocker ]] && ! age=$(recipe_release_age "$pkgs_base" "$pkg" 2>"$tmp/err"); }; then
    recipe_why="Could not read Omarchy's $pkg recipe: $(tail -1 "$tmp/err")"
    return 0
  fi
  if [[ -n $blocker ]]; then recipe_why=$blocker; return 0; fi
  recipe_why=$(build_hold_clause "$pkg" "$2" "$age" "$now")
}

# One table for the whole run: the merge happens once.
load_table
table=$app_table
order=$(jq -c 'map(.pkg)' <<<"$table")

# Writes status.json (status_write_check) as this run has it so far: $1 is
# 0 while checking, 1 for the final write, 2 when the run dies half way,
# with $2 saying how. The check time stays the last one's until the final
# write.
previous_at=$(jq -r '.checkedAt // ""' <<<"$previous")
write_status() {
  local final=$1 at=$previous_at
  (( final == 1 )) && at=$(date -Iseconds)
  # The rows from a file, not a pipe: the rename stays in this shell
  # (status_write_check). A row list that cannot be written is never sent,
  # in the EXIT trap (set -e off there) too.
  printf '%s\n' "${rows[@]}" >"$tmp/rows" || return
  status_write_check "$final" "$at" "$started" "$retry" "$(clean_text "${2:-}")" \
    "$pkgs_commit" "$(clean_text "$pkgs_error")" "$(clean_text "$pkgs_note")" "$mise_note" "$tmp/previous.json" "$order" \
    <"$tmp/rows"
}

# Each announcement is saved as soon as it is sent, so a run that dies later
# does not announce it again.
save_notified() { save_json "$notified" "$notified_file"; }

# Announces once what notified.json has not recorded for the key $1 (the
# row's pkg for an update Update installs, ahead:<pkg> for a release only
# Build now reaches, so that neither hides the other), at the version $2,
# with the summary $3, the body $4 and notify-send's options after them:
# announce_action decides (send, record or nothing), from the row's update
# $5, error and quiet.
announce() {
  local key=$1 version=$2 summary=$3 body=$4 update=$5 announced action
  shift 5
  announced=$(jq -r --arg k "$key" '.[$k] // ""' <<<"$notified")
  action=$(announce_action "$source" "$update" "$error" "$quiet" "$version" "$announced")
  [[ -n $action ]] || return 0
  if [[ $action == send ]]; then
    notify-send -a Omabump "$@" "$(clean_text "$summary")" "$(clean_text "$body")" 2>/dev/null || return 0
  fi
  notified=$(jq -c --arg k "$key" --arg v "$version" '.[$k] = $v' <<<"$notified")
  save_notified
}

write_status 0
# Loaded here, in this shell, so every row reads the same answers.
(( with_cli )) && mise_load 1
# Without mise's inventory no mise row can be read: the last run's rows stay,
# as an earlier check's, failed, and the panel says why.
if (( with_cli )) && [[ -n $mise_inventory_error ]]; then
  mise_note=$(clean_text "${mise_inventory_error:0:200}")
  while IFS= read -r row; do rows+=("$row"); done < <(jq -c --arg e "$mise_note" '.apps[] | select(.source == "mise")
    | del(.checking) | .stale = true | .installable = false | .error = $e' <<<"$previous")
fi
now=$(date +%s)
while IFS=$'\x1f' read -r pkg source app facts; do
  [[ $with_cli == 0 && $source == mise ]] && continue
  if ! read -r _ installed_name installed < <(installed_from "$app" "$facts"); then
    # Not installed. Or pacman is replacing it right now and its database
    # reads half way (pacman_busy): then the last check's row stays, failed,
    # so that the retry reads it, rather than go now and come back as new.
    # Not a mise tool or Omabump itself, which pacman does not hold.
    if pacman_busy && route "$source" installed pacman; then
      row=$(status_row "$pkg" "$previous" 'select(. != {}) | del(.checking) | .stale = true | .installable = false
        | .error = "pacman was in the middle of a transaction, so the installed version was not read" | tojson')
      [[ -z $row ]] || rows+=("$row")
    fi
    continue
  fi

  label=$(jq -r '.label // .pkg' <<<"$app")
  # What the last check's row says, for a feed that fails now.
  IFS=$'\x1f' read -r p_latest p_from p_installed p_update p_vendor < <(status_row "$pkg" "$previous" '
    [.latest // "", .versionFrom // "", .installed // "", .updateAvailable == true,
     (.vendorVersion // (if .versionFrom == "feed" then .latest else "" end))]
    | map(tostring) | join("\u001f")')
  latest="" from="" note="" installable=false stale=false
  route_error="" feed_error="" mise_update=false request="" unchecked=false
  held=false omarchy_update=false self_updating=false unread=false repo_version="" vendor_version=""

  # Installed as a copy that updates itself: no route of its source applies,
  # and nothing of omarchy-pkgs is read for it. self_row words the row
  # once the newest version is known.
  route=$source
  if self_updating_name "$installed_name"; then self_updating=true route=self-updating; fi
  case $route in
    self-updating) ;;
    mise)
      mise_row "$installed_name" "$installed" ;;
    vendor-pkg)
      if ! command -v sudo >/dev/null || ! command -v curl >/dev/null; then
        note="Missing: sudo or curl; sudo pacman -S --needed base-devel curl"
      elif ! vendor_pkg_url "$app" x >/dev/null; then
        note="No https vendor package for $(uname -m)"
      elif ! vendor_checksum_declared "$app"; then
        note="No published checksum for the vendor package"
      else
        installable=true
      fi ;;
    repo)
      # Update installs the repo's signed package, Build now the recipe
      # (omabump-install): what Update takes, and the rest once the feed and
      # the repo are read (repo_derive).
      repo_route_base ;;
    self)
      # omarchy update does not update plugins; omarchy plugin update does,
      # for a git clone.
      if self_git_managed; then installable=true
      else note="Local checkout, update it with git"; fi ;;
    indicator)
      # omarchy update runs pacman -Syu, then yay -Sua for every foreign
      # package. So a package one of pacman's repos has (voxtype-bin, from
      # [omarchy]) needs nothing from here, nor does an AUR row installed
      # from the AUR.
      note="No supported install path"
      if pacman -Qqn -- "$installed_name" >/dev/null 2>&1; then
        omarchy_update=true note="Updates with omarchy update"
      elif [[ $(jq -r '.feed.type // ""' <<<"$app") == aur-rpc ]]; then
        if pacman -Qqm -- "$installed_name" >/dev/null 2>&1; then
          omarchy_update=true note="Updates with omarchy update (AUR)"
        else
          note+=", version from AUR"
        fi
      fi ;;
    *)
      route_error="unknown source '$source'" ;;
  esac
  # apps.json can turn Omabump's Update off for a row (updateBlocked says
  # why): a known problem in what Update would install. The versions still
  # show and still notify; only the route is closed, and Build now with it.
  # An entry update_blocked could not read ends the check here, as the
  # read at top level under set -e did: the EXIT trap writes the run as
  # failed (runError), and no row says Update is on.
  blocked_rc=0
  blocked=$(update_blocked "$app" "$self_updating") || blocked_rc=$?
  if (( blocked_rc == 0 )); then
    apply_blocked
  elif (( blocked_rc == 1 )); then
    blocked=""
  else
    echo "omabump-check: could not read the updateBlocked of $pkg in the app table" >&2
    exit "$blocked_rc"
  fi

  # Every route but mise reads its newest version from the feed in apps.json;
  # the repo's route only when the entry has one.
  if route "$source" newest feed || { route "$source" newest repo && has_feed "$app"; }; then
    if latest=$(feed_version "$app" 2>"$tmp/err"); then
      from=feed
    else
      latest="" feed_error=$(<"$tmp/err")
    fi
  fi

  # Keep the last known version so a flaky feed neither hides a pending
  # update nor re-announces it once the feed comes back.
  if [[ -n $feed_error ]]; then
    latest=$p_latest from=$p_from stale=true
    # A mise row's update is mise's answer, not a comparison: keep the last
    # one while the installed version has not moved.
    if route "$source" newest mise && [[ $p_installed == "$installed" ]]; then mise_update=$p_update; fi
  fi
  # Omarchy's repo, read on the first row that needs it, and the vendor's
  # release beside it (repo_derive). A recipe only for a row the vendor is
  # ahead on, of an entry Build now may build, with buildAhead on.
  if [[ $self_updating == false ]] && route "$source" newest repo; then
    vendor_version=$latest
    [[ -z $feed_error ]] || vendor_version=$p_vendor
    [[ -n $repo_state ]] || repo_load || true
    repo_lookup "$pkg" || true
    repo_why="" repo_failed=false
    case $repo_state in
      none) repo_why=$repo_error ;;
      ready) [[ -n $repo_version ]] || repo_why="Omarchy's repo has no $pkg" ;;
      *) repo_failed=true ;;
    esac
    may_build=false recipe_why=""
    build_allowed "$app" && may_build=true
    if (( build_ahead )) && [[ $may_build == true && -z $blocked && -z $missing_line ]] \
      && vendor_ahead "$installed" "$repo_version" "$vendor_version"; then
      recipe_read "$pkg" "$vendor_version"
    fi
    build_reason=$(build_why "$may_build" "$blocked" "$missing_line" "$recipe_why")
  fi

  # The update, the switch and the settings' mute and skip, by the rules
  # every row follows (row_derive), Omarchy's repo and the vendor's ahead
  # release by repo_derive's. The panel words a switch from installedName,
  # updateAvailable and switchable, so the note holds only the rest.
  row_derive

  # Their lines that are not empty, joined by "; ", as is every ";" in them.
  error=""
  while IFS= read -r line; do
    [[ -z $line ]] || error+=${error:+;}$line
  done <<<"$route_error"$'\n'"$feed_error"
  error=$(clean_text "${error//;/; }")
  error=${error:0:240}

  # A row of the repo's route announces only an update its Update can
  # install (repo_new), and by the repo's full version: its latest is the
  # feed's upstream version at one check and the repo's full version at
  # another, and vercmp ranks an epoch-less 1.2 below an announced 1:1.1-1.
  # The notification names latest, or the repo's version while the vendor
  # is ahead of it. A release only Build now reaches is announced apart,
  # once per vendor version, low, and only while buildAhead is on and
  # Build now could run for it: with it off the panel shows it.
  if (( notify )) && [[ $held == false ]]; then
    shown=$latest announce_key=$pkg announce_version=$latest announces=true
    if route "$source" newest repo && [[ $self_updating == false ]]; then
      announces=$repo_new announce_version=$repo_version
      [[ $ahead == false ]] || shown=$repo_version
    fi
    body="Installed: $installed. Open the Omabump panel to update."
    [[ $installable == true ]] || body="Installed: $installed. ${note^}."
    [[ $self_updating == false ]] || body="Installed: $installed. Updates itself: $(self_update_text "$app" "$label")."
    [[ $announces == false ]] || announce "$announce_key" "$announce_version" "$label $shown available" "$body" "$update"
  fi
  if (( notify && build_ahead )) && [[ $buildable == true ]]; then
    announce "ahead:$pkg" "$vendor_version" "$label $vendor_version released" \
      "Not in Omarchy's repo yet. Build now is available." true -u low
  fi

  rows+=("$(row_json)")
  write_status 0
done < <(table_lines "$table")

write_status 1
status_done=1
