#!/bin/bash
# Compare each installed agent app with the newest version it could be updated
# to and record the result for the bar panel. Never installs anything.
#
#   omarchy     the feed in apps.json gives the vendor's newest version; the
#               recipe at the omarchy-pkgs commit pinned in pins.json is only
#               read (PKGBUILD and .omarchy/ as text, with git show) to see
#               whether bin/sync-upstream could move it. Nothing fetched is run: sync-upstream runs only in
#               omabump-install, after the user pressed Update.
#   vendor-pkg  the feed in apps.json; the vendor publishes the package.
#   indicator   the feed in apps.json; no install path.
#   mise        `mise outdated`: what `mise up` would reach under the
#               configured request, and what lies outside it (a pin).
#
# An app installed as its self-updating AppImage (apps.json "appImage")
# rather than its package: the feed in apps.json, against the version the
# AppImage names, read with 7z; the app updates itself, so no route.
#
#   omabump-check [--no-notify] [--no-mise] [--wait]
#   omabump-check --local [--no-mise]
#
# --wait runs after a check already in progress instead of leaving it to
# that one: the installer's refresh needs a check that starts after its
# install, since the running one may have read the old version.
#
# --local reads the installed versions again and nothing else, without the
# network: see local_refresh below.
#
# Exit 75: no check ran. Without --wait another check held the lock, and
# that one writes status.json; with --wait, it held the lock past the wait.
# A check that finds a local refresh holding it waits for that one instead,
# which takes seconds and is no check.
#
# Muted rows and skipped versions come from the widget's settings in
# Omarchy's shell.json (load_quiet), whoever runs the check. So do the
# notify and showMise settings when no flag says otherwise: the shell passes
# --no-notify and --no-mise when they are off, and a run from a terminal,
# the installer's refresh or an agent passes none and still honours them.
#
# The shell runs it under `timeout -k 10 600` (Main.qml), so a hung feed or
# tool cannot keep a check alive past ten minutes. The shell never passes
# --wait: it waits for the lock itself, before that deadline starts, since a
# long wait under it would end in the deadline's kill instead of exit 75. The
# TERM trap below still writes status.json as a failed run, with runError
# saying so. Every command under its own `timeout` runs through
# run_killable, so the trap is not held until that command ends.
set -euo pipefail
# shellcheck source=omabump-common
source "$(dirname "$(readlink -f "$0")")/omabump-common"

usage="usage: omabump-check [--no-notify] [--no-mise] [--wait] | --local [--no-mise]"
notify="" with_mise="" wait_lock=0 local_run=0
while (( $# )); do
  case $1 in
    --no-notify) notify=0 ;;
    --no-mise) with_mise=0 ;;
    --wait) wait_lock=1 ;;
    --local) local_run=1 ;;
    *) echo "$usage" >&2; exit 2 ;;
  esac
  shift
done
(( ! (local_run && wait_lock) )) || { echo "$usage" >&2; exit 2; }

# What --local tells its caller besides 0 and 75 (Model.js reads the same
# numbers, Model.localOutcome): a row changed in a way only a check can
# read; there is no status.json of a check to start from; pacman is in the
# middle of a transaction, so its rows wait for the next try. Numbers no
# tool here exits with, so a command that fails under set -e reads as a
# failed run, not as one of these.
full_check_exit=80 no_status_exit=81 pacman_busy_exit=82

mkdir -p "$state_dir"
# The shell timer and a hand run can overlap; the second one has nothing to
# add, unless it was asked to --wait. It exits 75, not 0, so a caller can
# tell it from a check that ran. A check lasts at most ten minutes; a wait
# that outlasts that exits 75 too, as the widget's own wait does.
#
# A local refresh holds the same lock, so neither runs during the other, and
# .local.lock (fd 6) as well, taken first and let go last. A check that
# finds the check lock taken while .local.lock is held waits for the local
# refresh to end and tries once more: that refresh writes no check, so
# leaving the answer to it would drop the check until the next tick. It
# takes a second or so; the wait lasts as long as Main.qml lets one run,
# its deadline and the KILL after it. The local refresh itself never waits:
# behind a check or another local refresh it has nothing to add.
exec 9>"$state_dir/.check.lock"
if (( local_run )); then
  exec 6>"$state_dir/.local.lock"
  if ! flock -n 6 || ! flock -n 9; then
    echo "omabump-check: a check or another local refresh is running; no local refresh ran" >&2
    exit 75
  fi
elif (( wait_lock )); then
  flock -n 9 || { echo "Waiting for the running check to end..." >&2; flock -w 660 9; } \
    || { echo "omabump-check: the running check held the lock for over 11 min; no check ran" >&2; exit 75; }
elif ! flock -n 9; then
  # The check lock is tried again with the local one held, so no new local
  # refresh can take it in between.
  exec 6>"$state_dir/.local.lock"
  flock -w 130 6 || true
  if ! flock -n 9; then
    echo "omabump-check: another check is running and will write status.json; no check ran (--wait runs one after it)" >&2
    exit 75
  fi
  exec 6>&-
fi
# Muted rows (the panel's mutedApps setting) and rows at a version the user
# skipped (skippedVersions) never notify; status.json still says the truth
# about them, plus "muted" and "skipped". They and the notify and showMise
# settings are read under the lock, so a run that waited for it checks with
# the settings as they are when it starts: the widget counts on a check
# that took the lock after a change of Show mise tools to honour it.
load_quiet
[[ -n $notify ]] || if [[ $setting_notify == false ]]; then notify=0; else notify=1; fi
[[ -n $with_mise ]] || if [[ $setting_show_mise == false ]]; then with_mise=0; else with_mise=1; fi

# Only a check or a local refresh makes these, and only under the lock: any
# left over is from a run that was killed outright. .check.?????? and
# .notified.?????? are an older release's; the locks themselves,
# .check.lock and .local.lock, match none of them, and deleting one would
# let a second run take a new lock beside this one.
rm -rf -- "$state_dir"/.run.* "$state_dir"/.check.?????? "$state_dir"/.notified.?????? "$state_dir"/.status.* "$state_dir"/.state.*
# An Update makes these while it runs, without this lock, and an older
# release's check left them outside its run's dir. One more than a day old
# belongs to no live run.
find "$state_dir" "$cache_dir" -mindepth 1 -maxdepth 1 \( -name '.discovered.??????' -o -name '.mise.??????' \
  -o -name '.mise-select.??????' -o -name '.feed.??????' \) -mmin +1440 -exec rm -rf -- {} + 2>/dev/null || true
# A killed Update's half download (curl writes to it until it stops, within
# 30 minutes, and a new download starts it over) and sync-upstream's mktemp
# dir (it runs at most 15 minutes and removes its own). Only mktemp's names
# in scratch: a hook's file by another name may carry an archive's old time
# while a live run still reads it.
find "$cache_dir/packages" -mindepth 1 -maxdepth 1 -type f -name '*.part' -mmin +1440 -exec rm -f -- {} + 2>/dev/null || true
find "$cache_dir/scratch" -mindepth 1 -maxdepth 1 -name 'tmp.??????????' -mmin +1440 -exec rm -rf -- {} + 2>/dev/null || true

# The order of status.json's rows: desktop apps first, mise tools after
# them, each in table order, then Omabump itself.
# shellcheck disable=SC2016 # jq variables, not the shell's
jq_row_order='
  def row_order($order): sort_by([.source == "self", .source == "mise", (.pkg as $p | $order | index($p) // 1e9)]);'

# The clause the release-age hold (below) puts first in a row's note.
hold_clause_re='^omarchy-pkgs holds new releases for [0-9]+ h, Update from [^;]*(; |$)'

# Installed under another name (chatgpt-desktop, z-code-bin): Update
# replaces it when a newer version exists, Switch does it at the same one,
# so a row is switchable when it has no update and the installed version is
# not past the newest. $1 source, $2 installed name, $3 pkg, $4 installable,
# $5 update, $6 latest, $7 installed.
row_switchable() {
  [[ ($1 == omarchy || $1 == vendor-pkg) && $2 != "$3" && $4 == true && $5 != true && -n $6 ]] \
    && ! newer "$(upstream_part "$7")" "$6"
}

# The row of an app installed as its self-updating AppImage (installed_app
# names it by its path): its own updater replaces the file, so the row has
# no route, and its note says to open the app. $1 label, $2 the AppImage's
# version (empty when unknown), $3 the newest known. Sets update, unchecked
# and note. A release version (version_ok: no "-", and a digit first)
# compares with the feed's by vercmp as it is, since an AppImage has no
# pkgrel. A pre-release (0.1.1-nightly.20261019.1) is compared with
# nothing: a feed's version never has a "-", so it is a release of another
# channel, and vercmp would take the suffix for a pkgrel and call
# 0.1.1-nightly.x the same as 0.1.1. Nor is a version with a letter first
# (continuous, as some CI builds name theirs): vercmp ranks it below every
# numeric one, an update forever. Such a row, or one whose version is
# unknown, never claims an update and never reads as current (unchecked),
# and its note says why first.
appimage_row() {
  local label=$1 have=$2 latest=$3 why=""
  update=false unchecked=false
  if [[ -z $have ]]; then
    unchecked=true
    if command -v 7z >/dev/null; then why="Version unknown: 7z could not read it from the AppImage"
    else why="Version unknown: install 7zip to read it (sudo pacman -S --needed 7zip)"; fi
  elif [[ $have != [0-9]* ]]; then
    unchecked=true why="Not a release number, not compared with the feed's"
  elif ! version_ok "$have"; then
    unchecked=true why="Pre-release build, not compared with the feed's stable releases"
  elif [[ -n $latest ]] && newer "$latest" "$have"; then
    update=true
  fi
  note="${why:+$why; }Updates itself: open $label to update"
}

# --- a local refresh (--local) -------------------------------------------------
#
# Apps are updated outside Omabump: Omarchy's wrappers update mise CLIs on
# launch, and omarchy update runs pacman and mise up. Until the next check,
# a row can then offer an Update that is already installed, and a
# self-updating app's own updater moves it. This reads the installed
# versions again, from pacman, the apps' AppImages and Omabump's
# manifest.json (installed_app) and mise's inventory (mise ls, offline),
# after discovery has read Omarchy's menu (load_table), and nothing else:
# no feed, no omarchy-pkgs, no mise outdated, nothing on the network. It
# starts from the last check's status.json and keeps the rest of each row
# (the newest version, the route, notes, errors, muted, skipped), and
# writes the file once, with checkedAt and startedAt as that check left
# them: the widget counts the next check from those, and a local refresh
# must never put it off.
# inventoryAt says when the installed versions were last read, by a check
# or by this. It never notifies and never reads or writes notified.json.
# It exits:
#   0                  done
#   full_check_exit    something only a check can read changed; the rows say
#                      what is known until one runs (the widget starts it)
#   no_status_exit     no status.json of a finished check to start from;
#                      nothing written
#   pacman_busy_exit   pacman was in the middle of a transaction
#                      (pacman_busy) before, during or after the reads;
#                      nothing written, for a later try
# and 75 when a check or another local refresh held the lock (above).
local_refresh() {
  local previous need_full=0 changes=() at out app pkg source name installed prev row why
  # pacman's transaction first: every other answer may ask for a check,
  # which reads pacman with no such guard. So the mise rows wait too; the
  # next try, once the transaction is over, finds them as this one would
  # have.
  ! pacman_busy || local_pacman_busy
  previous=""
  [[ -s $status_file ]] && previous=$(<"$status_file")
  if ! jq -e 'type == "object" and .schemaVersion == 1 and .checking != true and (.apps | type == "array")
      and all(.apps[]; type == "object" and (.pkg | type == "string"))' >/dev/null 2>&1 <<<"$previous"; then
    echo "omabump-check: no status.json of a finished check to start from; a full check is needed" >&2
    exit "$no_status_exit"
  fi
  tmp=$(mktemp -d "$state_dir/.run.XXXXXX")
  run_tmp=$tmp
  # The check's lock goes before the local one: a check that waits for this
  # refresh to end then finds it free.
  trap 'rm -rf "$tmp"; exec 9>&- 6>&-' EXIT
  trap 'exit 143' TERM
  trap 'exit 130' INT
  trap 'exit 129' HUP
  printf '%s\n' "$previous" >"$tmp/previous.json"
  at=$(date -Iseconds)

  load_table
  order=$(jq -c 'map(.pkg)' <<<"$app_table")
  # The inventory alone, under a shorter limit than a check's, offline:
  # mise ls names the active versions without asking any backend.
  if (( with_mise )); then
    mise_timeout=30 mise_offline=1
    mise_load 0
    [[ -z $mise_inventory_error ]] || echo "omabump-check: $mise_inventory_error; the mise rows stay as they were" >&2
  fi

  # Discovery and mise ls can take a while, and a transaction that started
  # meanwhile would be read half way: pacman's lock is looked for again
  # right before its rows are read, and once more after them.
  ! pacman_busy || local_pacman_busy
  while IFS= read -r app; do
    pkg=$(jq -r '.pkg' <<<"$app")
    source=$(jq -r '.source' <<<"$app")
    # A mise tool mise could not list is never read as uninstalled.
    if [[ $source == mise ]]; then
      (( with_mise )) && [[ -z $mise_inventory_error ]] || continue
    fi
    prev=$(jq -c --arg pkg "$pkg" '[.apps[] | select(.pkg == $pkg)][0] // {}' <<<"$previous")
    if ! read -r _ name installed < <(installed_app "$app"); then
      # Gone, as a check drops a row that is no longer installed.
      [[ $prev == '{}' ]] || changes+=("$(jq -cn --arg pkg "$pkg" '{pkg: $pkg, _drop: true}')")
      continue
    fi
    name=$(clean_text "$name") installed=$(clean_text "$installed")
    if local_row; then changes+=("$row"); fi
    if [[ -n $why ]]; then
      echo "omabump-check: $why; a full check is needed" >&2
      need_full=1
    fi
  done < <(jq -c '.[]' <<<"$app_table"; echo "$self_app")
  ! pacman_busy || local_pacman_busy

  out=$(mktemp "$tmp/.status.XXXXXX")
  printf '%s\n' "${changes[@]}" | jq -s --slurpfile prevs "$tmp/previous.json" --argjson order "$order" \
    --arg inventory "$at" "$jq_row_order"'
    $prevs[0] as $prev
    | reduce .[] as $c ($prev.apps;
        if any(.[]; .pkg == $c.pkg) then map(if .pkg == $c.pkg then $c else . end) else . + [$c] end)
    | $prev + {inventoryAt: $inventory, apps: (map(select(._drop != true)) | row_order($order))}' >"$out"
  mv -f "$out" "$status_file"
  (( ! need_full )) || exit "$full_check_exit"
  exit 0
}

# pacman's lock file is there while a transaction runs, and pacman -Q may
# read the database half way through one: a package being replaced reads as
# uninstalled, its row would go, and the next run would bring it back as
# new and ask for a check it does not need. pacman_lock is where it looks.
pacman_lock=""
pacman_busy() {
  local db=""
  if [[ -z $pacman_lock ]]; then
    read -r db < <(pacman-conf DBPath 2>/dev/null </dev/null) || true
    db=${db:-/var/lib/pacman/}
    pacman_lock=${db%/}/db.lck
  fi
  [[ -e $pacman_lock ]]
}

# A local refresh that found pacman busy leaves with nothing written: what
# it read so far goes with its run's dir.
local_pacman_busy() {
  echo "omabump-check: pacman is running ($pacman_lock); nothing changed, a later try reads the installed versions" >&2
  exit "$pacman_busy_exit"
}

# The row of $app ($pkg, $source) now that it is installed as $name at
# $installed, from its last row $prev, by the rules a check applies to the
# versions it knows: sets row, and why when only a check can read the rest.
# Fails, row unset, when the row stays as it is.
local_row() {
  local p_source p_name p_installed p_latest p_from p_installable p_held p_unchecked p_self p_unread have update held=false
  local installable unhold=false switchable=false label muted blocked=false self=false unchecked note
  row="" why=""
  self_updating_name "$name" && self=true
  if [[ $prev == '{}' ]]; then
    # Installed since the last check: what it is, not yet what is newer.
    label=$(jq -r '.label // .pkg' <<<"$app")
    muted=$(jq --arg pkg "$pkg" 'index($pkg) != null' <<<"$muted_json")
    [[ $self == true || -z $(jq -r '.updateBlocked // ""' <<<"$app") ]] || blocked=true
    row=$(jq -cn --arg pkg "$pkg" --arg label "$(clean_text "$label")" --arg source "$source" \
      --arg installedName "$name" --arg installed "$installed" --argjson muted "$muted" --argjson blocked "$blocked" \
      --argjson selfUpdating "$self" \
      --arg icon "$(jq -r '.icon // ""' <<<"$app")" --arg iconLight "$(jq -r '.iconLight // ""' <<<"$app")" \
      '{pkg: $pkg, label: $label, source: $source, installedName: $installedName,
        installed: $installed, latest: "", versionFrom: "",
        updateAvailable: false, installable: false, error: "", note: "Not checked yet",
        stale: false, switchable: false, recipe: "", recipeCommit: "",
        request: "", muted: $muted, skipped: false, unchecked: true, held: false, omarchyUpdate: false, blocked: $blocked,
        selfUpdating: $selfUpdating, icon: $icon, iconLight: $iconLight}')
    why="$pkg${installed:+ $installed} is installed since the last check"
    return 0
  fi
  # p_unread: a row a local refresh wrote and no check has read since (new,
  # or moved between package and AppImage). For a self-updating app,
  # unchecked alone does not say so: its unknown or pre-release version is
  # unchecked too.
  IFS=$'\x1f' read -r p_source p_name p_installed p_latest p_from p_installable p_held p_unchecked p_self p_unread < <(jq -r '
    [.source // "", .installedName // "", .installed // "", .latest // "", .versionFrom // "",
     .installable == true, .held == true, .unchecked == true, .selfUpdating == true,
     (.unchecked == true and .note == "Not checked yet")] | map(tostring) | join("\u001f")' <<<"$prev")
  if [[ $p_source != "$source" ]]; then
    why="$pkg has another source in the app table"
    return 1
  fi
  [[ $name != "$p_name" || $installed != "$p_installed" ]] || return 1

  # From the package to the self-updating AppImage or back: the route, the
  # note and what counts as newer all change, and only a check reads them.
  # The newest version stays (the feed is the entry's, whatever is
  # installed); what only the other form had goes, as a new row has it: the
  # recipe, omarchy update's AUR route, and updateBlocked's mark, which an
  # app that updates itself never carries.
  if [[ $self != "$p_self" ]]; then
    [[ $self == true || -z $(jq -r '.updateBlocked // ""' <<<"$app") ]] || blocked=true
    row=$(jq -c --arg name "$name" --arg installed "$installed" --argjson self "$self" --argjson blocked "$blocked" '
      . + {installedName: $name, installed: $installed, selfUpdating: $self, updateAvailable: false, installable: false,
           switchable: false, held: false, skipped: false, unchecked: true, note: "Not checked yet",
           recipe: "", recipeCommit: "", omarchyUpdate: false, blocked: $blocked}' <<<"$prev")
    why="$pkg is installed as $name now"
    return 0
  fi
  if [[ $self == true ]]; then
    # No check has read the row yet: it stays unread at its new version, as
    # a package row does, and the check asked for reads the rest.
    if [[ $p_unread == true ]]; then
      row=$(jq -c --arg name "$name" --arg installed "$installed" '. + {installedName: $name, installed: $installed}' <<<"$prev")
      why="$pkg${installed:+ $installed} is not checked yet"
      return 0
    fi
    # Its version against the newest known, by the rules a check applies
    # (appimage_row): its own updater moved it.
    appimage_row "$(jq -r '.label // .pkg' <<<"$app")" "$installed" "$p_latest"
    # Past the newest version known: a release no check has seen, which only
    # a check can compare with the feed's newest. Unread until one does.
    if [[ $unchecked == false && -n $p_latest ]] && newer "$installed" "$p_latest"; then
      update=false unchecked=true note="Not checked yet"
      why="$pkg $installed is past the last known $p_latest"
    fi
    row=$(jq -c --arg name "$name" --arg installed "$installed" --argjson update "$update" --argjson unchecked "$unchecked" \
      --arg note "$(clean_text "$note")" '
      . + {installedName: $name, installed: $installed, updateAvailable: $update, unchecked: $unchecked, note: $note}
      | if $update then . else .skipped = false end' <<<"$prev")
    [[ $name == "$p_name" ]] || why="$pkg is installed as $name now"
    return 0
  fi

  if [[ $source == mise ]]; then
    # mise's answer about a newer version holds only for the version it was
    # asked about. At the newest one known, the row is current, and a check
    # reads whether the request still holds it.
    if [[ $name == "$p_name" && -n $p_latest && $installed == "$p_latest" ]]; then
      row=$(jq -c --arg installed "$installed" '. + {installed: $installed, updateAvailable: false, skipped: false}' <<<"$prev")
      why="$pkg reached $installed"
    else
      row=$(jq -c --arg name "$name" --arg installed "$installed" --argjson keyed "$([[ $name == "$p_name" ]] && echo false || echo true)" '
        . + {installedName: $name, installed: $installed, updateAvailable: false, skipped: false,
             installable: false, unchecked: true, note: "Not checked yet"}
        | if $keyed then . + {latest: "", versionFrom: "", request: ""} else . end' <<<"$prev")
      why="$pkg is $name $installed now"
    fi
    return 0
  fi

  # A feed knows only upstream's version, as in the check.
  have=$installed
  [[ $p_from != feed ]] || have=$(upstream_part "$installed")
  update=false
  if [[ -n $p_latest ]] && newer "$p_latest" "$have"; then update=true; fi
  # A hold is on a release not installed yet; once it is, the row is the
  # check's again: Update (the hold came only after it) and its note.
  installable=$p_installable
  if [[ $update == false && $p_held == true ]]; then installable=true unhold=true; fi
  [[ $update == true ]] && held=$p_held
  row_switchable "$source" "$name" "$pkg" "$installable" "$update" "$p_latest" "$installed" && switchable=true
  row=$(jq -c --arg name "$name" --arg installed "$installed" --argjson update "$update" --argjson held "$held" \
    --argjson installable "$installable" --argjson switchable "$switchable" --argjson unhold "$unhold" --arg re "$hold_clause_re" '
    . + {installedName: $name, installed: $installed, updateAvailable: $update, held: $held,
         installable: $installable, switchable: $switchable}
    | if $update then . else .skipped = false end
    | if $unhold then .note = (.note | strings // "" | sub($re; "")) else . end' <<<"$prev")
  if [[ -n $p_latest ]] && newer "$have" "$p_latest"; then
    # A release no check has seen, as for an AppImage above. What the check
    # knew about the route (installable, omarchy update's AUR route) stays:
    # a check that finds the omarchy-pkgs clone busy keeps it from here.
    row=$(jq -c '. + {updateAvailable: false, switchable: false, skipped: false, unchecked: true, note: "Not checked yet"}' <<<"$row")
    why="$pkg $installed is past the last known $p_latest"
  elif [[ $name != "$p_name" ]]; then
    why="$pkg is installed as $name now"
  elif [[ $p_unchecked == true ]]; then
    why="$pkg $installed is not checked yet"
  fi
  return 0
}
(( ! local_run )) || local_refresh

# Last run's results, used only when they have the shape this script writes.
previous='{"apps":[]}'
[[ -s $status_file ]] && jq -e 'type == "object" and (.apps | type == "array")
  and all(.apps[]; type == "object" and (.pkg | type == "string"))' "$status_file" >/dev/null 2>&1 \
  && previous=$(<"$status_file")
# A status.json from an older release has no schemaVersion. Its notes may
# start with the switch clause, which the panel now writes from the row's
# fields, and its skipped mise rows may lack "unchecked". Those rows show
# while this run checks, so this brings them to the current shape first.
previous=$(jq -c 'if has("schemaVersion") then . else .apps |= map(
    .note = (.note | strings // "" | sub("^Installed as [^\\s,]+, (Update switches|switch) to [^\\s;]+(; |$)"; ""))
    | .unchecked = (.unchecked == true or (.note | startswith("Update check skipped")))) end' <<<"$previous")
notified='{}'
[[ -s $notified_file ]] && jq -e 'type == "object"' "$notified_file" >/dev/null 2>&1 && notified=$(<"$notified_file")

pkgs_state=""
pkgs_commit=$(jq -r '.omarchyPkgs.commit // ""' <<<"$previous")
pkgs_error="" pkgs_note="" mise_note="" discovery_note=""
started=$(date -Iseconds)
rows=() order='[]' status_done=0
# Every scratch file of the run, the helpers' included (run_tmp), is in
# $tmp, which the EXIT trap removes however the run ends.
tmp=$(mktemp -d "$state_dir/.run.XXXXXX")
run_tmp=$tmp
cleanup() {
  local rc=$?
  (( status_done )) || write_status 2 "The check stopped early (exit $rc)" || true
  rm -rf "$tmp"
}
trap cleanup EXIT
# Without these, a run stopped by Ctrl-C or a closed terminal would reach
# the EXIT trap with the status of the last command, often 0.
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP
# write_status reads the previous run from a file (--slurpfile), so a large
# status.json never becomes a command-line argument.
printf '%s\n' "$previous" >"$tmp/previous.json"
missing_line=$(missing_tools_line)

# The clone is fetched on first need, so a machine without any Omarchy-packaged
# app never fetches it. The check only reads it: no checkout, nothing run. The
# lock is held for the fetch alone; recipes are then read with git show from
# the object store, which an install's checkout and build do not touch. An
# install holds the lock for its whole build; a check that finds it taken
# keeps what it knew about the install route instead of waiting.
pkgs_busy_note="The omarchy-pkgs clone is busy with an update, showing the last result"
pkgs_ready() {
  if [[ -z $pkgs_state ]]; then
    if ! pkgs_take_lock 0; then
      pkgs_state=busy
      pkgs_note=$pkgs_busy_note
    else
      if pkgs_commit=$(pkgs_fetch 2>"$tmp/git.err"); then
        pkgs_state=ready pkgs_base=$pkgs_commit
      else
        pkgs_state=failed
        pkgs_error="Could not fetch omarchy-pkgs: $(tail -1 "$tmp/git.err")"
      fi
      pkgs_drop_lock
    fi
  fi
  [[ $pkgs_state == ready ]]
}

# What the recipe at recipe_rev (recipe_source) says about the omarchy row
# of $1: sets note, installable and hold from its watch and release-age
# window, recipe and recipe_commit from its PKGBUILD. Nothing is set and it
# fails, with the reason on stderr, when the blob-less clone could not read
# a file the recipe has: a failed check, never a missing recipe or watch.
recipe_read() {
  local pkg=$1 blocker age=0 text rc=0
  blocker=$(recipe_blocker "$recipe_rev" "$pkg") || return 1
  if [[ -z $blocker ]]; then age=$(recipe_release_age "$recipe_rev" "$pkg") || return 1; fi
  text=$(recipe_file "$recipe_rev" "$pkg" PKGBUILD) || rc=$?
  (( rc < 2 )) || return 1
  read -r _ recipe < <(recipe_version <<<"$text" 2>/dev/null) || recipe=""
  [[ $recipe_rev == "$pkgs_base" ]] || recipe_commit=$recipe_rev
  if [[ -n $blocker ]]; then
    note=$blocker
  else
    installable=true note=$recipe_note hold=$age
  fi
}

# One table for the whole run: discovery and the merge happen once.
load_table
table=$app_table
# Shown in the panel: without discovery, only the curated mise rows remain.
(( with_mise )) && [[ -n $discovery_error ]] && discovery_note=$(clean_text "${discovery_error:0:200}")
order=$(jq -c 'map(.pkg)' <<<"$table")

# Replaces status.json in one rename. $1 is 0 while checking, 1 for the final
# write, 2 when the run dies half way, with $2 saying how: that text is
# runError, "" on every other write, so every copy of the widget (and a run
# from a terminal) sees a failed run, not only the one whose process exited
# non-zero. startedAt lets the panel treat a run that was killed while
# "checking" as stale. Until the final write, rows not checked yet keep
# their previous entry, flagged "checking": true while the run lasts, so the
# panel shows progress row by row; the check time stays the old one.
# inventoryAt, when the installed versions were last read, is the run's
# start once it is done, and stays the last one's until then.
# schemaVersion names the file's shape. Version 1: no switch clause in a
# row's note, and "unchecked" on every row; inventoryAt and a row's
# selfUpdating came later, fields a reader may find missing.
write_status() {
  local final=$1 run_error=${2:-} out at
  at=$(jq -r '.checkedAt // ""' <<<"$previous")
  (( final == 1 )) && at=$(date -Iseconds)
  out=$(mktemp "$tmp/.status.XXXXXX")
  printf '%s\n' "${rows[@]}" | jq -s --slurpfile prevs "$tmp/previous.json" --argjson order "$order" \
    --argjson final "$final" --arg at "$at" --arg started "$started" \
    --arg commit "$pkgs_commit" --arg perr "$(clean_text "$pkgs_error")" --arg pnote "$(clean_text "$pkgs_note")" \
    --argjson following "$pkgs_follow" --arg derr "$discovery_note" --arg merr "$mise_note" \
    --arg rerr "$(clean_text "$run_error")" "$jq_row_order"'
    $prevs[0] as $prev
    | (map(.pkg)) as $done
    | (if $final == 1 then .
       else . + [$prev.apps[] | select(.pkg as $p | $done | index($p) | not) | .checking = ($final == 0)] end)
    | row_order($order)
    | {schemaVersion: 1, checkedAt: $at, checking: ($final == 0), startedAt: $started,
       inventoryAt: (if $final == 1 then $started else ($prev.inventoryAt | strings) // "" end), runError: $rerr,
       omarchyPkgs: {commit: $commit, following: ($following == 1), error: $perr, note: $pnote},
       discoveryError: $derr, miseError: $merr, apps: .}' >"$out"
  mv -f "$out" "$status_file"
}

# Each announcement is saved as soon as it is sent, so a run that dies later
# does not announce it again.
save_notified() { save_json "$notified" "$notified_file"; }

write_status 0
# Loaded here, in this shell, so every row reads the same answers.
(( with_mise )) && mise_load 1
# Without mise's inventory no mise row can be read: the last run's rows stay,
# as an earlier check's, failed, and the panel says why.
if (( with_mise )) && [[ -n $mise_inventory_error ]]; then
  mise_note=$(clean_text "${mise_inventory_error:0:200}")
  while IFS= read -r row; do rows+=("$row"); done < <(jq -c --arg e "$mise_note" '.apps[] | select(.source == "mise")
    | del(.checking) | .stale = true | .installable = false | .error = $e' <<<"$previous")
fi
now=$(date +%s)
while IFS= read -r app; do
  pkg=$(jq -r '.pkg' <<<"$app")
  label=$(jq -r '.label // .pkg' <<<"$app")
  [[ $with_mise == 0 && $(jq -r '.source' <<<"$app") == mise ]] && continue
  read -r source installed_name installed < <(installed_app "$app") || continue

  prev=$(jq -c --arg pkg "$pkg" '[.apps[] | select(.pkg == $pkg)][0] // {}' <<<"$previous")
  latest="" from="" note="" installable=false stale=false
  route_error="" feed_error="" recipe="" recipe_commit="" mise_update=false request="" unchecked=false
  hold=0 held=false omarchy_update=false self_updating=false

  # Installed as its self-updating AppImage: no route of its source applies,
  # and nothing of omarchy-pkgs is read for it. appimage_row words the row
  # once the newest version is known.
  route=$source
  if self_updating_name "$installed_name"; then self_updating=true route=self-updating; fi
  case $route in
    self-updating) ;;
    mise)
      mise_row "$installed_name" "$installed" ;;
    vendor-pkg)
      if ! command -v sudo >/dev/null || ! command -v curl >/dev/null; then
        note="Missing: sudo or curl; sudo pacman -S --needed base-devel curl"
      elif ! vendor_pkg_url "$app" x >/dev/null; then
        note="No https vendor package for $(uname -m)"
      elif ! vendor_checksum_declared "$app"; then
        note="No published checksum for the vendor package"
      else
        installable=true
      fi ;;
    self)
      # omarchy update does not update plugins; omarchy plugin update does,
      # for a git clone.
      if self_git_managed; then installable=true
      else note="Local checkout, update it with git"; fi ;;
    indicator)
      # omarchy update runs yay -Sua, which updates every foreign
      # package: an AUR row installed that way needs nothing from here.
      note="No supported install path"
      if [[ $(jq -r '.feed.type // ""' <<<"$app") == aur-rpc ]]; then
        if pacman -Qqm -- "$installed_name" >/dev/null 2>&1; then
          omarchy_update=true note="Updates with omarchy update (AUR)"
        else
          note+=", version from AUR"
        fi
      fi ;;
    omarchy)
      # Installable means bin/sync-upstream could move the recipe: it exists
      # at the pinned omarchy-pkgs commit (or the app's recipeCommit) and has
      # a watch or hook.
      recipe_rc=0
      if pkgs_ready; then
        recipe_source "$pkg" "$app" 2>"$tmp/err" || recipe_rc=$?
        if (( recipe_rc == 0 )); then
          recipe_read "$pkg" 2>"$tmp/err" || route_error=$(<"$tmp/err")
        elif (( recipe_rc != 75 )); then
          route_error=$(<"$tmp/err")
        fi
      fi
      if [[ $pkgs_state == busy ]] || (( recipe_rc == 75 )); then
        installable=$(jq '.installable == true' <<<"$prev")
        held=$(jq '.held == true' <<<"$prev")
        note=$pkgs_busy_note
      elif [[ $pkgs_state != ready ]]; then
        route_error=$pkgs_error
      fi
      if [[ -n $missing_line ]]; then
        installable=false
        note="$missing_line${note:+; $note}"
      fi ;;
    *)
      route_error="unknown source '$source'" ;;
  esac
  # apps.json can turn Omabump's Update off for a row (updateBlocked says
  # why): a known problem in what Update would install. The versions still
  # show and still notify; only the route is closed, and Ask agent with it.
  # An app that updates itself has no Update to turn off.
  blocked=$(jq -r '.updateBlocked // ""' <<<"$app")
  if [[ -n $blocked && $source != self && $self_updating == false ]]; then
    installable=false
    note="Update off: $blocked${note:+; $note}"
  else
    blocked=""
  fi
  is_blocked=false
  [[ -z $blocked ]] || is_blocked=true

  # Everything but mise reads its newest version from the feed in apps.json.
  if [[ $source != mise ]]; then
    if latest=$(feed_version "$app" 2>"$tmp/err"); then
      from=feed
    else
      latest="" feed_error=$(<"$tmp/err")
    fi
  fi

  # Keep the last known version so a flaky feed neither hides a pending
  # update nor re-announces it once the feed comes back.
  if [[ -n $feed_error ]]; then
    latest=$(jq -r '.latest // ""' <<<"$prev")
    from=$(jq -r '.versionFrom // ""' <<<"$prev")
    stale=true
    # A mise row's update is mise's answer, not a comparison: keep the last
    # one while the installed version has not moved.
    if [[ $source == mise && $(jq -r '.installed // ""' <<<"$prev") == "$installed" ]]; then
      mise_update=$(jq '.updateAvailable == true' <<<"$prev")
    fi
  fi
  error=$(printf '%s\n' "$route_error" "$feed_error" | sed '/^$/d' | paste -sd';' - | sed 's/;/; /g')
  error=$(clean_text "$error")
  error=${error:0:240}

  # A feed knows only upstream's version, so it is compared with the
  # installed one less epoch and pkgrel. The installer compares full versions.
  update=$mise_update
  if [[ $self_updating == true ]]; then
    appimage_row "$label" "$installed" "$latest"
  elif [[ -n $latest && $source != mise ]]; then
    have=$installed
    [[ $from == feed ]] && have=$(upstream_part "$installed")
    newer "$latest" "$have" && update=true
  fi

  # The recipe holds a release for its min_release_age (openclaw and
  # voxtype-bin: 24 h), and Update could not reach it before then. Until the
  # window has passed the row has no Update and does not notify. Once the
  # release is installed, a local refresh takes the clause off again
  # (hold_clause_re).
  if [[ $update == true && $installable == true ]] && (( hold > 0 )); then
    hold_until=$(( $(seen_since "$pkg" "$latest" "$now") + hold ))
    if (( now < hold_until )); then
      held=true installable=false
      note="omarchy-pkgs holds new releases for $(( (hold + 3599) / 3600 )) h, Update from $(date -d "@$hold_until" '+%b %-d %H:%M')${note:+; $note}"
    fi
  fi

  # The panel words a switch from installedName, updateAvailable and
  # switchable, so the note holds only the rest.
  switchable=false
  row_switchable "$source" "$installed_name" "$pkg" "$installable" "$update" "$latest" "$installed" && switchable=true

  muted=$(jq --arg pkg "$pkg" 'index($pkg) != null' <<<"$muted_json")
  skipped=false
  row_skipped "$source" "$update" "$latest" "$(jq -r --arg pkg "$pkg" '.[$pkg] // ""' <<<"$skipped_json")" && skipped=true
  quiet=false
  [[ $muted == true || $skipped == true ]] && quiet=true

  announced=$(jq -r --arg pkg "$pkg" '.[$pkg] // ""' <<<"$notified")
  action=""
  (( notify )) && [[ $held == false ]] && action=$(announce_action "$source" "$update" "$error" "$quiet" "$latest" "$announced")
  if [[ $action == record ]]; then
    notified=$(jq -c --arg pkg "$pkg" --arg v "$latest" '.[$pkg] = $v' <<<"$notified")
    save_notified
  elif [[ $action == send ]]; then
    body="Installed: $installed. Open the Omabump panel to update."
    [[ $installable == true ]] || body="Installed: $installed. ${note^}."
    [[ $self_updating == false ]] || body="Installed: $installed. $label updates itself: open it to update."
    if notify-send -a Omabump "$(clean_text "$label $latest available")" "$(clean_text "$body")" 2>/dev/null; then
      notified=$(jq -c --arg pkg "$pkg" --arg v "$latest" '.[$pkg] = $v' <<<"$notified")
      save_notified
    fi
  fi

  # Every string from a feed, mise, pacman or apps.json goes through
  # clean_text on its way into status.json.
  rows+=("$(jq -cn --arg pkg "$pkg" --arg label "$(clean_text "$label")" --arg source "$source" \
    --arg installedName "$(clean_text "$installed_name")" --arg installed "$(clean_text "$installed")" \
    --arg latest "$(clean_text "$latest")" --arg versionFrom "$from" --argjson update "$update" \
    --argjson installable "$installable" --arg error "$error" --arg note "$(clean_text "$note")" \
    --argjson stale "$stale" --argjson switchable "$switchable" --arg recipe "$(clean_text "$recipe")" --arg recipeCommit "$recipe_commit" \
    --arg request "$(clean_text "$request")" --argjson muted "$muted" --argjson skipped "$skipped" --argjson unchecked "$unchecked" --argjson held "$held" --argjson omarchyUpdate "$omarchy_update" --argjson blocked "$is_blocked" \
    --argjson selfUpdating "$self_updating" \
    --arg icon "$(jq -r '.icon // ""' <<<"$app")" --arg iconLight "$(jq -r '.iconLight // ""' <<<"$app")" \
    '{pkg: $pkg, label: $label, source: $source, installedName: $installedName,
      installed: $installed, latest: $latest, versionFrom: $versionFrom,
      updateAvailable: $update, installable: $installable, error: $error, note: $note,
      stale: $stale, switchable: $switchable, recipe: $recipe, recipeCommit: $recipeCommit,
      request: $request, muted: $muted, skipped: $skipped, unchecked: $unchecked, held: $held, omarchyUpdate: $omarchyUpdate, blocked: $blocked,
      selfUpdating: $selfUpdating, icon: $icon, iconLight: $iconLight}')")
  write_status 0
done < <(jq -c '.[]' <<<"$table"; echo "$self_app")

write_status 1
status_done=1
