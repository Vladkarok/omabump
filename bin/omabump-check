#!/bin/bash
# Compare each installed agent app with the newest version it could be updated
# to and record the result for the bar panel. Never installs anything.
#
#   omarchy     the feed in apps.json gives the vendor's newest version; the
#               recipe at the omarchy-pkgs commit pinned in pins.json is only
#               read (PKGBUILD and .omarchy/ as text, with git show) to see
#               whether bin/sync-upstream could move it. Nothing fetched is run: sync-upstream runs only in
#               omabump-install, after the user pressed Update.
#   vendor-pkg  the feed in apps.json; the vendor publishes the package.
#   indicator   the feed in apps.json; no install path.
#   mise        `mise outdated`: what `mise up` would reach under the
#               configured request, and what lies outside it (a pin).
#
#   omabump-check [--no-notify] [--no-mise] [--wait]
#
# --wait runs after a check already in progress instead of leaving it to
# that one: the installer's refresh needs a check that starts after its
# install, since the running one may have read the old version.
#
# Exit 75: no check ran. Without --wait another check held the lock, and
# that one writes status.json; with --wait, it held the lock past the wait.
#
# Muted rows and skipped versions come from the widget's settings in
# Omarchy's shell.json (load_quiet), whoever runs the check. So do the
# notify and showMise settings when no flag says otherwise: the shell passes
# --no-notify and --no-mise when they are off, and a run from a terminal,
# the installer's refresh or an agent passes none and still honours them.
#
# The shell runs it under `timeout -k 10 600` (Main.qml), so a hung feed or
# tool cannot keep a check alive past ten minutes. The shell never passes
# --wait: it waits for the lock itself, before that deadline starts, since a
# long wait under it would end in the deadline's kill instead of exit 75. The
# TERM trap below still writes status.json as a failed run, with runError
# saying so. Every command under its own `timeout` runs through
# run_killable, so the trap is not held until that command ends.
set -euo pipefail
# shellcheck source=omabump-common
source "$(dirname "$(readlink -f "$0")")/omabump-common"

usage="usage: omabump-check [--no-notify] [--no-mise] [--wait]"
notify="" with_mise="" wait_lock=0
while (( $# )); do
  case $1 in
    --no-notify) notify=0 ;;
    --no-mise) with_mise=0 ;;
    --wait) wait_lock=1 ;;
    *) echo "$usage" >&2; exit 2 ;;
  esac
  shift
done
# Muted rows (the panel's mutedApps setting) and rows at a version the user
# skipped (skippedVersions) never notify; status.json still says the truth
# about them, plus "muted" and "skipped".
load_quiet
[[ -n $notify ]] || if [[ $setting_notify == false ]]; then notify=0; else notify=1; fi
[[ -n $with_mise ]] || if [[ $setting_show_mise == false ]]; then with_mise=0; else with_mise=1; fi

mkdir -p "$state_dir"
# The shell timer and a hand run can overlap; the second one has nothing to
# add, unless it was asked to --wait. It exits 75, not 0, so a caller can
# tell it from a check that ran. A check lasts at most ten minutes; a wait
# that outlasts that exits 75 too, as the widget's own wait does.
exec 9>"$state_dir/.check.lock"
if (( wait_lock )); then
  flock -n 9 || { echo "Waiting for the running check to end..." >&2; flock -w 660 9; } \
    || { echo "omabump-check: the running check held the lock for over 11 min; no check ran" >&2; exit 75; }
elif ! flock -n 9; then
  echo "omabump-check: another check is running and will write status.json; no check ran (--wait runs one after it)" >&2
  exit 75
fi
# Only a check makes these, and only under the lock: any left over is from
# a run that was killed outright. .check.?????? and .notified.?????? are an
# older release's; the lock itself, .check.lock, matches none of them, and
# deleting it would let a second check take a new lock beside this one.
rm -rf -- "$state_dir"/.run.* "$state_dir"/.check.?????? "$state_dir"/.notified.?????? "$state_dir"/.status.* "$state_dir"/.state.*
# An Update makes these while it runs, without this lock, and an older
# release's check left them outside its run's dir. One more than a day old
# belongs to no live run.
find "$state_dir" "$cache_dir" -mindepth 1 -maxdepth 1 \( -name '.discovered.??????' -o -name '.mise.??????' \
  -o -name '.mise-select.??????' -o -name '.feed.??????' \) -mmin +1440 -exec rm -rf -- {} + 2>/dev/null || true
# A killed Update's half download (curl writes to it until it stops, within
# 30 minutes, and a new download starts it over) and sync-upstream's mktemp
# dir (it runs at most 15 minutes and removes its own). Only mktemp's names
# in scratch: a hook's file by another name may carry an archive's old time
# while a live run still reads it.
find "$cache_dir/packages" -mindepth 1 -maxdepth 1 -type f -name '*.part' -mmin +1440 -exec rm -f -- {} + 2>/dev/null || true
find "$cache_dir/scratch" -mindepth 1 -maxdepth 1 -name 'tmp.??????????' -mmin +1440 -exec rm -rf -- {} + 2>/dev/null || true

# Last run's results, used only when they have the shape this script writes.
previous='{"apps":[]}'
[[ -s $status_file ]] && jq -e 'type == "object" and (.apps | type == "array")
  and all(.apps[]; type == "object" and (.pkg | type == "string"))' "$status_file" >/dev/null 2>&1 \
  && previous=$(<"$status_file")
# A status.json from an older release has no schemaVersion. Its notes may
# start with the switch clause, which the panel now writes from the row's
# fields, and its skipped mise rows may lack "unchecked". Those rows show
# while this run checks, so this brings them to the current shape first.
previous=$(jq -c 'if has("schemaVersion") then . else .apps |= map(
    .note = (.note | strings // "" | sub("^Installed as [^\\s,]+, (Update switches|switch) to [^\\s;]+(; |$)"; ""))
    | .unchecked = (.unchecked == true or (.note | startswith("Update check skipped")))) end' <<<"$previous")
notified='{}'
[[ -s $notified_file ]] && jq -e 'type == "object"' "$notified_file" >/dev/null 2>&1 && notified=$(<"$notified_file")

pkgs_state=""
pkgs_commit=$(jq -r '.omarchyPkgs.commit // ""' <<<"$previous")
pkgs_error="" pkgs_note="" mise_note="" discovery_note=""
started=$(date -Iseconds)
rows=() order='[]' status_done=0
# Every scratch file of the run, the helpers' included (run_tmp), is in
# $tmp, which the EXIT trap removes however the run ends.
tmp=$(mktemp -d "$state_dir/.run.XXXXXX")
run_tmp=$tmp
cleanup() {
  local rc=$?
  (( status_done )) || write_status 2 "The check stopped early (exit $rc)" || true
  rm -rf "$tmp"
}
trap cleanup EXIT
# Without these, a run stopped by Ctrl-C or a closed terminal would reach
# the EXIT trap with the status of the last command, often 0.
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP
# write_status reads the previous run from a file (--slurpfile), so a large
# status.json never becomes a command-line argument.
printf '%s\n' "$previous" >"$tmp/previous.json"
missing_line=$(missing_tools_line)

# The clone is fetched on first need, so a machine without any Omarchy-packaged
# app never fetches it. The check only reads it: no checkout, nothing run. The
# lock is held for the fetch alone; recipes are then read with git show from
# the object store, which an install's checkout and build do not touch. An
# install holds the lock for its whole build; a check that finds it taken
# keeps what it knew about the install route instead of waiting.
pkgs_busy_note="The omarchy-pkgs clone is busy with an update, showing the last result"
pkgs_ready() {
  if [[ -z $pkgs_state ]]; then
    if ! pkgs_take_lock 0; then
      pkgs_state=busy
      pkgs_note=$pkgs_busy_note
    else
      if pkgs_commit=$(pkgs_fetch 2>"$tmp/git.err"); then
        pkgs_state=ready pkgs_base=$pkgs_commit
      else
        pkgs_state=failed
        pkgs_error="Could not fetch omarchy-pkgs: $(tail -1 "$tmp/git.err")"
      fi
      pkgs_drop_lock
    fi
  fi
  [[ $pkgs_state == ready ]]
}

# What the recipe at recipe_rev (recipe_source) says about the omarchy row
# of $1: sets note, installable and hold from its watch and release-age
# window, recipe and recipe_commit from its PKGBUILD. Nothing is set and it
# fails, with the reason on stderr, when the blob-less clone could not read
# a file the recipe has: a failed check, never a missing recipe or watch.
recipe_read() {
  local pkg=$1 blocker age=0 text rc=0
  blocker=$(recipe_blocker "$recipe_rev" "$pkg") || return 1
  if [[ -z $blocker ]]; then age=$(recipe_release_age "$recipe_rev" "$pkg") || return 1; fi
  text=$(recipe_file "$recipe_rev" "$pkg" PKGBUILD) || rc=$?
  (( rc < 2 )) || return 1
  read -r _ recipe < <(recipe_version <<<"$text" 2>/dev/null) || recipe=""
  [[ $recipe_rev == "$pkgs_base" ]] || recipe_commit=$recipe_rev
  if [[ -n $blocker ]]; then
    note=$blocker
  else
    installable=true note=$recipe_note hold=$age
  fi
}

# One table for the whole run: discovery and the merge happen once.
load_table
table=$app_table
# Shown in the panel: without discovery, only the curated mise rows remain.
(( with_mise )) && [[ -n $discovery_error ]] && discovery_note=$(clean_text "${discovery_error:0:200}")
order=$(jq -c 'map(.pkg)' <<<"$table")

# Replaces status.json in one rename. $1 is 0 while checking, 1 for the final
# write, 2 when the run dies half way, with $2 saying how: that text is
# runError, "" on every other write, so every copy of the widget (and a run
# from a terminal) sees a failed run, not only the one whose process exited
# non-zero. startedAt lets the panel treat a run that was killed while
# "checking" as stale. Until the final write, rows not checked yet keep
# their previous entry, flagged "checking": true while the run lasts, so the
# panel shows progress row by row; the check time stays the old one.
# schemaVersion names the file's shape. Version 1: no switch clause in a
# row's note, and "unchecked" on every row.
write_status() {
  local final=$1 run_error=${2:-} out at
  at=$(jq -r '.checkedAt // ""' <<<"$previous")
  (( final == 1 )) && at=$(date -Iseconds)
  out=$(mktemp "$tmp/.status.XXXXXX")
  # Desktop apps first, mise tools after them, each in table order, then
  # Omabump itself.
  printf '%s\n' "${rows[@]}" | jq -s --slurpfile prevs "$tmp/previous.json" --argjson order "$order" \
    --argjson final "$final" --arg at "$at" --arg started "$started" \
    --arg commit "$pkgs_commit" --arg perr "$(clean_text "$pkgs_error")" --arg pnote "$(clean_text "$pkgs_note")" \
    --argjson following "$pkgs_follow" --arg derr "$discovery_note" --arg merr "$mise_note" \
    --arg rerr "$(clean_text "$run_error")" '
    $prevs[0] as $prev
    | (map(.pkg)) as $done
    | (if $final == 1 then .
       else . + [$prev.apps[] | select(.pkg as $p | $done | index($p) | not) | .checking = ($final == 0)] end)
    | sort_by([.source == "self", .source == "mise", (.pkg as $p | $order | index($p) // 1e9)])
    | {schemaVersion: 1, checkedAt: $at, checking: ($final == 0), startedAt: $started, runError: $rerr,
       omarchyPkgs: {commit: $commit, following: ($following == 1), error: $perr, note: $pnote},
       discoveryError: $derr, miseError: $merr, apps: .}' >"$out"
  mv -f "$out" "$status_file"
}

# Each announcement is saved as soon as it is sent, so a run that dies later
# does not announce it again.
save_notified() { save_json "$notified" "$notified_file"; }

write_status 0
# Loaded here, in this shell, so every row reads the same answers.
(( with_mise )) && mise_load 1
# Without mise's inventory no mise row can be read: the last run's rows stay,
# as an earlier check's, failed, and the panel says why.
if (( with_mise )) && [[ -n $mise_inventory_error ]]; then
  mise_note=$(clean_text "${mise_inventory_error:0:200}")
  while IFS= read -r row; do rows+=("$row"); done < <(jq -c --arg e "$mise_note" '.apps[] | select(.source == "mise")
    | del(.checking) | .stale = true | .installable = false | .error = $e' <<<"$previous")
fi
now=$(date +%s)
while IFS= read -r app; do
  pkg=$(jq -r '.pkg' <<<"$app")
  label=$(jq -r '.label // .pkg' <<<"$app")
  [[ $with_mise == 0 && $(jq -r '.source' <<<"$app") == mise ]] && continue
  read -r source installed_name installed < <(installed_app "$app") || continue

  prev=$(jq -c --arg pkg "$pkg" '[.apps[] | select(.pkg == $pkg)][0] // {}' <<<"$previous")
  latest="" from="" note="" installable=false stale=false
  route_error="" feed_error="" recipe="" recipe_commit="" mise_update=false request="" unchecked=false
  hold=0 held=false omarchy_update=false

  case $source in
    mise)
      mise_row "$installed_name" "$installed" ;;
    vendor-pkg)
      if ! command -v sudo >/dev/null || ! command -v curl >/dev/null; then
        note="Missing: sudo or curl; sudo pacman -S --needed base-devel curl"
      elif ! vendor_pkg_url "$app" x >/dev/null; then
        note="No https vendor package for $(uname -m)"
      elif ! vendor_checksum_declared "$app"; then
        note="No published checksum for the vendor package"
      else
        installable=true
      fi ;;
    self)
      # omarchy update does not update plugins; omarchy plugin update does,
      # for a git clone.
      if self_git_managed; then installable=true
      else note="Local checkout, update it with git"; fi ;;
    indicator)
      # omarchy update runs yay -Sua, which updates every foreign
      # package: an AUR row installed that way needs nothing from here.
      note="No supported install path"
      if [[ $(jq -r '.feed.type // ""' <<<"$app") == aur-rpc ]]; then
        if pacman -Qqm -- "$installed_name" >/dev/null 2>&1; then
          omarchy_update=true note="Updates with omarchy update (AUR)"
        else
          note+=", version from AUR"
        fi
      fi ;;
    omarchy)
      # Installable means bin/sync-upstream could move the recipe: it exists
      # at the pinned omarchy-pkgs commit (or the app's recipeCommit) and has
      # a watch or hook.
      recipe_rc=0
      if pkgs_ready; then
        recipe_source "$pkg" "$app" 2>"$tmp/err" || recipe_rc=$?
        if (( recipe_rc == 0 )); then
          recipe_read "$pkg" 2>"$tmp/err" || route_error=$(<"$tmp/err")
        elif (( recipe_rc != 75 )); then
          route_error=$(<"$tmp/err")
        fi
      fi
      if [[ $pkgs_state == busy ]] || (( recipe_rc == 75 )); then
        installable=$(jq '.installable == true' <<<"$prev")
        held=$(jq '.held == true' <<<"$prev")
        note=$pkgs_busy_note
      elif [[ $pkgs_state != ready ]]; then
        route_error=$pkgs_error
      fi
      if [[ -n $missing_line ]]; then
        installable=false
        note="$missing_line${note:+; $note}"
      fi ;;
    *)
      route_error="unknown source '$source'" ;;
  esac

  # Everything but mise reads its newest version from the feed in apps.json.
  if [[ $source != mise ]]; then
    if latest=$(feed_version "$app" 2>"$tmp/err"); then
      from=feed
    else
      latest="" feed_error=$(<"$tmp/err")
    fi
  fi

  # Keep the last known version so a flaky feed neither hides a pending
  # update nor re-announces it once the feed comes back.
  if [[ -n $feed_error ]]; then
    latest=$(jq -r '.latest // ""' <<<"$prev")
    from=$(jq -r '.versionFrom // ""' <<<"$prev")
    stale=true
    # A mise row's update is mise's answer, not a comparison: keep the last
    # one while the installed version has not moved.
    if [[ $source == mise && $(jq -r '.installed // ""' <<<"$prev") == "$installed" ]]; then
      mise_update=$(jq '.updateAvailable == true' <<<"$prev")
    fi
  fi
  error=$(printf '%s\n' "$route_error" "$feed_error" | sed '/^$/d' | paste -sd';' - | sed 's/;/; /g')
  error=$(clean_text "$error")
  error=${error:0:240}

  # A feed knows only upstream's version, so it is compared with the
  # installed one less epoch and pkgrel. The installer compares full versions.
  update=$mise_update
  if [[ -n $latest && $source != mise ]]; then
    have=$installed
    [[ $from == feed ]] && have=$(upstream_part "$installed")
    newer "$latest" "$have" && update=true
  fi

  # The recipe holds a release for its min_release_age (openclaw and
  # voxtype-bin: 24 h), and Update could not reach it before then. Until the
  # window has passed the row has no Update and does not notify.
  if [[ $update == true && $installable == true ]] && (( hold > 0 )); then
    hold_until=$(( $(seen_since "$pkg" "$latest" "$now") + hold ))
    if (( now < hold_until )); then
      held=true installable=false
      note="omarchy-pkgs holds new releases for $(( (hold + 3599) / 3600 )) h, Update from $(date -d "@$hold_until" '+%b %-d %H:%M')${note:+; $note}"
    fi
  fi

  # Installed under another name (chatgpt-desktop, z-code-bin): Update
  # replaces it when a newer version exists, Switch does it at the same one.
  # The panel words this from installedName, updateAvailable and
  # switchable, so the note holds only the rest.
  switchable=false
  if [[ ($source == omarchy || $source == vendor-pkg) && $installed_name != "$pkg" && $installable == true
        && $update != true && -n $latest ]] && ! newer "$(upstream_part "$installed")" "$latest"; then
    switchable=true
  fi

  muted=$(jq --arg pkg "$pkg" 'index($pkg) != null' <<<"$muted_json")
  skipped=false
  row_skipped "$source" "$update" "$latest" "$(jq -r --arg pkg "$pkg" '.[$pkg] // ""' <<<"$skipped_json")" && skipped=true
  quiet=false
  [[ $muted == true || $skipped == true ]] && quiet=true

  announced=$(jq -r --arg pkg "$pkg" '.[$pkg] // ""' <<<"$notified")
  action=""
  (( notify )) && [[ $held == false ]] && action=$(announce_action "$source" "$update" "$error" "$quiet" "$latest" "$announced")
  if [[ $action == record ]]; then
    notified=$(jq -c --arg pkg "$pkg" --arg v "$latest" '.[$pkg] = $v' <<<"$notified")
    save_notified
  elif [[ $action == send ]]; then
    body="Installed: $installed. Open the Omabump panel to update."
    [[ $installable == true ]] || body="Installed: $installed. ${note^}."
    if notify-send -a Omabump "$(clean_text "$label $latest available")" "$(clean_text "$body")" 2>/dev/null; then
      notified=$(jq -c --arg pkg "$pkg" --arg v "$latest" '.[$pkg] = $v' <<<"$notified")
      save_notified
    fi
  fi

  # Every string from a feed, mise, pacman or apps.json goes through
  # clean_text on its way into status.json.
  rows+=("$(jq -cn --arg pkg "$pkg" --arg label "$(clean_text "$label")" --arg source "$source" \
    --arg installedName "$(clean_text "$installed_name")" --arg installed "$(clean_text "$installed")" \
    --arg latest "$(clean_text "$latest")" --arg versionFrom "$from" --argjson update "$update" \
    --argjson installable "$installable" --arg error "$error" --arg note "$(clean_text "$note")" \
    --argjson stale "$stale" --argjson switchable "$switchable" --arg recipe "$(clean_text "$recipe")" --arg recipeCommit "$recipe_commit" \
    --arg request "$(clean_text "$request")" --argjson muted "$muted" --argjson skipped "$skipped" --argjson unchecked "$unchecked" --argjson held "$held" --argjson omarchyUpdate "$omarchy_update" \
    --arg icon "$(jq -r '.icon // ""' <<<"$app")" --arg iconLight "$(jq -r '.iconLight // ""' <<<"$app")" \
    '{pkg: $pkg, label: $label, source: $source, installedName: $installedName,
      installed: $installed, latest: $latest, versionFrom: $versionFrom,
      updateAvailable: $update, installable: $installable, error: $error, note: $note,
      stale: $stale, switchable: $switchable, recipe: $recipe, recipeCommit: $recipeCommit,
      request: $request, muted: $muted, skipped: $skipped, unchecked: $unchecked, held: $held, omarchyUpdate: $omarchyUpdate,
      icon: $icon, iconLight: $iconLight}')")
  write_status 0
done < <(jq -c '.[]' <<<"$table"; echo "$self_app")

write_status 1
status_done=1
