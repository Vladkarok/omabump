user_apps=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/omabump/apps.json
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/plugins/io.github.vladkarok.omabump
status_file=$state_dir/status.json
notified_file=$state_dir/notified.json
# When a check first saw each release an omarchy-pkgs recipe still holds.
seen_file=$state_dir/seen.json

# Scratch files of one run go under $run_tmp when the script set it:
# omabump-check does, inside $state_dir, and removes it on every exit, so a
# file a helper made is not left behind when the run dies or a subshell is
# killed between mktemp and rm. Otherwise they go next to what they are for.
run_tmp=""

# Replaces the state file $2 with the JSON $1 in one rename.
save_json() {
  local out
  out=$(mktemp "${run_tmp:-$state_dir}/.state.XXXXXX")
  if jq . <<<"$1" >"$out" && mv -f "$out" "$2"; then return 0; fi
  rm -f "$out"
  return 1
}
cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/omabump
pkgs_dir=$cache_dir/omarchy-pkgs
