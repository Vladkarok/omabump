# Sourced by omabump-check and omabump-install; not run on its own.
# shellcheck shell=bash
# The paths and state variables below are read by the scripts that source
# this file, which shellcheck cannot see from here:
# shellcheck disable=SC2034

# One locale for every script: ${var:0:N} counts characters, and regexes,
# sorting and tool output (pacman -Qi fields) do not depend on the user's.
if locale -a 2>/dev/null | grep -qix 'c\.utf-\?8'; then
  export LC_ALL=C.UTF-8
else
  export LC_ALL=C
fi

# The lock files sit on fds 7 (one update per app), 8 (the omarchy-pkgs
# clone) and 9 (one check at a time). A child that inherited one would hold
# the lock after this process ends, so git, mise, sync-upstream, makepkg,
# sudo and command feeds run without them; the parent keeps its locks.
run_unlocked() { "$@" 7>&- 8>&- 9>&-; }

plugin_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
shipped_apps=$plugin_dir/apps.json
user_apps=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/omabump/apps.json
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/plugins/io.github.vladkarok.omabump
status_file=$state_dir/status.json
notified_file=$state_dir/notified.json
cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/omabump
pkgs_dir=$cache_dir/omarchy-pkgs
pkgs_url=https://github.com/omacom/omarchy-pkgs.git
pkgs_lock=$cache_dir/omarchy-pkgs.lock
shipped_pins=$plugin_dir/pins.json
user_pins=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/omabump/pins.json

# Omabump's own row ("self:omabump"): the installed version is this copy's
# manifest.json, the newest one the GitHub release. `omarchy plugin update`
# can update it only when the plugin directory is a git clone of its own,
# as `omarchy plugin add` leaves it; a symlink or a copy without .git is a
# developer checkout.
self_pkg=self:omabump
self_plugin_id=io.github.vladkarok.omabump
plugins_dir=$HOME/.config/omarchy/plugins
self_app='{"pkg": "self:omabump", "label": "Omabump", "source": "self", "feed": {"type": "github-release", "repo": "vladkarok/omabump"}}'
self_version() { jq -r '.version // ""' "$plugin_dir/manifest.json" 2>/dev/null; }
self_git_managed() {
  local dir=$plugins_dir/$self_plugin_id
  [[ ! -L $dir && -d $dir/.git ]] || return 1
  [[ $(cd "$dir" && pwd -P) == "$(cd "$plugin_dir" && pwd -P)" ]]
}

# Names that reach pacman, file names, git and mise. A package name as Arch
# allows it, never starting with a dot or dash; an app id is that or, for a
# mise row, "mise:<name>"; a mise tool may also carry a backend prefix and a
# scope (npm:@scope/name); a git ref sits under refs/. None may hold "..".
pkg_name_ok() { [[ $1 =~ ^[a-z0-9@_+][a-z0-9@._+-]*$ ]]; }
app_id_ok() { pkg_name_ok "$1" || { [[ $1 == mise:* ]] && pkg_name_ok "${1#mise:}"; } || [[ $1 == "$self_pkg" ]]; }
tool_name_ok() { [[ $1 =~ ^[A-Za-z0-9@_+:][A-Za-z0-9@._+:/-]*$ && $1 != *..* ]]; }
ref_ok() { [[ $1 =~ ^refs/[A-Za-z0-9._/-]+$ && $1 != *..* ]]; }
# The same rules as jq definitions, for apps_table.
jq_name_rules='
  def pkg_ok: type == "string" and test("^[a-z0-9@_+][a-z0-9@._+-]*$");
  def id_ok: pkg_ok or (type == "string" and startswith("mise:") and (.[5:] | pkg_ok));
  def tool_ok: type == "string" and test("^[A-Za-z0-9@_+:][A-Za-z0-9@._+:/-]*$") and (contains("..") | not);
  def entry_ok: (.pkg | id_ok) and ((.pkg | pkg_ok) or .source == "mise")
    and ((.installed // []) | type == "array" and all(.[]; pkg_ok))
    and ([.tool // empty] | flatten | all(.[]; tool_ok));'

# The rows the user muted in the panel (widget setting mutedApps), passed
# as --muted pkg1,pkg2. Prints the valid ids, one per line; an id
# app_id_ok refuses is dropped with a line on stderr.
parse_muted() {
  local id ids=()
  IFS=, read -ra ids <<<"$1"
  for id in "${ids[@]}"; do
    [[ -n $id ]] || continue
    if app_id_ok "$id"; then echo "$id"; else echo "ignoring muted id '$id'" >&2; fi
  done
}

# A version as mise or a feed prints it, for a skipped version: what
# version_ok allows plus "-" (mise versions such as 1.0.0-beta.1).
skip_version_ok() { [[ ${#1} -le 64 && $1 =~ ^[0-9A-Za-z][A-Za-z0-9._+~-]*$ && $1 != *..* ]]; }

# The versions the user skipped in the panel (widget setting
# skippedVersions), passed as --skipped pkg=version,... Prints them as a JSON
# object; an entry with a bad id or version is dropped with a line on stderr.
parse_skipped() {
  local entry entries=() pkg ver out='{}'
  IFS=, read -ra entries <<<"$1"
  for entry in "${entries[@]}"; do
    [[ -n $entry ]] || continue
    pkg=${entry%%=*} ver=${entry#*=}
    if [[ $entry == *=* ]] && app_id_ok "$pkg" && skip_version_ok "$ver"; then
      out=$(jq -c --arg p "$pkg" --arg v "$ver" '.[$p] = $v' <<<"$out")
    else
      echo "ignoring skipped entry '$entry'" >&2
    fi
  done
  echo "$out"
}

# True when a row's update is the version the user skipped, or older: mise
# versions must match exactly (mise compares them, not vercmp), the others
# compare with vercmp. A newer release than the skipped one lights the row
# up again. $1 source, $2 update (true/false), $3 latest, $4 skipped version.
row_skipped() {
  [[ $2 == true && -n $4 && -n $3 ]] || return 1
  if [[ $1 == mise ]]; then [[ $3 == "$4" ]]; else ! newer "$3" "$4"; fi
}

# What to do about a row's newer version once per version: "send" a
# notification, "record" it as announced without one (a quiet row: muted, or
# at a skipped version; undoing either does not announce it late), or
# nothing (no update, a failed check, or already announced). $1 update
# (true/false), $2 error text, $3 quiet (true/false), $4 latest, $5 the
# version last announced.
announce_action() {
  [[ $1 == true && -z $2 ]] || return 0
  [[ -z $5 ]] || newer "$4" "$5" || return 0
  if [[ $3 == true ]]; then echo record; else echo send; fi
}

# The omarchy-pkgs commit every recipe read, sync and build starts from:
# pins.json's 40-hex commit, with the user's pins.json merged over it. The
# install path runs that repo's sync tool and hook scripts, so a moving
# branch is never the default. "omarchyPkgs": {"follow": "master"} in the
# user's file opts in to origin/master; pkgs_fetch then resolves it to a
# commit. Sets pkgs_base (empty when the pin is unusable), pkgs_follow and
# pkgs_pin_ref; pkgs_pin_error says why a pin is unusable.
pkgs_base="" pkgs_follow=0 pkgs_pin_ref="" pkgs_pin_error=""
pkgs_pin() {
  local user=/dev/null pins follow
  if [[ -f $user_pins ]]; then
    if jq -se 'length == 1 and (.[0] | type == "object")' "$user_pins" >/dev/null 2>&1; then
      user=$user_pins
    else
      echo "ignoring $user_pins: not a JSON object" >&2
    fi
  fi
  # The user's file goes in with --slurpfile, never as an argv string.
  pins=$(jq -c --slurpfile user "$user" '. * ($user[0] // {}) | .omarchyPkgs // {}' "$shipped_pins" 2>/dev/null) || pins='{}'
  follow=$(jq -r '.follow // ""' <<<"$pins")
  if [[ $follow == master ]]; then
    pkgs_follow=1 pkgs_pin_ref=refs/heads/master
    return 0
  fi
  [[ -z $follow ]] || { pkgs_pin_error="omarchyPkgs.follow '$follow' is not \"master\""; return 0; }
  pkgs_base=$(jq -r '.commit // ""' <<<"$pins")
  pkgs_pin_ref=$(jq -r '.ref // "refs/heads/master"' <<<"$pins")
  if ! ref_ok "$pkgs_pin_ref"; then
    pkgs_pin_error="the omarchy-pkgs pin ref '$pkgs_pin_ref' is not a refs/ name"
    pkgs_base="" pkgs_pin_ref=""
    return 0
  fi
  if [[ ! $pkgs_base =~ ^[0-9a-f]{40}$ ]]; then
    pkgs_pin_error="the omarchy-pkgs pin '$pkgs_base' is not a 40-hex commit"
    pkgs_base=""
  fi
}
pkgs_pin

# The coding-agent CLIs Omarchy offers (bin/omabump-discover: its menu and
# omarchy-mise-install wrappers, read as text). Sets discovered_json, an
# array of {command, label, key, source}, and discovery_error, empty when
# discovery worked. Never fatal: the curated rows stay either way.
discovered_json='[]' discovery_error=""
discover_run() { run_unlocked timeout -k 5 20 python3 "$plugin_dir/bin/omabump-discover" </dev/null 2>/dev/null; }
discover_agents() {
  local out
  discovered_json='[]' discovery_error=""
  command -v python3 >/dev/null || { discovery_error="python3 is missing"; return 0; }
  if ! out=$(discover_run) || ! jq -e 'type == "object" and (.agents | type == "array") and (.errors | type == "array")' >/dev/null 2>&1 <<<"$out"; then
    discovery_error="bin/omabump-discover failed"
    return 0
  fi
  discovered_json=$(jq -c '[.agents[] | select(type == "object" and (.command | type == "string")
    and (.key | type == "string") and (.label | type == "string"))]' <<<"$out")
  discovery_error=$(jq -r '.errors | map(tostring) | join("; ")' <<<"$out")
}

# The app table: the shipped one, with the user's file merged over it by pkg,
# then the discovered agents. A user entry adds an app or overrides fields of
# a shipped one; "disabled": true hides it. Shipped order comes first, user
# additions after, new discovered rows last. An entry whose feed the user's
# file set carries "_userFeed": true (never taken from either file), which
# feed_version requires for a command feed. An entry whose pkg, installed
# names or tool names break the rules above is dropped with a line on stderr.
#
# A discovered agent joins the mise entry whose "command" is its command,
# else the one whose tool list holds its key, else the entry "mise:<command>";
# its key goes first in that entry's tool list. With no such entry it becomes
# the row "mise:<command>" with the menu's label. A disabled entry stays
# hidden (discovery never brings it back), a tool list the user's file sets
# is left as the user wrote it, and pkg stays the row's identity throughout.
# Reads discovered_json; load_table runs discovery first.
apps_table() {
  local user=/dev/null merged
  if [[ -f $user_apps ]]; then
    if jq -se 'length == 1 and (.[0] | type == "array")' "$user_apps" >/dev/null 2>&1; then
      user=$user_apps
    else
      echo "ignoring $user_apps: not a JSON array" >&2
    fi
  fi
  # The user's file goes in with --slurpfile, never as an argv string.
  merged=$(jq -c --slurpfile user "$user" --argjson disc "${discovered_json:-[]}" '
    ($user[0] // [] | map(select(type == "object"))) as $u
    | [$u[] | select(has("tool")) | .pkg] as $userTool
    | map(select(type == "object") | del(._userFeed))
    + ($u | map(del(._userFeed) | if has("feed") then ._userFeed = true else . end))
    | map(select(.pkg | type == "string"))
    | reduce .[] as $a ({order: [], by: {}};
      if .by[$a.pkg] then .by[$a.pkg] += $a
      else .order += [$a.pkg] | .by[$a.pkg] = $a end)
    | reduce $disc[] as $d (.;
      [.order[] as $p | .by[$p] | select(.source == "mise")] as $mise
      | ("mise:" + $d.command) as $own
      | ([$mise[] | select(.command == $d.command)][0]
         // [$mise[] | select([.tool // empty] | flatten | index($d.key))][0]
         // .by[$own]) as $hit
      | if $hit == null then
          .order += [$own]
          | .by[$own] = {pkg: $own, label: $d.label, source: "mise", command: $d.command, tool: [$d.key], discovered: true}
        elif $hit.disabled == true or $hit.source != "mise" or ($userTool | index($hit.pkg)) then .
        else .by[$hit.pkg].tool = ([$d.key] + ([$hit.tool // empty] | flatten | map(select(. != $d.key))))
        end)
    | [.order[] as $p | .by[$p] | select(.disabled != true)]' "$shipped_apps") || return 1
  jq -r "$jq_name_rules"' .[] | select(entry_ok | not)
    | "ignoring app \(.pkg | tojson): a pkg, installed or tool name with characters Omabump does not accept"' <<<"$merged" >&2
  jq -c "$jq_name_rules"' map(select(entry_ok))' <<<"$merged"
}

# The table every step of one run works on: discovery and the merge happen
# once, here, so the check, mise_load and app_json agree. Call it in the
# script's own shell (not in a subshell, the values would be lost there).
app_table=""
load_table() {
  discover_agents
  app_table=$(apps_table) || app_table='[]'
}

# An app by its pkg, or else by one of its installed package or mise tool
# names, so `omabump-install z-code-bin` finds ZCode.
app_json() {
  [[ -n $app_table ]] || load_table
  jq -ce --arg n "$1" '
    ([.[] | select(.pkg == $n)] + [.[] | select(((.installed // []) + ([.tool // empty] | flatten)) | index($n))])[0]
    // error("no app")' <<<"$app_table" 2>/dev/null
}

# Text bound for status.json and notifications, made inert: control
# characters dropped and < > & replaced, since a tooltip may render rich text
# and notify-send bodies are markup.
clean_text() { printf '%s' "$1" | tr -d '\000-\037\177' | sed 's/</‹/g; s/>/›/g; s/&/＆/g'; }

# Text printed in the terminal for the user to read before pacman (install
# scripts, the recipe diff), made unable to drive the terminal: ESC shown as
# ^[, C1 controls (UTF-8 encoded) as ?, other C0 controls but tab and
# newline dropped. UTF-8 text stays readable.
term_safe() { LC_ALL=C sed 's/\x1b/^[/g; s/\xc2[\x80-\x9f]/?/g' | LC_ALL=C tr -d '\000-\010\013-\037\177'; }

# vercmp is the only comparator: pacman, makepkg and omarchy-pkgs all use it.
newer() { (( $(vercmp "$1" "$2") > 0 )); }

# The upstream part of a pacman version: no epoch, no pkgrel.
upstream_part() { local v=${1#*:}; echo "${v%-*}"; }

# An upstream version as a feed gives it: what Arch allows in pkgver, starting
# with a letter or digit, no ".." anywhere (so never a "." or ".." path
# component in a {version} URL) and at most 64 characters. Versions end up in
# sed expressions, URLs and file names, so anything else is a feed error.
# Feed versions never carry an epoch; full_version_ok takes pacman's.
version_ok() { [[ ${#1} -le 64 && $1 =~ ^[0-9A-Za-z][A-Za-z0-9._+~]*$ && $1 != *..* ]]; }

# A full pacman version: [epoch:]pkgver-pkgrel, pkgver as version_ok has it.
full_version_ok() {
  local v=$1 rel
  if [[ $v == *:* ]]; then
    [[ ${v%%:*} =~ ^[0-9]{1,9}$ ]] || return 1
    v=${v#*:}
  fi
  [[ $v == *-* ]] || return 1
  rel=${v##*-}
  [[ $rel =~ ^[0-9]+(\.[0-9]+)?$ ]] && version_ok "${v%-*}"
}

# Prints "<name> <full version>" for the first of the given names pacman has
# installed. Only exact names count: a provide could be an unrelated package.
installed_package() {
  local name line
  for name in "$@"; do
    [[ -n $name ]] || continue
    line=$(pacman -Q -- "$name" 2>/dev/null) || continue
    [[ ${line%% *} == "$name" ]] || continue
    echo "$line"
    return 0
  done
  return 1
}

# mise answers depend on the config files of the current directory, so every
# mise call runs in $HOME, in the check and the installer alike.
mise_run() { (cd "$HOME" && run_unlocked env MISE_HIDE_UPDATE_WARNING=1 timeout -k 10 "${mise_timeout:-120}" mise "$@" </dev/null); }

# mise_load fills these once, in the calling shell (never call it in a
# subshell, the values would be lost there):
#   mise_ls_json        `mise ls --json`, the inventory
#   mise_safe_json      {key: backend} for the installed tools that resolve
#                       through a backend in mise_safe_backends, from
#                       `mise ls --json --backend <b>` (which classifies
#                       registry shorthands by the backend they resolve to)
# and with $1=1, for the key each mise row selected (mise_select) that is
# also safe:
#   mise_outdated_json  `mise outdated --json`: what `mise up` reaches under
#                       the configured request and release-age cooldown
#   mise_bump_json      `mise outdated --bump --json`: newer releases outside
#                       the request
# All keyed by tool name. mise versions are kept as mise prints them and
# never compared with vercmp: mise decides. Resolving a version can run a
# backend's own scripts (asdf and vfox plugins), so outdated is asked about
# the selected keys on mise's own backends only, never about every tool; a
# row on another backend shows its installed version and "Update check
# skipped". Each outdated call fails on its own: mise_error and
# mise_bump_error say why.
mise_safe_backends=(aqua github gitlab forgejo npm http ubi cargo go pipx gem core)
mise_ls_json='{}' mise_safe_json='{}' mise_outdated_json='{}' mise_bump_json='{}'
mise_error="" mise_bump_error="" mise_backend_error="" mise_query=()

# The first line of a mise error, colours and warnings dropped.
mise_err_line() { sed 's/\x1b\[[0-9;]*m//g' "$1" | grep -v 'WARN' | grep -v '^[[:space:]]*$' | head -1; }

mise_inventory() {
  mise_ls_json=$(mise_run ls --json 2>/dev/null | jq -ce 'if type == "object" then . else {} end' 2>/dev/null) || mise_ls_json='{}'
}

# A backend whose `mise ls --backend` call fails adds nothing to the safe set
# (its tools are then not checked) and a line to mise_backend_error.
mise_safe_keys() {
  local b out safe='{}'
  mise_backend_error=""
  for b in "${mise_safe_backends[@]}"; do
    if out=$(mise_run ls --json --backend "$b" 2>/dev/null) \
       && out=$(jq -ce 'if type == "object" then keys else error("bad") end' <<<"$out" 2>/dev/null); then
      safe=$(jq -c --arg b "$b" --argjson k "$out" '. + ($k | map({(.): $b}) | add // {})' <<<"$safe")
    else
      mise_backend_error+="${mise_backend_error:+; }mise ls --backend $b failed"
    fi
  done
  mise_safe_json=$safe
}

# The key each mise row of the frozen table resolves to (its first tool
# name mise has installed and active, as mise_active picks it) that is on a
# safe backend, unique: the only names the outdated calls see.
mise_select() {
  mapfile -t mise_query < <(jq -r --argjson ls "$mise_ls_json" --argjson safe "$mise_safe_json" '
    [.[] | select(.source == "mise") | [.tool // empty] | flatten
     | map(select(type == "string" and any(($ls[.] // [])[]; .active == true and .installed != false)))[0] // empty
     | select($safe[.] != null)] | unique | .[]' <<<"$app_table")
}

mise_load() {
  local out err
  command -v mise >/dev/null || return 0
  mise_inventory
  (( ${1:-0} )) || return 0
  mise_safe_keys
  mise_select
  (( ${#mise_query[@]} )) || return 0
  mkdir -p "$cache_dir"
  err=$(mktemp "$cache_dir/.mise.XXXXXX")
  if out=$(mise_run outdated --json -- "${mise_query[@]}" 2>"$err") && out=$(jq -ce 'if type == "object" then . else error("bad") end' <<<"$out" 2>/dev/null); then
    mise_outdated_json=$out
  else
    mise_error="mise outdated failed: $(mise_err_line "$err")"
  fi
  if out=$(mise_run outdated --bump --json -- "${mise_query[@]}" 2>"$err") && out=$(jq -ce 'if type == "object" then . else error("bad") end' <<<"$out" 2>/dev/null); then
    mise_bump_json=$out
  else
    mise_bump_error="mise outdated --bump failed: $(mise_err_line "$err")"
  fi
  rm -f "$err"
}

# True when mise_safe_keys found the key on one of mise's own backends.
mise_key_safe() { jq -e --arg k "$1" 'has($k)' <<<"$mise_safe_json" >/dev/null 2>&1; }

# Why a key is not checked, for the row: its explicit backend, else that it
# resolves to none of the allowed ones.
mise_skip_note() {
  if [[ -n $mise_backend_error ]]; then echo "Update check skipped: $mise_backend_error"
  elif [[ $1 == *:* ]]; then echo "Update check skipped: ${1%%:*} backend"
  else echo "Update check skipped: not on a backend Omabump queries"; fi
}

# A field of a tool's entry in one of the outdated tables, or nothing.
mise_field() { jq -r --arg t "$2" --arg f "$3" '.[$t][$f] // empty | tostring' <<<"$1"; }

# What the check shows for a mise row whose active key is $1 at version $2.
# mise decides: an entry in `mise outdated` is a version `mise up` will
# install; one only in the --bump table lies outside the request. Sets
# latest, from, note, installable, mise_update, request and feed_error.
mise_row() {
  local key=$1 have=$2
  latest="" from=mise note="" installable=true mise_update=false request="" feed_error=""
  if ! mise_key_safe "$key"; then
    installable=false from=""
    note=$(mise_skip_note "$key")
  elif [[ -n $mise_error ]]; then
    feed_error=$mise_error
  elif latest=$(mise_field "$mise_outdated_json" "$key" latest) && [[ -n $latest ]]; then
    mise_update=true
  elif [[ -n $mise_bump_error ]]; then
    feed_error=$mise_bump_error
  else
    latest=$(mise_field "$mise_bump_json" "$key" bump)
    [[ -n $latest ]] || latest=$(mise_field "$mise_bump_json" "$key" latest)
    if [[ -n $latest && $latest != "$have" ]]; then
      installable=false
      request=$(mise_field "$mise_bump_json" "$key" requested)
      if [[ $request == latest ]]; then note="Held back by your mise settings, $latest exists"
      else note="Pinned to $request, $latest exists"; fi
    else
      latest=$have
    fi
  fi
}

# Prints "<tool> <active version>" for the first of the app's tool names that
# mise has installed and active. The key is whatever the user's mise config
# uses, e.g. claude or npm:@anthropic-ai/claude-code.
mise_active() {
  jq -re --argjson tools "$(jq -c '[.tool // empty] | flatten' <<<"$1")" '
    . as $ls | [$tools[] as $t | ($ls[$t] // [])[] | select(.active == true and .installed != false)
      | "\($t) \(.version)"][0] // empty' <<<"$mise_ls_json"
}

# Prints "<source> <installed name> <version>" for an app, or fails when it is
# not installed.
installed_app() {
  local app=$1 source line names
  source=$(jq -r '.source // ""' <<<"$app")
  if [[ $source == mise ]]; then
    line=$(mise_active "$app") || return 1
  elif [[ $source == self ]]; then
    line=$(self_version)
    version_ok "$line" || return 1
    line="omabump $line"
  else
    mapfile -t names < <(jq -r '(.installed // [.pkg])[]' <<<"$app")
    line=$(installed_package "${names[@]}") || return 1
  fi
  echo "$source $line"
}

# A value that may be given per architecture: a string, or an object keyed by
# `uname -m`. Prints nothing when this machine's architecture is missing.
per_arch() {
  jq -r --arg arch "$(uname -m)" "($1) as \$v | if (\$v | type) == \"object\" then \$v[\$arch] // \"\" else \$v // \"\" end" <<<"$2"
}

# Every download: HTTPS only, redirects included, and bounded in time and
# size. $max_time and $max_size override the 30 s and 8 MB defaults for the
# vendor package itself.
fetch() {
  curl --proto =https --proto-redir =https --connect-timeout 15 --max-time "${max_time:-30}" \
    --max-filesize "${max_size:-8M}" "$@"
}

# The vendor package URL for this machine's architecture with {version}
# filled in, or nothing when the vendor builds none for it.
vendor_pkg_url() {
  local url
  url=$(per_arch .vendorPkg "$1")
  [[ $url == https://* ]] || return 1
  echo "${url//\{version\}/$2}"
}

# Prints "<algorithm> <hex digest>" for the vendor package at URL $2,
# version $3, from the source the app's "checksum" names, or fails with the
# reason. $4 is the feed document feed_version saved.
#   "feed"                      files[].sha512 (base64) next to the file's url
#                               in the feed, as electron-updater's latest.yml
#                               and Z.ai's manifest list them
#   {"url": ..., "algo": ...}   a sha256sum/sha512sum style list at that HTTPS
#                               URL ({version} and per-arch keys allowed)
# Without a "checksum" the package is not installed.
# True when apps.json names a checksum source the installer understands.
vendor_checksum_declared() {
  jq -e '.checksum | (type == "string" and . == "feed") or (type == "object" and has("url"))' <<<"$1" >/dev/null 2>&1
}

vendor_checksum() {
  local app=$1 url=$2 version=$3 feed_file=$4 name kind b64 hex algo sums_url body
  name=${url##*/}
  kind=$(jq -r '.checksum | if type == "string" then . elif type == "object" then "@list" else "" end' <<<"$app")
  case $kind in
    feed)
      algo=sha512
      # The exact url wins; the fallback is an entry whose url is the bare
      # file name, as electron-updater's latest.yml lists files.
      b64=$(awk -v url="$url" -v name="$name" '
        /^[[:space:]]*-[[:space:]]+url:/ { u = $NF; next }
        /^[[:space:]]+sha512:/ && u != "" { if (u == url) { exact = $2; exit } if (u == name && byname == "") byname = $2; u = "" }
        END { if (exact != "") print exact; else if (byname != "") print byname }' "$feed_file")
      [[ $b64 =~ ^[A-Za-z0-9+/]+=*$ ]] || { echo "the feed lists no sha512 for $name" >&2; return 1; }
      hex=$(base64 -d <<<"$b64" 2>/dev/null | od -An -v -tx1 | tr -d ' \n') ;;
    @list)
      algo=$(jq -r '.checksum.algo // "sha256"' <<<"$app")
      [[ $algo == sha256 || $algo == sha512 ]] || { echo "checksum algo '$algo' is not sha256 or sha512" >&2; return 1; }
      sums_url=$(per_arch .checksum.url "$app")
      sums_url=${sums_url//\{version\}/$version}
      [[ $sums_url == https://* ]] || { echo "no https checksum url for $(uname -m)" >&2; return 1; }
      body=$(fetch -fsSL "$sums_url" 2>/dev/null) || { echo "could not fetch $sums_url (curl exit $?)" >&2; return 1; }
      hex=$(awk -v name="$name" '{ f = $2; sub(/^\*/, "", f) } f == name { print tolower($1); exit }' <<<"$body") ;;
    "")
      echo "apps.json names no checksum source for the vendor package" >&2; return 1 ;;
    *)
      echo "unknown checksum source '$kind'" >&2; return 1 ;;
  esac
  [[ $algo == sha256 && $hex =~ ^[0-9a-f]{64}$ || $algo == sha512 && $hex =~ ^[0-9a-f]{128}$ ]] \
    || { echo "no well-formed $algo for $name" >&2; return 1; }
  echo "$algo $hex"
}

# Newest version in a Debian Packages index for one exact package name. Each
# version must pass version_ok before vercmp sees it, and only the first 500
# matching stanzas count: every comparison is a vercmp process, and a real
# index lists a few dozen releases of one package.
apt_newest() {
  local index=$1 want=$2 v best=""
  while read -r v; do
    version_ok "$v" || continue
    if [[ -z $best ]] || newer "$v" "$best"; then best=$v; fi
  done < <(awk -v want="$want" -v max=500 '
    { sub(/\r$/, "") }
    /^Package:/ { p = $2 }
    /^Version:/ { v = $2 }
    /^$/        { if (p == want && v != "") { print v; if (++n >= max) { done = 1; exit } } p = v = "" }
    END         { if (!done && p == want && v != "") print v }' <<<"$index")
  [[ -n $best ]] && echo "$best"
}

# First capture group of a Python regex over a page. Pages that embed JSON in
# a JS string escape its quotes, so the pattern is also tried with \" as ".
regex_first() {
  python3 -c '
import re, sys
body = sys.stdin.read()
for text in (body, body.replace("\\\"", "\"")):
    m = re.search(sys.argv[1], text)
    if m:
        print(m.group(1))
        break
' "$1"
}

# The first line a "command" feed prints. Such a feed is local code, not
# data: it is accepted only from the user's own apps.json (feed_version's
# other types never run anything), and the shipped table never runs one in
# the background.
user_command_version() {
  local cmd body
  jq -e '._userFeed == true' >/dev/null 2>&1 <<<"$1" \
    || { echo "command feeds are allowed only from ~/.config/omarchy/omabump/apps.json" >&2; return 1; }
  cmd=$(jq -r '.feed.command // ""' <<<"$1")
  body=$(run_unlocked timeout -k 10 60 bash -c "$cmd" </dev/null) || { echo "feed command failed" >&2; return 1; }
  head -1 <<<"$body"
}

# Prints the newest version the app's own feed advertises. Feeds are data:
# nothing fetched is ever run (a command feed is the user's own code, see
# user_command_version). Every fetch is checked on its own: a failed or
# cut-off download is an error, never a version. With $feed_save set, the
# fetched document is also written to that file (vendor_checksum reads it).
feed_version() {
  local app=$1 type url body v repo want
  type=$(jq -r '.feed.type // ""' <<<"$app")
  url=$(per_arch .feed.url "$app")
  case $type in
    apt-index|zcode-manifest|latest-yml|regex|json)
      [[ $url == https://* ]] || { echo "no https feed url for $(uname -m)" >&2; return 1; }
      body=$(fetch -fsSL "$url" 2>/dev/null) || { echo "could not fetch $url (curl exit $?)" >&2; return 1; }
      [[ -z ${feed_save:-} ]] || printf '%s\n' "$body" >"$feed_save" ;;
  esac
  case $type in
    apt-index)
      want=$(jq -r '.feed.package // .pkg' <<<"$app")
      v=$(apt_newest "$body" "$want") || { echo "no $want in the apt index" >&2; return 1; } ;;
    zcode-manifest|latest-yml)
      v=$(sed -n 's/^version: *//p' <<<"$body" | head -1) ;;
    regex)
      v=$(regex_first "$(jq -r '.feed.pattern // ""' <<<"$app")" <<<"$body" 2>/dev/null) \
        || { echo "bad feed pattern" >&2; return 1; } ;;
    json)
      v=$(jq -r "$(jq -r '.feed.path // ".version"' <<<"$app") // empty" <<<"$body" 2>/dev/null) \
        || { echo "feed is not JSON" >&2; return 1; } ;;
    aur-rpc)
      want=$(jq -r '.feed.name // .pkg' <<<"$app")
      body=$(fetch -fsSL "https://aur.archlinux.org/rpc/v5/info?arg%5B%5D=$want" 2>/dev/null) \
        || { echo "could not reach the AUR (curl exit $?)" >&2; return 1; }
      v=$(jq -r '.results[0].Version // ""' <<<"$body" 2>/dev/null) || v=""
      [[ -n $v ]] || { echo "the AUR has no $want" >&2; return 1; }
      v=$(upstream_part "$v") ;;
    github-release)
      # The /releases/latest redirect names the tag; the REST API would do the
      # same but allows only 60 unauthenticated calls an hour.
      repo=$(jq -r '.feed.repo // ""' <<<"$app")
      body=$(fetch -sS -o /dev/null -w '%{http_code} %{redirect_url}' \
        "https://github.com/$repo/releases/latest" 2>/dev/null) || { echo "could not reach github.com/$repo (curl exit $?)" >&2; return 1; }
      [[ $body == 302\ https://github.com/*/releases/tag/* ]] || { echo "github.com/$repo has no latest release (${body%% *})" >&2; return 1; }
      v=${body##*/releases/tag/}
      v=${v#v} ;;
    command)
      v=$(user_command_version "$app") || return 1 ;;
    "")
      echo "no feed declared" >&2; return 1 ;;
    *)
      echo "unknown feed type '$type'" >&2; return 1 ;;
  esac
  v=$(tr -d '[:space:]' <<<"$v")
  [[ -n $v ]] || { echo "feed returned no version" >&2; return 1; }
  version_ok "$v" || { echo "feed returned an odd version '$v'" >&2; return 1; }
  echo "$v"
}

# --- omarchy-pkgs ----------------------------------------------------------

# What building an Omarchy recipe needs, as tool:package. makepkg and sudo
# come with base-devel, vercmp with pacman, bsdtar with libarchive.
omarchy_tools=(makepkg:base-devel git:git jq:jq python3:python bsdtar:libarchive vercmp:pacman curl:curl sudo:base-devel)

# Names of the tools above that are not on PATH. Only command -v, so the
# check can call it on every run.
missing_tools() {
  local entry
  for entry in "${omarchy_tools[@]}"; do
    command -v "${entry%%:*}" >/dev/null || echo "${entry%%:*}"
  done
}

# "Missing: <tools>; sudo pacman -S --needed <packages>" for what building a
# recipe lacks, a python3 older than bin/sync-upstream needs (3.11) included.
# Prints nothing when everything is there.
missing_tools_line() {
  local missing=() pkgs=() entry tool
  mapfile -t missing < <(missing_tools)
  if command -v python3 >/dev/null && ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    missing+=(python3)
  fi
  (( ${#missing[@]} )) || return 0
  for tool in "${missing[@]}"; do
    for entry in "${omarchy_tools[@]}"; do
      [[ $tool == "${entry%%:*}" && " ${pkgs[*]} " != *" ${entry#*:} "* ]] && pkgs+=("${entry#*:}")
    done
  done
  echo "Missing: $(printf '%s, ' "${missing[@]}" | sed 's/, $//'); sudo pacman -S --needed ${pkgs[*]}"
}

# Exits with that line when something is missing.
require_omarchy_tools() {
  local line
  line=$(missing_tools_line)
  [[ -z $line ]] && return 0
  echo "omabump: building Omarchy's recipe needs tools that are missing." >&2
  echo "${line%%;*}" >&2
  echo "Install them with:${line#*;}" >&2
  exit 1
}

# Takes the clone lock on fd 8, waiting up to $1 s, until pkgs_drop_lock or
# the end of the process. The lock covers what writes the clone: fetches,
# checkout, sync and build. Reads through git show need no lock.
pkgs_locked=0
pkgs_take_lock() {
  mkdir -p "$cache_dir"
  exec 8>"$pkgs_lock"
  flock -w "${1:-0}" 8 && pkgs_locked=1
}
pkgs_drop_lock() { exec 8>&-; pkgs_locked=0; }

# Runs "$@" under the clone lock: directly when this process holds it, else
# in a subshell that takes it for that call only. Fails with 75 when another
# process holds it.
pkgs_with_lock() {
  if (( pkgs_locked )); then "$@"; return; fi
  (exec 8>"$pkgs_lock"; flock -n 8 || exit 75; "$@")
}

# git for the clone: HTTPS only, never a credential prompt, and always bounded:
# the clone is blob-less, so even show, checkout and archive can fetch from
# GitHub on demand. No hooks, no fsmonitor, no automatic gc or maintenance,
# whatever the clone's or the user's config says. Explicit network calls go
# through pgit_net.
git_safe=(-c core.hooksPath=/dev/null -c core.fsmonitor=false -c protocol.allow=never
  -c protocol.https.allow=always -c gc.auto=0 -c maintenance.auto=false)
pgit() { run_unlocked timeout -k 10 300 env GIT_ALLOW_PROTOCOL=https GIT_TERMINAL_PROMPT=0 git "${git_safe[@]}" -C "$pkgs_dir" "$@" </dev/null; }
pgit_net() { run_unlocked timeout -k 10 300 env GIT_ALLOW_PROTOCOL=https GIT_TERMINAL_PROMPT=0 git "${git_safe[@]}" "$@" </dev/null; }

# Makes the pinned commit (or, when following, origin/master's) present in
# the clone, creating it first, and prints that commit. The caller sets
# pkgs_base to it. Only data moves: the work tree is not touched. A pinned
# commit already in the clone needs no network. The clone is an empty repo
# with origin set and every fetch names the pinned commit, never a branch
# clone. A clone whose origin is not $pkgs_url is made again. Needs the lock.
pkgs_fetch() {
  if [[ -d $pkgs_dir/.git && $(pgit remote get-url origin 2>/dev/null) != "$pkgs_url" ]]; then
    echo "the omarchy-pkgs clone's origin is not $pkgs_url; making it again" >&2
    rm -rf "$pkgs_dir"
  fi
  if [[ ! -d $pkgs_dir/.git ]]; then
    rm -rf "$pkgs_dir"
    { pgit_net init -q -- "$pkgs_dir" && pgit remote add origin "$pkgs_url"; } >&2 \
      || { rm -rf "$pkgs_dir"; return 1; }
  fi
  if (( pkgs_follow )); then
    pgit_net -C "$pkgs_dir" fetch -q --filter=blob:none origin -- '+refs/heads/master:refs/remotes/origin/master' >&2 || return 1
    pgit rev-parse --verify -q 'refs/remotes/origin/master^{commit}'
    return
  fi
  [[ -n $pkgs_base ]] || { echo "$pkgs_pin_error" >&2; return 1; }
  if ! pgit cat-file -e "$pkgs_base^{commit}" 2>/dev/null; then
    local why
    why=$(pgit_net -C "$pkgs_dir" fetch -q --filter=blob:none origin -- "$pkgs_base" 2>&1) \
      || why=$(pgit_net -C "$pkgs_dir" fetch -q --filter=blob:none origin -- "$pkgs_pin_ref" 2>&1) || true
    pgit cat-file -e "$pkgs_base^{commit}" 2>/dev/null \
      || { echo "pinned omarchy-pkgs commit ${pkgs_base:0:12} is unreachable${why:+: $(tail -1 <<<"$why")}" >&2; return 1; }
  fi
  echo "$pkgs_base"
}

# Puts the work tree, detached, at pkgs_base and cleans $1 (the whole tree
# by default). Needs the lock.
pkgs_detach() {
  pgit checkout -q -f --detach "$pkgs_base" >&2 && pgit clean -qfdx -- "${1:-.}" >&2
}
pkgs_checkout() { pkgs_detach; }
# Puts Omarchy's recipe back the way pkgs_base has it; never fails.
pkgs_restore() { pkgs_detach "pkgbuilds/${1:?}" 2>/dev/null || true; }

# A file of a recipe at a commit, read from the object store without a
# checkout, so it is safe while an install holds the lock.
recipe_file() { pgit show "$1:pkgbuilds/$2/$3" 2>/dev/null; }
recipe_has() { pgit cat-file -e "$1:pkgbuilds/$2/$3" 2>/dev/null; }

# Why the recipe at commit $1 cannot follow its vendor, or nothing when it
# can: bin/sync-upstream needs an upstream watch (package.json "upstream") or
# hook (.omarchy/upstream.sh) to move it.
recipe_blocker() {
  local rev=$1 pkg=$2 meta
  recipe_has "$rev" "$pkg" PKGBUILD || { echo "No $pkg recipe in omarchy-pkgs"; return; }
  meta=$(recipe_file "$rev" "$pkg" .omarchy/package.json) || meta='{}'
  if jq -e '.sync == false' >/dev/null 2>&1 <<<"$meta"; then
    echo "Repo recipe has no upstream watch yet (sync: false)"; return
  fi
  recipe_has "$rev" "$pkg" .omarchy/upstream.sh && return
  jq -e '.upstream' >/dev/null 2>&1 <<<"$meta" && return
  echo "Repo recipe has no upstream watch yet"
}

# Fetches the recipeCommit $1 of app $2, or the ref its recipeFetch names.
recipe_fetch() {
  local ref
  pgit_net -C "$pkgs_dir" fetch -q --filter=blob:none origin -- "$1" 2>/dev/null && return 0
  ref=$(jq -r '.recipeFetch // ""' <<<"$2")
  [[ -n $ref ]] || return 1
  ref_ok "$ref" || { echo "recipeFetch '$ref' is not a refs/ name" >&2; return 1; }
  pgit_net -C "$pkgs_dir" fetch -q --filter=blob:none origin -- "$ref" 2>/dev/null
}

# Which commit's recipe an app uses. apps.json may pin one with
# "recipeCommit", a 40-hex SHA from an unmerged omarchy-pkgs PR that gives the
# package the watch the pinned omarchy-pkgs commit lacks ("recipeFetch" names
# a ref to fetch when the server will not hand out the bare SHA). Sets
# recipe_rev and recipe_note. Fails closed with the reason on stderr and never
# falls back to pkgs_base; fails with 75 when the clone is busy and the
# commit still has to be fetched. Once pkgs_base's own recipe has a watch,
# the recipeCommit is ignored.
recipe_source() {
  local pkg=$1 app=$2 sha rc=0
  recipe_rev=$pkgs_base recipe_note=""
  sha=$(jq -r '.recipeCommit // ""' <<<"$app")
  [[ -n $sha ]] || return 0
  if [[ -z $(recipe_blocker "$pkgs_base" "$pkg") ]]; then
    recipe_note="Pinned recipe no longer needed, omarchy-pkgs has a watch"
    return 0
  fi
  [[ $sha =~ ^[0-9a-f]{40}$ ]] || { echo "recipeCommit '$sha' is not a 40-hex commit" >&2; return 1; }
  if ! pgit cat-file -e "$sha^{commit}" 2>/dev/null; then
    pkgs_with_lock recipe_fetch "$sha" "$app" || rc=$?
    (( rc != 75 )) || { echo "the omarchy-pkgs clone is busy with an update" >&2; return 75; }
    pgit cat-file -e "$sha^{commit}" 2>/dev/null || { echo "pinned recipe ${sha:0:12} is unreachable" >&2; return 1; }
  fi
  recipe_has "$sha" "$pkg" PKGBUILD || { echo "pinned commit ${sha:0:12} has no $pkg recipe" >&2; return 1; }
  recipe_rev=$sha
  recipe_note=$(jq -r '.recipeNote // ""' <<<"$app")
  [[ -n $recipe_note ]] || recipe_note="Recipe from omarchy-pkgs ${sha:0:12}"
}

# Replaces the work tree's recipe with the exact tree at commit $2, so no
# pkgs_base-only file survives next to it. Needs the lock and pkgs_checkout.
recipe_materialise() {
  local pkg=$1 rev=$2
  [[ $rev == "$pkgs_base" ]] && return 0
  rm -rf "${pkgs_dir:?}/pkgbuilds/$pkg"
  pgit archive "$rev" "pkgbuilds/$pkg" | tar -x -C "$pkgs_dir" || return 1
  [[ -f $pkgs_dir/pkgbuilds/$pkg/PKGBUILD ]]
}

# A plain assignment in PKGBUILD text on stdin, the form omarchy-pkgs' own
# tools rewrite. The text is parsed, never sourced.
pkgbuild_field() { sed -n "s/^$1=//p" | head -1 | tr -d "\"'"; }

# Prints "<pkgname> <full version>" from PKGBUILD text on stdin. epoch=0 is
# no epoch, as makepkg writes it.
recipe_version() {
  local text name ver rel epoch
  text=$(cat)
  name=$(pkgbuild_field pkgname <<<"$text") ver=$(pkgbuild_field pkgver <<<"$text")
  rel=$(pkgbuild_field pkgrel <<<"$text") epoch=$(pkgbuild_field epoch <<<"$text")
  pkg_name_ok "$name" || { echo "unreadable pkgname in the recipe" >&2; return 1; }
  version_ok "$ver" || { echo "unreadable pkgver in the recipe" >&2; return 1; }
  [[ $rel =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "unreadable pkgrel in the recipe" >&2; return 1; }
  [[ -z $epoch || $epoch =~ ^[0-9]+$ ]] || { echo "unreadable epoch in the recipe" >&2; return 1; }
  [[ $epoch == 0 ]] && epoch=""
  echo "$name ${epoch:+$epoch:}$ver-$rel"
}
