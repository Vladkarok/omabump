# Sourced by omabump-check and omabump-install; not run on its own.
# shellcheck shell=bash
# The paths and state variables below are read by the scripts that source
# this file, which shellcheck cannot see from here:
# shellcheck disable=SC2034

# One locale for every script: ${var:0:N} counts characters, and regexes,
# sorting and tool output (pacman -Qi fields) do not depend on the user's.
if locale -a 2>/dev/null | grep -qix 'c\.utf-\?8'; then
  export LC_ALL=C.UTF-8
else
  export LC_ALL=C
fi

# The lock files sit on fds 6 (a local refresh, omabump-check --local), 7
# (one update per app), 8 (the omarchy-pkgs clone) and 9 (one check at a
# time). A child that inherited one would hold the lock after this process
# ends, so git, mise, sync-upstream, makepkg, sudo and command feeds run
# without them; the parent keeps its locks.
run_unlocked() { "$@" 6>&- 7>&- 8>&- 9>&-; }

# run_unlocked for a command under `timeout`, which puts itself and the
# command in a process group of their own. Main.qml stops a check that runs
# too long with TERM to the check's group, then KILL ten seconds later, and
# bash runs the check's TERM trap (status.json written as a failed run) only
# once the foreground command it waits for has ended: a git, mise or feed
# command outside that group would hold the trap for up to its own limit,
# the KILL would come first, and the rows would stay "checking" with the
# command left running. So the command runs as a background job of a
# subshell that waits for it with the wait builtin, which returns at once on
# a trapped signal: TERM stops the command's whole group and ends the
# subshell. INT (Ctrl-C in a terminal) and HUP (the terminal closed) reach
# neither that group nor timeout, which ignores INT in a background job, so
# they stop the command with TERM too. Once it has ended, the subshell dies
# of that same signal: bash then stops the calling script as it would had
# the command itself been interrupted, rather than going on to the next
# step as if one command had merely failed. Otherwise the exit status is
# the command's.
run_killable() (
  local pid="" rc sig=""
  trap '[[ -z $pid ]] || kill -TERM -- "-$pid" "$pid" 2>/dev/null; exit 143' TERM
  trap 'sig=INT; [[ -z $pid ]] || kill -TERM -- "-$pid" "$pid" 2>/dev/null' INT
  trap 'sig=HUP; [[ -z $pid ]] || kill -TERM -- "-$pid" "$pid" 2>/dev/null' HUP
  "$@" 6>&- 7>&- 8>&- 9>&- &
  pid=$!
  while :; do
    wait "$pid" && rc=0 && break
    rc=$?
    # A wait cut short by the INT or HUP trap: the command is still running.
    kill -0 "$pid" 2>/dev/null || break
  done
  if [[ -n $sig ]]; then
    trap - "$sig"
    kill "-$sig" "$BASHPID"
  fi
  exit "$rc"
)

plugin_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
