# Sourced by omabump-check and omabump-install; not run on its own.
# shellcheck shell=bash

plugin_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
shipped_apps=$plugin_dir/apps.json
user_apps=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/omabump/apps.json
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/plugins/io.github.vladkarok.omabump
status_file=$state_dir/status.json
notified_file=$state_dir/notified.json
cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/omabump
pkgs_dir=$cache_dir/omarchy-pkgs
pkgs_url=https://github.com/omacom/omarchy-pkgs.git
pkgs_lock=$cache_dir/omarchy-pkgs.lock
shipped_pins=$plugin_dir/pins.json
user_pins=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/omabump/pins.json

# The omarchy-pkgs commit every recipe read, sync and build starts from:
# pins.json's 40-hex commit, with the user's pins.json merged over it. The
# install path runs that repo's sync tool and hook scripts, so a moving
# branch is never the default. "omarchyPkgs": {"follow": "master"} in the
# user's file opts in to origin/master; pkgs_fetch then resolves it to a
# commit. Sets pkgs_base (empty when the pin is unusable), pkgs_follow and
# pkgs_pin_ref; pkgs_pin_error says why a pin is unusable.
pkgs_base="" pkgs_follow=0 pkgs_pin_ref="" pkgs_pin_error=""
pkgs_pin() {
  local user='{}' pins follow
  if [[ -f $user_pins ]]; then
    user=$(jq -ce 'if type == "object" then . else error("not an object") end' "$user_pins" 2>/dev/null) \
      || { echo "ignoring $user_pins: not a JSON object" >&2; user='{}'; }
  fi
  pins=$(jq -c --argjson user "$user" '. * $user | .omarchyPkgs // {}' "$shipped_pins" 2>/dev/null) || pins='{}'
  follow=$(jq -r '.follow // ""' <<<"$pins")
  if [[ $follow == master ]]; then
    pkgs_follow=1 pkgs_pin_ref=refs/heads/master
    return 0
  fi
  [[ -z $follow ]] || { pkgs_pin_error="omarchyPkgs.follow '$follow' is not \"master\""; return 0; }
  pkgs_base=$(jq -r '.commit // ""' <<<"$pins")
  pkgs_pin_ref=$(jq -r '.ref // "refs/heads/master"' <<<"$pins")
  if [[ ! $pkgs_base =~ ^[0-9a-f]{40}$ ]]; then
    pkgs_pin_error="the omarchy-pkgs pin '$pkgs_base' is not a 40-hex commit"
    pkgs_base=""
  fi
}
pkgs_pin

# The app table: the shipped one, with the user's file merged over it by pkg.
# A user entry adds an app or overrides fields of a shipped one; "disabled":
# true hides it. Shipped order comes first, user additions after.
apps_table() {
  local user='[]'
  if [[ -f $user_apps ]]; then
    user=$(jq -ce 'if type == "array" then . else error("not an array") end' "$user_apps" 2>/dev/null) \
      || { echo "ignoring $user_apps: not a JSON array" >&2; user='[]'; }
  fi
  jq -c --argjson user "$user" '
    reduce (. + $user)[] as $a ({order: [], by: {}};
      if .by[$a.pkg] then .by[$a.pkg] += $a
      else .order += [$a.pkg] | .by[$a.pkg] = $a end)
    | [.order[] as $p | .by[$p] | select(.disabled != true)]' "$shipped_apps"
}

# An app by its pkg, or else by one of its installed package or mise tool
# names, so `omabump-install z-code-bin` finds ZCode.
app_json() {
  apps_table | jq -ce --arg n "$1" '
    ([.[] | select(.pkg == $n)] + [.[] | select(((.installed // []) + ([.tool // empty] | flatten)) | index($n))])[0]
    // error("no app")' 2>/dev/null
}

# vercmp is the only comparator: pacman, makepkg and omarchy-pkgs all use it.
newer() { (( $(vercmp "$1" "$2") > 0 )); }

# The upstream part of a pacman version: no epoch, no pkgrel.
upstream_part() { local v=${1#*:}; echo "${v%-*}"; }

# What Arch allows in pkgver, plus ":" for an epoch. Versions end up in sed
# expressions, URLs and file names, so anything else is a feed error.
version_ok() { [[ $1 =~ ^[A-Za-z0-9._+~:]+$ ]]; }

# Prints "<name> <full version>" for the first of the given names pacman has
# installed. Only exact names count: a provide could be an unrelated package.
installed_package() {
  local name line
  for name in "$@"; do
    [[ -n $name ]] || continue
    line=$(pacman -Q -- "$name" 2>/dev/null) || continue
    [[ ${line%% *} == "$name" ]] || continue
    echo "$line"
    return 0
  done
  return 1
}

# mise answers depend on the config files of the current directory, so every
# mise call runs in $HOME, in the check and the installer alike.
mise_run() { (cd "$HOME" && timeout -k 10 "${mise_timeout:-120}" mise "$@" </dev/null); }

# mise_load fills these once, in the calling shell (never call it in a
# subshell, the values would be lost there): `mise ls --json`, and with $1=1
# `mise outdated --json` (what `mise up` reaches under the configured request
# and release-age cooldown) and `mise outdated --bump --json` (newer releases
# outside the request). All keyed by tool name. mise versions are kept as
# mise prints them and never compared with vercmp: mise decides.
mise_ls_json='{}' mise_outdated_json='{}' mise_bump_json='{}' mise_error=""
mise_load() {
  local out err
  command -v mise >/dev/null || return 0
  mise_ls_json=$(mise_run ls --json 2>/dev/null | jq -ce 'if type == "object" then . else {} end' 2>/dev/null) || mise_ls_json='{}'
  (( ${1:-0} )) || return 0
  err=$(mktemp)
  if out=$(mise_run outdated --json 2>"$err") && out=$(jq -ce 'if type == "object" then . else error("bad") end' <<<"$out" 2>/dev/null); then
    mise_outdated_json=$out
  else
    mise_error="mise outdated failed: $(sed 's/\x1b\[[0-9;]*m//g' "$err" | grep -v 'WARN' | grep -v '^[[:space:]]*$' | head -1)"
  fi
  if out=$(mise_run outdated --bump --json 2>/dev/null) && out=$(jq -ce 'if type == "object" then . else error("bad") end' <<<"$out" 2>/dev/null); then
    mise_bump_json=$out
  fi
  rm -f "$err"
}

# A field of a tool's entry in one of the outdated tables, or nothing.
mise_field() { jq -r --arg t "$2" --arg f "$3" '.[$t][$f] // empty | tostring' <<<"$1"; }

# Prints "<tool> <active version>" for the first of the app's tool names that
# mise has installed and active. The key is whatever the user's mise config
# uses, e.g. claude or npm:@anthropic-ai/claude-code.
mise_active() {
  jq -re --argjson tools "$(jq -c '[.tool // empty] | flatten' <<<"$1")" '
    . as $ls | [$tools[] as $t | ($ls[$t] // [])[] | select(.active == true and .installed != false)
      | "\($t) \(.version)"][0] // empty' <<<"$mise_ls_json"
}

# Prints "<source> <installed name> <version>" for an app, or fails when it is
# not installed.
installed_app() {
  local app=$1 source line names
  source=$(jq -r '.source // ""' <<<"$app")
  if [[ $source == mise ]]; then
    line=$(mise_active "$app") || return 1
  else
    mapfile -t names < <(jq -r '(.installed // [.pkg])[]' <<<"$app")
    line=$(installed_package "${names[@]}") || return 1
  fi
  echo "$source $line"
}

# A value that may be given per architecture: a string, or an object keyed by
# `uname -m`. Prints nothing when this machine's architecture is missing.
per_arch() {
  jq -r --arg arch "$(uname -m)" "($1) as \$v | if (\$v | type) == \"object\" then \$v[\$arch] // \"\" else \$v // \"\" end" <<<"$2"
}

# Every download: HTTPS only, redirects included, and bounded. $max_time
# overrides the 30 s default for the vendor package itself.
fetch() { curl --proto =https --proto-redir =https --connect-timeout 15 --max-time "${max_time:-30}" "$@"; }

# The vendor package URL for this machine's architecture with {version}
# filled in, or nothing when the vendor builds none for it.
vendor_pkg_url() {
  local url
  url=$(per_arch .vendorPkg "$1")
  [[ $url == https://* ]] || return 1
  echo "${url//\{version\}/$2}"
}

# Newest version in a Debian Packages index for one exact package name.
apt_newest() {
  local index=$1 want=$2 v best=""
  while read -r v; do
    if [[ -z $best ]] || newer "$v" "$best"; then best=$v; fi
  done < <(awk -v want="$want" '
    { sub(/\r$/, "") }
    /^Package:/ { p = $2 }
    /^Version:/ { v = $2 }
    /^$/        { if (p == want && v != "") print v; p = v = "" }
    END         { if (p == want && v != "") print v }' <<<"$index")
  [[ -n $best ]] && echo "$best"
}

# First capture group of a Python regex over a page. Pages that embed JSON in
# a JS string escape its quotes, so the pattern is also tried with \" as ".
regex_first() {
  python3 -c '
import re, sys
body = sys.stdin.read()
for text in (body, body.replace("\\\"", "\"")):
    m = re.search(sys.argv[1], text)
    if m:
        print(m.group(1))
        break
' "$1"
}

# Prints the newest version the app's own feed advertises. Feeds are data:
# nothing fetched is ever run. Every fetch is checked on its own: a failed or
# cut-off download is an error, never a version.
feed_version() {
  local app=$1 type url body v repo cmd want
  type=$(jq -r '.feed.type // ""' <<<"$app")
  url=$(per_arch .feed.url "$app")
  case $type in
    apt-index|zcode-manifest|latest-yml|regex|json)
      [[ $url == https://* ]] || { echo "no https feed url for $(uname -m)" >&2; return 1; }
      body=$(fetch -fsSL "$url" 2>/dev/null) || { echo "could not fetch $url (curl exit $?)" >&2; return 1; } ;;
  esac
  case $type in
    apt-index)
      want=$(jq -r '.feed.package // .pkg' <<<"$app")
      v=$(apt_newest "$body" "$want") || { echo "no $want in the apt index" >&2; return 1; } ;;
    zcode-manifest|latest-yml)
      v=$(sed -n 's/^version: *//p' <<<"$body" | head -1) ;;
    regex)
      v=$(regex_first "$(jq -r '.feed.pattern // ""' <<<"$app")" <<<"$body" 2>/dev/null) \
        || { echo "bad feed pattern" >&2; return 1; } ;;
    json)
      v=$(jq -r "$(jq -r '.feed.path // ".version"' <<<"$app") // empty" <<<"$body" 2>/dev/null) \
        || { echo "feed is not JSON" >&2; return 1; } ;;
    aur-rpc)
      want=$(jq -r '.feed.name // .pkg' <<<"$app")
      body=$(fetch -fsSL "https://aur.archlinux.org/rpc/v5/info?arg%5B%5D=$want" 2>/dev/null) \
        || { echo "could not reach the AUR (curl exit $?)" >&2; return 1; }
      v=$(jq -r '.results[0].Version // ""' <<<"$body" 2>/dev/null) || v=""
      [[ -n $v ]] || { echo "the AUR has no $want" >&2; return 1; }
      v=$(upstream_part "$v") ;;
    github-release)
      # The /releases/latest redirect names the tag; the REST API would do the
      # same but allows only 60 unauthenticated calls an hour.
      repo=$(jq -r '.feed.repo // ""' <<<"$app")
      body=$(fetch -sS -o /dev/null -w '%{http_code} %{redirect_url}' \
        "https://github.com/$repo/releases/latest" 2>/dev/null) || { echo "could not reach github.com/$repo (curl exit $?)" >&2; return 1; }
      [[ $body == 302\ https://github.com/*/releases/tag/* ]] || { echo "github.com/$repo has no latest release (${body%% *})" >&2; return 1; }
      v=${body##*/releases/tag/}
      v=${v#v} ;;
    command)
      # Only from apps.json, which is local config: the command is not data.
      cmd=$(jq -r '.feed.command // ""' <<<"$app")
      body=$(timeout -k 10 60 bash -c "$cmd" </dev/null) || { echo "feed command failed" >&2; return 1; }
      v=$(head -1 <<<"$body") ;;
    "")
      echo "no feed declared" >&2; return 1 ;;
    *)
      echo "unknown feed type '$type'" >&2; return 1 ;;
  esac
  v=$(tr -d '[:space:]' <<<"$v")
  [[ -n $v ]] || { echo "feed returned no version" >&2; return 1; }
  version_ok "$v" || { echo "feed returned an odd version '$v'" >&2; return 1; }
  echo "$v"
}

# --- omarchy-pkgs ----------------------------------------------------------

# What building an Omarchy recipe needs, as tool:package. makepkg and sudo
# come with base-devel, vercmp with pacman, bsdtar with libarchive.
omarchy_tools=(makepkg:base-devel git:git jq:jq python3:python bsdtar:libarchive vercmp:pacman curl:curl sudo:base-devel)

# Names of the tools above that are not on PATH. Only command -v, so the
# check can call it on every run.
missing_tools() {
  local entry
  for entry in "${omarchy_tools[@]}"; do
    command -v "${entry%%:*}" >/dev/null || echo "${entry%%:*}"
  done
}

# "Missing: <tools>; sudo pacman -S --needed <packages>" for what building a
# recipe lacks, a python3 older than bin/sync-upstream needs (3.11) included.
# Prints nothing when everything is there.
missing_tools_line() {
  local missing=() pkgs=() entry tool
  mapfile -t missing < <(missing_tools)
  if command -v python3 >/dev/null && ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    missing+=(python3)
  fi
  (( ${#missing[@]} )) || return 0
  for tool in "${missing[@]}"; do
    for entry in "${omarchy_tools[@]}"; do
      [[ $tool == "${entry%%:*}" && " ${pkgs[*]} " != *" ${entry#*:} "* ]] && pkgs+=("${entry#*:}")
    done
  done
  echo "Missing: $(printf '%s, ' "${missing[@]}" | sed 's/, $//'); sudo pacman -S --needed ${pkgs[*]}"
}

# Exits with that line when something is missing.
require_omarchy_tools() {
  local line
  line=$(missing_tools_line)
  [[ -z $line ]] && return 0
  echo "omabump: building Omarchy's recipe needs tools that are missing." >&2
  echo "${line%%;*}" >&2
  echo "Install them with:${line#*;}" >&2
  exit 1
}

# Takes the clone lock on fd 8 for the rest of the process, waiting up to $1 s.
pkgs_take_lock() {
  mkdir -p "$cache_dir"
  exec 8>"$pkgs_lock"
  flock -w "${1:-0}" 8
}

# git for the clone: HTTPS only, never a credential prompt. Network calls go
# through pgit_net, which also bounds them and kills what they leave behind.
pgit() { GIT_ALLOW_PROTOCOL=https GIT_TERMINAL_PROMPT=0 git -C "$pkgs_dir" "$@" </dev/null; }
pgit_net() { timeout -k 10 300 env GIT_ALLOW_PROTOCOL=https GIT_TERMINAL_PROMPT=0 git "$@" </dev/null; }

# Makes the pinned commit (or, when following, origin/master's) present in
# the clone, cloning it first, and prints that commit. The caller sets
# pkgs_base to it. Only data moves: the work tree is not touched. A pinned
# commit already in the clone needs no network. Needs the lock.
pkgs_fetch() {
  if [[ ! -d $pkgs_dir/.git ]]; then
    rm -rf "$pkgs_dir"
    pgit_net clone -q --no-checkout --filter=blob:none "$pkgs_url" "$pkgs_dir" >&2 || return 1
  fi
  if (( pkgs_follow )); then
    pgit_net -C "$pkgs_dir" fetch -q origin >&2 || return 1
    pgit rev-parse origin/master
    return
  fi
  [[ -n $pkgs_base ]] || { echo "$pkgs_pin_error" >&2; return 1; }
  if ! pgit cat-file -e "$pkgs_base^{commit}" 2>/dev/null; then
    pgit_net -C "$pkgs_dir" fetch -q origin "$pkgs_base" 2>/dev/null \
      || pgit_net -C "$pkgs_dir" fetch -q origin "$pkgs_pin_ref" >&2 || true
    pgit cat-file -e "$pkgs_base^{commit}" 2>/dev/null \
      || { echo "pinned omarchy-pkgs commit ${pkgs_base:0:12} is unreachable" >&2; return 1; }
  fi
  echo "$pkgs_base"
}

# Puts the work tree, detached, at pkgs_base for a build. Needs the lock.
pkgs_checkout() {
  pgit checkout -q -f --detach "$pkgs_base" >&2 && pgit clean -qfdx >&2
}

# Puts Omarchy's recipe back the way pkgs_base has it.
pkgs_restore() {
  pgit checkout -q -f --detach "$pkgs_base" 2>/dev/null || true
  pgit clean -qfdx -- "pkgbuilds/${1:?}" 2>/dev/null || true
}

# A file of a recipe at a commit, read from git without a checkout.
recipe_file() { pgit show "$1:pkgbuilds/$2/$3" 2>/dev/null; }
recipe_has() { pgit cat-file -e "$1:pkgbuilds/$2/$3" 2>/dev/null; }

# Why the recipe at commit $1 cannot follow its vendor, or nothing when it
# can: bin/sync-upstream needs an upstream watch (package.json "upstream") or
# hook (.omarchy/upstream.sh) to move it.
recipe_blocker() {
  local rev=$1 pkg=$2 meta
  recipe_has "$rev" "$pkg" PKGBUILD || { echo "No $pkg recipe in omarchy-pkgs"; return; }
  meta=$(recipe_file "$rev" "$pkg" .omarchy/package.json) || meta='{}'
  if jq -e '.sync == false' >/dev/null 2>&1 <<<"$meta"; then
    echo "Repo recipe has no upstream watch yet (sync: false)"; return
  fi
  recipe_has "$rev" "$pkg" .omarchy/upstream.sh && return
  jq -e '.upstream' >/dev/null 2>&1 <<<"$meta" && return
  echo "Repo recipe has no upstream watch yet"
}

# Which commit's recipe an app uses. apps.json may pin one with
# "recipeCommit", a 40-hex SHA from an unmerged omarchy-pkgs PR that gives the
# package the watch the pinned omarchy-pkgs commit lacks ("recipeFetch" names
# a ref to fetch when the server will not hand out the bare SHA). Sets
# recipe_rev and recipe_note. Fails closed with the reason on stderr and never
# falls back to pkgs_base. Once pkgs_base's own recipe has a watch, the
# recipeCommit is ignored.
recipe_source() {
  local pkg=$1 app=$2 sha ref
  recipe_rev=$pkgs_base recipe_note=""
  sha=$(jq -r '.recipeCommit // ""' <<<"$app")
  [[ -n $sha ]] || return 0
  if [[ -z $(recipe_blocker "$pkgs_base" "$pkg") ]]; then
    recipe_note="Pinned recipe no longer needed, omarchy-pkgs has a watch"
    return 0
  fi
  [[ $sha =~ ^[0-9a-f]{40}$ ]] || { echo "recipeCommit '$sha' is not a 40-hex commit" >&2; return 1; }
  if ! pgit cat-file -e "$sha^{commit}" 2>/dev/null; then
    if ! pgit_net -C "$pkgs_dir" fetch -q origin "$sha" 2>/dev/null; then
      ref=$(jq -r '.recipeFetch // ""' <<<"$app")
      [[ -n $ref ]] && pgit_net -C "$pkgs_dir" fetch -q origin "$ref" 2>/dev/null
    fi
    pgit cat-file -e "$sha^{commit}" 2>/dev/null || { echo "pinned recipe ${sha:0:12} is unreachable" >&2; return 1; }
  fi
  recipe_has "$sha" "$pkg" PKGBUILD || { echo "pinned commit ${sha:0:12} has no $pkg recipe" >&2; return 1; }
  recipe_rev=$sha
  recipe_note=$(jq -r '.recipeNote // ""' <<<"$app")
  [[ -n $recipe_note ]] || recipe_note="Recipe from omarchy-pkgs ${sha:0:12}"
}

# Replaces the work tree's recipe with the exact tree at commit $2, so no
# pkgs_base-only file survives next to it. Needs the lock and pkgs_checkout.
recipe_materialise() {
  local pkg=$1 rev=$2
  [[ $rev == "$pkgs_base" ]] && return 0
  rm -rf "${pkgs_dir:?}/pkgbuilds/$pkg"
  pgit archive "$rev" "pkgbuilds/$pkg" | tar -x -C "$pkgs_dir" || return 1
  [[ -f $pkgs_dir/pkgbuilds/$pkg/PKGBUILD ]]
}

# A plain assignment in PKGBUILD text on stdin, the form omarchy-pkgs' own
# tools rewrite. The text is parsed, never sourced.
pkgbuild_field() { sed -n "s/^$1=//p" | head -1 | tr -d "\"'"; }

# Prints "<pkgname> <full version>" from PKGBUILD text on stdin. epoch=0 is
# no epoch, as makepkg writes it.
recipe_version() {
  local text name ver rel epoch
  text=$(cat)
  name=$(pkgbuild_field pkgname <<<"$text") ver=$(pkgbuild_field pkgver <<<"$text")
  rel=$(pkgbuild_field pkgrel <<<"$text") epoch=$(pkgbuild_field epoch <<<"$text")
  [[ $name =~ ^[a-z0-9@._+-]+$ ]] || { echo "unreadable pkgname in the recipe" >&2; return 1; }
  [[ $ver =~ ^[A-Za-z0-9._+~]+$ ]] || { echo "unreadable pkgver in the recipe" >&2; return 1; }
  [[ $rel =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "unreadable pkgrel in the recipe" >&2; return 1; }
  [[ -z $epoch || $epoch =~ ^[0-9]+$ ]] || { echo "unreadable epoch in the recipe" >&2; return 1; }
  [[ $epoch == 0 ]] && epoch=""
  echo "$name ${epoch:+$epoch:}$ver-$rel"
}
