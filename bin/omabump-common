# --- text in the user's language -------------------------------------------------
#
# The panel words its text from the catalogs in i18n/, one flat JSON file
# per Omarchy language code (Model.js says how). Of what the scripts say,
# only the notifications follow that language too, through say below:
# what they print to a terminal or stderr stays English, as pacman's own
# output does, and so do status.json's English fields. Beside a row's note
# and build note the checker writes their parts (noteParts,
# buildNoteParts: a list of {key, args}, made by part), which the panel
# words in the language, and the English field stays for an older panel, a
# terminal and the tests; tests/check.sh holds each to its parts.

i18n_dir=$plugin_dir/i18n
# A catalog file larger than this is none: read as empty, so English.
i18n_max_bytes=262144

# The language picked under Setup > Region > Language, as Omarchy's
# Commons/I18n.qml reads it (languageCode): the code in
# ~/.config/omarchy/language ($OMARCHY_LANGUAGE_FILE overrides where, as
# it does for the shell), trimmed, when it is one; else "en", for a file
# that is missing too.
i18n_language() {
  local file=${OMARCHY_LANGUAGE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/language} code=""
  # A plain file of a few bytes, as omarchy-language writes it; anything
  # else is English here, as it is to the shell's I18n.
  [[ -f $file && ! -L $file && $(stat -c %s -- "$file" 2>/dev/null) -le 64 ]] && code=$(head -c 64 -- "$file" 2>/dev/null | tr -d '\0')
  code="${code#"${code%%[![:space:]]*}"}"
  code="${code%"${code##*[![:space:]]}"}"
  [[ $code =~ ^[a-z]{2,3}(-[A-Za-z]{2})?$ ]] || code=en
  printf '%s\n' "$code"
}

# The strings of the catalog i18n/$1.json ($1 a code i18n_language
# accepts), as one JSON object of the entries that are strings: no file,
# one over i18n_max_bytes, or one that is not a JSON object gives {}. Data
# only: read with jq, never sourced. Plural entries are left out: no
# notification counts anything.
i18n_catalog() {
  local file=$i18n_dir/$1.json size
  local out
  # A plain file, not a link, a pipe or a device, and one whole JSON object
  # and nothing after it: jq prints a first value before it fails on what
  # follows, so the file is read as a list of its values.
  size=""
  [[ -f $file && ! -L $file ]] && size=$(stat -c %s -- "$file" 2>/dev/null)
  if [[ -n $size ]] && (( size <= i18n_max_bytes )) && out=$(head -c "$i18n_max_bytes" -- "$file" | jq -cs '
      if length == 1 and (.[0] | type == "object")
      then .[0] | with_entries(select(.value | type == "string" and . != "")) else error("not one object") end' 2>/dev/null); then
    printf '%s\n' "$out"
    return 0
  fi
  echo '{}'
}

# The catalog say reads: the language's strings over its base language's
# (pt-BR over pt) over English's, as Commons.Translations layers them.
# Loaded once, by the first i18n_load in this shell; a say in a subshell
# ($(say ...)) loads it for itself unless the shell has, so a caller that
# says several things loads it first. Set it to "" to read them again. It
# goes to jq on stdin, never as an argument, whatever its size.
i18n_strings=""
i18n_load() {
  [[ -z $i18n_strings ]] || return 0
  local code base layers=()
  code=$(i18n_language)
  base=${code%%-*}
  layers=("$(i18n_catalog en)")
  [[ $base == "$code" || $base == en ]] || layers+=("$(i18n_catalog "$base")")
  [[ $code == en ]] || layers+=("$(i18n_catalog "$code")")
  i18n_strings=$(printf '%s\n' "${layers[@]}" | jq -cs 'add')
}

# jq: the string with its %1..%n holes filled from the list $a in one
# pass (Model.fill's rule): an argument's own "%1" stays as it is, and so
# does a hole with no argument.
# shellcheck disable=SC2016 # jq variables, not the shell's
jq_i18n='
  def i18n_fill($a): gsub("%(?<n>[0-9]+)"; (.n | tonumber) as $i
    | if $i >= 1 and $i <= ($a | length) then $a[$i - 1] | tostring else "%" + .n end);'

# say <key> [<arg>...]: the string for key in the user's language, filled
# with the args; a key no catalog has is itself.
say() {
  i18n_load
  jq -r --arg k "$1" "$jq_i18n"' (.[$k] // $k) | i18n_fill($ARGS.positional) | .[0:1000]' --args -- "${@:2}" <<<"$i18n_strings"
}

# part <key> [<arg>...]: one clause of a note as parts, a JSON list of one
# {key, args}. The key is one of i18n/en.json's, its string the clause in
# English; an argument is a string, free text from outside (a feed's
# error, apps.json's updateBlocked) included, through clean_text as the
# English fields are.
part() {
  local args=() arg
  for arg in "${@:2}"; do args+=("$(clean_text "$arg")"); done
  jq -cn --arg k "$1" '[{key: $k, args: $ARGS.positional}]' --args -- "${args[@]}"
}

# The parts of "Not checked yet", the note of a row no check has read.
parts_not_checked='[{"key":"note.notChecked","args":[]}]'

# parts_cat <parts>...: the clauses in order, as one list; "" counts as
# none. null (a note whose parts are not known, carried over from a row an
# older checker wrote) when any of them is: the panel then reads the
# English field.
parts_cat() {
  local p out=""
  for p; do
    [[ $p != null ]] || { echo null; return 0; }
    p=${p#[}
    p=${p%]}
    [[ -z $p ]] || out+=${out:+,}$p
  done
  echo "[$out]"
}

# say_parts <parts>: the note in the user's language, its clauses joined by
# "; " as the English fields join them; a date argument ({date: epoch
# seconds}) as the English fields write it. "" for null.
say_parts() {
  i18n_load
  jq -r --argjson p "$1" "$jq_i18n"'
    . as $c
    | [($p // [])[] | .key as $k | [.args[] | if type == "object" then .date | strflocaltime("%b %-d %H:%M") else . end] as $a
      | ($c[$k] // $k) | i18n_fill($a)] | join("; ")' <<<"$i18n_strings"
}

# Omabump's own row ("self:omabump"): the installed version is this copy's
# manifest.json, the newest one the GitHub release. Update fast-forwards the
# plugin directory to the release tag (self_plan), so it has to be a git
# clone of its own, as `omarchy plugin add` leaves it; a symlink or a copy
# without .git is a developer checkout.
self_pkg=self:omabump
self_plugin_id=io.github.vladkarok.omabump
plugins_dir=$HOME/.config/omarchy/plugins
self_app='{"pkg": "self:omabump", "label": "Omabump", "source": "self", "feed": {"type": "github-release", "repo": "vladkarok/omabump"}}'
self_version() { jq -r '.version // ""' "$plugin_dir/manifest.json" 2>/dev/null; }
self_git_managed() {
  local dir=$plugins_dir/$self_plugin_id
  [[ ! -L $dir && -d $dir/.git ]] || return 1
  [[ $(cd "$dir" && pwd -P) == "$(cd "$plugin_dir" && pwd -P)" ]]
}

# Names that reach pacman, file names, git and mise. A package name as Arch
# allows it, never starting with a dot or dash; an app id is that or, for a
# mise row, "mise:<name>"; a mise tool may also carry a backend prefix and a
# scope (npm:@scope/name); a git ref sits under refs/. None may hold "..".
pkg_name_ok() { [[ $1 =~ ^[a-z0-9@_+][a-z0-9@._+-]*$ ]]; }
app_id_ok() { pkg_name_ok "$1" || { [[ $1 == mise:* ]] && pkg_name_ok "${1#mise:}"; } || [[ $1 == "$self_pkg" ]]; }
tool_name_ok() { [[ $1 =~ ^[A-Za-z0-9@_+:][A-Za-z0-9@._+:/-]*$ && $1 != *..* ]]; }
ref_ok() { [[ $1 =~ ^refs/[A-Za-z0-9._/-]+$ && $1 != *..* ]]; }
# An app's "appImage" or "npmPackage" (see installed_app): a path under
# your home, written ~/<path>, at most 200 characters of letters, digits
# and ._+- with no "." or ".." component (and no ".." at all, as in the
# names above). It reaches status.json as written, so it has no blank
# either. In apps.json, null or "" is none: a user's file turns a shipped
# one off with "", as it does updateBlocked.
home_path_ok() {
  local re='^~(/[A-Za-z0-9._+-]+)+$'
  [[ ${#1} -le 200 && $1 =~ $re && $1 != *..* && $1 != */. && $1 != */./* ]]
}
# The same rules as jq definitions, for apps_table. \z, not $: in jq's
# regexes $ also matches before a final newline, which bash's =~ refuses.
# A mise row is mise's tool, never a file, so its appImage and npmPackage
# can only be none. selfUpdate is text for the note, at most 100
# characters.
jq_name_rules='
  def pkg_ok: type == "string" and test("^[a-z0-9@_+][a-z0-9@._+-]*\\z");
  def id_ok: pkg_ok or (type == "string" and startswith("mise:") and (.[5:] | pkg_ok));
  def tool_ok: type == "string" and test("^[A-Za-z0-9@_+:][A-Za-z0-9@._+:/-]*\\z") and (contains("..") | not);
  def home_path_ok: type == "string" and length <= 200 and test("^~(/[A-Za-z0-9._+-]+)+\\z")
    and (contains("..") | not) and (test("/\\.(/|\\z)") | not);
  def entry_ok: (.pkg | id_ok) and ((.pkg | pkg_ok) or .source == "mise")
    and (.source | IN(@SOURCES@))
    and ((.build // false) | type == "boolean")
    and ((.section // "cli") | IN("desktop", "cli")) and (.source != "mise" or (.section // "cli") == "cli")
    and ((.installed // []) | type == "array" and all(.[]; pkg_ok))
    and ([.tool // empty] | flatten | all(.[]; tool_ok))
    and ((.updateBlocked // "") | type == "string" and length <= 200)
    and ((.selfUpdate // "") | type == "string" and length <= 100)
    and ((.appImage // "") == "" or (.source != "mise" and (.appImage | home_path_ok)))
    and ((.npmPackage // "") == "" or (.source != "mise" and (.npmPackage | home_path_ok)));'

# A version as mise or a feed prints it, for a skipped version: what
# version_ok allows plus "-" (mise versions such as 1.0.0-beta.1), or a
# full pacman version, epoch included (a repo row's newest can be
# 1:2.0-1). Model.js (skipToggled) checks the same rule before it stores a
# skip.
skip_version_ok() {
  { [[ ${#1} -le 64 && $1 =~ ^[0-9A-Za-z][A-Za-z0-9._+~-]*$ && $1 != *..* ]]; } || full_version_ok "$1"
}

# The rows the user muted (widget setting mutedApps, an array of pkg ids) and
# the versions the user skipped (skippedVersions, an object of pkg id to
# version), read from the widget's entry in Omarchy's shell.json: the one with
# the plugin's id in bar.layout.left/center/right or in the top-level
# plugins list. The checker reads them itself, so every run (the shell's
# timer, a terminal, the installer's refresh) honours them. Sets muted_json
# (an array) and skipped_json (an object). The file is read only up to
# 1 MiB, each setting only up to 200 entries, and an id or version the rules
# above refuse is dropped with a line on stderr; nothing else in the file is
# used but the notify, showCli and buildAhead settings: setting_notify,
# setting_show_cli and setting_build_ahead are "true" or "false" as the
# widget reads them (a boolean, or the string "true" or "false" in any
# case, as `omarchy bar set` without --json stores it), else empty.
# showCli was showMise until 0.1.19: the old key counts while the new one
# is absent (Model.settingValue reads it the same way), and the panel's
# next settings write stores the new key; the old one can go once no
# shell.json written before 0.2.0 is left to read.
shell_json=$HOME/.config/omarchy/shell.json
muted_json='[]' skipped_json='{}' setting_notify="" setting_show_cli="" setting_build_ahead=""
quiet_max=200
load_quiet() {
  local entry size ids=() pairs=() id ver
  muted_json='[]' skipped_json='{}' setting_notify="" setting_show_cli="" setting_build_ahead=""
  [[ -f $shell_json ]] || return 0
  size=$(head -c 1048577 -- "$shell_json" 2>/dev/null | wc -c)
  (( size <= 1048576 )) || { echo "ignoring $shell_json: larger than 1 MiB" >&2; return 0; }
  entry=$(head -c 1048576 -- "$shell_json" | jq -c --arg id "$self_plugin_id" --argjson max "$quiet_max" '
    def flag: if type == "boolean" then tostring
      elif type == "string" then sub("^\\s+"; "") | sub("\\s+$"; "") | ascii_downcase | select(. == "true" or . == "false")
      else empty end;
    [(.bar?.layout? | objects | (.left, .center, .right) | arrays | .[]), (.plugins? | arrays | .[])]
    | map(objects | select(.id == $id))[0] // {}
    | {muted: [.mutedApps | arrays | .[] | strings], skipped: [.skippedVersions | objects | to_entries[] | select(.value | type == "string")],
       notify: (first(.notify | flag) // ""), showCli: (first(.showCli | flag) // first(.showMise | flag) // ""),
       buildAhead: (first(.buildAhead | flag) // "")}
    | (if (.muted | length) > $max or (.skipped | length) > $max then "more than \($max) muted or skipped entries; using the first \($max)" else "" end) as $cap
    | {muted: .muted[:$max], skipped: .skipped[:$max], cap: $cap, notify, showCli, buildAhead}' 2>/dev/null) \
    || { echo "ignoring $shell_json: not JSON" >&2; return 0; }
  [[ -z $(jq -r .cap <<<"$entry") ]] || echo "$shell_json: $(jq -r .cap <<<"$entry")" >&2
  setting_notify=$(jq -r .notify <<<"$entry") setting_show_cli=$(jq -r .showCli <<<"$entry")
  setting_build_ahead=$(jq -r .buildAhead <<<"$entry")
  while IFS= read -r id; do
    if app_id_ok "$id"; then ids+=("$id"); else echo "ignoring muted id $(jq -Rc . <<<"$id")" >&2; fi
  done < <(jq -r '.muted[] | select(test("\n") | not)' <<<"$entry")
  while IFS=$'\t' read -r id ver; do
    if app_id_ok "$id" && skip_version_ok "$ver"; then pairs+=("$id"$'\t'"$ver")
    else echo "ignoring skipped entry $(jq -Rc . <<<"$id=$ver")" >&2; fi
  done < <(jq -r '.skipped[] | select((.key + .value) | test("[\t\n]") | not) | "\(.key)\t\(.value)"' <<<"$entry")
  (( ${#ids[@]} )) && muted_json=$(printf '%s\n' "${ids[@]}" | jq -Rsc 'split("\n") | map(select(. != "")) | unique')
  (( ${#pairs[@]} )) && skipped_json=$(printf '%s\n' "${pairs[@]}" | jq -Rnc '[inputs | split("\t") | {(.[0]): .[1]}] | add // {}')
  return 0
}

# True when the row of the id $1 is muted. A text test: the ids in
# muted_json are ones app_id_ok accepts, which JSON writes without escapes.
row_muted() { [[ $muted_json == *"\"$1\""* ]]; }

# --- routes ----------------------------------------------------------------------
#
# A row's source names its route: how its versions are read and compared,
# and what Update can do. The facts below are asked here (route), not of
# the source's name; what a route runs (the check's route case, the
# installer's, mise's own readers) stays with the code that runs it, and
# so do the rules that name mise for what they are about: Show CLI tools,
# mise's inventory failing, a mise row's id and tool name in apps.json.
# One line a route:
#   versions   how a newer version is told: vercmp, or exact (a string
#              that differs: mise decides what is newer, and vercmp would
#              call 1.0.0 and 1.0.0-beta.1 equal; Omabump's release tags
#              likewise)
#   newest     where the newest version comes from: the feed in apps.json,
#              mise (mise outdated), or repo: Omarchy's repo [omarchy],
#              whose package Update installs, with the entry's feed, when
#              it has one, for a release the vendor has and the repo not
#              yet (ahead; repo_derive)
#   installed  what reads the installed version: pacman (or the app's own
#              copy, installed_app), mise's inventory, or Omabump's
#              manifest.json
#   switch     yes when Update installs a package by the row's pkg, and so
#              can replace one installed under another name (Switch)
#   section    where the row sits: with the desktop apps, the CLI tools, or
#              Omabump itself (row_order; the panel's sections, the row's
#              section)
#   build      yes when Build now can build Omarchy's own recipe for an
#              entry that says "build": true (build_allowed), while the
#              vendor is ahead of the repo
# An app installed as a copy that updates itself (selfUpdating) is listed
# under its source, and its row carries the source's section and switch,
# but it takes no route: no Update (installable false), and so no Switch,
# its version from a file and compared by self_row.
route_table='
  repo        vercmp  repo  pacman    yes  desktop  yes
  vendor-pkg  vercmp  feed  pacman    yes  desktop  no
  indicator   vercmp  feed  pacman    no   desktop  no
  mise        exact   mise  mise      no   cli      no
  self        exact   feed  manifest  no   plugin   no'
declare -gA route_facts=()
route_names=()
while read -r _route _versions _newest _installed _switch _section _build; do
  [[ -n $_route ]] || continue
  route_names+=("$_route")
  route_facts[$_route.versions]=$_versions route_facts[$_route.newest]=$_newest
  route_facts[$_route.installed]=$_installed route_facts[$_route.switch]=$_switch
  route_facts[$_route.section]=$_section route_facts[$_route.build]=$_build
done <<<"$route_table"
unset _route _versions _newest _installed _switch _section _build
# The sources an apps.json entry may name (entry_ok): every route but
# Omabump's own.
_sources=""
for _route in "${route_names[@]}"; do [[ $_route == self ]] || _sources+="${_sources:+, }\"$_route\""; done
jq_name_rules=${jq_name_rules//@SOURCES@/$_sources}
unset _route _sources

# True when the route of the source $1 has the fact $2 at the value $3
# (route_table). A source no route names has none.
route() { [[ ${route_facts[$1.$2]:-} == "$3" ]]; }

# True when Build now may build Omarchy's recipe for the app $1 (its
# entry): its route builds (route_table's build) and the entry says
# "build": true. The one place that reads the entry's build.
build_allowed() {
  route "$(jq -r '.source // ""' <<<"$1")" build yes && jq -e '.build == true' >/dev/null 2>&1 <<<"$1"
}

# The jq definitions for the same: route_section, the section of a row or
# of an apps.json entry: the one it names ("section": "cli" puts a pacman
# package among the CLI tools), else its source's, desktop for a source no
# route names; and route_rank, where that section comes: desktop apps, CLI
# tools, Omabump itself. The names and sections are
# route_table's words, which need no escapes in JSON.
_sections=""
for _route in "${route_names[@]}"; do _sections+="${_sections:+, }\"$_route\": \"${route_facts[$_route.section]}\""; done
jq_routes="
  def route_section: (.section | select(IN(\"desktop\", \"cli\", \"plugin\")))
    // {$_sections}[.source | strings] // \"desktop\";
  def route_rank: {desktop: 0, cli: 1, plugin: 2}[route_section];"
unset _route _sections

# Versions of a route that compares them exactly (route_table's versions).
string_versions() { route "$1" versions exact; }

# True when a row's update is the version the user skipped, or (vercmp
# sources) older. A newer release than the skipped one lights the row up
# again. $1 source, $2 update (true/false), $3 latest, $4 skipped version.
row_skipped() {
  [[ $2 == true && -n $4 && -n $3 ]] || return 1
  if string_versions "$1"; then [[ $3 == "$4" ]]; else ! newer "$3" "$(skip_beside "$3" "$4")"; fi
}

# The skipped version $2 as it compares with a row's latest $1. A repo
# row's latest is the repo's full version at one check and the vendor's
# upstream version at another: against an upstream version a skipped full
# one (1:2.0-2) counts by its upstream part, or its epoch would outrank
# every later release the vendor names.
skip_beside() {
  if full_version_ok "$2" && ! full_version_ok "$1"; then upstream_part "$2"; else printf '%s\n' "$2"; fi
}

# True when a skip is over and may leave the settings: a newer release than
# the skipped version, or that version or a later one installed (vercmp
# sources); a mise or self row no longer at it. A skip of a version still
# to come stays. The panel compares no versions, so it drops a skip only on
# this answer (the row's skipEnded), never one no run has read yet.
# $1 source, $2 update (true/false), $3 latest, $4 skipped version,
# $5 installed version.
skip_over() {
  local have=$5
  [[ -n $4 && -n $3 ]] || return 1
  # A skipped full version (a repo row's 1:2.0-1) against the full version
  # installed; an upstream one against its upstream part.
  full_version_ok "$4" || have=$(upstream_part "$5")
  if string_versions "$1"; then ! row_skipped "$1" "$2" "$3" "$4"
  else newer "$3" "$(skip_beside "$3" "$4")" || ! newer "$4" "$have"; fi
}

# The settings' word on the row of the id $1 (load_quiet): sets muted,
# skipped (row_skipped), skip_end (the skip's version when skip_over says
# it is over, else "") and quiet (muted or skipped). $2 source, $3 update
# (true/false), $4 latest, $5 installed version.
row_quiet() {
  local skip
  muted=false skipped=false skip_end="" quiet=false
  row_muted "$1" && muted=true
  skip=$(jq -r --arg pkg "$1" '.[$pkg] // ""' <<<"$skipped_json")
  row_skipped "$2" "$3" "$4" "$skip" && skipped=true
  skip_over "$2" "$3" "$4" "$skip" "$5" && skip_end=$skip
  [[ $muted == false && $skipped == false ]] || quiet=true
}

# A row's skipEnded (row_quiet's skip_end), the row given as JSON in $1,
# on stdout; nothing when no skip is over.
skip_ended() {
  local pkg source update latest installed muted skipped skip_end quiet
  IFS=$'\x1f' read -r pkg source update latest installed < <(jq -r '
    [.pkg, .source // "", .updateAvailable == true, .latest // "", .installed // ""] | map(tostring) | join("\u001f")' <<<"$1")
  row_quiet "$pkg" "$source" "$update" "$latest" "$installed"
  [[ -z $skip_end ]] || echo "$skip_end"
}

# What to do about a row's newer version once per version: "send" a
# notification, "record" it as announced without one (a quiet row: muted, or
# at a skipped version; undoing either does not announce it late), or
# nothing (no update, a failed check, or already announced). "Not announced
# yet" is a different string for mise and self rows, a newer vercmp version
# for the others. $1 source, $2 update (true/false), $3 error text, $4 quiet
# (true/false), $5 latest, $6 the version last announced.
announce_action() {
  [[ $2 == true && -z $3 ]] || return 0
  if [[ -n $6 ]]; then
    if string_versions "$1"; then [[ $5 != "$6" ]] || return 0
    else newer "$5" "$6" || return 0; fi
  fi
  if [[ $4 == true ]]; then echo record; else echo send; fi
}

# The omarchy-pkgs commit every recipe read, sync and build starts from:
# pins.json's 40-hex commit, with the user's pins.json merged over it. The
# install path runs that repo's sync tool and hook scripts, so a moving
# branch is never the default. "omarchyPkgs": {"follow": "master"} in the
# user's file opts in to origin/master; pkgs_fetch then resolves it to a
# commit. Sets pkgs_base (empty when the pin is unusable), pkgs_follow and
# pkgs_pin_ref; pkgs_pin_error says why a pin is unusable. This runs when
# the file is sourced, so a pins.json of the wrong shape (omarchyPkgs not an
# object, a field not a string) is a pin error Build now shows, never
# a jq error that would end every check and install under set -e.
pkgs_base="" pkgs_follow=0 pkgs_pin_ref="" pkgs_pin_error=""
pkgs_pin() {
  local user=/dev/null pins follow
  if [[ -f $user_pins ]]; then
    if jq -se 'length == 1 and (.[0] | type == "object")' "$user_pins" >/dev/null 2>&1; then
      user=$user_pins
    else
      echo "ignoring $user_pins: not a JSON object" >&2
    fi
  fi
  # The user's file goes in with --slurpfile, never as an argv string.
  pins=$(jq -c --slurpfile user "$user" '. * ($user[0] // {}) | .omarchyPkgs // {}' "$shipped_pins" 2>/dev/null) || pins='{}'
  if ! jq -e 'type == "object"' >/dev/null 2>&1 <<<"$pins"; then
    pkgs_pin_error="omarchyPkgs in pins.json is not an object"
    return 0
  fi
  pin_field follow follow "" || return 0
  if [[ $follow == master ]]; then
    pkgs_follow=1 pkgs_pin_ref=refs/heads/master
    return 0
  fi
  [[ -z $follow ]] || { pkgs_pin_error="omarchyPkgs.follow '$follow' is not \"master\""; return 0; }
  pin_field pkgs_base commit "" || return 0
  pin_field pkgs_pin_ref ref refs/heads/master || { pkgs_base=""; return 0; }
  if ! ref_ok "$pkgs_pin_ref"; then
    pkgs_pin_error="the omarchy-pkgs pin ref '$pkgs_pin_ref' is not a refs/ name"
    pkgs_base="" pkgs_pin_ref=""
    return 0
  fi
  if [[ ! $pkgs_base =~ ^[0-9a-f]{40}$ ]]; then
    pkgs_pin_error="the omarchy-pkgs pin '$pkgs_base' is not a 40-hex commit"
    pkgs_base=""
  fi
}
# Sets the variable $1 to the string field $2 of pkgs_pin's $pins, or to $3
# when the field is unset; any other type sets pkgs_pin_error and fails.
pin_field() {
  local value
  value=$(jq -er --arg f "$2" --arg d "$3" '.[$f] // $d | strings' <<<"$pins" 2>/dev/null) \
    || { pkgs_pin_error="omarchyPkgs.$2 in pins.json is not a string"; return 1; }
  printf -v "$1" '%s' "$value"
}
pkgs_pin

# The user's apps.json when it holds a JSON array, else /dev/null, with a
# line on stderr unless $1 is "quiet".
user_apps_json() {
  if [[ -f $user_apps ]]; then
    if jq -se 'length == 1 and (.[0] | type == "array")' "$user_apps" >/dev/null 2>&1; then
      echo "$user_apps"
      return 0
    fi
    [[ ${1:-} == quiet ]] || echo "ignoring $user_apps: not a JSON array" >&2
  fi
  echo /dev/null
}

# The shipped table (the input) with the user's entries $u merged over it by
# pkg, as {order: [pkg], by: {pkg: entry}}.
# shellcheck disable=SC2016 # jq variables, not the shell's
jq_apps_merge='
  def apps_merge($u): map(select(type == "object") | del(._userFeed))
    + ($u | map(del(._userFeed) | if has("feed") then ._userFeed = true else . end))
    | map(select(.pkg | type == "string"))
    | reduce .[] as $a ({order: [], by: {}};
      if .by[$a.pkg] then .by[$a.pkg] += $a
      else .order += [$a.pkg] | .by[$a.pkg] = $a end);'

# The app table: the shipped one, with the user's file merged over it by pkg.
# A user entry adds an app or overrides fields of a shipped one; "disabled":
# true hides it. "source": "omarchy", the route that built every Omarchy
# app until 0.1.19, reads as "repo" with "build": true (unless the entry
# says build itself): Update takes the repo's package, and Build now the
# recipe. A shim for users' files of 0.1.19 and before; it can go once
# such files are not expected any more. Shipped order comes first, user additions after. An entry
# whose feed the user's file set carries "_userFeed": true (never taken from
# either file), which feed_version requires for a command feed. An entry
# whose pkg, installed names, tool names, appImage, npmPackage, updateBlocked,
# selfUpdate or build break the rules above is dropped with a line on
# stderr. The source must be one of the four route names a file may give;
# "self" is Omabump's own row and never comes from a file. An entry larger than app_entry_max bytes is
# dropped the same way: an entry goes to jq as one argv string (--argjson
# app), and the kernel refuses a string over 128 KiB (E2BIG), which would end
# every check.
#
# The CLI rows are the mise entries of that table and nothing else: the
# agents Omarchy offers are listed in apps.json, each with the keys mise may
# have it under, and a row shows when mise has one of them installed and
# active (mise_active). An agent Omarchy adds later needs its entry there, or
# in the user's file.
app_entry_max=65536
apps_table() {
  local user merged
  user=$(user_apps_json)
  # The user's file goes in with --slurpfile, never as an argv string.
  merged=$(jq -c --slurpfile user "$user" "$jq_apps_merge"'
    ($user[0] // [] | map(select(type == "object"))) as $u
    | apps_merge($u)
    | [.order[] as $p | .by[$p] | select(.disabled != true)
       | if .source == "omarchy" then .source = "repo" | (if has("build") then . else .build = true end) else . end]' \
    "$shipped_apps") || return 1
  jq -r --argjson max "$app_entry_max" "$jq_name_rules"' .[]
    | if entry_ok | not then "ignoring app \(.pkg | tojson): a pkg, installed or tool name with characters Omabump does not accept, an appImage or npmPackage that is not a ~/ path Omabump accepts, an updateBlocked or selfUpdate too long, a source other than repo, vendor-pkg, mise or indicator (omarchy reads as repo), a build that is not true or false, or a section other than desktop or cli"
      elif (tojson | utf8bytelength) > $max then "ignoring app \(.pkg | tojson): its entry is larger than \($max) bytes"
      else empty end' <<<"$merged" >&2
  jq -c --argjson max "$app_entry_max" "$jq_name_rules"' map(select(entry_ok and (tojson | utf8bytelength) <= $max))' <<<"$merged"
}

# The table every step of one run works on: the merge happens once, here,
# so the check, mise_load and app_json agree. Call it in the script's own
# shell (not in a subshell, the value would be lost there).
app_table=""
load_table() { app_table=$(apps_table) || app_table='[]'; }

# An app by its pkg, or else by one of its installed package or mise tool
# names, so `omabump-install z-code-bin` finds ZCode.
app_json() {
  [[ -n $app_table ]] || load_table
  jq -ce --arg n "$1" '
    ([.[] | select(.pkg == $n)] + [.[] | select(((.installed // []) + ([.tool // empty] | flatten)) | index($n))])[0]
    // error("no app")' <<<"$app_table" 2>/dev/null
}

# Text bound for status.json and notifications, made inert: control
# characters dropped and < > & replaced, since a tooltip may render rich text
# and notify-send bodies are markup. In bash, without tr or sed: a check
# calls it for every field of every row. A bash string never holds NUL.
clean_text() {
  local s=${1//[$'\001'-$'\037'$'\177']/}
  s=${s//</‹} s=${s//>/›} s=${s//&/＆}
  printf '%s' "$s"
}

# Text printed in the terminal for the user to read before pacman (install
# scripts, the recipe diff), made unable to drive the terminal: ESC shown as
# ^[, C1 controls (UTF-8 encoded) as ?, other C0 controls but tab and
# newline dropped. UTF-8 text stays readable.
term_safe() { LC_ALL=C sed 's/\x1b/^[/g; s/\xc2[\x80-\x9f]/?/g' | LC_ALL=C tr -d '\000-\010\013-\037\177'; }

# vercmp is the only comparator: pacman, makepkg and omarchy-pkgs all use it.
newer() { (( $(vercmp "$1" "$2") > 0 )); }

# The upstream part of a pacman version: no epoch, no pkgrel.
upstream_part() { local v=${1#*:}; echo "${v%-*}"; }

# An upstream version as a feed gives it: what Arch allows in pkgver, starting
# with a letter or digit, no ".." anywhere (so never a "." or ".." path
# component in a {version} URL) and at most 64 characters. Versions end up in
# sed expressions, URLs and file names, so anything else is a feed error.
# Feed versions never carry an epoch; full_version_ok takes pacman's.
version_ok() { [[ ${#1} -le 64 && $1 =~ ^[0-9A-Za-z][A-Za-z0-9._+~]*$ && $1 != *..* ]]; }

# A full pacman version: [epoch:]pkgver-pkgrel, pkgver as version_ok has it.
full_version_ok() {
  local v=$1 rel
  if [[ $v == *:* ]]; then
    [[ ${v%%:*} =~ ^[0-9]{1,9}$ ]] || return 1
    v=${v#*:}
  fi
  [[ $v == *-* ]] || return 1
  rel=${v##*-}
  [[ $rel =~ ^[0-9]+(\.[0-9]+)?$ ]] && version_ok "${v%-*}"
}

# Prints "<name> <full version>" for the first of the given names pacman has
# installed. Only exact names count: a provide could be an unrelated package.
installed_package() {
  local name line
  for name in "$@"; do
    [[ -n $name ]] || continue
    line=$(pacman -Q -- "$name" 2>/dev/null) || continue
    [[ ${line%% *} == "$name" ]] || continue
    echo "$line"
    return 0
  done
  return 1
}

# mise answers depend on the config files of the current directory, so every
# mise call runs in $HOME, in the check and the installer alike. asdf and
# vfox plugins are scripts: with those backends (and every installed plugin
# by name) disabled for Omabump's calls,
# no plugin script runs while mise resolves your config (mise ls still lists
# such a tool, it just cannot be checked or updated here).
# A vfox backend plugin is disabled by its own name, not by "vfox", so every
# installed plugin is listed too: the names of the directories in mise's
# plugins directory, read without running anything.
# MISE_DISABLE_BACKENDS replaces mise's disable_backends setting for the
# call, so the backends you disabled yourself are added: your environment's
# MISE_DISABLE_BACKENDS and mise's setting (mise_user_backends, which
# mise_backends_load reads once per run). A name with other characters is
# left out, and each name is listed once.
mise_user_backends=""
mise_disabled_backends() {
  local dir=${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/plugins name names=(asdf vfox) user=() out=()
  if [[ -d $dir ]]; then
    for name in "$dir"/*; do names+=("${name##*/}"); done
  fi
  IFS=, read -ra user <<<"${MISE_DISABLE_BACKENDS:-},$mise_user_backends"
  for name in "${user[@]}"; do names+=("${name// /}"); done
  for name in "${names[@]}"; do
    [[ $name =~ ^[A-Za-z0-9._:-]+$ && $name != .* && " ${out[*]} " != *" $name "* ]] && out+=("$name")
  done
  (IFS=,; echo "${out[*]}")
}
# Tools mise is told to leave alone (MISE_DISABLE_TOOLS): yours (your
# environment's MISE_DISABLE_TOOLS and mise's disable_tools setting,
# mise_user_tools, read with mise_user_backends) and the tools your config
# names that are not installed (mise_unused_tools, mise_unused_load).
# Omarchy's config names some twenty agent CLIs, most never installed, and
# mise would resolve each one's "latest" over the network on every call,
# for nothing Omabump shows. Not the unused ones for mise install or up
# (mise_run): those end by rewriting the shims of every tool not disabled,
# and an unused tool's shim is how Omarchy installs it on first use. A name
# with other characters is left out, and each name is listed once.
mise_user_tools="" mise_unused_tools=""
mise_disabled_tools() {
  local name names=() out=()
  IFS=, read -ra names <<<"${MISE_DISABLE_TOOLS:-},$mise_user_tools,$mise_unused_tools"
  for name in "${names[@]}"; do
    # Spaces around a name go; one inside it makes it odd.
    name=${name#"${name%%[! ]*}"} name=${name%"${name##*[! ]}"}
    [[ $name =~ ^[A-Za-z0-9._:@/-]+$ && $name != .* && " ${out[*]} " != *" $name "* ]] && out+=("$name")
  done
  (IFS=,; echo "${out[*]}")
}

# No release-age cooldown, as Omarchy's own agent wrappers and `omarchy
# update` run mise: an agent CLI's new release shows and installs at once.
# Finding the newest version skips mise's versions host
# (mise-versions.jdx.dev), which can list a release hours after its tag (a
# day for Codex): mise asks the tool's own source, one light request per
# tool (GitHub's /releases/latest for aqua and github tools), and caches the
# answer for an hour (fetch_remote_versions_cache). Installing a version
# already found goes through the host (mise_versions_host=1, the
# installer), unless you turned the host off (mise_user_host): there mise
# maps the version to its release from the host's cache, where GitHub's
# own list of releases can be tens of MB (45 MB for Codex) and often times
# out. Never with mise's install counter.
# `mise settings` resolves no tool, so it runs no plugin code; it gets no
# MISE_DISABLE_BACKENDS of Omabump's, which would replace the setting asked.
# With mise_offline=1 mise fetches nothing: the inventory (mise ls, which
# would otherwise resolve "latest" for each configured tool not installed)
# and the local refresh. The active versions it lists are the same.
mise_offline=0 mise_versions_host=0
mise_run() {
  local off=() host=false unused=$mise_unused_tools
  (( ! mise_versions_host )) || [[ $mise_user_host != true ]] || host=true
  [[ ${1:-} != install && ${1:-} != up ]] || unused=""
  [[ ${1:-} == settings ]] || off=("MISE_DISABLE_BACKENDS=$(mise_disabled_backends)"
    "MISE_DISABLE_TOOLS=$(mise_unused_tools=$unused mise_disabled_tools)" "MISE_USE_VERSIONS_HOST=$host")
  (( ! mise_offline )) || off+=(MISE_OFFLINE=1)
  (cd "$HOME" && run_killable env MISE_HIDE_UPDATE_WARNING=1 MISE_MINIMUM_RELEASE_AGE=0 MISE_USE_VERSIONS_HOST_TRACK=false \
    "${off[@]}" timeout -k 10 "${mise_timeout:-120}" mise "$@" </dev/null)
}

# mise's own settings, as `mise settings ls --all --json` gives them, your
# environment's MISE_* included, read once per run by mise_load:
# disable_backends and disable_tools (lists) into mise_user_backends and
# mise_user_tools, use_versions_host into mise_user_host (false only when
# you turned it off), and for mise_github_token whether a
# github.credential_command or github.use_git_credentials gives it a token
# (mise_user_github_auth) and whether it reads gh's (github.gh_cli_tokens,
# on by default: mise_user_gh_tokens). A mise that cannot answer leaves
# them out.
mise_user_host=true mise_user_github_auth=false mise_user_gh_tokens=true
mise_backends_load() {
  local out
  mise_user_backends="" mise_user_tools="" mise_user_host=true mise_user_github_auth=false mise_user_gh_tokens=true
  out=$(mise_run settings ls --all --json 2>/dev/null) || return 0
  IFS=$'\x1f' read -r mise_user_backends mise_user_tools mise_user_host mise_user_github_auth mise_user_gh_tokens < <(jq -r '
    def names: if type == "array" then map(strings) | join(",") else strings // "" end;
    [(.disable_backends | names), (.disable_tools | names), (.use_versions_host != false | tostring),
     ((.github.credential_command? | strings // "") != "" or .github.use_git_credentials? == true | tostring),
     (.github.gh_cli_tokens? != false | tostring)]
    | join("\u001f")' <<<"$out" 2>/dev/null) || { mise_user_host=true mise_user_github_auth=false mise_user_gh_tokens=true; }
}

# True when mise sends GitHub a token of yours, so that its calls count
# against your account's 5,000 an hour rather than this address's 60: one
# in its environment (MISE_GITHUB_TOKEN, GITHUB_API_TOKEN, GITHUB_TOKEN), a
# credential command or git's credentials (mise_user_github_auth), or gh's
# where gh keeps it in its hosts.yml; gh's default is the keyring, which
# mise does not read.
mise_github_token() {
  [[ -n ${MISE_GITHUB_TOKEN:-}${GITHUB_API_TOKEN:-}${GITHUB_TOKEN:-} || $mise_user_github_auth == true ]] && return 0
  [[ $mise_user_gh_tokens == true ]] \
    && grep -qs '^[[:space:]]*oauth_token:' "${GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gh}/hosts.yml"
}

# The tools your mise config names that are not installed, into
# mise_unused_tools: `mise config ls` read offline, less the inventory's
# keys. Nothing when mise cannot list its config.
mise_unused_load() {
  local out
  mise_unused_tools=""
  out=$(mise_offline=1 mise_run config ls --json 2>/dev/null) || return 0
  # Both on stdin: the inventory can outgrow an argument.
  mise_unused_tools=$(printf '%s\n%s\n' "$out" "$mise_ls_json" | jq -rn '
    input as $config | input as $ls
    | [$config | .[]? | objects | .tools[]? | strings] | unique | map(select(. as $t | $ls | has($t) | not)) | join(",")' \
    2>/dev/null) || mise_unused_tools=""
}

# mise_load fills these once, in the calling shell (never call it in a
# subshell, the values would be lost there):
#   mise_user_backends  mise's disable_backends setting (mise_backends_load)
#   mise_user_tools     mise's disable_tools setting (mise_backends_load)
#   mise_ls_json        `mise ls --json`, the inventory, read offline
#   mise_safe_json      {key: true} for the installed tools that resolve
#                       through a backend in mise_safe_backends, from one
#                       `mise ls --json --backend <b> --backend <b2> ...`
#                       (which classifies registry shorthands by the backend
#                       they resolve to)
# and with $1=1 mise_unused_tools (mise_unused_load), then, for the key
# each mise row selected (mise_select) that is also safe:
#   mise_outdated_json  `mise outdated --json`: what `mise up` reaches under
#                       the configured request
#   mise_bump_json      `mise outdated --bump --json`: newer releases outside
#                       the request
# All keyed by tool name. mise versions are kept as mise prints them and
# never compared with vercmp: mise decides. Resolving a version can run a
# backend's own scripts (asdf and vfox plugins), so outdated is asked about
# the selected keys on mise's own backends only, never about every tool; a
# row on another backend shows its installed version and "Update check
# skipped". Each outdated call fails on its own: mise_error and
# mise_bump_error say why. The allowed backends are the ones agent CLIs ship
# on; mise's core languages, go and gem are left out.
mise_safe_backends=(aqua github gitlab forgejo npm http ubi pipx cargo)
mise_ls_json='{}' mise_safe_json='{}' mise_outdated_json='{}' mise_bump_json='{}'
mise_error="" mise_bump_error="" mise_backend_error="" mise_inventory_error="" mise_query=()
# mise outdated leaves out a tool whose versions it could not fetch (offline,
# rate limited) and still exits 0; only a warning on stderr names the tool.
# Those keys, with mise's reason, so such a row never reads as current.
declare -gA mise_fetch_failed=()
# The keys a check did not ask about, to leave GitHub's last API calls to
# you (mise_github_reserve), with the reason.
declare -gA mise_held=()

# The first line of a mise error, colours and warnings dropped. mise can
# fail with nothing on stderr (killed by its timeout), so this never fails:
# its callers run under set -e.
mise_err_line() {
  local line
  line=$(sed 's/\x1b\[[0-9;]*m//g' "$1" | grep -v 'WARN' | grep -v '^[[:space:]]*$' | head -1) || true
  echo "${line:-no error message}"
}

# A failed listing is mise_inventory_error: no mise row can be read then,
# and none may read as current or vanish without a word.
mise_inventory() {
  local out err
  mise_inventory_error=""
  mkdir -p "$cache_dir"
  err=$(mktemp "${run_tmp:-$cache_dir}/.mise.XXXXXX")
  if out=$(mise_offline=1 mise_run ls --json 2>"$err") && out=$(jq -ce 'if type == "object" then . else {} end' <<<"$out" 2>/dev/null); then
    mise_ls_json=$out
  else
    mise_ls_json='{}'
    mise_inventory_error="mise ls failed: $(mise_err_line "$err")"
  fi
  rm -f "$err"
}

# One listing for all allowed backends. When it fails, no tool is checked
# and mise_backend_error says why.
mise_safe_keys() {
  local b out args=()
  mise_backend_error="" mise_safe_json='{}'
  for b in "${mise_safe_backends[@]}"; do args+=(--backend "$b"); done
  if out=$(mise_offline=1 mise_run ls --json "${args[@]}" 2>/dev/null) \
     && out=$(jq -ce 'if type == "object" then with_entries(.value = true) else error("bad") end' <<<"$out" 2>/dev/null); then
    mise_safe_json=$out
  else
    mise_backend_error="mise ls --backend failed"
  fi
}

# The key a mise row resolves to: the first of its tool names that mise has
# installed and active, with that version, or null. One definition for
# mise_select and mise_active, so the outdated calls and the rows agree.
# shellcheck disable=SC2016 # jq variables, not the shell's
mise_jq_active='
  def active($ls): first([.tool // empty] | flatten | .[] | strings as $t
    | ($ls[$t] // [])[]? | select(type == "object" and .active == true and .installed != false)
    | {key: $t, version: (.version | tostring)}) // null;'

# The key each mise row of the frozen table resolves to that is on a safe
# backend, unique: the only names the outdated calls see. The inventory can
# be large, so it reaches jq as a file, never as an argument. A failure is
# mise_error: no row may then read as current.
mise_select() {
  local d out rc=0
  mise_query=()
  mkdir -p "$cache_dir"
  # Called as `mise_select || ...`, where set -e does not stop a failed
  # mktemp: without this the files would go to /.
  if ! d=$(mktemp -d "${run_tmp:-$cache_dir}/.mise-select.XXXXXX"); then
    mise_error="could not select the mise tools to check"
    return 1
  fi
  printf '%s\n' "$mise_ls_json" >"$d/ls.json"
  printf '%s\n' "$mise_safe_json" >"$d/safe.json"
  out=$(jq -r --slurpfile ls "$d/ls.json" --slurpfile safe "$d/safe.json" "$mise_jq_active"'
    $ls[0] as $ls | $safe[0] as $safe
    | [.[] | select(.source == "mise") | active($ls) | .key? // empty | select($safe[.] != null)]
    | unique | .[]' <<<"$app_table" 2>/dev/null) || rc=1
  rm -rf "$d"
  if (( rc )); then
    mise_error="could not select the mise tools to check"
    return 1
  fi
  [[ -z $out ]] || mapfile -t mise_query <<<"$out"
}

# The text is read once and searched as a here-string: no pipe, so an early
# grep exit cannot fail the search with SIGPIPE under pipefail.
mise_note_fetch_failures() {
  local key line text name names backend
  text=$(sed 's/\x1b\[[0-9;]*m//g' "$1")
  for key in "${mise_query[@]}"; do
    [[ -z ${mise_fetch_failed[$key]:-} ]] || continue
    if line=$(grep -F -m1 "Error getting latest version for $key: " <<<"$text"); then
      mise_fetch_failed[$key]=${line#*"Error getting latest version for $key: "}
      continue
    fi
    # A pinned or ranged request whose version list could not be fetched
    # (a rate limit, a 504): mise leaves the entry out, exits 0 and names
    # the backend's tool, openai/codex for codex (aqua:openai/codex).
    names=("$key" "${key#*:}")
    backend=$(mise_backend_name "$key") && names+=("$backend")
    for name in "${names[@]}"; do
      line=$(grep -F -m1 "Remote versions cannot be fetched for $name: " <<<"$text") || continue
      mise_fetch_failed[$key]=${line#*"Remote versions cannot be fetched for $name: "}
      break
    done
  done
}

# The backend's name for the installed mise tool $1 (a key without a
# backend, codex), as mise recorded it at install: openai/codex for
# aqua:openai/codex. Fails when there is no such record.
mise_backend_name() {
  local full
  [[ $1 =~ ^[A-Za-z0-9._-]+$ && $1 != .* ]] || return 1
  full=$(sed -n 's/^[[:space:]]*full[[:space:]]*=[[:space:]]*"\([^"]*\)".*$/\1/p' \
    "${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/installs/$1/.mise.backend.toml" 2>/dev/null | head -n1)
  [[ $full == *:?* ]] || return 1
  echo "${full#*:}"
}

# Leaves GitHub's last API calls to you (github_api_reserve): unless mise
# sends a token of yours (mise_github_token), the check does not ask mise
# about its tools whose versions come from GitHub (the aqua, github and ubi
# backends, read offline) while GitHub's API has fewer than that many
# unauthenticated calls left for this address, or does not say. Those keys
# leave mise_query for mise_held, and their rows keep what the last check
# found and say why (mise_row). When the backends cannot be read, every
# key counts as GitHub's.
mise_github_reserve() {
  local out key why left n limit can gh=() rest=()
  mise_github_token && return 0
  if ! out=$(mise_offline=1 mise_run ls --json --backend aqua --backend github --backend ubi 2>/dev/null) \
    || ! out=$(jq -r 'if type == "object" then keys[] else error("not an object") end' <<<"$out" 2>/dev/null); then
    out=$(printf '%s\n' "${mise_query[@]}")
  fi
  for key in "${mise_query[@]}"; do
    if grep -qxF -- "$key" <<<"$out"; then gh+=("$key"); else rest+=("$key"); fi
  done
  (( ${#gh[@]} )) || return 0
  if left=$(github_api_left); then
    read -r n limit <<<"$left"
    # One call per key for a `latest` request, cached by mise for an hour;
    # a pinned or ranged one lists the tool's releases, a few calls more,
    # which the reserve takes up. Each key counts against what is left, as
    # each feed's fallback does (github_latest_tag): mise is asked about as
    # many as the calls above the reserve allow, and the rest are held.
    can=$(( n - github_api_reserve + 1 ))
    if (( can >= ${#gh[@]} )); then
      github_api_spend "${#gh[@]}"
      return 0
    fi
    why="GitHub's API has $n of its $limit calls an hour left here, which Omabump leaves to you"
    if (( can > 0 )); then
      github_api_spend "$can"
      rest+=("${gh[@]:0:can}")
      gh=("${gh[@]:can}")
      why="GitHub's API has $n of its $limit calls an hour left here, and Omabump leaves the last $github_api_reserve to you"
    fi
  else
    why="GitHub's API did not say how many calls it has left here"
  fi
  for key in "${gh[@]}"; do mise_held[$key]="$why, so mise was not asked about $key"; done
  mise_query=("${rest[@]}")
}

# $2, when given, is the one key to ask outdated about (an Update asks about
# its own tool only); it must still be one mise_select chose.
mise_load() {
  local out err only=${2:-} key all
  mise_fetch_failed=() mise_held=()
  command -v mise >/dev/null || return 0
  mise_backends_load
  mise_inventory
  (( ${1:-0} )) || return 0
  mise_unused_load
  mise_safe_keys
  mise_select || return 0
  if [[ -n $only ]]; then
    all=("${mise_query[@]}") mise_query=()
    for key in "${all[@]}"; do [[ $key != "$only" ]] || mise_query=("$key"); done
  fi
  (( ${#mise_query[@]} )) || return 0
  # An Update you asked for may spend GitHub's last calls; a check may not.
  [[ -n $only ]] || mise_github_reserve
  (( ${#mise_query[@]} )) || return 0
  mkdir -p "$cache_dir"
  err=$(mktemp "${run_tmp:-$cache_dir}/.mise.XXXXXX")
  if out=$(mise_run outdated --json -- "${mise_query[@]}" 2>"$err") && out=$(mise_outdated_table <<<"$out"); then
    mise_outdated_json=$out
  else
    mise_error="mise outdated failed: $(mise_err_line "$err")"
  fi
  mise_note_fetch_failures "$err"
  if out=$(mise_run outdated --bump --json -- "${mise_query[@]}" 2>"$err") && out=$(mise_outdated_table <<<"$out"); then
    mise_bump_json=$out
  else
    mise_bump_error="mise outdated --bump failed: $(mise_err_line "$err")"
  fi
  mise_note_fetch_failures "$err"
  rm -f "$err"
}

# The answer of `mise outdated --json` on stdin, an object of tool entries,
# with each entry's fields kept only when they are a string or a number
# without control characters, as text; an entry that is not an object is
# kept as {"odd": true}, so mise_row says the answer could not be read
# instead of calling the row current. Anything but an object fails.
mise_outdated_table() {
  jq -ce 'if type == "object" then map_values(
      if type == "object" then with_entries(select((.value | type == "string" or type == "number")
        and (.value | tostring | explode | all(. >= 32 and . != 127))) | .value |= tostring)
      else {odd: true} end)
    else error("not an object") end' 2>/dev/null
}

# True when mise_safe_keys found the key on one of mise's own backends.
mise_key_safe() { jq -e --arg k "$1" 'has($k)' <<<"$mise_safe_json" >/dev/null 2>&1; }

# Why a key is not checked, for the row: its explicit backend, else that it
# resolves to none of the allowed ones. Sets note and note_parts.
mise_skip_note() {
  if [[ -n $mise_backend_error ]]; then
    # mise_backend_error has one wording, which the part says itself.
    note="Update check skipped: $mise_backend_error" note_parts=$(part note.checkSkippedBackendList)
  elif [[ $1 == *:* ]]; then
    note="Update check skipped: ${1%%:*} backend" note_parts=$(part note.checkSkippedBackend "${1%%:*}")
  else
    note="Update check skipped: not on a backend Omabump queries" note_parts=$(part note.checkSkippedNoBackend)
  fi
}

# A field of a tool's entry in one of the outdated tables, as text, or
# nothing: whatever shape the table has, this never fails (its callers run
# under set -e), and a value that is not a string or a number is nothing.
mise_field() {
  jq -r --arg t "$2" --arg f "$3" '.[$t]? | objects | .[$f] | select(type == "string" or type == "number") | tostring' \
    <<<"$1" 2>/dev/null || true
}

# True unless the key's entry in an outdated table is one
# mise_outdated_table could not read.
mise_entry_ok() { ! jq -e --arg t "$2" '.[$t]? | objects | .odd == true' <<<"$1" >/dev/null 2>&1; }

# What the check shows for a mise row whose active key is $1 at version $2,
# and what Update installs. mise decides: an entry in `mise outdated` is a
# version `mise up` will install; one only in the --bump table lies outside
# the request. Sets latest, from, note and note_parts, installable,
# mise_update, request, feed_error and unchecked (a key on no allowed backend: no newest version
# is known), and mise_state, the outcome in one word:
#   unchecked  not on an allowed backend; note says why
#   error      no answer to go by; feed_error says why
#   update     latest is the version `mise up` reaches
#   pinned     latest exists outside the request (request), note says so
#   current    nothing newer; latest is the installed version
# Call it in the calling shell, never in a subshell: it answers through
# these variables.
mise_state=""
mise_row() {
  local key=$1 have=$2
  latest="" from=mise note="" note_parts='[]' installable=true mise_update=false request="" feed_error="" unchecked=false
  if ! mise_key_safe "$key"; then
    installable=false from="" unchecked=true
    mise_skip_note "$key"
  elif [[ -n ${mise_held[$key]:-} ]]; then
    feed_error=${mise_held[$key]}
  elif [[ -n $mise_error ]]; then
    feed_error=$mise_error
  elif [[ -n ${mise_fetch_failed[$key]:-} ]]; then
    feed_error="mise could not fetch the versions of $key: ${mise_fetch_failed[$key]}"
  elif ! mise_entry_ok "$mise_outdated_json" "$key"; then
    feed_error="mise outdated gave an entry for $key that is not an object"
  elif latest=$(mise_field "$mise_outdated_json" "$key" latest) && [[ -n $latest ]]; then
    mise_update=true
  elif [[ -n $mise_bump_error ]]; then
    feed_error=$mise_bump_error
  elif ! mise_entry_ok "$mise_bump_json" "$key"; then
    feed_error="mise outdated --bump gave an entry for $key that is not an object"
  else
    # latest is the release itself; bump is the request rewritten to reach
    # it, in the request's own shape ("0.97" for a 0.97 request at 0.97.1).
    latest=$(mise_field "$mise_bump_json" "$key" latest)
    [[ -n $latest ]] || latest=$(mise_field "$mise_bump_json" "$key" bump)
    if [[ -n $latest && $latest != "$have" ]]; then
      installable=false
      request=$(mise_field "$mise_bump_json" "$key" requested)
      if [[ $request == latest ]]; then
        note="Held back by your mise settings, $latest exists" note_parts=$(part note.miseHeld "$latest")
      else
        note="Pinned to $request, $latest exists" note_parts=$(part note.misePinned "$request" "$latest")
      fi
    else
      latest=$have
    fi
  fi
  if [[ $unchecked == true ]]; then mise_state=unchecked
  elif [[ -n $feed_error ]]; then mise_state=error
  elif [[ $mise_update == true ]]; then mise_state=update
  elif [[ $installable == false ]]; then mise_state=pinned
  else mise_state=current; fi
}

# Prints "<tool> <active version>" for the first of the app's tool names that
# mise has installed and active. The key is whatever the user's mise config
# uses, e.g. claude or npm:@anthropic-ai/claude-code.
mise_active() {
  jq -re --argjson app "$1" "$mise_jq_active"'
    . as $ls | $app | active($ls) | select(. != null) | "\(.key) \(.version)"' <<<"$mise_ls_json"
}

# --- apps that update themselves ------------------------------------------------
#
# An app may be installed as a copy that updates itself instead of a
# package, and Omabump only reads its version: the row has no Update
# (self_row, under rows below) and the installer refuses one.
#
#   appImage    the vendor's self-updating AppImage. Omarchy's migration
#               1792345511 replaced the t3code-bin package with T3 Code's
#               own AppImage, ~/.local/share/t3code/T3-Code.AppImage, and
#               its Install menu calls T3 Code installed once that file is
#               there. The app's own updater replaces the file.
#   npmPackage  the directory of an npm package that updates itself in
#               place. Omarchy's migration 1792334754 set OpenClaw up under
#               ~/.openclaw from the openclaw package, which stays as its
#               seed: upstream's installer puts the package in
#               ~/.openclaw/tools/node/lib/node_modules/openclaw, and
#               `openclaw update` replaces it there.
#
# Both are paths in apps.json (home_path_ok), and selfUpdate says how the
# app updates itself (self_update_text).

# The largest AppImage read: an Electron app such as T3 Code is 150 to 300 MB.
appimage_max_bytes=$(( 2 * 1024 * 1024 * 1024 ))
# The largest package.json read: OpenClaw's is about 120 KiB.
npm_package_max_bytes=$(( 1024 * 1024 ))

# The full path of ~/<path> $1, when it is a file Omabump reads: a regular
# file of yours, not a symlink, of at most $2 bytes. Fails otherwise. The
# caller checks the path (home_path_ok).
home_file() {
  local file=$HOME/${1#"~/"} facts type uid size
  # stat without -L describes a symlink itself, not what it points to.
  facts=$(stat -c '%F/%u/%s' -- "$file" 2>/dev/null) || return 1
  IFS=/ read -r type uid size <<<"$facts"
  [[ $type == "regular file" && $uid == "$UID" && $size =~ ^[0-9]{1,12}$ ]] || return 1
  (( size <= $2 )) || return 1
  echo "$file"
}

# The full path of the file the app $1's appImage names, when it is one
# Omabump reads (home_file, at most appimage_max_bytes). Fails otherwise.
appimage_file() {
  local rel
  rel=$(jq -r '.appImage | strings' <<<"$1")
  home_path_ok "$rel" || return 1
  home_file "$rel" "$appimage_max_bytes"
}

# The version the AppImage $1 says it is: X-AppImage-Version in the
# [Desktop Entry] group of the one .desktop file at its top, where every
# AppImage has its desktop entry. 7z (the 7zip package) extracts that file
# to stdout without running anything: the top-level *.desktop entries
# alone (-r-, and -x!*/* leaves out what a directory of that name holds),
# within 20 s; one over 64 KiB is no desktop entry. The AppImage itself is
# never run: --appimage-extract would mount it and run its own code. The
# version is the vendor's, less one leading v before a digit (v0.1.1, as a
# git tag names it): the github-release feed drops it from the tag too, and
# vercmp would rank any v-version below every numeric one. A pre-release
# stays as it is (0.1.1-nightly.20261019.1): skip_version_ok's rule,
# version_ok's plus "-". Fails without 7z, or when there is not exactly one
# such entry with one such version.
appimage_version() {
  local out v
  command -v 7z >/dev/null || return 1
  out=$(run_killable timeout -k 5 20 7z e -so -r- '-x!*/*' -- "$1" '*.desktop' </dev/null 2>/dev/null | head -c 65537) || return 1
  # Bytes, not characters: the length in the C locale.
  (( $(LC_ALL=C; echo "${#out}") <= 65536 )) || return 1
  v=$(awk '
    { sub(/\r$/, "") }
    /^\[/ { group = $0; sub(/[ \t]+$/, "", group); if (group == "[Desktop Entry]") entries++; next }
    group == "[Desktop Entry]" && /^X-AppImage-Version[ \t]*=/ { sub(/^[^=]*=[ \t]*/, ""); sub(/[ \t]+$/, ""); v = $0; found++ }
    END { if (entries != 1 || found != 1) exit 1; print v }' <<<"$out") || return 1
  if [[ $v == [vV][0-9]* ]]; then v=${v:1}; fi
  skip_version_ok "$v" || return 1
  echo "$v"
}

# Prints "<appImage as apps.json writes it> <version>" for an app installed
# as its self-updating AppImage, the version empty when it cannot be read
# (no 7z, or none in the file), or fails when the app has no such file.
appimage_installed() {
  local file version
  file=$(appimage_file "$1") || return 1
  version=$(appimage_version "$file") || version=""
  echo "$(jq -r .appImage <<<"$1") $version"
}

# The version the npm package whose package.json is $1 says it is: its
# "version", read with jq; nothing of the package runs. npm versions have
# no leading v, and a pre-release (2026.10.9-beta.1) stays as it is, as an
# AppImage's does. Fails when the file is not one JSON object with such a
# version.
npm_package_version() {
  local v
  v=$(jq -r 'if type == "object" then .version | strings else empty end' "$1" 2>/dev/null) || return 1
  skip_version_ok "$v" || return 1
  echo "$v"
}

# Prints "<npmPackage as apps.json writes it> <version>" for an app
# installed as its self-updating npm package, the version empty when its
# package.json names none, or fails when the app has no such package.json
# (home_file, at most npm_package_max_bytes). Most apps have no npmPackage,
# and the text test spares them the jq.
npm_package_installed() {
  local rel file version
  [[ $1 == *'"npmPackage"'* ]] || return 1
  rel=$(jq -r '.npmPackage | strings' <<<"$1")
  home_path_ok "$rel" || return 1
  file=$(home_file "$rel/package.json" "$npm_package_max_bytes") || return 1
  version=$(npm_package_version "$file") || version=""
  echo "$rel $version"
}

# True for an installed name installed_app gives an app that updates
# itself: its AppImage's or npm package's path as apps.json writes it,
# ~/<path>, which no package or mise tool name can be.
# shellcheck disable=SC2088 # the text "~/" as apps.json has it, not your home
self_updating_name() { [[ $1 == "~/"* ]]; }

# How the app $1, labelled $2, updates itself, for its note, its
# notification and the installer's refusal: its selfUpdate from apps.json
# ("run openclaw update"), else "open <label> to update", since an
# AppImage's own updater runs while the app is open.
self_update_text() {
  local text
  text=$(jq -r '.selfUpdate // "" | strings' <<<"$1")
  printf '%s\n' "${text:-open $2 to update}"
}

# The same as the clause of a note, "Updates itself: <that>", as parts.
self_update_parts() {
  local text
  text=$(jq -r '.selfUpdate // "" | strings' <<<"$1")
  if [[ -n $text ]]; then part note.updatesItself "$text"; else part note.updatesItselfOpen "$2"; fi
}

# Prints "<source> <installed name> <version>" for an app, or fails when it is
# not installed. An npm package that updates itself wins over the pacman
# package: Omarchy sets that copy up from the package, which stays installed
# as its seed, and the copy is what runs. The pacman package wins over the
# app's AppImage: Omarchy's migration removes the package once the AppImage
# is in place, so both at once is an install half done, or the package put
# back, and the package is what Update knows.
installed_app() {
  # shellcheck disable=SC2016 # jq variables, not the shell's
  installed_from "$1" "$(jq -r --argjson app "$1" "$jq_app_facts"'. as $ls | $app | app_facts($ls)' <<<"$mise_ls_json")"
}

# What installed_app reads of an entry, as one line: its source, its
# package names (pkg_ok, so no blank) joined by blanks, its npmPackage and
# its appImage (none ""), and the first line of what mise_active prints for
# it from mise's inventory $ls, split by \x1e: a line break in a version
# would start another row. A check reads every entry's line in the jq that
# lists the table (table_lines in omabump-check).
# shellcheck disable=SC2016 # jq variables, not the shell's
jq_app_facts=$mise_jq_active'
  def app_facts($ls): [.source // "", ((.installed // [.pkg]) | join(" ")), (.npmPackage | strings // ""),
    (.appImage | strings // ""), (active($ls) | values | "\(.key) \(.version)" | split("\n")[0])] | join("\u001e");'

# installed_app for the app $1 whose line of jq_app_facts is $2.
installed_from() {
  local app=$1 source line names npm image active
  IFS=$'\x1e' read -r source names npm image active <<<"$2"
  if route "$source" installed mise; then
    [[ -n $active ]] || return 1
    line=$active
  elif route "$source" installed manifest; then
    line=$(self_version)
    version_ok "$line" || return 1
    line="omabump $line"
  else
    read -ra names <<<"$names"
    { [[ -n $npm ]] && line=$(npm_package_installed "$app"); } || line=$(installed_package "${names[@]}") \
      || { [[ -n $image ]] && line=$(appimage_installed "$app"); } || return 1
  fi
  echo "$source $line"
}

# A value that may be given per architecture: a string, or an object keyed by
# `uname -m`. Prints nothing when this machine's architecture is missing.
per_arch() {
  jq -r --arg arch "$(uname -m)" "($1) as \$v | if (\$v | type) == \"object\" then \$v[\$arch] // \"\" else \$v // \"\" end" <<<"$2"
}

# Every download: HTTPS only, redirects included, and bounded in time and
# size. $max_time and $max_size override the 30 s and 8 MB defaults for the
# vendor package itself.
fetch() {
  curl --proto =https --proto-redir =https --connect-timeout 15 --max-time "${max_time:-30}" \
    --max-filesize "${max_size:-8M}" "$@"
}

# The vendor package URL for this machine's architecture with {version}
# filled in, or nothing when the vendor builds none for it.
vendor_pkg_url() {
  local url
  url=$(per_arch .vendorPkg "$1")
  [[ $url == https://* ]] || return 1
  echo "${url//\{version\}/$2}"
}

# Prints "<algorithm> <hex digest>" for the vendor package at URL $2,
# version $3, from the source the app's "checksum" names, or fails with the
# reason. $4 is the feed document feed_version saved.
#   "feed"                      files[].sha512 (base64) next to the file's url
#                               in the feed, as electron-updater's latest.yml
#                               and Z.ai's manifest list them
#   {"url": ..., "algo": ...}   a sha256sum/sha512sum style list at that HTTPS
#                               URL ({version} and per-arch keys allowed)
# Without a "checksum" the package is not installed.
# True when apps.json names a checksum source the installer understands.
vendor_checksum_declared() {
  jq -e '.checksum | (type == "string" and . == "feed") or (type == "object" and has("url"))' <<<"$1" >/dev/null 2>&1
}

vendor_checksum() {
  local app=$1 url=$2 version=$3 feed_file=$4 name kind b64 hex algo sums_url body
  name=${url##*/}
  kind=$(jq -r '.checksum | if type == "string" then . elif type == "object" then "@list" else "" end' <<<"$app")
  case $kind in
    feed)
      algo=sha512
      # The exact url wins; the fallback is an entry whose url is the bare
      # file name, as electron-updater's latest.yml lists files.
      b64=$(awk -v url="$url" -v name="$name" '
        { sub(/\r$/, "") }
        /^[[:space:]]*-[[:space:]]+url:/ { u = $NF; next }
        /^[[:space:]]+sha512:/ && u != "" { if (u == url) { exact = $2; exit } if (u == name && byname == "") byname = $2; u = "" }
        END { if (exact != "") print exact; else if (byname != "") print byname }' "$feed_file")
      [[ $b64 =~ ^[A-Za-z0-9+/]+=*$ ]] || { echo "the feed lists no sha512 for $name" >&2; return 1; }
      hex=$(base64 -d <<<"$b64" 2>/dev/null | od -An -v -tx1 | tr -d ' \n') ;;
    @list)
      algo=$(jq -r '.checksum.algo // "sha256"' <<<"$app")
      [[ $algo == sha256 || $algo == sha512 ]] || { echo "checksum algo '$algo' is not sha256 or sha512" >&2; return 1; }
      sums_url=$(per_arch .checksum.url "$app")
      sums_url=${sums_url//\{version\}/$version}
      [[ $sums_url == https://* ]] || { echo "no https checksum url for $(uname -m)" >&2; return 1; }
      body=$(fetch -fsSL "$sums_url" 2>/dev/null) || { echo "could not fetch $sums_url (curl exit $?)" >&2; return 1; }
      hex=$(awk -v name="$name" '{ sub(/\r$/, ""); f = $2; sub(/^\*/, "", f) } f == name { print tolower($1); exit }' <<<"$body") ;;
    "")
      echo "apps.json names no checksum source for the vendor package" >&2; return 1 ;;
    *)
      echo "unknown checksum source '$kind'" >&2; return 1 ;;
  esac
  [[ $algo == sha256 && $hex =~ ^[0-9a-f]{64}$ || $algo == sha512 && $hex =~ ^[0-9a-f]{128}$ ]] \
    || { echo "no well-formed $algo for $name" >&2; return 1; }
  echo "$algo $hex"
}

# A Debian version as an apt index lists it: [epoch:]upstream[-revision], the
# upstream part as version_ok has it. vercmp orders these as it orders
# pacman's epoch:pkgver-pkgrel.
deb_version_ok() {
  local v=$1
  if [[ $v == *:* ]]; then
    [[ ${v%%:*} =~ ^[0-9]{1,9}$ ]] || return 1
    v=${v#*:}
  fi
  # A revision starts with a digit (1, 0ubuntu1); a hyphen before a letter
  # is an upstream pre-release (2.0.0-beta1), refused like any other hyphen.
  if [[ $v == *-* ]]; then
    [[ ${v##*-} =~ ^[0-9][A-Za-z0-9.+~]{0,31}$ ]] || return 1
    v=${v%-*}
  fi
  version_ok "$v"
}

# Newest upstream version in a Debian Packages index for one exact package
# name: the full versions are compared, the upstream part is printed. Each
# must pass deb_version_ok before vercmp sees it, and only the last 500
# matching stanzas count: every comparison is a vercmp process, an index is
# appended to as releases come, and a real one lists a few dozen releases of
# one package.
apt_newest() {
  local index=$1 want=$2 v best=""
  while read -r v; do
    deb_version_ok "$v" || continue
    if [[ -z $best ]] || newer "$v" "$best"; then best=$v; fi
  done < <(awk -v want="$want" '
    { sub(/\r$/, "") }
    /^Package:/ { p = $2 }
    /^Version:/ { v = $2 }
    /^$/        { if (p == want && v != "") print v; p = v = "" }
    END         { if (p == want && v != "") print v }' <<<"$index" | tail -n 500)
  [[ -n $best ]] && upstream_part "$best"
}

# First capture group of a Python regex over a page. Pages that embed JSON in
# a JS string escape its quotes, so the pattern is also tried with \" as ".
# A match whose group took no part in it (an alternative without the group)
# gives nothing, never the text "None".
regex_first() {
  python3 -I -c '
import re, sys
body = sys.stdin.read()
for text in (body, body.replace("\\\"", "\"")):
    m = re.search(sys.argv[1], text)
    if m and m.group(1) is not None:
        print(m.group(1))
        break
' "$1"
}

# The first line a "command" feed prints. Such a feed is local code, not
# data: it is accepted only from the user's own apps.json (feed_version's
# other types never run anything), and the shipped table never runs one in
# the background.
user_command_version() {
  local cmd body
  jq -e '._userFeed == true' >/dev/null 2>&1 <<<"$1" \
    || { echo "command feeds are allowed only from ~/.config/omarchy/omabump/apps.json" >&2; return 1; }
  cmd=$(jq -r '.feed.command // ""' <<<"$1")
  body=$(run_killable timeout -k 10 60 bash -c "$cmd" </dev/null) || { echo "feed command failed" >&2; return 1; }
  head -1 <<<"$body"
}

# The tag of the latest release of the GitHub repo $1 (owner/repo). The
# /releases/latest redirect names it without the REST API's 60
# unauthenticated calls an hour. A 404 there, or a 302 elsewhere (to the
# releases page), means the repo has no release. No answer, a 5xx, a 403 or
# a 429 is github.com's pages failing, which happens for minutes at a time
# while the API keeps answering (2026-11-08: 504s, cached at the edge, on
# every page of releases): then the API's latest release names it, one call
# per such feed. Any other answer (a repo that moved, a page that no longer
# redirects) is an error that names it, so that the feed gets fixed rather
# than costing an API call on every check. Fails with the reason on
# stderr.
#
# Without a token the API allows 60 calls an hour per IP address, shared by
# everything here that calls it without one, mise in your terminal
# included. So the fallback first asks /rate_limit, which GitHub does not
# count against that limit, and leaves the last github_api_reserve calls
# alone; when it cannot tell, it does not call.
github_api_reserve=20

# How many of its unauthenticated calls an hour GitHub's REST API has left
# for this address, and that limit, as "<left> <limit>", from /rate_limit,
# which GitHub does not count against the limit. Fails when GitHub does not
# say. A check asks once: its feeds run in subshells, so the answer, or
# that there was none, waits in the run's scratch directory for the next
# caller, and an API that times out costs the run one wait, not one per
# feed.
github_api_left() {
  local out left="" rc=0 memo=${run_tmp:+$run_tmp/github-api-left}
  if [[ -n $memo && -f $memo ]]; then
    left=$(<"$memo")
  else
    out=$(fetch -sS -H 'Accept: application/vnd.github+json' -w '\n%{http_code}' \
      "https://api.github.com/rate_limit" 2>/dev/null) || rc=$?
    if (( rc == 0 )) && [[ ${out##*$'\n'} == 200 ]]; then
      left=$(jq -r '.resources.core | objects | select((.remaining | type) == "number" and (.limit | type) == "number")
        | "\(.remaining) \(.limit)"' <<<"${out%$'\n'*}" 2>/dev/null)
    fi
    [[ $left =~ ^[0-9]+\ [0-9]+$ ]] || left=""
    [[ -z $memo ]] || printf '%s\n' "$left" >"$memo"
  fi
  [[ -n $left ]] || return 1
  echo "$left"
}

# Counts $1 calls about to be spent against what github_api_left keeps for
# the run, so that the next caller in it sees them gone.
github_api_spend() {
  local memo=${run_tmp:+$run_tmp/github-api-left} n="" limit=""
  [[ -n $memo && -s $memo ]] || return 0
  read -r n limit <"$memo" || true
  [[ $n =~ ^[0-9]+$ && $limit =~ ^[0-9]+$ ]] || return 0
  printf '%s %s\n' "$(( n > $1 ? n - $1 : 0 ))" "$limit" >"$memo"
}

github_latest_tag() {
  local repo=$1 out code web left rc=0
  out=$(fetch -sS -o /dev/null -w '%{http_code} %{redirect_url}' "https://github.com/$repo/releases/latest" 2>/dev/null) || rc=$?
  if (( rc == 0 )); then
    if [[ $out == 302\ https://github.com/*/releases/tag/* ]]; then
      echo "${out##*/releases/tag/}"
      return 0
    fi
    code=${out%% *}
    if [[ $code == 404 || $code == 302 ]]; then
      echo "github.com/$repo has no latest release" >&2
      return 1
    fi
    if [[ ! $code =~ ^(5[0-9][0-9]|403|429)$ ]]; then
      echo "github.com answered $code for $repo's latest release" >&2
      return 1
    fi
    web="github.com answered $code"
  else
    web="github.com could not be reached (curl exit $rc)"
  fi
  # Not the last of the API's calls (github_api_reserve).
  if ! left=$(github_api_left); then
    echo "$web for $repo's latest release, and api.github.com did not say how many calls it has left, so Omabump did not ask it" >&2
    return 1
  fi
  if (( ${left%% *} < github_api_reserve )); then
    echo "$web for $repo's latest release; api.github.com has ${left%% *} of its ${left#* } calls an hour left here, which Omabump leaves to you" >&2
    return 1
  fi
  github_api_spend 1
  # The body, then the status on a line of its own.
  rc=0
  out=$(fetch -sS -H 'Accept: application/vnd.github+json' -w '\n%{http_code}' \
    "https://api.github.com/repos/$repo/releases/latest" 2>/dev/null) || rc=$?
  if (( rc != 0 )); then
    echo "$web and api.github.com could not be reached (curl exit $rc) for $repo's latest release" >&2
    return 1
  fi
  code=${out##*$'\n'}
  case $code in
    200)
      jq -er 'if type == "object" then .tag_name | strings else empty end' <<<"${out%$'\n'*}" 2>/dev/null \
        || { echo "$web and api.github.com named no tag for $repo's latest release" >&2; return 1; } ;;
    404)
      echo "github.com/$repo has no latest release" >&2; return 1 ;;
    *)
      echo "$web and api.github.com answered $code for $repo's latest release" >&2; return 1 ;;
  esac
}

# Prints the newest version the app's own feed advertises. Feeds are data:
# nothing fetched is ever run (a command feed is the user's own code, see
# user_command_version). Every fetch is checked on its own: a failed or
# cut-off download is an error, never a version. With $feed_save set, the
# fetched document is also written to that file (vendor_checksum reads it).
feed_version() {
  local app=$1 type url body v repo want n
  type=$(jq -r '.feed.type // ""' <<<"$app")
  url=$(per_arch .feed.url "$app")
  case $type in
    apt-index|zcode-manifest|latest-yml|regex|json)
      [[ $url == https://* ]] || { echo "no https feed url for $(uname -m)" >&2; return 1; }
      body=$(fetch -fsSL "$url" 2>/dev/null) || { echo "could not fetch $url (curl exit $?)" >&2; return 1; }
      [[ -z ${feed_save:-} ]] || printf '%s\n' "$body" >"$feed_save" ;;
  esac
  case $type in
    apt-index)
      want=$(jq -r '.feed.package // .pkg' <<<"$app")
      v=$(apt_newest "$body" "$want") || { echo "no $want in the apt index" >&2; return 1; } ;;
    zcode-manifest|latest-yml)
      v=$(sed -n 's/\r$//; s/^version: *//p' <<<"$body" | head -1) ;;
    regex)
      v=$(regex_first "$(jq -r '.feed.pattern // ""' <<<"$app")" <<<"$body" 2>/dev/null) \
        || { echo "bad feed pattern" >&2; return 1; } ;;
    json)
      # One document: jq would apply the path to each of several, and to
      # none of an empty body.
      n=$(jq -s length <<<"$body" 2>/dev/null) || { echo "feed is not JSON" >&2; return 1; }
      (( n > 0 )) || { echo "the feed is empty" >&2; return 1; }
      (( n == 1 )) || { echo "the feed holds $n JSON documents, not one" >&2; return 1; }
      v=$(jq -c "[($(jq -r '.feed.path // ".version"' <<<"$app")) // empty]" <<<"$body" 2>/dev/null) \
        || { echo "the feed path fails on this feed" >&2; return 1; }
      # One value: a path that yields several would run them together.
      n=$(jq length <<<"$v")
      (( n <= 1 )) || { echo "the feed path gives $n values, not one" >&2; return 1; }
      v=$(jq -r '.[0] // empty | if type == "string" then . else tojson end' <<<"$v") ;;
    aur-rpc)
      want=$(jq -r '.feed.name // .pkg' <<<"$app")
      body=$(fetch -fsSL "https://aur.archlinux.org/rpc/v5/info?arg%5B%5D=$want" 2>/dev/null) \
        || { echo "could not reach the AUR (curl exit $?)" >&2; return 1; }
      v=$(jq -r '.results[0].Version // ""' <<<"$body" 2>/dev/null) || v=""
      [[ -n $v ]] || { echo "the AUR has no $want" >&2; return 1; }
      v=$(upstream_part "$v") ;;
    github-release)
      repo=$(jq -r '.feed.repo // ""' <<<"$app")
      v=$(github_latest_tag "$repo") || return 1
      v=${v#v} ;;
    command)
      v=$(user_command_version "$app") || return 1 ;;
    "")
      echo "no feed declared" >&2; return 1 ;;
    *)
      echo "unknown feed type '$type'" >&2; return 1 ;;
  esac
  # Blanks around the version go. Blanks inside it stay, and version_ok
  # refuses them: two versions on two lines are not one.
  v=${v#"${v%%[![:space:]]*}"}
  v=${v%"${v##*[![:space:]]}"}
  [[ -n $v ]] || { echo "feed returned no version" >&2; return 1; }
  version_ok "$v" || { echo "feed returned an odd version '${v//[[:space:]]/ }'" >&2; return 1; }
  echo "$v"
}

# --- Omarchy's package repo ------------------------------------------------
#
# Omarchy builds its packages, the coding agents among them, in its own
# pacman repo [omarchy], signed with its key, and follows the vendors'
# releases within the hour. A repo row's Update installs that package, and
# never builds: Build now (bin/omabump-install --build) is the other,
# explicit action, for a release the repo does not have yet. The repo's
# database (omarchy.db) is not
# signed (pacman.conf says DatabaseOptional), so it is only an index: it
# names the file and its sha256, and the installer checks every claim on
# the file itself, the signature by a key pacman trusts above all
# (package_signature_ok), before sudo, and the signature again on the
# root-owned copy pacman -U opens.
#
# The database is read once per check, and once per Update, never from
# status.json. Nothing in it is run: bsdtar streams each package's desc to
# awk, and only these fields are kept, each checked (repo_entry_ok):
#   %NAME%       the package name, matched exactly (crush-bin-debug sits
#                beside crush-bin)
#   %VERSION%    the full version, [epoch:]pkgver-pkgrel
#   %FILENAME%   <name>-<version>-<arch>.pkg.tar.<ext>, one path component
#   %SHA256SUM%  64 hex digits
repo_name=omarchy
# The database is about 90 KiB; its packages' descs, unpacked, a few hundred.
repo_db_max=8M repo_desc_max=$(( 64 * 1024 * 1024 ))

# The first https Server pacman.conf gives the repo, as pacman-conf prints
# it with $repo and $arch filled in, less a trailing slash; one with any
# other character than a URL's plain ones, or a "..", is passed over. Sets
# repo_server, or fails with repo_error saying why, and repo_error_parts
# the same as parts (for a row's note).
repo_server=""
repo_error_parts='[]'
repo_server_find() {
  local servers line
  repo_server=""
  servers=$(run_unlocked timeout 10 pacman-conf --repo "$repo_name" Server 2>/dev/null </dev/null) || servers=""
  if [[ -z $servers ]]; then
    repo_error="No [$repo_name] repo in pacman.conf" repo_error_parts=$(part note.noRepo "$repo_name")
    return 1
  fi
  while IFS= read -r line; do
    line=${line%/}
    if [[ $line =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~%+-]+)*$ && $line != *..* ]]; then
      repo_server=$line
      return 0
    fi
  done <<<"$servers"
  repo_error="No https Server for [$repo_name] in pacman.conf" repo_error_parts=$(part note.noHttpsServer "$repo_name")
  return 1
}

# True when a database entry is one Omabump takes: $1 name, $2 full
# version, $3 file name, $4 sha256. The file name is exactly the package
# file pacman's tools name for that name and version, for this machine's
# architecture or any: a single path component, so it cannot point
# anywhere but the repo's directory and the packages cache. The name and
# the full version are at most repo_field_max characters each, and so the
# file name is bounded too: a pkgrel of 140 KB would otherwise reach jq as
# one argument and end the check (E2BIG).
repo_field_max=128
repo_entry_ok() {
  local name=$1 version=$2 file=$3 sum=$4 rest
  (( ${#name} <= repo_field_max && ${#version} <= repo_field_max )) || return 1
  pkg_name_ok "$name" && full_version_ok "$version" && [[ $sum =~ ^[0-9a-f]{64}$ ]] || return 1
  [[ $file != */* && $file != *..* ]] || return 1
  rest=${file#"$name-$version-"}
  [[ $rest != "$file" ]] || return 1
  [[ $rest =~ ^([a-z0-9_]+)\.pkg\.tar\.(zst|xz|gz|bz2|lz4)$ ]] || return 1
  [[ ${BASH_REMATCH[1]} == any || ${BASH_REMATCH[1]} == "$repo_arch" ]]
}
# This machine's architecture, read once.
repo_arch=$(uname -m)

# The entries of the database file $1 that repo_entry_ok takes, one a line:
# name, full version, file name and sha256, split by tabs. Each desc starts
# with %FILENAME%, which is where awk starts a new package; a field given
# twice in one package drops it. Fails when bsdtar cannot read the file,
# when its descs run past repo_desc_max, or when no entry is left: a real
# database names hundreds.
repo_db_entries() {
  local out name version file sum n=0
  out=$(set -o pipefail
    run_unlocked timeout -k 5 30 bsdtar -xOf "$1" 2>/dev/null </dev/null | head -c "$repo_desc_max" | awk '
      function flush() {
        if (!bad && fn != "" && nm != "" && vr != "" && sh != "") print nm "\t" vr "\t" fn "\t" sh
        fn = nm = vr = sh = ""; bad = 0
      }
      { sub(/\r$/, "") }
      /^%[A-Z0-9]+%$/ { key = $0; if (key == "%FILENAME%") flush(); next }
      $0 == "" { key = ""; next }
      key == "%FILENAME%" { if (fn != "") bad = 1; fn = $0; next }
      key == "%NAME%" { if (nm != "") bad = 1; nm = $0; next }
      key == "%VERSION%" { if (vr != "") bad = 1; vr = $0; next }
      key == "%SHA256SUM%" { if (sh != "") bad = 1; sh = $0; next }
      END { flush() }') || return 1
  while IFS=$'\t' read -r name version file sum; do
    repo_entry_ok "$name" "$version" "$file" "$sum" || continue
    printf '%s\t%s\t%s\t%s\n' "$name" "$version" "$file" "$sum"
    n=$((n + 1))
  done <<<"$out"
  (( n > 0 ))
}

# Reads the repo's database into repo_entries, name to "<version> <file>
# <sha256>" (a name listed twice maps to "", which no lookup takes), in the
# calling shell. repo_state says how it went:
#   ready   read; repo_server is where from
#   none    this machine has no such repo with an https Server (not
#           Omarchy, or another pacman.conf): nothing failed
#   failed  the database could not be fetched or read
# and repo_error why, for the last two. The download is bounded as every
# fetch is, with repo_db_max for its size.
repo_state="" repo_error=""
declare -gA repo_entries=()
repo_load() {
  local db out rc=0 name version file sum
  repo_entries=() repo_error=""
  if ! repo_server_find; then
    repo_state=none
    return 1
  fi
  mkdir -p "$cache_dir"
  db=$(mktemp "${run_tmp:-$cache_dir}/.repo.XXXXXX")
  max_size=$repo_db_max fetch -fsSL "$repo_server/$repo_name.db" >"$db" 2>/dev/null || rc=$?
  if (( rc )); then
    rm -f "$db"
    repo_state=failed repo_error="could not fetch Omarchy's repo database from $repo_server (curl exit $rc)"
    return 1
  fi
  if ! out=$(repo_db_entries "$db"); then
    rm -f "$db"
    repo_state=failed repo_error="Omarchy's repo database from $repo_server could not be read"
    return 1
  fi
  rm -f "$db"
  while IFS=$'\t' read -r name version file sum; do
    if [[ -n ${repo_entries[$name]+set} ]]; then repo_entries[$name]=""
    else repo_entries[$name]="$version $file $sum"; fi
  done <<<"$out"
  repo_state=ready
}

# The repo's package $1, from repo_load's entries: sets repo_version,
# repo_file and repo_sha256, or fails, all three "", when the repo has no
# such package (or names it twice).
repo_version="" repo_file="" repo_sha256=""
repo_lookup() {
  repo_version="" repo_file="" repo_sha256=""
  [[ $repo_state == ready && -n ${repo_entries[$1]:-} ]] || return 1
  read -r repo_version repo_file repo_sha256 <<<"${repo_entries[$1]}"
}

# The URL of the repo's file $1: the file name is a single path component
# of repo_entry_ok's characters, and only an epoch's ":" is percent-encoded,
# as no server's path needs it raw.
repo_file_url() { echo "$repo_server/${1//:/%3A}"; }

# What Update from Omarchy's repo needs, as tool:package (as omarchy_tools
# below): sudo and curl, gpg for the signature, bsdtar for the database,
# vercmp to compare versions.
repo_tools=(sudo:base-devel curl:curl gpg:gnupg bsdtar:libarchive vercmp:pacman)

# The tools of the list $1 (repo_tools, omarchy_tools) that are not on
# PATH, $2... more names (a python3 too old) taken as missing too: sets
# tools_missing, and tools_pkgs to the packages that have them, each once.
tools_missing=() tools_pkgs=()
tools_find() {
  local -n list=$1
  local entry tool
  tools_missing=() tools_pkgs=()
  for entry in "${list[@]}"; do
    command -v "${entry%%:*}" >/dev/null || tools_missing+=("${entry%%:*}")
  done
  for tool in "${@:2}"; do tools_missing+=("$tool"); done
  for tool in "${tools_missing[@]}"; do
    for entry in "${list[@]}"; do
      [[ $tool == "${entry%%:*}" && " ${tools_pkgs[*]} " != *" ${entry#*:} "* ]] && tools_pkgs+=("${entry#*:}")
    done
  done
  return 0
}

# What tools_find found, "Missing: <tools>; sudo pacman -S --needed
# <packages>", or nothing when nothing is missing; tools_parts the same as
# parts, [] for nothing.
tools_line() {
  (( ${#tools_missing[@]} )) || return 0
  echo "Missing: $(printf '%s, ' "${tools_missing[@]}" | sed 's/, $//'); sudo pacman -S --needed ${tools_pkgs[*]}"
}
tools_parts() {
  (( ${#tools_missing[@]} )) || { echo '[]'; return 0; }
  parts_cat "$(part note.missing "$(printf '%s, ' "${tools_missing[@]}" | sed 's/, $//')")" \
    "$(part note.installWith "${tools_pkgs[*]}")"
}

# "Missing: <tools>; sudo pacman -S --needed <packages>" for what the repo
# path lacks, as missing_tools_line says it for a build. Prints nothing
# when everything is there. Only command -v, so the check can call it.
# repo_missing_parts: the same as parts.
repo_missing_line() { tools_find repo_tools; tools_line; }
repo_missing_parts() { tools_find repo_tools; tools_parts; }

# Exits with that line when something is missing, as require_omarchy_tools
# does for a build.
require_repo_tools() {
  local line
  line=$(repo_missing_line)
  [[ -z $line ]] && return 0
  echo "omabump: Update from Omarchy's repo needs tools that are missing." >&2
  echo "${line%%;*}" >&2
  echo "Install them with:${line#*;}" >&2
  exit 1
}

# True when the vendor is ahead of Omarchy's repo for an app installed at
# the full version $1: its newest release $3 (an upstream version, "" when
# the entry has no feed or it failed for good) is newer than what is
# installed and than the repo's package $2 (a full version, "" when the
# repo has none or could not be read). Build now is for that window; the
# check reads a recipe only for such a row, and Build now refuses another.
vendor_ahead() {
  [[ -n $3 ]] && newer "$3" "$(upstream_part "$1")" && { [[ -z $2 ]] || newer "$3" "$(upstream_part "$2")"; }
}

# True when the file $2 carries a good signature, the detached binary
# signature $1, by a key pacman's keyring trusts fully or ultimately, as
# pacman trusts a package. pacman-key --verify cannot say so: pacman 7.1.0
# tests the trust in a PIPESTATUS an earlier test has already reset, so a
# good signature by a key that is in the keyring but not trusted passes.
# This runs gpg exactly as pacman-key does (its keyring: pacman-conf's
# GPGDir, /etc/pacman.d/gnupg when it names none), and takes only its
# status lines: exit 0, a GOODSIG, a VALIDSIG and a TRUST_FULLY or
# TRUST_ULTIMATE, and no signature by an expired or revoked key, nor one
# that has expired itself, which gpg may still pass with exit 0 and
# pacman (gpgme) refuses. An armored signature is refused, as pacman-key
# refuses one. Sets sig_signer to the signer, its user ID and the primary
# key's fingerprint, VALIDSIG's last field (terminal-safe), for the run to
# show; on a failure gpg's own words go to
# stderr, terminal-safe, and sig_error says why.
sig_signer="" sig_error=""
package_signature_ok() {
  local sig=$1 file=$2 dir="" out err rc=0 uid fpr
  sig_signer="" sig_error=""
  read -r dir < <(run_unlocked timeout 10 pacman-conf GPGDir 2>/dev/null </dev/null) || true
  dir=${dir:-/etc/pacman.d/gnupg}
  if [[ $dir != /* ]]; then
    sig_error="pacman-conf names GPGDir '$(term_safe <<<"$dir")', not an absolute path"
    return 1
  fi
  if grep -qF -- 'BEGIN PGP SIGNATURE' "$sig" 2>/dev/null; then
    sig_error="the signature is armored; pacman takes only a binary one"
    return 1
  fi
  mkdir -p "$cache_dir"
  err=$(mktemp "${run_tmp:-$cache_dir}/.gpg.XXXXXX")
  out=$(run_unlocked timeout -k 5 60 gpg --homedir "$dir" --no-permission-warning --status-fd 1 --verify "$sig" "$file" 2>"$err" </dev/null) || rc=$?
  if (( rc )); then
    sig_error="gpg exited $rc: it is not a good signature from a key in pacman's keyring"
  elif grep -qE '^\[GNUPG:\] (EXPSIG|EXPKEYSIG|REVKEYSIG|BADSIG|ERRSIG) ' <<<"$out"; then
    sig_error="gpg found a signature that has expired, or is by an expired or revoked key"
  elif ! grep -q '^\[GNUPG:\] GOODSIG ' <<<"$out" || ! grep -q '^\[GNUPG:\] VALIDSIG ' <<<"$out"; then
    sig_error="gpg found no valid signature"
  fi
  if [[ -n $sig_error ]]; then
    term_safe <"$err" >&2
    rm -f "$err"
    return 1
  fi
  if ! grep -qE '^\[GNUPG:\] TRUST_(FULLY|ULTIMATE)( .*)?$' <<<"$out"; then
    term_safe <"$err" >&2
    rm -f "$err"
    sig_error="the signature is good, but its key is not one pacman's keyring trusts"
    return 1
  fi
  rm -f "$err"
  uid=$(sed -n 's/^\[GNUPG:\] GOODSIG [0-9A-Fa-f]* //p' <<<"$out" | head -n1)
  fpr=$(awk '$1 == "[GNUPG:]" && $2 == "VALIDSIG" { print ($12 != "" ? $12 : $3); exit }' <<<"$out")
  sig_signer=$(printf '%s' "${uid:+$uid, }key $fpr" | term_safe | tr '\t\n' '  ')
}

# --- omarchy-pkgs ----------------------------------------------------------

# What building an Omarchy recipe needs, as tool:package. makepkg and sudo
# come with base-devel, vercmp with pacman, bsdtar with libarchive.
omarchy_tools=(makepkg:base-devel git:git jq:jq python3:python bsdtar:libarchive vercmp:pacman curl:curl sudo:base-devel)

# "Missing: <tools>; sudo pacman -S --needed <packages>" for what building a
# recipe lacks, a python3 older than bin/sync-upstream needs (3.11) included.
# Prints nothing when everything is there. missing_tools_parts: the same
# as parts.
missing_tools_find() {
  local old=()
  if command -v python3 >/dev/null && ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    old=(python3)
  fi
  tools_find omarchy_tools "${old[@]}"
}
missing_tools_line() { missing_tools_find; tools_line; }
missing_tools_parts() { missing_tools_find; tools_parts; }

# Exits with that line when something is missing.
require_omarchy_tools() {
  local line
  line=$(missing_tools_line)
  [[ -z $line ]] && return 0
  echo "omabump: building Omarchy's recipe needs tools that are missing." >&2
  echo "${line%%;*}" >&2
  echo "Install them with:${line#*;}" >&2
  exit 1
}

# Takes the clone lock on fd 8, waiting up to $1 s, until pkgs_drop_lock or
# the end of the process. The lock covers what writes the clone: fetches,
# checkout, sync and build. Reads through git show need no lock.
pkgs_locked=0
pkgs_take_lock() {
  mkdir -p "$cache_dir"
  exec 8>"$pkgs_lock"
  flock -w "${1:-0}" 8 && pkgs_locked=1
}
pkgs_drop_lock() { exec 8>&-; pkgs_locked=0; }

# git for the clone: HTTPS only, never a credential prompt, and always bounded:
# the clone is blob-less, so even show, checkout and archive can fetch from
# GitHub on demand. No hooks, no fsmonitor, no automatic gc or maintenance,
# whatever the clone's or the user's config says. Explicit network calls go
# through pgit_net. The clone is Omabump's own, so the user's and the
# system's git config do not apply to it: a url.*.insteadOf rule (github.com
# rewritten to ssh) would otherwise point it at another origin and make it
# again on every run. Their http.* settings (proxy, CA bundle) carry no
# rewrite and are passed on, read once here; proxy environment variables
# apply as well.
git_safe=(-c core.hooksPath=/dev/null -c core.fsmonitor=false -c protocol.allow=never
  -c protocol.https.allow=always -c gc.auto=0 -c maintenance.auto=false)
git_noconfig=(GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1)
git_http=()
git_http_load() {
  local key value
  git_http=()
  while read -r key value; do
    [[ -n $key ]] && git_http+=(-c "$key=$value")
  done < <({ git config --system --get-regexp '^http\.'; git config --global --get-regexp '^http\.'; } 2>/dev/null </dev/null || true)
}
git_http_load
pgit() { run_killable timeout -k 10 300 env "${git_noconfig[@]}" GIT_ALLOW_PROTOCOL=https GIT_TERMINAL_PROMPT=0 git "${git_http[@]}" "${git_safe[@]}" -C "$pkgs_dir" "$@" </dev/null; }
pgit_net() { run_killable timeout -k 10 300 env "${git_noconfig[@]}" GIT_ALLOW_PROTOCOL=https GIT_TERMINAL_PROMPT=0 git "${git_http[@]}" "${git_safe[@]}" "$@" </dev/null; }

# --- Omabump's own update ----------------------------------------------------

# Update installs the release the row named: the commit behind the tag
# v<latest>, fetched alone from the canonical repository into the plugin's
# own clone and fast-forwarded to, never the branch head. git runs as pgit
# does: hardened, HTTPS only, bounded.
self_repo=https://github.com/vladkarok/omabump
self_git() { run_killable timeout -k 10 120 env GIT_ALLOW_PROTOCOL=https GIT_TERMINAL_PROMPT=0 git "${git_safe[@]}" -C "$plugin_dir" "$@" </dev/null; }

# True when the clone's origin, as git would fetch it (insteadOf applied), is
# the canonical repository, in any letter case, with or without .git.
self_origin_ok() {
  local url
  url=$(self_git remote get-url origin 2>/dev/null) || return 1
  url=${url,,}
  [[ $url == "$self_repo" || $url == "$self_repo.git" ]]
}

# Fetches the tag v$1 and nothing else into FETCH_HEAD and checks that the
# clone can fast-forward to it: no local changes, and the installed commit
# is an ancestor of the tagged one. Sets self_target to that commit, or
# fails with the reason on stderr.
self_target=""
self_plan() {
  local tag=v$1 status
  self_target=""
  version_ok "$1" || { echo "'$1' is not a release version" >&2; return 1; }
  # --untracked-files=normal whatever status.showUntrackedFiles says: the
  # rollback's git clean -fd deletes any untracked file this would not see.
  status=$(self_git status --porcelain --untracked-files=normal) || { echo "git status failed in $plugin_dir" >&2; return 1; }
  [[ -z $status ]] || { echo "the plugin clone $plugin_dir has local changes" >&2; return 1; }
  self_git fetch -q --no-tags origin -- "refs/tags/$tag" >&2 || { echo "could not fetch the tag $tag" >&2; return 1; }
  self_target=$(self_git rev-parse --verify -q 'FETCH_HEAD^{commit}') || { echo "the tag $tag names no commit" >&2; return 1; }
  self_git merge-base --is-ancestor HEAD "$self_target" \
    || { echo "the tag $tag (${self_target:0:12}) does not contain the installed commit, so it is not a fast-forward" >&2; self_target=""; return 1; }
}

# Makes the pinned commit (or, when following, origin/master's) present in
# the clone, creating it first, and prints that commit. The caller sets
# pkgs_base to it. Only data moves: the work tree is not touched. A pinned
# commit already in the clone needs no network. The clone is an empty repo
# with origin set and every fetch names the pinned commit, never a branch
# clone. A clone whose origin is not $pkgs_url is made again. Needs the lock.
pkgs_fetch() {
  if [[ -d $pkgs_dir/.git && $(pgit remote get-url origin 2>/dev/null) != "$pkgs_url" ]]; then
    echo "the omarchy-pkgs clone's origin is not $pkgs_url; making it again" >&2
    rm -rf "$pkgs_dir"
  fi
  if [[ ! -d $pkgs_dir/.git ]]; then
    rm -rf "$pkgs_dir"
    { pgit_net init -q -- "$pkgs_dir" && pgit remote add origin "$pkgs_url"; } >&2 \
      || { rm -rf "$pkgs_dir"; return 1; }
  fi
  if (( pkgs_follow )); then
    pgit_net -C "$pkgs_dir" fetch -q --filter=blob:none origin -- '+refs/heads/master:refs/remotes/origin/master' >&2 || return 1
    pgit rev-parse --verify -q 'refs/remotes/origin/master^{commit}'
    return
  fi
  [[ -n $pkgs_base ]] || { echo "$pkgs_pin_error" >&2; return 1; }
  if ! pgit cat-file -e "$pkgs_base^{commit}" 2>/dev/null; then
    local why
    why=$(pgit_net -C "$pkgs_dir" fetch -q --filter=blob:none origin -- "$pkgs_base" 2>&1) \
      || why=$(pgit_net -C "$pkgs_dir" fetch -q --filter=blob:none origin -- "$pkgs_pin_ref" 2>&1) || true
    pgit cat-file -e "$pkgs_base^{commit}" 2>/dev/null \
      || { echo "pinned omarchy-pkgs commit ${pkgs_base:0:12} is unreachable${why:+: $(tail -1 <<<"$why")}" >&2; return 1; }
  fi
  echo "$pkgs_base"
}

# Puts the work tree, detached, at pkgs_base and cleans $1 (the whole tree
# by default). Needs the lock.
pkgs_detach() {
  pgit checkout -q -f --detach "$pkgs_base" >&2 && pgit clean -qfdx -- "${1:-.}" >&2
}
pkgs_checkout() { pkgs_detach; }
# Puts Omarchy's recipe back the way pkgs_base has it; never fails.
pkgs_restore() { pkgs_detach "pkgbuilds/${1:?}" 2>/dev/null || true; }

# Files of a recipe at a commit, read from the object store without a
# checkout, so it is safe while an install holds the lock. The clone is
# blob-less: its trees are all there, a file's content may first have to be
# fetched from GitHub. So whether a file exists is asked of the tree alone
# (ls-tree fetches nothing), and a failed fetch of its content is a failed
# read, never a missing file.
#   recipe_has    0 the file is in the recipe, 1 it is not, 2 the tree could
#                 not be read (the reason on stderr)
#   recipe_file   prints the file; 1 when it is not in the recipe, 2 when it
#                 could not be read (the reason on stderr)
recipe_has() {
  local entry type
  entry=$(pgit ls-tree "$1" -- "pkgbuilds/$2/$3" 2>/dev/null) \
    || { echo "could not read the omarchy-pkgs tree at ${1:0:12}" >&2; return 2; }
  read -r _ type _ <<<"$entry"
  [[ $type == blob ]]
}
recipe_file() {
  local rc=0 err
  recipe_has "$1" "$2" "$3" || return
  # git's message goes to the variable, the file to stdout (fd 3).
  { err=$(pgit show "$1:pkgbuilds/$2/$3" 2>&1 >&3 3>&-); } 3>&1 || rc=$?
  (( rc == 0 )) && return 0
  echo "could not read pkgbuilds/$2/$3 at ${1:0:12}${err:+: $(tail -1 <<<"$err")}" >&2
  return 2
}

# Why the recipe of $2 at commit $1 cannot follow its vendor, as the key of
# its words in i18n/en.json (recipe_blocker_text says them, for $2;
# recipe_blocker_parts as parts), or nothing when it can: bin/sync-upstream
# needs an upstream watch (package.json "upstream") or hook
# (.omarchy/upstream.sh) to move it. Fails with the reason on stderr when
# the clone could not read the recipe: that is a failed check, not a
# missing recipe or watch.
recipe_blocker() {
  local rev=$1 pkg=$2 meta rc=0
  recipe_has "$rev" "$pkg" PKGBUILD || rc=$?
  case $rc in 0) ;; 1) echo build.noRecipe; return 0 ;; *) return 1 ;; esac
  rc=0
  meta=$(recipe_file "$rev" "$pkg" .omarchy/package.json) || rc=$?
  case $rc in 0) ;; 1) meta='{}' ;; *) return 1 ;; esac
  if jq -e '.sync == false' >/dev/null 2>&1 <<<"$meta"; then
    echo build.noWatchSync; return 0
  fi
  rc=0
  recipe_has "$rev" "$pkg" .omarchy/upstream.sh || rc=$?
  case $rc in 0) return 0 ;; 1) ;; *) return 1 ;; esac
  jq -e '.upstream' >/dev/null 2>&1 <<<"$meta" && return 0
  echo build.noWatch
}
recipe_blocker_text() {
  case $1 in
    build.noRecipe) echo "No $2 recipe in omarchy-pkgs" ;;
    build.noWatchSync) echo "Repo recipe has no upstream watch yet (sync: false)" ;;
    build.noWatch) echo "Repo recipe has no upstream watch yet" ;;
  esac
}
recipe_blocker_parts() {
  case $1 in
    build.noRecipe) part build.noRecipe "$2" ;;
    build.noWatchSync) part build.noWatchSync ;;
    build.noWatch) part build.noWatch ;;
  esac
}

# The release-age window the recipe at commit $1 declares, in seconds, or 0:
# min_release_age in .omarchy/package.json, bare seconds or "90m", "24h",
# "2d". bin/sync-upstream does not move the recipe to a younger release.
# Fails, with the reason on stderr, when the file could not be read.
recipe_release_age() {
  local age n meta rc=0
  meta=$(recipe_file "$1" "$2" .omarchy/package.json) || rc=$?
  (( rc < 2 )) || return 1
  age=$(jq -r '.min_release_age // empty | tostring' <<<"$meta" 2>/dev/null) || age=""
  if [[ $age =~ ^([0-9]{1,9})([smhd]?)$ ]]; then
    n=$(( 10#${BASH_REMATCH[1]} ))
    case ${BASH_REMATCH[2]} in
      m) n=$(( n * 60 )) ;;
      h) n=$(( n * 3600 )) ;;
      d) n=$(( n * 86400 )) ;;
    esac
    echo "$n"
  else
    echo 0
  fi
}

# The epoch second a check first saw version $2 of row $1, recorded now when
# it is new to seen_file. A feed gives no release date, so a release-age
# window runs from there: never shorter than upstream's.
seen_since() {
  local pkg=$1 version=$2 now=$3 seen='{}' at
  [[ -s $seen_file ]] && jq -e 'type == "object"' "$seen_file" >/dev/null 2>&1 && seen=$(<"$seen_file")
  at=$(jq -r --arg pkg "$pkg" --arg v "$version" \
    '.[$pkg] | if type == "object" and .version == $v then .at else empty end' <<<"$seen")
  if [[ ! $at =~ ^[0-9]{1,12}$ ]]; then
    at=$now
    save_json "$(jq -c --arg pkg "$pkg" --arg v "$version" --argjson at "$at" '.[$pkg] = {version: $v, at: $at}' <<<"$seen")" \
      "$seen_file" || true
  fi
  echo "$at"
}

# A plain assignment in PKGBUILD text on stdin, the form omarchy-pkgs' own
# tools rewrite. The text is parsed, never sourced.
pkgbuild_field() { sed -n "s/^$1=//p" | head -1 | tr -d "\"'"; }

# Prints "<pkgname> <full version>" from PKGBUILD text on stdin. epoch=0 is
# no epoch, as makepkg writes it.
recipe_version() {
  local text name ver rel epoch
  text=$(cat)
  name=$(pkgbuild_field pkgname <<<"$text") ver=$(pkgbuild_field pkgver <<<"$text")
  rel=$(pkgbuild_field pkgrel <<<"$text") epoch=$(pkgbuild_field epoch <<<"$text")
  pkg_name_ok "$name" || { echo "unreadable pkgname in the recipe" >&2; return 1; }
  version_ok "$ver" || { echo "unreadable pkgver in the recipe" >&2; return 1; }
  [[ $rel =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "unreadable pkgrel in the recipe" >&2; return 1; }
  [[ -z $epoch || $epoch =~ ^[0-9]+$ ]] || { echo "unreadable epoch in the recipe" >&2; return 1; }
  [[ $epoch == 0 ]] && epoch=""
  echo "$name ${epoch:+$epoch:}$ver-$rel"
}

# --- the keys a recipe's sources are signed with ---------------------------------
#
# A recipe that checks a vendor's signature on its sources lists the keys
# in validpgpkeys, and omarchy-pkgs ships each one beside it as
# keys/pgp/<FINGERPRINT>.asc. makepkg verifies such a source against
# GNUPGHOME: the build gets a keyring made here from those files alone, at
# the pinned commit, never your own keyring and never a keyserver, and
# never --skippgpcheck. Nothing here knows about rows or apps: a commit, a
# recipe and fingerprints in, a keyring directory or a refusal out.

# The fingerprints PKGBUILD text on stdin lists in validpgpkeys, one a
# line, upper case, from every assignment (= and +=). Parsed, never
# sourced: the array as omarchy-pkgs writes it, on one line or several,
# quoted or not, with comments. Fails, with the
# reason on stderr, when an entry is not a 40-hex fingerprint (a short key
# ID names no key for sure).
pgp_fingerprints() {
  local text body word words=() out=()
  text=$(cat)
  # Every assignment counts, = and += alike: a superset only asks for more
  # key files. A mention in any other form (outside a comment) is refused.
  if grep -vE '^[[:space:]]*#' <<<"$text" | grep -E 'validpgpkeys' \
    | grep -qvE '^[[:space:]]*validpgpkeys[[:space:]]*\+?=[[:space:]]*\('; then
    echo "validpgpkeys is set in a form Omabump does not read" >&2
    return 1
  fi
  body=$(awk '
    on { line = $0 }
    !on && /^[[:space:]]*validpgpkeys[[:space:]]*\+?=[[:space:]]*\(/ { on = 1; line = $0; sub(/^[^(]*\(/, "", line) }
    on { sub(/#.*/, "", line); if (index(line, ")")) { sub(/\).*/, "", line); on = 0 } print line }' <<<"$text")
  read -rd '' -a words <<<"$body" || true
  for word in "${words[@]}"; do
    word=${word//[\"\']/}
    [[ -n $word ]] || continue
    [[ $word =~ ^[0-9A-Fa-f]{40}$ ]] || { echo "validpgpkeys lists '$(term_safe <<<"$word")', not a 40-hex fingerprint" >&2; return 1; }
    out+=("${word^^}")
  done
  (( ${#out[@]} == 0 )) || printf '%s\n' "${out[@]}"
}

# The primary-key fingerprints of the OpenPGP key file $2, one a line, as
# gpg in the home $1 reads the file without importing it.
pgp_file_primaries() {
  run_unlocked timeout -k 5 30 gpg --homedir "$1" --batch --no-tty --with-colons --import-options show-only \
    --import -- "$2" 2>/dev/null </dev/null | awk -F: '$1 == "pub" { want = 1; next } $1 == "fpr" && want { print toupper($10); want = 0 }'
}

# Makes the keyring $3, a new directory (mode 700), from the key files the
# recipe $2 ships at commit $1 for the fingerprints $4...: for each one
# keys/pgp/<FPR>.asc, read from git at that commit (not from a work tree a
# sync or a hook may have touched), whose one primary key must be exactly
# that fingerprint. A file that is missing, holds another key, or holds
# more than one primary key is refused, and so is a keyring that ends up
# with any other primary key. With no fingerprints the keyring is empty:
# makepkg then verifies no signature against anything of yours. Fails with
# the reason on stderr; the caller removes $3 either way (pgp_keyring_drop).
pgp_keyring() {
  local rev=$1 recipe=$2 home=$3 fpr file got rc
  shift 3
  mkdir -m 700 -- "$home" || { echo "could not make the keyring $home" >&2; return 1; }
  printf 'no-auto-key-retrieve\nno-auto-key-locate\n' >"$home/gpg.conf"
  for fpr; do
    [[ $fpr =~ ^[0-9A-F]{40}$ ]] || { echo "'$fpr' is not a 40-hex fingerprint" >&2; return 1; }
    file=$home/$fpr.asc rc=0
    recipe_file "$rev" "$recipe" "keys/pgp/$fpr.asc" >"$file" || rc=$?
    case $rc in
      0) ;;
      1) echo "the $recipe recipe lists the key $fpr in validpgpkeys, but omarchy-pkgs ships no keys/pgp/$fpr.asc at ${rev:0:12}; not building" >&2; return 1 ;;
      *) return 1 ;;
    esac
    got=$(pgp_file_primaries "$home" "$file") || got=""
    if [[ $got != "$fpr" ]]; then
      echo "keys/pgp/$fpr.asc of the $recipe recipe holds the primary key(s) $(printf '%s' "${got:-none}" | tr '\n' ' '), not exactly $fpr; not building" >&2
      return 1
    fi
    run_unlocked timeout -k 5 30 gpg --homedir "$home" --batch --no-tty --quiet --import -- "$file" </dev/null >/dev/null 2>&1 \
      || { echo "gpg could not import keys/pgp/$fpr.asc of the $recipe recipe; not building" >&2; return 1; }
    rm -f -- "$file"
  done
  (( $# )) || return 0
  got=$(run_unlocked timeout -k 5 30 gpg --homedir "$home" --batch --no-tty --with-colons --list-keys </dev/null 2>/dev/null \
    | awk -F: '$1 == "pub" { want = 1; next } $1 == "fpr" && want { print toupper($10); want = 0 }' | sort -u)
  if [[ $got != "$(printf '%s\n' "$@" | sort -u)" ]]; then
    echo "the keyring made for the $recipe recipe holds $(printf '%s' "$got" | tr '\n' ' '), not exactly the keys validpgpkeys lists; not building" >&2
    return 1
  fi
}

# Stops the gpg-agent a keyring of pgp_keyring's started and removes the
# keyring. Never fails.
pgp_keyring_drop() {
  [[ -n $1 && -d $1 ]] || return 0
  run_unlocked timeout 10 gpgconf --homedir "$1" --kill all </dev/null >/dev/null 2>&1 || true
  rm -rf -- "$1"
}

# --- rows ----------------------------------------------------------------------
#
# A row of status.json is what is known about one app: what is installed,
# the newest version and where it came from, what Update can do, and why
# not. The rules that turn those facts into a row live here, and only here:
# the check derives every row with them (row_derive, then row_json), the
# local refresh re-derives a row from the last check's when the installed
# version moved (local_row in bin/omabump-check), and Update asks them
# what the panel showed and whether its route reaches anything newer
# (row_newer, row_past, mise_row, update_blocked). What a route reads (a
# feed, a recipe, mise's tables) stays with its reader; these take its
# answers.

# The installed version $1 as a row compares it with its newest known
# version, which came from $2 (the row's versionFrom): a feed knows only
# upstream's version, so it is the installed one less epoch and pkgrel;
# from anywhere else, the version as it is. Update compares full versions
# where it installs (guard_version in bin/omabump-install).
row_have() { if [[ $2 == feed ]]; then upstream_part "$1"; else printf '%s\n' "$1"; fi; }

# True when the newest version $1, from $3, is newer than the installed $2
# (row_have): the row's update.
row_newer() { newer "$1" "$(row_have "$2" "$3")"; }

# True when the installed $1 is past the newest known version $2, from $3
# (row_have): a release no check has seen.
row_past() { newer "$(row_have "$1" "$3")" "$2"; }

# Whether apps.json turned Omabump's Update off for the app $1 (its
# updateBlocked), with three answers a caller must tell apart:
#   0  off: the reason on stdout
#   1  not off, nothing on stdout. An app installed as a copy that updates
#      itself ($2 true) has no Update to turn off; Omabump's own row
#      (self_app) carries none.
#   2+ the entry could not be read (jq failed: its status, 2 for its 1),
#      nothing on stdout. Not "not off": a caller that cannot stop treats
#      it as its own failure, as a top-level read under set -e did. Callers
#      run it in a test (if, ||), where set -e stops nothing, so the read's
#      status is checked here.
update_blocked() {
  local why rc=0
  why=$(jq -r '.updateBlocked // ""' <<<"$1") || rc=$?
  (( rc == 0 )) || return $(( rc == 1 ? 2 : rc ))
  [[ $2 != true && -n $why ]] || return 1
  printf '%s\n' "$why"
}

# What an Update turned off (blocked, update_blocked's reason) does to the
# route's installable and note, in the check and the local refresh alike.
# shellcheck disable=SC2154 # the row's fields, the caller's variables
apply_blocked() {
  [[ -n $blocked ]] || return 0
  installable=false note="Update off: $blocked${note:+; $note}"
  note_parts=$(parts_cat "$(part note.updateOff "$blocked")" "${note_parts-null}")
}

# The repo route's own word on Update before the repo is read: its tools
# (repo_missing_line). Sets installable, note and note_parts.
repo_route_base() {
  note=$(repo_missing_line) note_parts=$(repo_missing_parts) installable=true
  [[ -z $note ]] || installable=false
}

# True when the entry $1 names a feed. A repo entry may have none: the
# repo's version is then its only newest one, and it is never ahead.
has_feed() { jq -e '.feed | type == "object"' >/dev/null 2>&1 <<<"$1"; }

# Installed under another name (chatgpt-desktop, z-code-bin): Update
# replaces it when it installs a newer version, Switch does it at the same
# one. A row is switchable when its route installs a package by the row's
# pkg (route_table's switch) and works (Update not off, its tools there),
# Update does not offer the replacement already, and the version Switch
# would install is not older than what is installed (switch_target_ok,
# which the installer asks too). $1 source, $2 installed name, $3 pkg,
# $4 the route works (true/false), $5 update, $6 installable, $7 the
# version Switch installs (the vendor's newest, or the repo's full
# version; "" when none), $8 installed.
row_switchable() {
  route "$1" switch yes && [[ $2 != "$3" && $4 == true ]] && ! [[ $5 == true && $6 == true ]] \
    && switch_target_ok "$8" "$7"
}

# True when Switch may install the version $2 over the installed full
# version $1: $2 is known and $1 is not newer. A feed's upstream version
# is compared with the upstream part alone, as vercmp does without a
# pkgrel on one side; the repo's full version with the full one.
switch_target_ok() { [[ -n $2 ]] && ! newer "$1" "$2"; }

# The row of an app installed as a copy that updates itself (installed_app
# names it by its path): its own updater replaces it, so the row has no
# route, and its note says how the app updates (self_update_text). $1 the
# app, $2 its label, $3 the copy's path as installed_app names it, $4 its
# version (empty when unknown), $5 the newest known. Sets update, unchecked,
# note and note_parts. A release version (version_ok: no "-", and a digit first)
# compares with the feed's by vercmp as it is, since a copy has no pkgrel.
# A pre-release (0.1.1-nightly.20261019.1) is compared with nothing: a
# feed's version never has a "-", so it is a release of another channel,
# and vercmp would take the suffix for a pkgrel and call
# 0.1.1-nightly.x the same as 0.1.1. Nor is a version with a letter first
# (continuous, as some CI builds name theirs): vercmp ranks it below every
# numeric one, an update forever. Such a row, or one whose version is
# unknown, never claims an update and never reads as current (unchecked),
# and its note says why first.
self_row() {
  local app=$1 label=$2 name=$3 have=$4 latest=$5 why="" why_key=""
  update=false unchecked=false
  if [[ -z $have ]]; then
    unchecked=true
    if [[ $name == "$(jq -r '.npmPackage // "" | strings' <<<"$app")" ]]; then
      why="Version unknown: its package.json names none" why_key=note.versionUnknownNpm
    elif command -v 7z >/dev/null; then
      why="Version unknown: 7z could not read it from the AppImage" why_key=note.versionUnknown7z
    else
      why="Version unknown: install 7zip to read it (sudo pacman -S --needed 7zip)" why_key=note.versionUnknownNo7z
    fi
  elif [[ $have != [0-9]* ]]; then
    unchecked=true why="Not a release number, not compared with the feed's" why_key=note.notRelease
  elif ! version_ok "$have"; then
    unchecked=true why="Pre-release build, not compared with the feed's stable releases" why_key=note.preRelease
  elif [[ -n $latest ]] && newer "$latest" "$have"; then
    update=true
  fi
  note="${why:+$why; }Updates itself: $(self_update_text "$app" "$label")"
  note_parts=$(parts_cat "${why_key:+$(part "$why_key")}" "$(self_update_parts "$app" "$label")")
}

# The clause a recipe's release-age window puts on Build now: the recipe
# holds a release for its min_release_age (.omarchy/package.json, $3
# seconds), and bin/sync-upstream does not move it to a younger one, so a
# build could not reach it before then. The window counts from the first
# check that saw the version $2 of the row $1 (seen_since), at the time $4.
# Prints the clause while it holds, nothing once it has passed or with no
# window; build_hold_parts the same as parts, [] for nothing, the window's
# end as a date ({date: epoch seconds}) that the panel writes its way.
build_hold_end() {
  local ends
  (( $3 > 0 )) || return 0
  ends=$(( $(seen_since "$1" "$2" "$4") + $3 ))
  (( $4 < ends )) || return 0
  echo "$ends"
}
build_hold_clause() {
  local ends
  ends=$(build_hold_end "$@")
  [[ -n $ends ]] || return 0
  echo "omarchy-pkgs holds new releases for $(( ($3 + 3599) / 3600 )) h, Build now from $(date -d "@$ends" '+%b %-d %H:%M')"
}
build_hold_parts() {
  local ends
  ends=$(build_hold_end "$@")
  [[ -n $ends ]] || { echo '[]'; return 0; }
  jq -cn --arg h "$(( ($3 + 3599) / 3600 ))" --argjson e "$ends" '[{key: "build.hold", args: [$h, {date: $e}]}]'
}

# Why Build now could not run for a row, apart from whether the vendor is
# ahead: sets build_reason to the words, "" when it could, and build_from
# to which of the four it was (entry, off, tools, recipe; "" with no
# reason), so that no reader has to tell them apart by their words: the
# local refresh reads the first three again and keeps only a recipe's
# (local_row in bin/omabump-check). In this order: the entry may not
# be built ($1 false: build_allowed), Update is off for it ($2, the
# reason), a build tool is missing ($3, missing_tools_line's), and what
# the recipe says ($4: its blocker, its release-age clause, or why it could
# not be read; "" when it was not read, as while buildAhead is off, when
# the installer finds out the rest). $5 and $6 are $3 and $4 as parts
# (missing_tools_parts, and the recipe's), and build_reason_parts the
# reason as parts.
build_reason="" build_from="" build_reason_parts='[]'
build_why() {
  build_reason="" build_from="" build_reason_parts='[]'
  if [[ $1 != true ]]; then build_from=entry build_reason="Not in Omarchy's repo yet" build_reason_parts=$(part note.notInRepo)
  elif [[ -n $2 ]]; then build_from=off build_reason="Update off: $2" build_reason_parts=$(part note.updateOff "$2")
  elif [[ -n $3 ]]; then build_from=tools build_reason=$3 build_reason_parts=${5:-null}
  elif [[ -n $4 ]]; then build_from=recipe build_reason=$4 build_reason_parts=${6:-null}
  fi
}

# The row of an app on a route whose newest version is Omarchy's repo's
# (route_table's newest repo), from plain facts: the one rule for the
# check, the local refresh and, through vendor_ahead and switch_target_ok,
# the installer. Reads:
#   pkg, installed          the row's id, the full version installed
#   repo_version            the full version the repo has, "" when none
#                           or unknown
#   vendor_version          the vendor's newest release from the entry's
#                           feed, "" without one
#   repo_why, repo_why_parts  why repo_version is "", for the note (no
#                           repo, no such package); "" (and []) to add
#                           nothing
#   repo_failed             true when the repo's database could not be read
#   feed_error              the feed's failure, "" when it answered
#   installable, note, note_parts  the route's: true unless Update is off
#                           or a tool is missing, and its note
#   build_reason, build_from, build_reason_parts  build_why's answer for
#                           the row
# Sets:
#   repo_new                the repo has a package newer than installed:
#                           Update can install it (and the check announces
#                           it, by repo_version)
#   ahead                   vendor_ahead: the vendor has a release the repo
#                           does not
#   update                  repo_new or ahead
#   installable             Update can run: the route's, and repo_new
#   route_ok                the route's installable, for Switch
#   buildable, build_note   Build now could run (ahead, and no
#                           build_reason), or why not while ahead, with
#                           build_note_from saying which reason it is,
#                           and build_note_parts the same as parts
#   latest, from            the newest version the row shows: the vendor's
#                           while ahead; else the repo's, by its upstream
#                           version when that is the vendor's too
#   held, hold_clause, note, note_parts  Update waits for the repo ("Not
#                           in Omarchy's repo yet" first in the note)
#                           while the vendor is ahead and the repo has an
#                           older package
#   route_error             set when the repo could not be read and the
#                           row shows something newer, or knows nothing
#                           else: Update can be neither offered nor ruled
#                           out
# shellcheck disable=SC2154 # the row's fields, the caller's variables
repo_derive() {
  local repo_up=""
  repo_new=false ahead=false buildable=false build_note="" build_note_from="" build_note_parts='[]' held=false hold_clause=""
  route_ok=$installable
  [[ -z $repo_version ]] || repo_up=$(upstream_part "$repo_version")
  if [[ -n $repo_version ]] && newer "$repo_version" "$installed"; then repo_new=true; fi
  if vendor_ahead "$installed" "$repo_version" "$vendor_version"; then ahead=true; fi
  if [[ $ahead == true ]]; then
    latest=$vendor_version from=feed
  elif [[ $repo_new == true ]]; then
    # The vendor's own words for the repo's release, unless only a pkgrel
    # moved (the upstream part already installed).
    if [[ $vendor_version == "$repo_up" ]] && newer "$vendor_version" "$(upstream_part "$installed")"; then
      latest=$vendor_version from=feed
    else
      latest=$repo_version from=repo
    fi
  elif [[ -n $vendor_version ]] && { [[ -z $repo_version ]] || ! newer "$repo_up" "$vendor_version"; }; then
    latest=$vendor_version from=feed
  elif [[ -n $repo_version ]]; then
    latest=$repo_version from=repo
  else
    latest="" from=""
  fi
  update=false
  [[ $repo_new == false && $ahead == false ]] || update=true
  [[ $repo_new == true ]] || installable=false
  # A feed that failed while the repo answered is no failure: the repo says
  # what Update installs. Its last known release stays (stale) only while
  # it is what makes the row ahead.
  if [[ -n $feed_error && -n $repo_version ]]; then
    feed_error=""
    [[ $ahead == true ]] || stale=false
  fi
  if [[ $ahead == true ]]; then
    if [[ -z $build_reason ]]; then buildable=true
    else build_note=$build_reason build_note_from=$build_from build_note_parts=$build_reason_parts; fi
  fi
  if [[ $ahead == true && $repo_new == false && $route_ok == true && -n $repo_version ]]; then
    held=true hold_clause="Not in Omarchy's repo yet"
    note="$hold_clause${note:+; $note}"
    note_parts=$(parts_cat "$(part note.notInRepo)" "${note_parts-null}")
  fi
  if [[ -z $repo_version && -n $repo_why ]]; then
    note="${note:+$note; }$repo_why"
    note_parts=$(parts_cat "${note_parts-null}" "${repo_why_parts:-null}")
  fi
  if [[ $repo_failed == true ]] && { [[ $update == true || -n $feed_error || -z $vendor_version ]]; }; then
    route_error=$repo_error
  fi
  return 0
}

# The rest of a row once its route and its newest version have been read.
# Reads pkg, source, app, label, installed_name, installed, latest, from,
# mise_update (mise's answer, a mise row's update), self_updating, and the
# route's installable, note, held and unchecked; on a route whose newest is
# the repo's, repo_derive's inputs too. Sets update (row_newer, repo_derive,
# or self_row for a copy that updates itself), switchable
# (row_switchable), and skipped, skip_end and quiet (row_quiet), and, off
# the repo's routes, repo_new, ahead, buildable, build_note and
# hold_clause as nothing. Call it in the calling shell: it answers through
# these variables.
# shellcheck disable=SC2154 # the row's fields, the caller's variables
row_derive() {
  local target
  update=$mise_update repo_new=false ahead=false buildable=false build_note="" build_note_from="" build_note_parts='[]' hold_clause=""
  route_ok=$installable
  if [[ $self_updating == true ]]; then
    self_row "$app" "$label" "$installed_name" "$installed" "$latest"
  elif route "$source" newest repo; then
    repo_derive
  elif [[ -n $latest ]] && ! route "$source" newest mise; then
    row_newer "$latest" "$installed" "$from" && update=true
  fi
  target=$latest
  ! route "$source" newest repo || target=$repo_version
  switchable=false
  row_switchable "$source" "$installed_name" "$pkg" "$route_ok" "$update" "$installable" "$target" "$installed" \
    && [[ $self_updating == false ]] && switchable=true
  row_quiet "$pkg" "$source" "$update" "$latest" "$installed"
}

# The row as status.json holds it, on stdout as one line of JSON: the one
# place a whole row is built. Its fields are these variables (true/false
# for a flag): pkg, label, source, installed_name, installed, latest, from
# (versionFrom), update (updateAvailable), installable, error, note and
# note_parts (noteParts, its parts; null when they are not known), stale,
# switchable, skipped, skip_end (skipEnded), unchecked, held,
# omarchy_update, blocked (the reason, "" when Update is not off),
# self_updating, hold_clause (holdClause, repo_derive's), unread (written
# by a local refresh, read by no check since), repo_version (repoVersion:
# the full version Omarchy's repo has of a repo row's package, "" when
# unknown), vendor_version (vendorVersion, the feed's newest on such a
# row, "" without one), ahead, buildable, build_note (buildNote),
# build_note_parts (buildNoteParts) and build_note_from (buildNoteFrom), and
# the icon and iconLight of the entry app; section and switchRoute are its
# route's (route_table), for the panel. Every string from a feed, mise,
# pacman or apps.json goes through clean_text on its way in. The fields
# are listed under status.json below.
# shellcheck disable=SC2154 # the row's fields, the caller's variables
row_json() {
  jq -cn --arg pkg "$pkg" --arg label "$(clean_text "$label")" --arg source "$source" \
    --arg installedName "$(clean_text "$installed_name")" --arg installed "$(clean_text "$installed")" \
    --arg latest "$(clean_text "$latest")" --arg versionFrom "$from" --argjson update "$update" \
    --argjson installable "$installable" --arg error "$(clean_text "$error")" --arg note "$(clean_text "$note")" \
    --argjson stale "$stale" --argjson switchable "$switchable" --argjson skipped "$skipped" \
    --arg skipEnded "$skip_end" --argjson unchecked "$unchecked" --argjson held "$held" \
    --argjson omarchyUpdate "$omarchy_update" --arg blocked "$blocked" --argjson selfUpdating "$self_updating" \
    --arg holdClause "$(clean_text "$hold_clause")" --argjson unread "$unread" \
    --arg repoVersion "$(clean_text "${repo_version:-}")" --arg vendorVersion "$(clean_text "${vendor_version:-}")" \
    --argjson ahead "${ahead:-false}" --argjson buildable "${buildable:-false}" --arg buildNote "$(clean_text "${build_note:-}")" \
    --arg buildNoteFrom "${build_note_from:-}" \
    --argjson noteParts "${note_parts:-null}" --argjson buildNoteParts "${build_note_parts:-[]}" \
    --arg section "${route_facts[$source.section]:-desktop}" --argjson switchRoute "$(route "$source" switch yes && echo true || echo false)" \
    --argjson app "$app" \
    '{pkg: $pkg, label: $label, source: $source, installedName: $installedName,
      installed: $installed, latest: $latest, versionFrom: $versionFrom,
      updateAvailable: $update, installable: $installable, error: $error, note: $note,
      stale: $stale, switchable: $switchable,
      skipped: $skipped, skipEnded: $skipEnded, unchecked: $unchecked,
      held: $held, omarchyUpdate: $omarchyUpdate, blocked: ($blocked != ""),
      selfUpdating: $selfUpdating, icon: ($app.icon // "" | tostring), iconLight: ($app.iconLight // "" | tostring),
      holdClause: $holdClause, unread: $unread,
      section: (($app.section | select(IN("desktop", "cli"))) // $section), switchRoute: $switchRoute,
      repoVersion: $repoVersion, vendorVersion: $vendorVersion, ahead: $ahead, buildable: $buildable,
      buildNote: $buildNote, buildNoteFrom: $buildNoteFrom, noteParts: $noteParts, buildNoteParts: $buildNoteParts}'
}

# --- status.json -----------------------------------------------------------------
#
# The last check's result, status_file: what the panel shows, what the next
# check keeps of a row whose feed failed, what the local refresh starts
# from, and what Update compares with. The check writes it
# (status_write_check) and the local refresh rewrites it
# (status_write_local), each in one rename; every bash reader takes it
# through status_load and a row of it through status_row, and the panel
# reads it in Model.parseStatus. schemaVersion names the shape, and a file
# of another one (or none) is no status.json to these readers.
#
# Version 1, the top level:
#   schemaVersion  1
#   checkedAt      when the last check ended; while one runs, the one before
#   checking       true while a check runs (rows not read yet carry
#                  "checking": true too); a killed run leaves it, and
#                  startedAt tells the panel the run is stale
#   startedAt      when the last (or running) check started
#   inventoryAt    when the installed versions were last read: a finished
#                  check's start, or a local refresh
#   runError       why the check failed as a whole, "" when it did not
#   retry          the run was the retry of a check that failed (--retry)
#   omarchyPkgs    {commit, following, error, note}: the omarchy-pkgs pin
#   miseError      why mise's inventory could not be read
#   apps           the rows, in row_order
# A row (row_json) has pkg, label, source, installedName, installed,
# latest, versionFrom, updateAvailable, installable, error, note, stale,
# switchable, skipped, skipEnded, unchecked, held, omarchyUpdate, blocked,
# selfUpdating, icon and iconLight, and since they came holdClause and
# unread, then section and switchRoute (the route's section and switch,
# route_table), then repoVersion, then (0.2.0) vendorVersion, ahead,
# buildable, buildNote and buildNoteFrom (repo_derive says what they mean;
# buildNoteFrom is build_why's entry, off, tools or recipe). A file from an
# older checker may lack the later ones: inventoryAt, retry, selfUpdating,
# holdClause, unread, section, switchRoute, repoVersion, vendorVersion,
# ahead, buildable, buildNote and buildNoteFrom, and a row the local refresh
# carries over from such a file lacks the last seven until a check reads it. No field a
# reader uses is removed or renamed within a version: a panel still loaded
# from an older release reads a newer checker's file. 0.2.0 stopped
# writing recipe, request and muted, which no panel read (a 0.1.x panel
# read recipe only on omarchy rows, which no longer exist), and added
# fields only, so the version stays 1.
status_schema=1

# The jq definitions for the file: status_ok, a status.json of this shape
# with rows a reader can index (an object per row, its pkg a string);
# status_row($pkg), the row of pkg, {} when there is none; row_order, the
# order of the rows: desktop apps first, mise tools after them, each in
# table order ($order, the pkg ids), then Omabump itself. And for a row:
# row_unread, its unread. A row 0.1.17 or earlier wrote has no such field,
# and said "Not checked yet" in the note of an unchecked row: only for such
# a row is it read from the note.
#
# And for the whole file: field_text, a field as text (none: "", a
# non-string as JSON); and what the widget reads of it the same way
# (tests/model.sh holds the two together): status_apps($mise), the rows
# it lists (an object each, mise rows only while $mise is 1: Show mise
# tools, Model.parseStatus), and check_failed($muted; $mise), whether the
# check it holds failed by the settings as they are now, the muted pkg ids
# $muted and Show CLI tools $mise (1 or 0). Failed means what the widget
# calls a failure (Model.failureText, or Model.errorCount above 0): runError,
# a mise error that not only muted rows share (all_muted: every listed mise
# row, and at least one, muted), an omarchy-pkgs error while a listed row
# that is not muted is ahead of the repo (the check reads the clone for
# such rows alone), or a failed row that is not muted. The mark of a run still checking counts too, which the
# widget shows as a check running instead: --if-due reads the file under
# the lock, when no check runs, so the mark is a killed run's.
# shellcheck disable=SC2016 # jq variables, not the shell's
jq_status=$jq_routes'
  def status_ok: type == "object" and .schemaVersion == '"$status_schema"' and (.apps | type == "array")
    and all(.apps[]; type == "object" and (.pkg | type == "string"));
  def status_row($pkg): [.apps[] | select(.pkg == $pkg)][0] // {};
  def row_order($order): sort_by([route_rank, (.pkg as $p | $order | index($p) // 1e9)]);
  def row_unread: if has("unread") then .unread == true else .unchecked == true and .note == "Not checked yet" end;
  def field_text: if . == null or . == false then "" elif type == "string" then . else tostring end;
  def status_apps($mise): [.apps | arrays | .[] | objects | select($mise == 1 or route_section != "cli")];
  def check_failed($muted; $mise):
    status_apps($mise) as $apps
    | def muted: (.pkg | tostring) as $p | $muted | index($p) != null;
      def all_muted($source): [$apps[] | select(.source == $source and .selfUpdating != true)]
        | length > 0 and all(.[]; muted);
      ((.omarchyPkgs | objects | .error) // null | field_text) as $perr
    | (.runError | field_text) != "" or ($perr != "" and any($apps[]; .ahead == true and (muted | not)))
      or ($mise == 1 and (.miseError | field_text) != "" and (all_muted("mise") | not))
      or any($apps[]; (.error | field_text) != "" and (muted | not)) or .checking == true;'

# Every bar asks whether a check is due, and a local refresh whether one
# is, at about the same time: a run that started less than its interval
# $3 (seconds), less due_slack_sec, before the time $1 is recent enough,
# and none other is due. $2 is when it started, empty when unknown; any
# value that is no count of seconds is not recent. A time
# ahead of the clock (it was set back) proves nothing, and is not recent.
# Model.localDue reads the same slack (Model.dueSlackSec); tests/model.sh
# sets the two side by side.
due_slack_sec=30
run_recent() {
  [[ $1 =~ ^[0-9]{1,12}$ && $2 =~ ^[0-9]{1,12}$ && $3 =~ ^[0-9]{1,9}$ ]] || return 1
  (( $1 >= $2 && $1 - $2 < $3 - due_slack_sec ))
}

# Reads status_file into status_json when it is a status.json of this
# shape (status_ok), and with $1 "finished" only when no check is running
# or was killed running (checking). Fails, status_json "", otherwise:
# missing, empty, not JSON, of another schemaVersion.
status_json=""
status_load() {
  local text
  status_json=""
  [[ -s $status_file ]] || return 1
  text=$(<"$status_file") || return 1
  jq -e --arg finished "${1:-}" "$jq_status"' status_ok and ($finished != "finished" or .checking != true)' \
    >/dev/null 2>&1 <<<"$text" || return 1
  status_json=$text
}

# The row of the id $1 in the status.json text $2 (status_load's), through
# the jq filter $3 (tojson by default), on stdout as raw text: {} when the
# file has no such row.
status_row() {
  jq -r --arg pkg "$1" "$jq_status"' status_row($pkg) | '"${3:-tojson}" <<<"$2"
}

# The field $2 of the row of $1 in status.json as it is now (status_load),
# as text, a flag as true or false; nothing when no check wrote the file,
# or the row or field is missing or of another type.
status_field() {
  status_load || return 0
  # shellcheck disable=SC2016 # jq variables, not the shell's
  jq -r --arg pkg "$1" --arg f "$2" "$jq_status"' status_row($pkg)[$f]
    | select(type == "string" or type == "boolean") | tostring' <<<"$status_json"
}

# Replaces status.json with a check's, in one rename. $1 is 0 while
# checking, 1 for the final write, 2 when the run dies half way; $2
# checkedAt, $3 startedAt, $4 retry (0 or 1), $5 runError ("" but on a run
# that dies: every copy of the widget, and a run from a terminal, sees a
# failed run, not only the one whose process exited non-zero), $6 the
# omarchy-pkgs commit, $7 its error, $8 its note, $9 miseError, ${10} the
# file of the status.json the run started from, ${11} the table's order
# (a JSON array of pkg ids), ${12} the omarchy-pkgs note as parts ([]
# when not given); the rows checked so far on stdin, one a line.
# Until the final write, rows not checked yet keep their previous entry,
# flagged "checking": true while the run lasts, so the panel shows progress
# row by row. inventoryAt is the run's start once it is done, and stays the
# last one's until then.
# Call both writers in the calling shell, never at the end of a pipe: stdin
# from a file. A TERM, INT or HUP that comes while jq runs then has its trap
# run once jq is done and before the rename, so the run stops with the
# previous status.json in place; at the end of a pipe the rename would
# happen in the pipe's subshell first. A jq that fails leaves status.json
# alone too, under set -e or not (the dying run's write, in the EXIT trap).
status_write_check() {
  local out
  out=$(mktemp "${run_tmp:-$state_dir}/.status.XXXXXX")
  # shellcheck disable=SC2016 # jq variables, not the shell's
  jq -s --slurpfile prevs "${10}" --argjson order "${11}" --argjson pparts "${12:-[]}" \
    --argjson final "$1" --arg at "$2" --arg started "$3" --argjson retry "$4" --arg rerr "$5" \
    --arg commit "$6" --arg perr "$7" --arg pnote "$8" --arg merr "$9" \
    --argjson following "$pkgs_follow" --argjson schema "$status_schema" "$jq_status"'
    $prevs[0] as $prev
    | (map(.pkg)) as $done
    | (if $final == 1 then .
       else . + [$prev.apps[] | select(.pkg as $p | $done | index($p) | not) | .checking = ($final == 0)] end)
    | row_order($order)
    | {schemaVersion: $schema, checkedAt: $at, checking: ($final == 0), startedAt: $started,
       inventoryAt: (if $final == 1 then $started else ($prev.inventoryAt | strings) // "" end), runError: $rerr,
       retry: ($retry == 1),
       omarchyPkgs: {commit: $commit, following: ($following == 1), error: $perr, note: $pnote, noteParts: $pparts},
       miseError: $merr, apps: .}' >"$out" || { local rc=$?; rm -f "$out"; return "$rc"; }
  mv -f "$out" "$status_file"
}

# Replaces status.json with the local refresh's, in one rename: the
# status.json in the file $1 with the changed rows on stdin, one a line,
# put in place of its rows by pkg (a row not there yet is added, one with
# "_drop": true goes), every row of the table in the file $2 taking its
# icon and iconLight from it, and inventoryAt $3. Everything else stays as
# the check left it: checkedAt and startedAt, which the widget counts the
# next check from, included. In the calling shell, as status_write_check.
status_write_local() {
  local out
  out=$(mktemp "${run_tmp:-$state_dir}/.status.XXXXXX")
  # shellcheck disable=SC2016 # jq variables, not the shell's
  jq -s --slurpfile prevs "$1" --slurpfile table "$2" --arg inventory "$3" "$jq_status"'
    $prevs[0] as $prev
    | ($table[0] | map(.pkg)) as $order
    | ($table[0] | map({key: .pkg, value: {icon: (.icon // "" | tostring), iconLight: (.iconLight // "" | tostring)}})
        | from_entries) as $icons
    | reduce .[] as $c ($prev.apps;
        if any(.[]; .pkg == $c.pkg) then map(if .pkg == $c.pkg then $c else . end) else . + [$c] end)
    | map(if $icons[.pkg] then . + $icons[.pkg] else . end)
    | $prev + {inventoryAt: $inventory, apps: (map(select(._drop != true)) | row_order($order))}' >"$out" \
    || { local rc=$?; rm -f "$out"; return "$rc"; }
  mv -f "$out" "$status_file"
}
